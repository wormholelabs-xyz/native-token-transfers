-- | Tests of 'Wormhole.Genesis': the operator offers every genesis parameter,
-- and the guardians accept once. Guardian keys are generated in the script, so
-- each test signs its own VAAs.
module Test.TestAcceptGenesis where

import Daml.Script
import DA.Assert ((===))
import DA.Crypto.Text (keccak256)
import DA.Foldable (forA_, maximum)
import DA.List (dedup, sort)
import DA.Optional (isNone, isSome)
import DA.Set qualified as Set
import DA.Text qualified as T

import Splice.Api.Token.BurnMintV1 (BurnMintFactory)
import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Token.CIP0056.CoinFactory (CoinFactory (..))
import Wormhole.Core.Bytes
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Core.Governance (coreModule)
import Wormhole.Core.Setup (GenesisGuardianSet (..), defaultGovernanceContract, mkInitialCoreState, solanaGovernanceChainId)
import Wormhole.Core.State
import Wormhole.Core.VAA (addressFromPubKey, parseVAA, spkiPrefixSecp256k1)
import Wormhole.Genesis
import Wormhole.Ntt.Governance
import Wormhole.Ntt.Manager
import Wormhole.Ntt.Payload (NttGovernanceAction (..), encodeNttGovernance)

----------------------------------------------------------------------
-- In-script guardian signing
----------------------------------------------------------------------

data GuardianKey = GuardianKey with
    privateKey : Text
    publicKey  : Bytes
  deriving (Eq, Show)

generateGuardianKey : Script GuardianKey
generateGuardianKey = do
  pair <- secp256k1generatekeypair
  let spki = normalizeHex pair.publicKey
  assertMsg ("unexpected public key encoding: " <> spki) (spkiPrefixSecp256k1 `T.isPrefixOf` spki)
  let publicKey = T.drop (T.length spkiPrefixSecp256k1) spki
  byteLength publicKey === 65
  pure GuardianKey with privateKey = pair.privateKey, publicKey

-- | DER @SEQUENCE { INTEGER r, INTEGER s }@ to 32-byte @r@ and @s@.
derSignatureToRs : Bytes -> (Bytes, Bytes)
derSignatureToRs der =
  let rLength = bytesToInt (sliceBytes 3 1 der)
      r = sliceBytes 4 rLength der
      sOffset = 4 + rLength
      sLength = bytesToInt (sliceBytes (sOffset + 1) 1 der)
      s = sliceBytes (sOffset + 2) sLength der
  in (leftPadTo 32 (stripLeadingZeroBytes r), leftPadTo 32 (stripLeadingZeroBytes s))

-- | A governance VAA from the standard governance emitter, signed by guardian 0 of set 0.
signGovernanceVaa : GuardianKey -> Int -> Bytes -> Script Bytes
signGovernanceVaa key sequence payload = do
  let body = intToBytesN 0 4 <> intToBytesN 0 4
        <> intToBytesN solanaGovernanceChainId 2 <> leftPadTo 32 defaultGovernanceContract
        <> intToBytesN sequence 8 <> "00" <> normalizeHex payload
      digest = keccak256 (keccak256 body)
  der <- secp256k1signWithEcdsaOnly key.privateKey digest
  let (r, s) = derSignatureToRs (normalizeHex der)
  pure ("01" <> intToBytesN 0 4 <> "01" <> "00" <> r <> s <> "00" <> body)

setMessageFeePayload : Int -> Bytes
setMessageFeePayload fee = coreModule <> "03" <> intToBytesN cantonChainIdForTests 2 <> leftPadTo 32 (intToBytesN fee 8)

transferFeesPayload : Int -> Bytes32 -> Bytes
transferFeesPayload amount recipient =
  coreModule <> "04" <> intToBytesN cantonChainIdForTests 2 <> leftPadTo 32 (intToBytesN amount 8) <> recipient

cantonChainIdForTests : Int
cantonChainIdForTests = 75

----------------------------------------------------------------------
-- Parties and parameters
----------------------------------------------------------------------

data GenesisParties = GenesisParties with
    operator           : Party
    guardianGovernance : Party
    feeCustody         : Party
    nttCustody         : Party
    onboardingFeeAdmin : Party
    feeInstrumentAdmin : Party
    stranger           : Party

allocateGenesisParties : Text -> Script GenesisParties
allocateGenesisParties label = do
  operator <- allocateParty (label <> "Operator")
  guardianGovernance <- allocateParty (label <> "GuardianGovernance")
  feeCustody <- allocateParty (label <> "FeeCustody")
  nttCustody <- allocateParty (label <> "NttCustody")
  onboardingFeeAdmin <- allocateParty (label <> "OnboardingFeeAdmin")
  feeInstrumentAdmin <- allocateParty (label <> "FeeInstrumentAdmin")
  stranger <- allocateParty (label <> "Stranger")
  pure GenesisParties with ..

guardianAddressA : Bytes20
guardianAddressA = "befa429d57cd18b7f8a4d91a2da9ab4af05d0fbe"

guardianAddressB : Bytes20
guardianAddressB = "88d7d8b32a9105d228100e72dffe2fae0705d31c"

digestOf : Text -> Bytes32
digestOf label = keccak256 (toHex label)

parametersFor : GenesisParties -> [Bytes20] -> GenesisParameters
parametersFor parties guardianAddresses = GenesisParameters with
  guardianGovernance = parties.guardianGovernance
  feeCustody = parties.feeCustody
  nttCustody = parties.nttCustody
  onboardingFeeAdmin = parties.onboardingFeeAdmin
  genesisGuardianSet = GenesisGuardianSet with guardianSetIndex = 0, guardianAddresses
  governanceChainId = solanaGovernanceChainId
  governanceContract = defaultGovernanceContract
  initialMessageFee = 0
  feeInstrument = InstrumentId with admin = parties.feeInstrumentAdmin, id = "Amulet"
  registrationFee = 0
  replayRootClaimFee = 0
  firstEmitterId = 0
  firstNttManagerId = 0
  consumedCoreGovernanceDigests = []
  consumedNttGovernanceDigests = []

offerGenesis : GenesisParties -> GenesisParameters -> Script (ContractId WormholeGenesisOffer)
offerGenesis parties parameters =
  submit parties.operator do createCmd WormholeGenesisOffer with operator = parties.operator, parameters

tryOfferGenesis : GenesisParties -> GenesisParameters -> Script (Either SubmitError (ContractId WormholeGenesisOffer))
tryOfferGenesis parties parameters =
  trySubmit parties.operator do createCmd WormholeGenesisOffer with operator = parties.operator, parameters

-- | The guardians accept: gg and both custody parties act.
acceptAsGuardians : GenesisParameters -> ContractId WormholeGenesisOffer -> GenesisParameters -> Script (Either SubmitError GenesisRoots)
acceptAsGuardians offered offerCid agreedParameters =
  trySubmit (actAs offered.guardianGovernance <> actAs offered.feeCustody <> actAs offered.nttCustody) do
    exerciseCmd offerCid AcceptGenesis with agreedParameters

acceptGenesisRoots : GenesisParameters -> ContractId WormholeGenesisOffer -> Script GenesisRoots
acceptGenesisRoots parameters offerCid =
  acceptAsGuardians parameters offerCid parameters
    >>= either (\submitError -> abort ("AcceptGenesis failed: " <> rejectionText submitError)) pure

rejectionText : SubmitError -> Text
rejectionText = \case
  FailureStatusError failure -> failure.message
  submitError -> show submitError

discardResult : Script (Either SubmitError a) -> Script (Either SubmitError ())
discardResult = fmap (fmap (const ()))

----------------------------------------------------------------------
-- Test 1: AcceptGenesis creates every root
----------------------------------------------------------------------

data StakeholderCase = StakeholderCase with
    templateName        : Text
    actualSignatories   : [Party]
    actualObservers     : [Party]
    expectedSignatories : [Party]

testAcceptGenesisCreatesEveryRoot : Script ()
testAcceptGenesisCreatesEveryRoot = do
  parties <- allocateGenesisParties "Roots"
  let gg = parties.guardianGovernance
      coreDigest = digestOf "core governance before genesis"
      nttDigest = digestOf "ntt governance before genesis"
      parameters = (parametersFor parties [guardianAddressA, guardianAddressB]) with
        initialMessageFee = 5
        registrationFee = 7
        replayRootClaimFee = 9
        firstEmitterId = 3
        firstNttManagerId = 2
        consumedCoreGovernanceDigests = [coreDigest]
        consumedNttGovernanceDigests = [nttDigest]
  offerCid <- offerGenesis parties parameters
  roots <- acceptGenesisRoots parameters offerCid

  Some coreState <- queryContractId gg roots.coreStateCid
  Some emitterRegistry <- queryContractId gg roots.emitterRegistryCid
  Some replayRootRegistry <- queryContractId gg roots.replayRootRegistryCid
  Some nttGovernance <- queryContractId gg roots.nttGovernanceCid
  Some coinFactory <- queryContractId gg roots.coinFactoryCid
  let cases =
        [ StakeholderCase "CoreState" (signatory coreState) (observer coreState) [gg, parties.feeCustody]
        , StakeholderCase "EmitterRegistry" (signatory emitterRegistry) (observer emitterRegistry) [gg]
        , StakeholderCase "ReplayRootRegistry" (signatory replayRootRegistry) (observer replayRootRegistry) [gg]
        , StakeholderCase "NttGovernance" (signatory nttGovernance) (observer nttGovernance) [gg, parties.nttCustody]
        , StakeholderCase "CoinFactory" (signatory coinFactory) (observer coinFactory) [gg]
        ]
  forA_ cases \stakeholderCase -> do
    assertMsg (stakeholderCase.templateName <> ": signatories " <> show stakeholderCase.actualSignatories)
      (sort (dedup stakeholderCase.actualSignatories) == sort stakeholderCase.expectedSignatories)
    assertMsg (stakeholderCase.templateName <> ": observers " <> show stakeholderCase.actualObservers)
      (null stakeholderCase.actualObservers)
    assertMsg (stakeholderCase.templateName <> ": the operator is a stakeholder")
      (parties.operator `notElem` (stakeholderCase.actualSignatories <> stakeholderCase.actualObservers))

  let expectedCoreState =
        (mkInitialCoreState gg parameters.governanceChainId parameters.governanceContract
          parameters.genesisGuardianSet parameters.feeInstrument parameters.feeCustody) with
          messageFee = 5
          consumedGovernance = Set.fromList [coreDigest]
  coreState === expectedCoreState
  emitterRegistry.guardianGovernance === gg
  emitterRegistry.onboardingFeeAdmin === parties.onboardingFeeAdmin
  emitterRegistry.registrationFee === 7
  emitterRegistry.nextId === 3
  replayRootRegistry.guardianGovernance === gg
  replayRootRegistry.onboardingFeeAdmin === parties.onboardingFeeAdmin
  replayRootRegistry.claimFee === 9
  nttGovernance.guardianGovernance === gg
  nttGovernance.nttCustody === parties.nttCustody
  nttGovernance.nextId === 2
  nttGovernance.consumedGovernance === Set.fromList [nttDigest]
  coinFactory.admin === gg

  offerAfterAccept <- queryContractId parties.operator offerCid
  assertMsg "the offer is active after AcceptGenesis" (isNone offerAfterAccept)
  operatorCoreStates <- query @CoreState parties.operator
  operatorCoreStates === []
  operatorNttRoots <- query @NttGovernance parties.operator
  operatorNttRoots === []

----------------------------------------------------------------------
-- Test 2: AcceptGenesis rejects
----------------------------------------------------------------------

data GenesisRejectionCase = GenesisRejectionCase with
    caseName          : Text
    expectedRejection : Text   -- substring of the rejection; "AuthorizationError" or "ContractNotFound" match the error kind
    offerStaysActive  : Bool
    attempt           : GenesisParties -> GenesisParameters -> ContractId WormholeGenesisOffer -> Script (Either SubmitError ())

checkRejection : Text -> Text -> Either SubmitError () -> Script ()
checkRejection caseName expectedRejection = \case
  Right _ -> abort (caseName <> ": accepted")
  Left (AuthorizationError _) | expectedRejection == "AuthorizationError" -> pure ()
  Left (ContractNotFound {}) | expectedRejection == "ContractNotFound" -> pure ()
  Left submitError
    | expectedRejection `T.isInfixOf` rejectionText submitError
        && expectedRejection /= "AuthorizationError"
        && expectedRejection /= "ContractNotFound" -> pure ()
    | otherwise -> abort (caseName <> ": expected " <> expectedRejection <> ", got: " <> rejectionText submitError)

acceptWithChangedParameters : (GenesisParameters -> GenesisParameters) -> GenesisParties -> GenesisParameters -> ContractId WormholeGenesisOffer -> Script (Either SubmitError ())
acceptWithChangedParameters changeParameters _ offered offerCid =
  discardResult (acceptAsGuardians offered offerCid (changeParameters offered))

-- | Offer @changeOffer offered@, then accept it with the same parameters.
acceptChangedOffer : (GenesisParameters -> GenesisParameters) -> GenesisParties -> GenesisParameters -> ContractId WormholeGenesisOffer -> Script (Either SubmitError ())
acceptChangedOffer changeOffer parties offered _ = do
  let changed = changeOffer offered
  changedOfferCid <- offerGenesis parties changed
  discardResult (acceptAsGuardians changed changedOfferCid changed)

mismatchedParameterCases : [(Text, GenesisParameters -> GenesisParameters)]
mismatchedParameterCases =
  [ ("genesis guardian set", \parameters -> parameters with genesisGuardianSet = GenesisGuardianSet with guardianSetIndex = 0, guardianAddresses = [guardianAddressB])
  , ("governance chain", \parameters -> parameters with governanceChainId = 2)
  , ("governance contract", \parameters -> parameters with governanceContract = digestOf "another governance contract")
  , ("message fee", \parameters -> parameters with initialMessageFee = 1)
  , ("fee instrument", \parameters -> parameters with feeInstrument = parameters.feeInstrument with id = "Another")
  , ("fee recipient", \parameters -> parameters with feeCustody = parameters.onboardingFeeAdmin)
  , ("registration fee", \parameters -> parameters with registrationFee = 1)
  , ("claim fee", \parameters -> parameters with replayRootClaimFee = 1)
  , ("onboarding fee admin", \parameters -> parameters with onboardingFeeAdmin = parameters.feeCustody)
  , ("NTT custody party", \parameters -> parameters with nttCustody = parameters.onboardingFeeAdmin)
  , ("guardianGovernance", \parameters -> parameters with guardianGovernance = parameters.onboardingFeeAdmin)
  , ("first emitter id", \parameters -> parameters with firstEmitterId = 1)
  , ("first NTT manager id", \parameters -> parameters with firstNttManagerId = 1)
  , ("consumed core governance digests", \parameters -> parameters with consumedCoreGovernanceDigests = [digestOf "core"])
  , ("consumed NTT governance digests", \parameters -> parameters with consumedNttGovernanceDigests = [digestOf "ntt"])
  ]

testAcceptGenesisRejects : Script ()
testAcceptGenesisRejects = do
  let mismatchCases =
        [ GenesisRejectionCase ("mismatched " <> fieldName) "genesis: agreed parameters differ from the offer" True
            (acceptWithChangedParameters changeParameters)
        | (fieldName, changeParameters) <- mismatchedParameterCases ]
      cases = mismatchCases <>
        [ GenesisRejectionCase "zero address" "guardian set: zero address at position 0" True $
            acceptChangedOffer \parameters -> parameters with
              genesisGuardianSet = GenesisGuardianSet with guardianSetIndex = 0, guardianAddresses = ["0000000000000000000000000000000000000000"]
        , GenesisRejectionCase "duplicate address" "guardian set: duplicate address" True $
            acceptChangedOffer \parameters -> parameters with
              genesisGuardianSet = GenesisGuardianSet with guardianSetIndex = 0, guardianAddresses = [guardianAddressA, guardianAddressA]
        , GenesisRejectionCase "index above uint32" "precondition" True $
            acceptChangedOffer \parameters -> parameters with
              genesisGuardianSet = GenesisGuardianSet with guardianSetIndex = 4294967296, guardianAddresses = [guardianAddressA]
        , GenesisRejectionCase "registration fee above the bound" "precondition" True $
            acceptChangedOffer \parameters -> parameters with registrationFee = maxOnboardingFee + 1
        , GenesisRejectionCase "fee recipient is gg" "precondition" True $
            acceptChangedOffer \parameters -> parameters with feeCustody = parameters.guardianGovernance
        , GenesisRejectionCase "first emitter id above the bound" "precondition" True $
            acceptChangedOffer \parameters -> parameters with firstEmitterId = maxEmitterId + 2
        , GenesisRejectionCase "negative first emitter id" "genesis: first emitter id is negative" True $
            acceptChangedOffer \parameters -> parameters with firstEmitterId = -1
        , GenesisRejectionCase "negative first NTT manager id" "genesis: first NTT manager id is negative" True $
            acceptChangedOffer \parameters -> parameters with firstNttManagerId = -1
        , GenesisRejectionCase "malformed consumed core governance digest" "genesis: consumed governance digest is not 32 bytes of lowercase hex" True $
            acceptChangedOffer \parameters -> parameters with consumedCoreGovernanceDigests = [T.toUpper (digestOf "core")]
        , GenesisRejectionCase "malformed consumed NTT governance digest" "genesis: consumed governance digest is not 32 bytes of lowercase hex" True $
            acceptChangedOffer \parameters -> parameters with consumedNttGovernanceDigests = ["00"]
        , GenesisRejectionCase "duplicate consumed core governance digest" "genesis: duplicate consumed core governance digest" True $
            acceptChangedOffer \parameters -> parameters with consumedCoreGovernanceDigests = [digestOf "core", digestOf "core"]
        , GenesisRejectionCase "duplicate consumed NTT governance digest" "genesis: duplicate consumed NTT governance digest" True $
            acceptChangedOffer \parameters -> parameters with consumedNttGovernanceDigests = [digestOf "ntt", digestOf "ntt"]
        , GenesisRejectionCase "consumed governance digests above the bound" "precondition" True \parties offered _ ->
            discardResult $ tryOfferGenesis parties offered with
              consumedCoreGovernanceDigests = [ digestOf (show position) | position <- [0 .. maxGenesisConsumedGovernanceDigests] ]
        , GenesisRejectionCase "accept by a stranger" "AuthorizationError" True \parties _ offerCid -> do
            offerDisclosure <- fromSomeDisclosure parties.operator offerCid
            discardResult $ trySubmit (actAs parties.stranger <> disclose offerDisclosure) do
              exerciseCmd offerCid AcceptGenesis with agreedParameters = parametersFor parties [guardianAddressA]
        , GenesisRejectionCase "accept by the operator" "AuthorizationError" True \parties offered offerCid ->
            discardResult $ trySubmit parties.operator do
              exerciseCmd offerCid AcceptGenesis with agreedParameters = offered
        , GenesisRejectionCase "accept by gg without the custody parties" "AuthorizationError" True \parties offered offerCid ->
            discardResult $ trySubmit parties.guardianGovernance do
              exerciseCmd offerCid AcceptGenesis with agreedParameters = offered
        , GenesisRejectionCase "withdraw by gg" "AuthorizationError" True \parties _ offerCid ->
            discardResult $ trySubmit parties.guardianGovernance do exerciseCmd offerCid WithdrawGenesisOffer
        , GenesisRejectionCase "accept twice" "ContractNotFound" False \_ offered offerCid -> do
            _ <- acceptGenesisRoots offered offerCid
            discardResult (acceptAsGuardians offered offerCid offered)
        , GenesisRejectionCase "accept after withdrawal" "ContractNotFound" False \parties offered offerCid -> do
            submit parties.operator do exerciseCmd offerCid WithdrawGenesisOffer
            discardResult (acceptAsGuardians offered offerCid offered)
        ]
  forA_ (zip [0 .. length cases - 1] cases) \(position, rejectionCase) -> do
    parties <- allocateGenesisParties ("Reject" <> show position)
    let offered = parametersFor parties [guardianAddressA]
    offerCid <- offerGenesis parties offered
    rejectionCase.attempt parties offered offerCid >>= checkRejection rejectionCase.caseName rejectionCase.expectedRejection
    offerAfterAttempt <- queryContractId parties.operator offerCid
    assertMsg (rejectionCase.caseName <> ": offer activity " <> show (isSome offerAfterAttempt))
      (isSome offerAfterAttempt == rejectionCase.offerStaysActive)
    coreStates <- query @CoreState parties.guardianGovernance
    assertMsg (rejectionCase.caseName <> ": a CoreState exists after the rejection")
      (length coreStates == (if rejectionCase.caseName == "accept twice" then 1 else 0))

fromSomeDisclosure : Party -> ContractId WormholeGenesisOffer -> Script Disclosure
fromSomeDisclosure reader offerCid = queryDisclosure reader offerCid >>= \case
  Some offerDisclosure -> pure offerDisclosure
  None -> abort "the offer is not visible to its signatory"

----------------------------------------------------------------------
-- Test 3: a re-genesis seeds governance replay protection and the id floors
----------------------------------------------------------------------

relayCoreGovernance : Party -> GenesisRoots -> Party -> Bytes -> GuardianKey -> Script (Either SubmitError (ContractId CoreState))
relayCoreGovernance reader roots relayer encodedVAA key = do
  coreStateDisclosure <- fromSomeCoreStateDisclosure reader roots.coreStateCid
  trySubmit (actAs relayer <> disclose coreStateDisclosure) do
    exerciseCmd roots.coreStateCid SubmitGovernanceVAA with
      submitter = relayer, encodedVAA, pubKeys = [(0, key.publicKey)]

fromSomeCoreStateDisclosure : Party -> ContractId CoreState -> Script Disclosure
fromSomeCoreStateDisclosure reader coreStateCid = queryDisclosure reader coreStateCid >>= \case
  Some coreStateDisclosure -> pure coreStateDisclosure
  None -> abort "CoreState is not visible to gg"

registerManagerByVaaAttempt : Party -> GenesisRoots -> Party -> Bytes -> GuardianKey -> Script (Either SubmitError (ContractId NttManager))
registerManagerByVaaAttempt gg roots admin vaaBytes key =
  fmap (\(_, managerCid, _, _, _) -> managerCid) <$> trySubmit (actAs admin <> readAs gg) do
    exerciseCmd roots.nttGovernanceCid RegisterManagerByVaa with
      admin
      emitterRegistryCid = roots.emitterRegistryCid
      replayRootRegistryCid = roots.replayRootRegistryCid
      instrumentNonce = 0
      factory = BurnMintFactoryCid (toInterfaceContractId @BurnMintFactory roots.coinFactoryCid)
      coreStateCid = roots.coreStateCid
      consistencyLevel = 0
      emitterFeeAllocation = None
      claimFeeAllocation = None
      feeAllocation = None
      vaaBytes
      pubKeys = [(0, key.publicKey)]
      extraArgs = emptyExtraArgs

data ReplayCase = ReplayCase with
    caseName          : Text
    expectedRejection : Text
    attempt           : Script (Either SubmitError ())

-- | Genesis A runs core and NTT governance. Genesis B, for the same gg, seeds
-- the consumed digests and the id floors from A. Each old VAA is then rejected
-- on B. A control genesis C without seeds accepts the old core VAA, so the seed
-- is what rejects it on B.
testReGenesisRejectsGovernanceReplay : Script ()
testReGenesisRejectsGovernanceReplay = do
  key <- generateGuardianKey
  parties <- allocateGenesisParties "Regenesis"
  relayer <- allocateParty "RegenesisRelayer"
  admin <- allocateParty "RegenesisAdmin"
  let gg = parties.guardianGovernance
      parametersA = parametersFor parties [addressFromPubKey key.publicKey]
  rootsA <- offerGenesis parties parametersA >>= acceptGenesisRoots parametersA

  setFeeVaa <- signGovernanceVaa key 1 (setMessageFeePayload 1000)
  transferFeesVaa <- signGovernanceVaa key 2 (transferFeesPayload 9 (digestOf "fee recipient"))
  registerVaa <- signGovernanceVaa key 3 $ encodeNttGovernance RegisterBurnMintManager with
    chain = cantonChainIdForTests
    registrationBinding = nttRegistrationBindingFor gg admin 0
    tokenDecimals = 8
  coreStateAfterFee <- relayCoreGovernance gg rootsA relayer setFeeVaa key
    >>= either (\submitError -> abort ("SetMessageFee on A: " <> rejectionText submitError)) pure
  _ <- relayCoreGovernance gg (rootsA with coreStateCid = coreStateAfterFee) relayer transferFeesVaa key
    >>= either (\submitError -> abort ("TransferFees on A: " <> rejectionText submitError)) pure
  managerA <- registerManagerByVaaAttempt gg rootsA admin registerVaa key
    >>= either (\submitError -> abort ("RegisterManagerByVaa on A: " <> rejectionText submitError)) pure
  Some managerOnA <- queryContractId gg managerA
  [(_, nttGovernanceA)] <- query @NttGovernance gg
  emitterRegistriesA <- query @EmitterRegistry gg
  let emitterNextIdA = maximum [ registry.nextId | (_, registry) <- emitterRegistriesA ]

  let parametersB = parametersA with
        firstEmitterId = emitterNextIdA
        firstNttManagerId = nttGovernanceA.nextId
        consumedCoreGovernanceDigests = [(parseVAA setFeeVaa).hash, (parseVAA transferFeesVaa).hash]
        consumedNttGovernanceDigests = [(parseVAA registerVaa).hash]
  rootsB <- offerGenesis parties parametersB >>= acceptGenesisRoots parametersB
  checkAttacksRejectedInOrder
    [ ReplayCase "SetMessageFee from before the re-genesis" "governance: action already consumed" $
        discardResult (relayCoreGovernance gg rootsB relayer setFeeVaa key)
    , ReplayCase "TransferFees from before the re-genesis" "governance: action already consumed" $
        discardResult (relayCoreGovernance gg rootsB relayer transferFeesVaa key)
    , ReplayCase "RegisterBurnMintManager from before the re-genesis" "registration VAA already consumed" $
        discardResult (registerManagerByVaaAttempt gg rootsB admin registerVaa key)
    ]
  feeWithdrawals <- query @FeeWithdrawalAuthorization gg
  length feeWithdrawals === 1

  -- A registration on B gets a manager id, an address and a namespace that A never issued.
  freshVaa <- signGovernanceVaa key 4 $ encodeNttGovernance RegisterBurnMintManager with
    chain = cantonChainIdForTests
    registrationBinding = nttRegistrationBindingFor gg admin 0
    tokenDecimals = 8
  managerB <- registerManagerByVaaAttempt gg rootsB admin freshVaa key
    >>= either (\submitError -> abort ("RegisterManagerByVaa on B: " <> rejectionText submitError)) pure
  Some managerOnB <- queryContractId gg managerB
  managerOnB.managerId === managerOnA.managerId + 1
  assertMsg "re-genesis reuses a manager address" (managerOnB.managerAddress /= managerOnA.managerAddress)
  assertMsg "re-genesis reuses a replay namespace" (managerOnB.namespace /= managerOnA.namespace)
  Some transceiverOnA <- queryContractIdOfEmitter gg managerOnA.transceiverEmitterId
  Some transceiverOnB <- queryContractIdOfEmitter gg managerOnB.transceiverEmitterId
  assertMsg "re-genesis reuses an emitter address" (transceiverOnA.emitterAddress /= transceiverOnB.emitterAddress)
  assertMsg "re-genesis emitter id is below the floor" (managerOnB.transceiverEmitterId >= emitterNextIdA)

  -- Control: an unseeded re-genesis accepts the old SetMessageFee.
  rootsC <- offerGenesis parties parametersA >>= acceptGenesisRoots parametersA
  controlResult <- relayCoreGovernance gg rootsC relayer setFeeVaa key
  assertMsg "an unseeded re-genesis rejects the old SetMessageFee" (either (const False) (const True) controlResult)

queryContractIdOfEmitter : Party -> Int -> Script (Optional Emitter)
queryContractIdOfEmitter reader emitterId = do
  emitters <- query @Emitter reader
  pure case [ emitter | (_, emitter) <- emitters, emitter.emitterId == emitterId ] of
    [emitter] -> Some emitter
    _ -> None

checkAttacksRejectedInOrder : [ReplayCase] -> Script ()
checkAttacksRejectedInOrder cases = forA_ cases \replayCase -> do
  result <- replayCase.attempt
  case result of
    Right _ -> abort (replayCase.caseName <> ": accepted")
    Left submitError ->
      assertMsg (replayCase.caseName <> ": unexpected rejection: " <> rejectionText submitError)
        (replayCase.expectedRejection `T.isInfixOf` rejectionText submitError)
