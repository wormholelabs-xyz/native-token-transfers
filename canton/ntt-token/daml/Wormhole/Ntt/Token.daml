-- | The rule that shapes this module: a holding signed by its owner can only be
-- created or spent in a transaction that carries that owner's signature. The
-- two directions obtain that signature differently:
--
--   * Outbound: alice is the one sending, so she is present anyway. 'LockOrBurn'
--     lists the sender as co-controller, and her signature lets the impl spend
--     her holdings.
--   * Inbound: alice may be offline; only a relayer is present. 'MintOrUnlock'
--     is therefore manager-only, and alice's signature comes from a contract
--     instead: she exercises 'PreApproveDeposit' once, creating a standing
--     'DepositPreapproval' signed by her and the admin, and every later mint
--     runs inside that contract's 'Deposit' choice, where her signature is in
--     scope.
--
-- The choices carry the CIP-56 handles a real registry needs: @inputHoldingCids@
-- (holdings to spend; empty for a mint) and @extraArgs@ (choice context/metadata,
-- disclosed off-ledger).
module Wormhole.Ntt.Token where

import Splice.Api.Token.HoldingV1 (Holding, InstrumentId)
import Splice.Api.Token.MetadataV1 (ExtraArgs (..), emptyChoiceContext, emptyMetadata)

-- | Custody the token (lock/unlock) or destroy-and-recreate it (burn/mint). One
-- mode per deployment, chosen at creation.
data TokenMode
  = LockUnlock
  | BurnMint
  deriving (Eq, Show)

-- | The NTT "trimmed amount": normalized to at most 8 decimals, with @decimals@
-- recording the scale so the receiving chain can rescale. See 'trimAmount' /
-- 'untrimAmount'.
data TrimmedAmount = TrimmedAmount with
    decimals : Int
    amount   : Int
  deriving (Eq, Show)

-- | NTT trims amounts to at most this many decimals on the wire.
maxTrimmedDecimals : Int
maxTrimmedDecimals = 8

-- | @10 ^ n@ for @n >= 0@.
tenPow : Int -> Int
tenPow n = if n <= 0 then 1 else 10 * tenPow (n - 1)

-- | Trim @rawAmount@ (at @fromDecimals@) to the wire form. Above 8 decimals the
-- low digits are dropped (NTT dust handling is deferred, README §11).
trimAmount : Int -> Int -> TrimmedAmount
trimAmount rawAmount fromDecimals =
  if fromDecimals <= maxTrimmedDecimals
    then TrimmedAmount with decimals = fromDecimals, amount = rawAmount
    else TrimmedAmount with
           decimals = maxTrimmedDecimals
           amount = rawAmount / tenPow (fromDecimals - maxTrimmedDecimals)

-- | Rescale a received trimmed amount to the local token's @toDecimals@.
untrimAmount : TrimmedAmount -> Int -> Int
untrimAmount ta toDecimals =
  if toDecimals >= ta.decimals
    then ta.amount * tenPow (toDecimals - ta.decimals)
    else ta.amount / tenPow (ta.decimals - toDecimals)

-- | The view of an 'NttToken' hook: the token admin (whose authority it carries),
-- the manager party that drives it, and the mode.
data NttTokenView = NttTokenView with
    admin   : Party
    manager : Party
    mode    : TokenMode
  deriving (Eq, Show)

-- | Empty 'ExtraArgs', for callers/impls that need no registry context.
emptyExtraArgs : ExtraArgs
emptyExtraArgs = ExtraArgs with context = emptyChoiceContext, meta = emptyMetadata

-- | The view of a 'DepositPreapproval': the token @admin@ and the pre-approving
-- @owner@ (its two signatories) plus the @instrumentId@ it covers. Mint impls
-- read this view to check a pre-approval matches the intended recipient,
-- registry, and instrument before using it.
data DepositPreapprovalView = DepositPreapprovalView with
    admin        : Party
    owner        : Party
    instrumentId : InstrumentId
  deriving (Eq, Show)

-- | A recipient's standing consent to receive deposits of one instrument — the
-- NTT analog of Canton Coin's 'TransferPreapproval'. Alice creates it once via
-- 'NttToken.PreApproveDeposit' (signed by both her and the token admin). From
-- then on any relayer can deliver to her while she is offline: each mint runs
-- inside this contract's 'Deposit' choice, and her signature — stored in the
-- contract — is what allows her owner-signed holding to be created. Owner-signed
-- token kinds implement it.
interface DepositPreapproval where
  viewtype DepositPreapprovalView

  -- | Deposit @amount@ to the pre-approving owner, spending @inputHoldingCids@
  -- ([] for a mint). Runs with the pre-approval's admin+owner authority.
  depositImpl : TrimmedAmount -> [ContractId Holding] -> ExtraArgs -> Update ()

  -- The owner approves once; that lets the token admin exercise this choice
  -- any number of times afterward, once per incoming transfer, with the owner
  -- offline. The relayer never appears at this layer.
  nonconsuming choice Deposit : ()
    with
      amount           : TrimmedAmount
      inputHoldingCids : [ContractId Holding]
      extraArgs        : ExtraArgs
    controller (view this).admin
    do depositImpl this amount inputHoldingCids extraArgs

  -- The owner alone tears down its standing consent. No expiry; the delivery path
  -- is unaffected until the owner revokes.
  choice Revoke : ()
    controller (view this).owner
    do pure ()

-- | The token effect seam. Impls supply 'lockOrBurnImpl' / 'mintOrUnlockImpl' /
-- 'preApproveImpl'; the manager calls the 'LockOrBurn' / 'MintOrUnlock' choices,
-- and a recipient opts in via 'PreApproveDeposit'.
interface NttToken where
  viewtype NttTokenView

  -- | Outbound: lock or burn @amount@ from @sender@, spending @inputHoldingCids@.
  lockOrBurnImpl : Party -> TrimmedAmount -> [ContractId Holding] -> ExtraArgs -> Update ()
  -- | Inbound: unlock (spending @inputHoldingCids@) or mint @amount@ to
  -- @recipient@. @depositPreapprovalCid@ carries the recipient's standing consent
  -- for owner-signed kinds; 'None' is for kinds that need no NTT-level consent.
  mintOrUnlockImpl : Party -> TrimmedAmount -> [ContractId Holding] -> Optional (ContractId DepositPreapproval) -> ExtraArgs -> Update ()
  -- | Create @user@'s standing 'DepositPreapproval' for this token, or 'None' for
  -- kinds that need no NTT-level consent. Runs with the token's admin authority
  -- (admin-signed) plus @user@'s (the choice controller).
  preApproveImpl : Party -> Update (Optional (ContractId DepositPreapproval))

  -- Manager and sender both control this choice: alice co-signs her own
  -- outbound transfer, which is what lets the impl spend her owner-signed
  -- holdings.
  nonconsuming choice LockOrBurn : ()
    with
      sender           : Party
      amount           : TrimmedAmount
      inputHoldingCids : [ContractId Holding]
      extraArgs        : ExtraArgs
    controller (view this).manager, sender
    do lockOrBurnImpl this sender amount inputHoldingCids extraArgs

  -- Manager-only, so a relayer can drive a receive while the recipient is
  -- offline. The recipient's signature is not supplied here — for owner-signed
  -- kinds it comes from the standing 'DepositPreapproval' passed in.
  nonconsuming choice MintOrUnlock : ()
    with
      recipient             : Party
      amount                : TrimmedAmount
      inputHoldingCids      : [ContractId Holding]
      depositPreapprovalCid : Optional (ContractId DepositPreapproval)
      extraArgs             : ExtraArgs
    controller (view this).manager
    do mintOrUnlockImpl this recipient amount inputHoldingCids depositPreapprovalCid extraArgs

  -- | Recipient opt-in, done once before the first inbound transfer. @user@
  -- controls the choice (supplying its own signature) and the token contract is
  -- admin-signed (supplying the admin's), so the dual-signed consent is created
  -- in a single step. Returns 'None' for kinds that need no pre-approval.
  nonconsuming choice PreApproveDeposit : Optional (ContractId DepositPreapproval)
    with
      user : Party
    controller user
    do preApproveImpl this user
