{-# LANGUAGE AllowAmbiguousTypes #-}
-- | The disclosure sets for the NTT flows.
--
-- A disclosure set is the list of contracts that a submitter must attach to
-- a transaction when the submitter is not a stakeholder of those contracts.
-- Example: a relayer that delivers a Release VAA is a stakeholder of
-- nothing. The relayer must attach the manager, the core state, the replay
-- node, the ledger, the custody pot, and the factory.
--
-- This module defines one function per flow. Each function returns that
-- flow's disclosure set. This module is the only definition of these sets.
-- Do not derive a set from the choice bodies again. This module has no
-- HTTP server and no Go code. It uses only 'Daml.Script.queryDisclosure'.
-- A disclosure service can serve these sets over a transport later.
--
-- The sets (a submitter's own contracts are not listed; only what a
-- non-stakeholder must attach):
--
--   * releaseDisclosures      -- NttManager, CoreState, covering ReplayNode,
--                                LockedLedger, custody-pot Holding (if any),
--                                committed TransferFactory
--   * mintDisclosures         -- NttManager, CoreState, covering ReplayNode,
--                                DepositPreapproval, committed BurnMintFactory
--   * acceptAdminDisclosures  -- NttManager, CoreState, covering ReplayNode,
--                                AdminTransferProposal; LockUnlock adds
--                                LockedLedger, and (if a pot exists) the pot
--                                Holding + committed TransferFactory
--   * setPeerByVaaDisclosures -- NttManager, CoreState, transceiver Emitter,
--                                covering ReplayNode
--   * transferDisclosures     -- NttManager, transceiver Emitter, CoreState;
--                                LockUnlock adds LockedLedger (+ pot, if
--                                any) and the committed TransferFactory;
--                                BurnMint adds the committed BurnMintFactory
--   * registerDisclosures     -- NttGovernance, EmitterRegistry,
--                                ReplayRootRegistry, CoreState; the ByVaa
--                                variant adds the canonical CoinFactory
--   * consolidateDisclosures  -- NttManager, LockedLedger, the supplied
--                                custody holdings, committed TransferFactory
--
-- Each function reads the live 'NttManager' for the deployment's own
-- namespace, factory, and token config. It does not trust caller-supplied
-- copies of those fields.
--
-- Two set members are interface contract ids: the committed factory
-- ('NttManager.factory') and the custody pot
-- ('LockedLedger.custodyHoldingCid'). 'queryDisclosure' accepts only a
-- concrete template type. On an interface contract id it fails at runtime
-- with "unserializableType". Only the caller knows which concrete template
-- backs such a contract id. For these two members the caller therefore
-- supplies a callback that resolves the contract id to a 'Disclosure'.
-- 'discloseConcrete' builds that callback from the known concrete type.
-- The functions in this module still decide when each member is necessary.
module Wormhole.Ntt.Disclosure where

import Daml.Script
import DA.Optional (fromSome)
import DA.Text qualified as T

import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.BurnMintV1 (BurnMintFactory)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Token.CIP0056.CoinFactory (CoinFactory)

import Wormhole.Core.Bytes (normalizeHex)
import Wormhole.Core.Replay (ReplayNode)
import Wormhole.Core.State (CoreState, Emitter, EmitterRegistry, ReplayRootRegistry)
import Wormhole.Ntt.Deposit (DepositPreapproval)
import Wormhole.Ntt.Governance (NttGovernance)
import Wormhole.Ntt.Ledger (LockedLedger)
import Wormhole.Ntt.Manager
  ( NttManager, NttFactory(..), NttTokenConfig(..), AdminTransferProposal )

----------------------------------------------------------------------
-- Replay-node coverage lookup
----------------------------------------------------------------------

-- | Find the one active node of @consumer@'s @namespace@ trie that covers
-- @digest@. Aborts unless exactly one node covers it: more or fewer shows a
-- broken partition invariant or a forked trie. The trie tests in
-- 'Test.TestReplay' also call this directly.
coveringNode : Party -> Text -> Text -> Script (ContractId ReplayNode, ReplayNode)
coveringNode consumer namespace digest = do
  nodes <- query @ReplayNode consumer
  let d = normalizeHex digest
  case filter (\(_, n) -> n.consumer == consumer && n.namespace == namespace && n.prefix `T.isPrefixOf` d) nodes of
    [one] -> pure one
    covering -> abort ("partition invariant violated: " <> show (length covering) <> " covering nodes")

-- | 'coveringNode' plus its 'Disclosure'. @reader@ is any party that sees
-- the node.
coveringDisclosure : Party -> Party -> Text -> Text -> Script (ContractId ReplayNode, Disclosure)
coveringDisclosure reader consumer namespace digest = do
  (cid, _) <- coveringNode consumer namespace digest
  disc <- fromSome <$> queryDisclosure reader cid
  pure (cid, disc)

----------------------------------------------------------------------
-- Shared lookups
----------------------------------------------------------------------

-- | 'queryDisclosure', or an abort that names what @reader@ could not see.
-- A missing disclosure fails here with a specific message, not later as an
-- opaque submission error. Do not call this on an interface contract id --
-- use 'discloseConcrete'.
requireDisclosure : Template t => Party -> ContractId t -> Text -> Script Disclosure
requireDisclosure reader cid label =
  queryDisclosure reader cid >>= \case
    Some d -> pure d
    None -> abort ("disclosure: " <> label <> " not visible to " <> show reader)

-- | 'queryContractId', or an abort that names what could not be resolved.
-- Reads a deployment's own committed fields (namespace, factory, token
-- config); callers never pass copies of those fields.
requireContract : (Template t, HasEnsure t) => Party -> ContractId t -> Text -> Script t
requireContract reader cid label =
  queryContractId reader cid >>= \case
    Some c -> pure c
    None -> abort ("disclosure: " <> label <> " could not be resolved by " <> show reader)

-- | Build a discloser callback for an interface contract id. Downcasts the
-- id to the known concrete template @t@, then discloses that (example:
-- @discloseConcrete \@MyToken gg "committed TransferFactory"@). The downcast
-- is a caller assertion: it is sound only when @t@ backs the given contract
-- id, as with every use of 'fromInterfaceContractId'.
discloseConcrete
  : forall t i. (Template t, HasFromInterface t i, HasTemplateTypeRep t, HasInterfaceTypeRep i)
  => Party -> Text -> ContractId i -> Script Disclosure
discloseConcrete reader label ifaceCid = requireDisclosure reader (fromInterfaceContractId @t ifaceCid) label

-- | Unwrap the committed 'TransferFactory' cid, or abort. The abort is
-- unreachable for a real LockUnlock deployment: 'factoryMatchesConfig' ties
-- the factory type to the config at registration and at every rotation.
requireTransferFactoryCid : NttFactory -> Script (ContractId TIV1.TransferFactory)
requireTransferFactoryCid = \case
  TransferFactoryCid cid -> pure cid
  BurnMintFactoryCid _ -> abort "disclosure: committed factory is not a transfer factory"

-- | Unwrap the committed 'BurnMintFactory' cid, or abort. Unreachable for a
-- real BurnMint deployment, by the same invariant.
requireBurnMintFactoryCid : NttFactory -> Script (ContractId BurnMintFactory)
requireBurnMintFactoryCid = \case
  BurnMintFactoryCid cid -> pure cid
  TransferFactoryCid _ -> abort "disclosure: committed factory is not a burn/mint factory"

----------------------------------------------------------------------
-- Release
----------------------------------------------------------------------

-- | The disclosure set for 'Release', for an @executor@ that is a
-- stakeholder of nothing. The custody-pot 'Holding' is included only when
-- the ledger's hint names one; a deployment's first release has none. The
-- committed 'TransferFactory' is always included: 'Release' spends through
-- it for every funding source. @discloseHolding@ and @discloseFactory@
-- resolve the two interface members -- see the module header.
releaseDisclosures
  : Party -> Party -> ContractId NttManager -> ContractId CoreState -> ContractId LockedLedger -> Text
  -> (ContractId Holding -> Script Disclosure)
  -> (ContractId TIV1.TransferFactory -> Script Disclosure)
  -> Script (ContractId ReplayNode, [Disclosure])
releaseDisclosures operator gg mgrCid csId ledgerCid digest discloseHolding discloseFactory = do
  mgr <- requireContract operator mgrCid "NttManager"
  assertMsg "releaseDisclosures: deployment is not lock/unlock" (mgr.tokenConfig == LockUnlock)
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dCs <- requireDisclosure operator csId "CoreState"
  (nodeCid, dNode) <- coveringDisclosure operator gg mgr.namespace digest
  dLedger <- requireDisclosure operator ledgerCid "LockedLedger"
  ledger <- requireContract operator ledgerCid "LockedLedger"
  potDiscs <- case ledger.custodyHoldingCid of
    Some potCid -> (\d -> [d]) <$> discloseHolding potCid
    None -> pure []
  factoryCid <- requireTransferFactoryCid mgr.factory
  dFactory <- discloseFactory factoryCid
  let discs = [dMgr, dCs, dNode, dLedger] <> potDiscs <> [dFactory]
  assertMsg "releaseDisclosures: disclosure set must not be empty" (not (null discs))
  pure (nodeCid, discs)

----------------------------------------------------------------------
-- Mint
----------------------------------------------------------------------

-- | The disclosure set for 'Mint', for an @executor@ that is a stakeholder
-- of nothing. 'DepositPreapproval' is queried as @gg@, its observer;
-- @operator@ is not a stakeholder of it. @discloseFactory@ resolves the
-- committed 'BurnMintFactory' member.
mintDisclosures
  : Party -> Party -> ContractId NttManager -> ContractId CoreState -> ContractId DepositPreapproval -> Text
  -> (ContractId BurnMintFactory -> Script Disclosure)
  -> Script (ContractId ReplayNode, [Disclosure])
mintDisclosures operator gg mgrCid csId preapprovalCid digest discloseFactory = do
  mgr <- requireContract operator mgrCid "NttManager"
  assertMsg "mintDisclosures: deployment is not burn/mint" (mgr.tokenConfig == BurnMint)
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dCs <- requireDisclosure operator csId "CoreState"
  (nodeCid, dNode) <- coveringDisclosure operator gg mgr.namespace digest
  dPre <- requireDisclosure gg preapprovalCid "DepositPreapproval"
  factoryCid <- requireBurnMintFactoryCid mgr.factory
  dFactory <- discloseFactory factoryCid
  let discs = [dMgr, dCs, dNode, dPre, dFactory]
  assertMsg "mintDisclosures: disclosure set must not be empty" (not (null discs))
  pure (nodeCid, discs)

----------------------------------------------------------------------
-- AcceptAdminTransferByVaa
----------------------------------------------------------------------

-- | The disclosure set for 'AcceptAdminTransferByVaa', for an @executor@
-- that is a stakeholder of nothing. 'AdminTransferProposal' is queried as
-- @admin@, the proposing party; @operator@ is not a stakeholder of it. For
-- LockUnlock the 'LockedLedger' is always included, because its observer
-- changes hands. The pot 'Holding' and committed 'TransferFactory' are
-- included only when the ledger names a pot to move. This matches
-- 'TransferAdmin's own branch on 'custodyHoldingCid'.
acceptAdminDisclosures
  : Party -> Party -> Party -> ContractId NttManager -> ContractId CoreState -> ContractId AdminTransferProposal
  -> Optional (ContractId LockedLedger) -> Text
  -> (ContractId Holding -> Script Disclosure)
  -> (ContractId TIV1.TransferFactory -> Script Disclosure)
  -> Script (ContractId ReplayNode, [Disclosure])
acceptAdminDisclosures operator gg admin mgrCid csId propCid ledgerCid digest discloseHolding discloseFactory = do
  mgr <- requireContract operator mgrCid "NttManager"
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dCs <- requireDisclosure operator csId "CoreState"
  (nodeCid, dNode) <- coveringDisclosure operator gg mgr.namespace digest
  dProp <- requireDisclosure admin propCid "AdminTransferProposal"
  extra <- case (mgr.tokenConfig, ledgerCid) of
    (LockUnlock, Some lcid) -> do
      dLedger <- requireDisclosure operator lcid "LockedLedger"
      ledger <- requireContract operator lcid "LockedLedger"
      potAndFactory <- case ledger.custodyHoldingCid of
        None -> pure []
        Some potCid -> do
          dPot <- discloseHolding potCid
          factoryCid <- requireTransferFactoryCid mgr.factory
          dFactory <- discloseFactory factoryCid
          pure [dPot, dFactory]
      pure ([dLedger] <> potAndFactory)
    (LockUnlock, None) -> abort "acceptAdminDisclosures: LockUnlock deployment requires a ledger cid"
    (BurnMint, None) -> pure []
    (BurnMint, Some _) -> abort "acceptAdminDisclosures: BurnMint deployment must not carry a ledger cid"
  let discs = [dMgr, dCs, dNode, dProp] <> extra
  assertMsg "acceptAdminDisclosures: disclosure set must not be empty" (not (null discs))
  pure (nodeCid, discs)

----------------------------------------------------------------------
-- SetPeerByVaa
----------------------------------------------------------------------

-- | The disclosure set for 'SetPeerByVaa', for an @executor@ that is a
-- stakeholder of nothing. The 'Emitter' serves the nested 'SetPeer'
-- broadcast. 'Emitter' is a plain template, so no callback is needed here.
setPeerByVaaDisclosures
  : Party -> Party -> ContractId NttManager -> ContractId CoreState -> ContractId Emitter -> Text
  -> Script (ContractId ReplayNode, [Disclosure])
setPeerByVaaDisclosures operator gg mgrCid csId emitterCid digest = do
  mgr <- requireContract operator mgrCid "NttManager"
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dCs <- requireDisclosure operator csId "CoreState"
  dEmitter <- requireDisclosure operator emitterCid "transceiver Emitter"
  (nodeCid, dNode) <- coveringDisclosure operator gg mgr.namespace digest
  let discs = [dMgr, dCs, dEmitter, dNode]
  assertMsg "setPeerByVaaDisclosures: disclosure set must not be empty" (not (null discs))
  assertMsg "setPeerByVaaDisclosures: expected exactly 4 elements" (length discs == 4)
  pure (nodeCid, discs)

----------------------------------------------------------------------
-- Transfer (outbound)
----------------------------------------------------------------------

-- | The disclosure set for 'Transfer', for a @user@ hosted away from the
-- deployment. The user's own input holdings are not listed: a party always
-- sees its own holdings. LockUnlock always includes the committed
-- 'TransferFactory'; the pot 'Holding' is included only when a pot exists
-- to merge. BurnMint always includes the committed 'BurnMintFactory' and
-- never a ledger. Only the callback for the deployment's own mode runs.
transferDisclosures
  : Party -> Party -> ContractId NttManager -> ContractId Emitter -> ContractId CoreState
  -> Optional (ContractId LockedLedger)
  -> (ContractId Holding -> Script Disclosure)
  -> (ContractId TIV1.TransferFactory -> Script Disclosure)
  -> (ContractId BurnMintFactory -> Script Disclosure)
  -> Script [Disclosure]
transferDisclosures operator gg mgrCid emitterCid csId ledgerCid discloseHolding discloseTransferFactory discloseBurnMintFactory = do
  mgr <- requireContract operator mgrCid "NttManager"
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dEmitter <- requireDisclosure operator emitterCid "transceiver Emitter"
  dCs <- requireDisclosure operator csId "CoreState"
  extra <- case (mgr.tokenConfig, mgr.factory, ledgerCid) of
    (LockUnlock, TransferFactoryCid factoryCid, Some lcid) -> do
      dLedger <- requireDisclosure operator lcid "LockedLedger"
      ledger <- requireContract operator lcid "LockedLedger"
      potDiscs <- case ledger.custodyHoldingCid of
        Some potCid -> (\d -> [d]) <$> discloseHolding potCid
        None -> pure []
      dFactory <- discloseTransferFactory factoryCid
      pure ([dLedger] <> potDiscs <> [dFactory])
    (BurnMint, BurnMintFactoryCid factoryCid, None) -> do
      dFactory <- discloseBurnMintFactory factoryCid
      pure [dFactory]
    _ -> abort "transferDisclosures: token config, committed factory, and ledger cid are inconsistent"
  let discs = [dMgr, dEmitter, dCs] <> extra
  assertMsg "transferDisclosures: disclosure set must not be empty" (not (null discs))
  pure discs

----------------------------------------------------------------------
-- Register
----------------------------------------------------------------------

-- | The disclosure set for 'RegisterManager', for a registering @admin@
-- hosted away from the bootstrap roots. Pass @Some coinFactoryCid@ for the
-- ByVaa variant: 'RegisterManagerByVaa' also reaches
-- 'requireCanonicalFactory', so it also needs the canonical 'CoinFactory'.
-- 'CoinFactory' is a plain, concrete template, so no callback is needed.
registerDisclosures
  : Party -> Party -> ContractId NttGovernance -> ContractId EmitterRegistry -> ContractId ReplayRootRegistry
  -> ContractId CoreState -> Optional (ContractId CoinFactory)
  -> Script [Disclosure]
registerDisclosures operator gg govCid emReg rrReg csId byVaaFactory = do
  dGov <- requireDisclosure operator govCid "NttGovernance"
  dEmReg <- requireDisclosure operator emReg "EmitterRegistry"
  dRrReg <- requireDisclosure operator rrReg "ReplayRootRegistry"
  dCs <- requireDisclosure operator csId "CoreState"
  factoryDiscs <- case byVaaFactory of
    Some factoryCid -> (\d -> [d]) <$> requireDisclosure gg factoryCid "canonical CoinFactory"
    None -> pure []
  let discs = [dGov, dEmReg, dRrReg, dCs] <> factoryDiscs
  assertMsg "registerDisclosures: disclosure set must not be empty" (not (null discs))
  assertMsg "registerDisclosures: expected at least the 4 base elements" (length discs >= 4)
  pure discs

----------------------------------------------------------------------
-- ConsolidateCustody
----------------------------------------------------------------------

-- | The disclosure set for 'ConsolidateCustody', for a @caller@ that is a
-- stakeholder of nothing. The committed 'TransferFactory' is used only by
-- the merge branch (two or more holdings), which is this function's
-- intended use. The single-holding repoint branch never touches the
-- factory.
consolidateDisclosures
  : Party -> Party -> ContractId NttManager -> ContractId LockedLedger -> [ContractId Holding]
  -> (ContractId Holding -> Script Disclosure)
  -> (ContractId TIV1.TransferFactory -> Script Disclosure)
  -> Script [Disclosure]
consolidateDisclosures operator gg mgrCid ledgerCid holdingCids discloseHolding discloseFactory = do
  mgr <- requireContract operator mgrCid "NttManager"
  assertMsg "consolidateDisclosures: deployment is not lock/unlock" (mgr.tokenConfig == LockUnlock)
  assertMsg "consolidateDisclosures: at least one custody holding required" (not (null holdingCids))
  dMgr <- requireDisclosure operator mgrCid "NttManager"
  dLedger <- requireDisclosure operator ledgerCid "LockedLedger"
  dHoldings <- forA holdingCids discloseHolding
  factoryCid <- requireTransferFactoryCid mgr.factory
  dFactory <- discloseFactory factoryCid
  let discs = [dMgr, dLedger] <> dHoldings <> [dFactory]
  assertMsg "consolidateDisclosures: disclosure set must not be empty" (not (null discs))
  pure discs
