-- | CIP-56 implementations of the 'NttToken' interface, against the vendored
-- token-standard DARs. Work for Canton Coin (Amulet) or any conforming token.
--
-- Two Cip56 token types, one for each side of the 'MintOrUnlock' choice:
--
--   * 'Cip56CustodyToken' is the unlock side. The token's holding already
--     exists on Canton, sitting with a custody party between send and
--     receive; unlocking moves it from custody to the recipient via
--     'TransferFactory_Transfer' (lock = sender -> custody, unlock =
--     custody -> recipient).
--   * 'Cip56BurnMintToken' is the mint side. The token's holding does not
--     exist yet; minting creates it directly for the recipient via
--     'BurnMintFactory_BurnMint' (burn = spend @inputHoldingCids@, no
--     outputs; mint = one output to the recipient).
--
-- A "factory" is a contract, implemented by the token's registry (e.g.
-- Amulet), that carries out the registry's own transfer/burn/mint logic --
-- NTT calls into it rather than moving holdings directly.
--
-- Each hook stores the registry factory cid and the token 'InstrumentId';
-- per-transfer holdings + context arrive through the seam, disclosed off-ledger.
--
-- Amounts: NTT carries an integer 'TrimmedAmount'; CIP-56 holdings are 'Decimal'
-- ('trimmedToDecimal' converts).
module Wormhole.Ntt.TokenCip56 where

import DA.Time (days, addRelTime)
import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV1
  ( Transfer (..), TransferFactory, TransferFactory_Transfer (..)
  , TransferInstructionResult (..), TransferInstructionResult_Output (..)
  )
import Splice.Api.Token.BurnMintV1 (BurnMintFactory, BurnMintFactory_BurnMint (..), BurnMintOutput (..))
import Wormhole.Ntt.Token

-- | NTT 'TrimmedAmount' to CIP-56 'Decimal': value = amount / 10^decimals.
trimmedToDecimal : TrimmedAmount -> Decimal
trimmedToDecimal ta = intToDecimal ta.amount / intToDecimal (tenPow ta.decimals)

----------------------------------------------------------------------
-- lock / unlock via the transfer factory
----------------------------------------------------------------------

template Cip56CustodyToken
  with
    admin              : Party                        -- token registry admin (backs transfers)
    manager            : Party                        -- NTT operator that drives the seam
    custody            : Party                        -- holds locked funds between send/receive
    instrumentId       : InstrumentId
    transferFactoryCid : ContractId TransferFactory   -- the registry's transfer factory
  where
    signatory admin
    observer manager

    interface instance NttToken for Cip56CustodyToken where
      view = NttTokenView with admin, manager, mode = LockUnlock

      -- Lock: sender -> custody. Must settle synchronously (Completed); a
      -- Pending/Failed result means the tokens never reached custody.
      lockOrBurnImpl sender amount inputHoldingCids extraArgs = do
        now <- getTime
        res <- exercise transferFactoryCid TransferFactory_Transfer with
               expectedAdmin = instrumentId.admin
               transfer = Transfer with
                 sender
                 receiver = custody
                 amount = trimmedToDecimal amount
                 instrumentId
                 requestedAt = now
                 executeBefore = now `addRelTime` days 1
                 inputHoldingCids
                 meta = emptyMetadata
               extraArgs
        case res.output of
          TransferInstructionResult_Completed _ -> pure ()
          _ -> abort "ntt: transfer did not settle synchronously"

      -- Unlock: custody -> recipient, spending the custody holdings. Same
      -- synchronous-settle requirement as the lock path.
      --
      -- When the ntt is minting, alice must have given a pre-approval to
      -- mint tokens to her holdings. We therefore pass in the
      -- depositPreapproval Cid from alice in order to pass signatory checks.
      --
      -- Note that the "depositPreapproval" flow is only for tokens that are
      -- on the minting side. For the unlocking side, the holding contract
      -- already exists on Canton and the user will need to call e.g.
      -- transferPreapproval (as is the case for Canton Coin). If there is no
      -- transferPreapproval, it will fail with an error message.
      mintOrUnlockImpl recipient amount inputHoldingCids _depositPreapprovalCid extraArgs = do
        now <- getTime
        res <- exercise transferFactoryCid TransferFactory_Transfer with
               expectedAdmin = instrumentId.admin
               transfer = Transfer with
                 sender = custody
                 receiver = recipient
                 amount = trimmedToDecimal amount
                 instrumentId
                 requestedAt = now
                 executeBefore = now `addRelTime` days 1
                 inputHoldingCids
                 meta = emptyMetadata
               extraArgs
        case res.output of
          TransferInstructionResult_Completed _ -> pure ()
          _ -> abort "ntt: transfer did not settle synchronously"

      -- This is the unlock case, and there is no NTT-level pre-approval to
      -- give here -- it always aborts. Alice must instead pre-approve with
      -- the token's own registry (e.g. Amulet's transferPreapproval).
      preApproveImpl _user =
        abort "ntt: in order to unlock this token, a pre-approval is needed from the registry of the token contract. See transferPreapproval in the amulet implementation"

----------------------------------------------------------------------
-- burn / mint via the burn-mint factory
----------------------------------------------------------------------

template Cip56BurnMintToken
  with
    admin              : Party
    manager            : Party
    instrumentId       : InstrumentId
    burnMintFactoryCid : ContractId BurnMintFactory
  where
    signatory admin
    observer manager

    interface instance NttToken for Cip56BurnMintToken where
      view = NttTokenView with admin, manager, mode = BurnMint

      -- Burn: spend the sender's holdings for exactly the wire amount, returning change.
      lockOrBurnImpl sender amount inputHoldingCids extraArgs = do
        let target = trimmedToDecimal amount
        views <- forA inputHoldingCids \cid -> do
          hv <- view <$> fetch cid
          assertMsg "ntt: burn holding not owned by sender" (hv.owner == sender)
          assertMsg "ntt: burn holding instrument mismatch" (hv.instrumentId == instrumentId)
          assertMsg "ntt: burn holding is locked" (hv.lock == None)
          pure hv.amount
        let total = sum views
        assertMsg "ntt: input holdings do not cover the burn amount" (total >= target)
        let change = total - target
            outputs =
              if change == 0.0
                then []
                else [ BurnMintOutput with
                         owner = sender
                         amount = change
                         context = extraArgs.context ]
        _ <- exercise burnMintFactoryCid BurnMintFactory_BurnMint with
               expectedAdmin = instrumentId.admin
               outputs
               instrumentId
               inputHoldingCids
               extraArgs
               extraActors = [sender]
        pure ()

      -- In the minting case, alice must give approval for token holdings to
      -- be minted to her. It takes depositPreapprovalCid as an input, which
      -- alice created in order to allow minting of tokens directly to her
      -- balance.
      --
      -- Alice's DepositPreapproval contract is signed by both alice and the
      -- admin. Exercising its Deposit choice is therefore authorized by
      -- both of them, and that authorization carries through to the
      -- burn-mint factory call made inside Deposit -- which is how the
      -- factory gets alice's signature for the owner-signed output, even
      -- though this choice itself is manager-only. If alice never gave a
      -- pre-approval, the mint aborts and the transfer can be re-relayed
      -- once she opts in.
      mintOrUnlockImpl recipient amount _inputHoldingCids depositPreapprovalCid extraArgs = do
        cid <- case depositPreapprovalCid of
          Some c -> pure c
          None -> abort "ntt: deposit pre-approval required to mint an owner-signed holding"
        vw <- view <$> fetch cid
        assertMsg "ntt: deposit pre-approval is not for this recipient" (vw.owner == recipient)
        assertMsg "ntt: deposit pre-approval is not for this registry" (vw.admin == admin)
        assertMsg "ntt: deposit pre-approval is for a different instrument" (vw.instrumentId == instrumentId)
        exercise cid Deposit with amount, inputHoldingCids = [], extraArgs

      -- Opt-in: create the caller's standing 'Cip56DepositPreapproval'. Both
      -- required signatures are already in scope — the token contract is
      -- admin-signed and the caller controls 'PreApproveDeposit' — so the
      -- dual-signed contract is created in one step. It snapshots
      -- @burnMintFactoryCid@: if the registry ever replaces its factory
      -- contract, existing pre-approvals go stale and must be re-issued (the
      -- same static-cid limitation 'Cip56BurnMintToken' itself has; acceptable
      -- at devnet stage).
      preApproveImpl user =
        fmap (Some . toInterfaceContractId @DepositPreapproval) $
          create Cip56DepositPreapproval with admin, owner = user, instrumentId, burnMintFactoryCid

----------------------------------------------------------------------
-- burn / mint deposit pre-approval (recipient standing consent)
----------------------------------------------------------------------

-- | Alice's standing consent to receive burn/mint deposits of one instrument.
-- Signed by both @admin@ and @owner@ — which is the whole point: exercising
-- 'Deposit' puts both signatures in scope, enough to create alice's owner-signed
-- holding while she is offline. Created in one step by
-- 'Cip56BurnMintToken.PreApproveDeposit'; alice can 'Revoke' at any time.
-- Copies the token's @burnMintFactoryCid@ at creation (same static-cid caveat
-- as 'Cip56BurnMintToken').
template Cip56DepositPreapproval
  with
    admin              : Party
    owner              : Party
    instrumentId       : InstrumentId
    burnMintFactoryCid : ContractId BurnMintFactory   -- copied from the token at PreApprove time
  where
    signatory admin, owner

    interface instance DepositPreapproval for Cip56DepositPreapproval where
      view = DepositPreapprovalView with admin, owner, instrumentId
      -- The factory call needs two signatures: the admin's (as the burn/mint
      -- controller) and the owner's (listed in @extraActors@, required for the
      -- owner-signed output). Both are in scope here because both parties signed
      -- this contract.
      depositImpl amount _inputHoldingCids extraArgs = do
        _ <- exercise burnMintFactoryCid BurnMintFactory_BurnMint with
          expectedAdmin = instrumentId.admin
          outputs =
            [ BurnMintOutput with
                owner
                amount = trimmedToDecimal amount
                context = extraArgs.context
            ]
          instrumentId
          inputHoldingCids = []
          extraArgs
          extraActors = [owner]
        pure ()
