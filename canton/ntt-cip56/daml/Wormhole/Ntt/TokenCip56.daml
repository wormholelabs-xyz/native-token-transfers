-- | CIP-56 implementations of the 'NttToken' seam, against the vendored
-- token-standard DARs. Work for Canton Coin (Amulet) or any conforming token.
--
--   * lock/unlock ('Cip56CustodyToken') via 'TransferFactory_Transfer': lock =
--     sender -> custody; unlock = custody -> recipient.
--   * burn/mint ('Cip56BurnMintToken') via 'BurnMintFactory_BurnMint': burn =
--     spend @inputHoldingCids@, no outputs; mint = one output to recipient.
--
-- Each hook stores the registry factory cid and the token 'InstrumentId';
-- per-transfer holdings + context arrive through the seam, disclosed off-ledger.
--
-- Amounts: NTT carries an integer 'TrimmedAmount'; CIP-56 holdings are 'Decimal'
-- ('trimmedToDecimal' converts).
module Wormhole.Ntt.TokenCip56 where

import DA.Time (days, addRelTime)
import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV1
  ( Transfer (..), TransferFactory, TransferFactory_Transfer (..)
  , TransferInstructionResult (..), TransferInstructionResult_Output (..)
  )
import Splice.Api.Token.BurnMintV1 (BurnMintFactory, BurnMintFactory_BurnMint (..), BurnMintOutput (..))
import Wormhole.Ntt.Token

-- | NTT 'TrimmedAmount' to CIP-56 'Decimal': value = amount / 10^decimals.
trimmedToDecimal : TrimmedAmount -> Decimal
trimmedToDecimal ta = intToDecimal ta.amount / intToDecimal (tenPow ta.decimals)

----------------------------------------------------------------------
-- lock / unlock via the transfer factory
----------------------------------------------------------------------

template Cip56CustodyToken
  with
    admin              : Party                        -- token registry admin (backs transfers)
    manager            : Party                        -- NTT operator that drives the seam
    custody            : Party                        -- holds locked funds between send/receive
    instrumentId       : InstrumentId
    transferFactoryCid : ContractId TransferFactory   -- the registry's transfer factory
  where
    signatory admin
    observer manager

    interface instance NttToken for Cip56CustodyToken where
      view = NttTokenView with admin, manager, mode = LockUnlock

      -- Lock: sender -> custody. Must settle synchronously (Completed); a
      -- Pending/Failed result means the tokens never reached custody.
      lockOrBurnImpl sender amount inputHoldingCids extraArgs = do
        now <- getTime
        res <- exercise transferFactoryCid TransferFactory_Transfer with
               expectedAdmin = instrumentId.admin
               transfer = Transfer with
                 sender
                 receiver = custody
                 amount = trimmedToDecimal amount
                 instrumentId
                 requestedAt = now
                 executeBefore = now `addRelTime` days 1
                 inputHoldingCids
                 meta = emptyMetadata
               extraArgs
        case res.output of
          TransferInstructionResult_Completed _ -> pure ()
          _ -> abort "ntt: transfer did not settle synchronously"

      -- Unlock: custody -> recipient, spending the custody holdings. Same
      -- synchronous-settle requirement as the lock path.
      --
      -- The NTT 'DepositPreapproval' cannot fix the custody leg, so
      -- @depositPreapprovalCid@ is ignored here. 'TransferFactory_Transfer' exposes
      -- no 'extraActors' and its controller is @transfer.sender = custody@, so even
      -- if the transfer were exercised inside 'Deposit''s body the recipient's
      -- authority would stop at that node boundary. What settles a custody unlock to
      -- an arbitrary recipient is *registry-level* receiver pre-approval (e.g.
      -- Amulet's own 'TransferPreapproval'), which makes the registry's transfer
      -- impl settle synchronously; without it the registry yields a Pending
      -- 'TransferInstruction' (receiver must accept off-ledger) which this hook's
      -- synchronous-settle assert rejects.
      mintOrUnlockImpl recipient amount inputHoldingCids _depositPreapprovalCid extraArgs = do
        now <- getTime
        res <- exercise transferFactoryCid TransferFactory_Transfer with
               expectedAdmin = instrumentId.admin
               transfer = Transfer with
                 sender = custody
                 receiver = recipient
                 amount = trimmedToDecimal amount
                 instrumentId
                 requestedAt = now
                 executeBefore = now `addRelTime` days 1
                 inputHoldingCids
                 meta = emptyMetadata
               extraArgs
        case res.output of
          TransferInstructionResult_Completed _ -> pure ()
          _ -> abort "ntt: transfer did not settle synchronously"

      -- The custody kind takes no NTT-level deposit pre-approval: settlement to an
      -- arbitrary recipient depends on registry-level receiver pre-approval (above),
      -- which is out of this interface's reach. The abort signals that real
      -- dependency rather than silently returning None.
      preApproveImpl _user =
        abort "ntt: custody kind takes no NTT deposit pre-approval (registry-level pre-approval applies; see module comment)"

----------------------------------------------------------------------
-- burn / mint via the burn-mint factory
----------------------------------------------------------------------

template Cip56BurnMintToken
  with
    admin              : Party
    manager            : Party
    instrumentId       : InstrumentId
    burnMintFactoryCid : ContractId BurnMintFactory
  where
    signatory admin
    observer manager

    interface instance NttToken for Cip56BurnMintToken where
      view = NttTokenView with admin, manager, mode = BurnMint

      -- Burn: spend the sender's holdings for exactly the wire amount, returning change.
      lockOrBurnImpl sender amount inputHoldingCids extraArgs = do
        let target = trimmedToDecimal amount
        views <- forA inputHoldingCids \cid -> do
          hv <- view <$> fetch cid
          assertMsg "ntt: burn holding not owned by sender" (hv.owner == sender)
          assertMsg "ntt: burn holding instrument mismatch" (hv.instrumentId == instrumentId)
          assertMsg "ntt: burn holding is locked" (hv.lock == None)
          pure hv.amount
        let total = sum views
        assertMsg "ntt: input holdings do not cover the burn amount" (total >= target)
        let change = total - target
            outputs =
              if change == 0.0
                then []
                else [ BurnMintOutput with
                         owner = sender
                         amount = change
                         context = extraArgs.context ]
        _ <- exercise burnMintFactoryCid BurnMintFactory_BurnMint with
               expectedAdmin = instrumentId.admin
               outputs
               instrumentId
               inputHoldingCids
               extraArgs
               extraActors = [sender]
        pure ()

      -- Mint: one output to the recipient, no inputs. The recipient's authority
      -- for the owner-signed output holding (BurnMintV1 requires each output owner
      -- in extraActors) does NOT come from this manager-only choice — it arrives
      -- through the recipient's standing 'DepositPreapproval', whose 'Deposit' body
      -- runs the factory with @extraActors = [owner]@. So the mint here is a fetch +
      -- validate + 'Deposit'; a missing pre-approval aborts cleanly, leaving the VAA
      -- digest unconsumed (README §10).
      mintOrUnlockImpl recipient amount _inputHoldingCids depositPreapprovalCid extraArgs = do
        cid <- case depositPreapprovalCid of
          Some c -> pure c
          None -> abort "ntt: deposit pre-approval required to mint an owner-signed holding"
        vw <- view <$> fetch cid
        assertMsg "ntt: deposit pre-approval is not for this recipient" (vw.owner == recipient)
        assertMsg "ntt: deposit pre-approval is not for this registry" (vw.admin == admin)
        assertMsg "ntt: deposit pre-approval is for a different instrument" (vw.instrumentId == instrumentId)
        exercise cid Deposit with amount, inputHoldingCids = [], extraArgs

      -- Opt-in: create the recipient's standing 'Cip56DepositPreapproval' for this
      -- token (dual-signed admin + user; the body carries admin's authority because
      -- the token is admin-signed, and user's as the PreApproveDeposit controller).
      -- Snapshots @burnMintFactoryCid@; if the registry rotates its factory, existing
      -- pre-approvals go stale and must be re-issued — the same static-cid limitation
      -- 'Cip56BurnMintToken' itself has. Acceptable at devnet stage.
      preApproveImpl user =
        fmap (Some . toInterfaceContractId @DepositPreapproval) $
          create Cip56DepositPreapproval with admin, owner = user, instrumentId, burnMintFactoryCid

----------------------------------------------------------------------
-- burn / mint deposit pre-approval (recipient standing consent)
----------------------------------------------------------------------

-- | A recipient's standing consent to receive burn/mint deposits of one
-- instrument. Dual-signed (@admin@, @owner@) so the 'Deposit' body can create the
-- owner-signed output holding without the owner online; created in one step by
-- 'Cip56BurnMintToken.PreApproveDeposit'. Copies the token's @burnMintFactoryCid@
-- at creation (same static-cid caveat as 'Cip56BurnMintToken'); the @owner@ can
-- tear it down at any time via 'Revoke'.
template Cip56DepositPreapproval
  with
    admin              : Party
    owner              : Party
    instrumentId       : InstrumentId
    burnMintFactoryCid : ContractId BurnMintFactory   -- copied from the token at PreApprove time
  where
    signatory admin, owner

    interface instance DepositPreapproval for Cip56DepositPreapproval where
      view = DepositPreapprovalView with admin, owner, instrumentId
      -- Body authority = {admin (Deposit controller)} u {admin, owner (signatories)}
      -- = {admin, owner}: exactly what BurnMintFactory_BurnMint's controller
      -- @admin :: extraActors@ needs to create the owner-signed output holding.
      depositImpl amount _inputHoldingCids extraArgs = do
        _ <- exercise burnMintFactoryCid BurnMintFactory_BurnMint with
          expectedAdmin = instrumentId.admin
          outputs =
            [ BurnMintOutput with
                owner
                amount = trimmedToDecimal amount
                context = extraArgs.context
            ]
          instrumentId
          inputHoldingCids = []
          extraArgs
          extraActors = [owner]
        pure ()
