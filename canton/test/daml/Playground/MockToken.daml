-- | A minimal, admin-signed 'NttToken' double, scoped to the Playground CLI's own
-- scripts. Ignores the CIP-56 handles ('registryCid'/'inputHoldingCids'/'extraArgs')
-- entirely -- 'LockOrBurn'/'MintOrUnlock' always succeed with no recipient consent,
-- so a deployment can be driven end to end with no pre-approval setup. Deliberately
-- kept out of Test.TestNtt: the shared NttManager test suite exercises the real
-- Cip56BurnMintToken/Cip56CustodyToken harness instead, so mints and locks there
-- genuinely need the recipient/sender's own signature (see that module's header).
-- This double only backs the Playground CLI's "mock-admin-signed" deployment kind.
module Playground.MockToken where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import Wormhole.Ntt.Token
import Wormhole.Ntt.TokenCip56 (Cip56DepositPreapproval)

-- | A minted/custodied balance. Signed by the token @admin@ only -- creating one
-- needs no signature from the recipient, so any relayer can drive 'Receive'
-- against this mock with no recipient involvement at all.
template MockHolding
  with
    admin  : Party
    owner  : Party
    amount : Int
  where
    signatory admin
    observer owner

-- | The token hook. Admin-signed (its authority backs the holdings) and observed
-- by the @manager@.
template MockToken
  with
    admin   : Party
    manager : Party
    mode    : TokenMode
  where
    signatory admin
    observer manager

    interface instance NttToken for MockToken where
      view = NttTokenView with admin, manager, mode
      -- The mock ignores the CIP-56 handles; a real token uses them (TokenCip56).
      lockOrBurnImpl _sender amt _inputHoldingCids _registryCid _extraArgs = do
        create MockHolding with admin, owner = admin, amount = amt.amount
        pure ()
      -- Admin-signed mint: needs no recipient authority, so the pre-approval cid
      -- (and the registry cid) are ignored and executor-only delivery works with 'None'.
      mintOrUnlockImpl recipient amt _inputHoldingCids _depositPreapprovalCid _registryCid _extraArgs = do
        create MockHolding with admin, owner = recipient, amount = amt.amount
        pure ()
      -- Nothing to consent to (the mint binds only the admin): silent no-op.
      preApproveImpl _user = pure None

-- | Regression test for the no-op above: the mock kind's 'PreApproveDeposit' must
-- return 'None' and create no standing 'Cip56DepositPreapproval'. Carried over from
-- Test.TestNtt (where this template used to live) now that MockToken is scoped here.
testPreapproveMockNoOp : Script ()
testPreapproveMockNoOp = do
  admin <- allocateParty "MockPreAdmin"
  manager <- allocateParty "MockPreManager"
  alice <- allocateParty "MockPreAlice"
  mockCid <- submit admin do createCmd MockToken with admin, manager, mode = BurnMint
  let tokenCid = toInterfaceContractId @NttToken mockCid
  dTok <- fromSome <$> queryDisclosure admin mockCid

  mCid <- submit (actAs alice <> disclose dTok) do
    exerciseCmd tokenCid PreApproveDeposit with user = alice
  mCid === None
  pres <- query @Cip56DepositPreapproval admin
  assertMsg "the mock kind must create no pre-approval" (null [ p | (_, p) <- pres, p.owner == alice ])
