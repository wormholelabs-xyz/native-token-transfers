-- | Per-deployment operations: peer configuration, outbound transfers (with the
-- recompute-outbound-message pattern -- see the module-level note below), inbound relaying,
-- and mock-registry funding for the Cip56 token kinds. Every entrypoint resolves its
-- contracts fresh by identity (Playground.Types resolvers); none takes or returns a
-- long-lived contract id, except where a cid is threaded between two calls the CLI makes
-- back-to-back within a single logical operation (fundUser's holding cid feeding straight
-- into the following transferOut) -- never persisted to the CLI's state file.
--
-- ## Outbound observation without an event stream
--
-- 'Wormhole.Core.State.WormholeMessage' is a choice result, not a template, so nothing can
-- query it after 'Transfer' returns. 'transferOut' instead reads the manager's
-- @outboundSequence@ *before* exercising 'Transfer' and recomputes the exact published
-- payload with the same 'Wormhole.Ntt.Payload' encoders 'Wormhole.Ntt.Manager.Transfer' uses
-- internally -- bit-exact input for `guardian sign-vaa`, matching what a real off-ledger
-- watcher would have observed.
module Playground.Ops where

import Daml.Script hiding (AnyContractId)
import DA.Action (when)
import DA.Map qualified as Map
import DA.Optional (fromSome, fromSomeNote, isSome)
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId (..))
import Splice.Api.Token.MetadataV1 (AnyContractId, ExtraArgs (..), emptyMetadata)
import Wormhole.Core.Bytes (leftPadTo, intToBytesN, normalizeHex)
import Wormhole.Core.State (SubmitGovernanceVAA (..), PublishMessage (..))
import Wormhole.Core.VAA (parseVAA)
import Wormhole.Ntt.Manager (Peer (..), Transfer (..), Receive (..), SetPeer (..))
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token
  ( trimAmount, emptyExtraArgs, NttToken, DepositPreapproval
  , PreApproveDeposit (..), Revoke (..) )
import Wormhole.Ntt.TokenCip56 (Cip56BurnMintToken, Cip56CustodyToken, Cip56DepositPreapproval)
import Test.TestCore qualified as TestCore
import Test.TestNtt (mkHolding, MockBurnMintFactory, MockTransferFactory)
import Test.TestReplay (coveringDisclosure)

import Playground.Amulet (AmuletSeam, toDisclosure, amuletHoldings)
import Playground.Disclose (RemoteSeam (..), toDisclosureByName, mkSeedDisclosure)
import Playground.MockToken (MockToken)
import Playground.Types

----------------------------------------------------------------------
-- allocatePlaygroundParty
----------------------------------------------------------------------

data AllocatePartyInput = AllocatePartyInput with
    hint : Text
  deriving (Eq, Show)

data AllocatePartyOutput = AllocatePartyOutput with
    party : Party
  deriving (Eq, Show)

-- | Allocate a fresh party under a CLI-supplied display-name hint (e.g. "Alice", "Relayer1")
-- -- the playground's generic identity source for `--user`/`--recipient`/`--executor`
-- flags. The Go CLI resolves a hint once and remembers the resulting full party id
-- (playground.state.json's Users map) for every later reference to that hint.
allocatePlaygroundParty : AllocatePartyInput -> Script AllocatePartyOutput
allocatePlaygroundParty input = do
  party <- allocateParty input.hint
  pure AllocatePartyOutput with party

----------------------------------------------------------------------
-- setPeer
----------------------------------------------------------------------

data SetPeerInput = SetPeerInput with
    operator        : Party
    managerId       : Int
    admin           : Party
    chain           : Int
    peerManager     : Text
    peerTransceiver : Text
  deriving (Eq, Show)

data SetPeerOutput = SetPeerOutput with
    managerId : Int
  deriving (Eq, Show)

setPeer : SetPeerInput -> Script SetPeerOutput
setPeer input = do
  (mgrCid, _mgr) <- resolveManager input.operator input.managerId
  _ <- submit input.admin do
    exerciseCmd mgrCid SetPeer with
      chainId = input.chain
      peer = Peer with managerAddress = input.peerManager, transceiverAddress = input.peerTransceiver
  pure SetPeerOutput with managerId = input.managerId

----------------------------------------------------------------------
-- fundUser (Cip56 mock kinds only; MockAdminSigned needs no funding)
----------------------------------------------------------------------

data FundUserInput = FundUserInput with
    admin  : Party
    owner  : Party
    amount : Decimal
  deriving (Eq, Show)

data FundUserOutput = FundUserOutput with
    holdingCid : ContractId Holding
  deriving (Eq, Show)

-- | Mint a 'Test.TestNtt.Cip56MockHolding' of @amount@ (CIP-56 decimal units) owned by
-- @owner@, under this deployment's 'playgroundInstrumentId'. The returned cid is only ever
-- valid for the immediately-following `transfer --sign`; the CLI must not cache it.
fundUser : FundUserInput -> Script FundUserOutput
fundUser input = do
  let instrument = InstrumentId with admin = input.admin, id = playgroundInstrumentId
  cid <- mkHolding input.admin input.owner instrument input.amount
  pure FundUserOutput with holdingCid = cid

----------------------------------------------------------------------
-- transferOut
----------------------------------------------------------------------

data TransferOutInput = TransferOutInput with
    operator         : Party
    managerId        : Int
    admin            : Party
    tokenKind        : Text
    user             : Party
    recipientChain   : Int
    recipientAddress : Text
    sourceToken      : Text
    rawAmount        : Int
    nonce            : Int
    consistencyLevel : Int
    inputHoldingCids : [ContractId Holding]
    -- "cip56-custody" only: the real Amulet registry's transfer-factory cid, choice context,
    -- and disclosures, resolved off-ledger by Go (internal/amulet.GetTransferFactory) for
    -- THIS call -- never cached across calls. 'None' for every other kind.
    amulet           : Optional AmuletSeam
    -- 'None' when this submit runs on the same participant as the operator/admin (today's
    -- unchanged fast path); 'Some' when the CLI ran 'Playground.Prepare:prepareTransferOut' on
    -- the data-owning parties' own participant first (phase 5, plan §4) because @user@'s
    -- participant differs from theirs.
    remote           : Optional RemoteSeam
  deriving (Eq, Show)

-- | Bit-exact recomputation of the published VAA payload -- what `guardian sign-vaa` needs.
data TransferOutOutput = TransferOutOutput with
    outboundSequence : Int
    emitterChain     : Int    -- 72, cantonChainId
    emitterAddress   : Text   -- this deployment's transceiver Emitter address
    nonce            : Int
    consistencyLevel : Int
    payload          : Text  -- encoded WormholeTransceiverMessage, hex
  deriving (Eq, Show)

-- | Resolve the token contracts a nested LockOrBurn/MintOrUnlock needs visible to the
-- submitter even though they aren't choice arguments (Wormhole.Ntt.Manager's NttManager
-- stores only the interface cid). For the Cip56 kinds this is BOTH the token hook AND its
-- underlying registry factory: the mock factories (Test.TestNtt:MockBurnMintFactory /
-- MockTransferFactory) are @signatory admin@ with no observer, so a non-admin submitter can't
-- resolve them without an explicit disclosure -- exactly the gap that made cip56 receive fail
-- with CONTRACT_NOT_FOUND. Mirrors Test.TestNtt:testLockOrBurnOwnerSignedSucceeds's factory
-- disclosure, generalized per tokenKind. Read as @admin@ (the sole signatory of both).
--
-- Also returns the resolved factory cid itself (erased to 'AnyContractId'), not just its
-- disclosure: the token no longer stores it (Wormhole.Ntt.TokenCip56), so every
-- Transfer/Receive/PreApproveDeposit call must pass it fresh as 'registryCid'. 'None' for
-- 'MockAdminSigned', which has no underlying registry.
resolveTokenSeam : Party -> TokenKind -> Script (ContractId NttToken, Optional AnyContractId, [Disclosure])
resolveTokenSeam admin kind = case kind of
  MockAdminSigned -> do
    [(cid, _)] <- query @MockToken admin
    dTok <- fromSome <$> queryDisclosure admin cid
    pure (toInterfaceContractId @NttToken cid, None, [dTok])
  Cip56BurnMintMock -> do
    [(cid, _)] <- query @Cip56BurnMintToken admin
    dTok <- fromSome <$> queryDisclosure admin cid
    -- The token stores the factory as an interface cid; disclosure needs the concrete
    -- template cid, so resolve MockBurnMintFactory directly (one per fresh deployment admin).
    [(facCid, _)] <- query @MockBurnMintFactory admin
    dFactory <- fromSome <$> queryDisclosure admin facCid
    pure (toInterfaceContractId @NttToken cid, Some (coerceContractId facCid), [dTok, dFactory])
  Cip56CustodyMock -> do
    [(cid, _)] <- query @Cip56CustodyToken admin
    dTok <- fromSome <$> queryDisclosure admin cid
    [(facCid, _)] <- query @MockTransferFactory admin
    dFactory <- fromSome <$> queryDisclosure admin facCid
    pure (toInterfaceContractId @NttToken cid, Some (coerceContractId facCid), [dTok, dFactory])
  Cip56Custody -> do
    -- Real Amulet: no on-ledger mock factory to resolve here. The real transfer-factory cid
    -- is resolved off-ledger (the scan-proxy registry call) and disclosed fresh per call by
    -- transferOut's Cip56Custody branch, not by this generic resolver -- only the token
    -- hook's own disclosure is returned; registryCid is 'None' here on purpose (a caller that
    -- doesn't override it, e.g. receiveVaa, aborts with a clear "not supported" message
    -- rather than silently trying to lock/unlock against nothing).
    [(cid, _)] <- query @Cip56CustodyToken admin
    dTok <- fromSome <$> queryDisclosure admin cid
    pure (toInterfaceContractId @NttToken cid, None, [dTok])

resolveTokenDisclosure : Party -> TokenKind -> Script [Disclosure]
resolveTokenDisclosure admin kind = do
  (_, _, disc) <- resolveTokenSeam admin kind
  pure disc

-- | Resolve @recipient@'s standing 'DepositPreapproval' for an owner-signed kind,
-- as seen by @admin@ (a signatory). Returns 'Some' cid + its disclosure if one
-- exists, else 'None' (so the on-ledger mint gate aborts with "pre-approval
-- required" rather than a script-side shortcut). Only the burn/mint kind carries
-- one; the mock needs none and the custody kind takes none.
resolvePreapproval : Party -> TokenKind -> Party -> Script (Optional (ContractId DepositPreapproval), [Disclosure])
resolvePreapproval admin kind recipient = case kind of
  Cip56BurnMintMock -> do
    pres <- query @Cip56DepositPreapproval admin
    case [ cid | (cid, p) <- pres, p.owner == recipient ] of
      cid :: _ -> do
        dPre <- fromSome <$> queryDisclosure admin cid
        pure (Some (toInterfaceContractId @DepositPreapproval cid), [dPre])
      [] -> pure (None, [])
  _ -> pure (None, [])

transferOut : TransferOutInput -> Script TransferOutOutput
transferOut input = do
  -- Resolve the manager/emitter/core-state cids + records, and gather the base disclosure set
  -- the final submit needs. 'None' queries fresh, exactly as before phase 5 (the fast path that
  -- keeps sandbox/same-participant flows unchanged); 'Some' takes a pre-fetched RemoteSeam
  -- (Playground.Prepare:prepareTransferOut, run on the data owners' own participant) instead of
  -- querying locally -- the actor's participant may not even be able to see operator/admin.
  (mgrCid, mgr, emCid, em, csCid, registryCidDefault, dTokens, baseOpts) <- case input.remote of
    None -> do
      (mgrCid, mgr) <- resolveManager input.operator input.managerId
      (emCid, em) <- resolveEmitter input.admin mgr.transceiverEmitterId
      csCid <- resolveCoreState input.operator
      dMgr <- fromSome <$> queryDisclosure input.admin mgrCid
      dEmitter <- fromSome <$> queryDisclosure input.admin emCid
      (_, registryCidDefault, dTokens) <- resolveTokenSeam input.admin (parseTokenKind input.tokenKind)
      dCs <- fromSome <$> queryDisclosure input.operator csCid
      let baseOpts = actAs input.user <> disclose dMgr <> disclose dEmitter <> disclose dCs
      pure (mgrCid, mgr, emCid, em, csCid, registryCidDefault, dTokens, baseOpts)
    Some seam -> do
      let mgrCid = fromSomeNote "playground: remote seam missing mgrCid" seam.mgrCid
          mgr    = fromSomeNote "playground: remote seam missing mgr" seam.mgr
          emCid  = fromSomeNote "playground: remote seam missing emCid" seam.emCid
          em     = fromSomeNote "playground: remote seam missing em" seam.em
          csCid  = fromSomeNote "playground: remote seam missing csCid" seam.csCid
      -- No existing contract of @user@'s own to queryDisclosure a seed FROM on this
      -- participant -- create+fetch a throwaway one (Playground.Disclose.mkSeedDisclosure).
      seed <- mkSeedDisclosure input.user
      let toDisc = map (toDisclosureByName seed) seam.disclosed
          baseOpts = foldl (\opts d -> opts <> disclose d) (actAs input.user) toDisc
      pure (mgrCid, mgr, emCid, em, csCid, seam.registryCid, [], baseOpts)

  let peer = fromSomeNote ("playground: no peer for chain " <> show input.recipientChain)
               (Map.lookup input.recipientChain mgr.peers)
      trimmed = trimAmount input.rawAmount mgr.tokenDecimals
      ntt = NativeTokenTransfer with
        decimals = trimmed.decimals
        amount = trimmed.amount
        sourceToken = normalizeHex input.sourceToken
        recipientAddress = normalizeHex input.recipientAddress
        recipientChain = input.recipientChain
        additionalPayload = ""
      mm = NttManagerMessage with
        id = leftPadTo 32 (intToBytesN mgr.outboundSequence 8)
        sender = mgr.managerAddress
        payload = encodeNativeTokenTransfer ntt
      wm = WormholeTransceiverMessage with
        sourceManager = mgr.managerAddress
        recipientManager = peer.managerAddress
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""
      recomputedPayload = encodeWormholeTransceiverMessage wm

  -- Cip56Custody drives the real Amulet registry: the factory cid/choice-context/disclosures
  -- arrive fresh per call in input.amulet (resolveTokenSeam deliberately left registryCid =
  -- None for this kind -- there is no mock factory to fall back to). Every other kind is
  -- byte-identical to before this feature landed. Cip56Custody senders never route through a
  -- RemoteSeam in practice (they are always app-provider wallet users, plan §3), so dTokens is
  -- only ever [] here in the (unreachable in practice) remote+Cip56Custody combination.
  (registryCid, extraArgs, inputHoldingCids, dSeam) <- case parseTokenKind input.tokenKind of
    Cip56Custody -> do
      let seam = fromSomeNote "playground: cip56-custody transferOut needs a resolved input.amulet seam" input.amulet
      dTok <- case dTokens of
        [d] -> pure d
        _   -> abort "playground: cip56-custody token disclosure resolution invariant violated"
      [(_, tok)] <- query @Cip56CustodyToken input.admin
      resolvedHoldingCids <-
        if input.inputHoldingCids == []
          then amuletHoldings input.user tok.instrumentId.admin
          else pure input.inputHoldingCids
      let extraArgs = ExtraArgs with context = seam.choiceContext, meta = emptyMetadata
          dDisclosed = map (toDisclosure dTok) seam.disclosed
      pure (Some (coerceContractId seam.factoryCid), extraArgs, resolvedHoldingCids, dTok :: dDisclosed)
    _ -> do
      when (isSome input.amulet) $
        abort "playground: the amulet seam must be None for a non-cip56-custody deployment"
      pure (registryCidDefault, emptyExtraArgs, input.inputHoldingCids, dTokens)

  _ <- submit (foldl (\opts d -> opts <> disclose d) baseOpts dSeam) do
    exerciseCmd mgrCid Transfer with
      user = input.user
      transceiverEmitterCid = emCid
      coreStateCid = csCid
      recipientChain = input.recipientChain
      recipientAddress = normalizeHex input.recipientAddress
      sourceToken = normalizeHex input.sourceToken
      rawAmount = input.rawAmount
      nonce = input.nonce
      consistencyLevel = input.consistencyLevel
      inputHoldingCids
      feeAllocation = None  -- playground MVP assumes fee 0; see Playground.Init's note
      registryCid
      extraArgs

  pure TransferOutOutput with
    outboundSequence = mgr.outboundSequence
    emitterChain = 72
    emitterAddress = em.emitterAddress
    nonce = input.nonce
    consistencyLevel = input.consistencyLevel
    payload = recomputedPayload

----------------------------------------------------------------------
-- registerEmitter
----------------------------------------------------------------------

data RegisterEmitterInput = RegisterEmitterInput with
    operator : Party
    owner    : Party
  deriving (Eq, Show)

data RegisterEmitterOutput = RegisterEmitterOutput with
    emitterId      : Int
    emitterAddress : Text
  deriving (Eq, Show)

-- | Register a standalone core-bridge 'Emitter' for @owner@, not tied to any NTT
-- deployment -- the same requester-submitted 'Test.TestCore:registerEmitter' path
-- 'Playground.Deploy:deployNtt' uses for transceivers (zero-fee registry, so no CoreState
-- reference needed). The returned identity pair is what the CLI persists; the cid is not.
registerEmitter : RegisterEmitterInput -> Script RegisterEmitterOutput
registerEmitter input = do
  emCid <- TestCore.registerEmitter input.operator input.owner
  Some em <- queryContractId input.owner emCid
  pure RegisterEmitterOutput with
    emitterId = em.emitterId
    emitterAddress = em.emitterAddress

----------------------------------------------------------------------
-- publishMessage
----------------------------------------------------------------------

data PublishMessageInput = PublishMessageInput with
    operator         : Party
    owner            : Party
    emitterId        : Int
    payload          : Text
    nonce            : Int
    consistencyLevel : Int
    -- 'None' on the same-participant fast path; 'Some' when the CLI ran
    -- 'Playground.Prepare:preparePublish' on the operator's own participant first (phase 5)
    -- because the emitter's owner routes to a different participant.
    remote           : Optional RemoteSeam
  deriving (Eq, Show)

data PublishMessageOutput = PublishMessageOutput with
    sequence       : Int
    emitterChain   : Int   -- 72, cantonChainId
    emitterAddress : Text
    payload        : Text
  deriving (Eq, Show)

-- | Publish an arbitrary message from a standalone emitter. Unlike 'transferOut' there is
-- nothing to recompute: 'PublishMessage''s choice result -- the 'WormholeMessage' a real
-- watcher decodes from the exercise result -- is directly available here, so its sequence
-- and payload are returned verbatim (the address comes from the resolved 'Emitter'; the
-- 'WormholeMessage' carries only the identity components a watcher hashes itself). @owner@
-- is its own payer, collapsing the choice's @owner, payer@ controller set to one party;
-- the CoreState is disclosed for the fee read, with @feeAllocation = None@ under the
-- playground's fee-0 assumption (same as 'transferOut').
publishMessage : PublishMessageInput -> Script PublishMessageOutput
publishMessage input = do
  (emCid, em, csCid, submitOpts) <- case input.remote of
    None -> do
      (emCid, em) <- resolveEmitter input.operator input.emitterId
      csCid <- resolveCoreState input.operator
      dCs <- fromSome <$> queryDisclosure input.operator csCid
      pure (emCid, em, csCid, actAs input.owner <> disclose dCs)
    Some seam -> do
      let emCid = fromSomeNote "playground: remote seam missing emCid" seam.emCid
          em    = fromSomeNote "playground: remote seam missing em" seam.em
          csCid = fromSomeNote "playground: remote seam missing csCid" seam.csCid
      seed <- mkSeedDisclosure input.owner
      let toDisc = map (toDisclosureByName seed) seam.disclosed
      pure (emCid, em, csCid, foldl (\opts d -> opts <> disclose d) (actAs input.owner) toDisc)
  msg <- submit submitOpts do
    exerciseCmd emCid PublishMessage with
      nonce = input.nonce
      payload = normalizeHex input.payload
      consistencyLevel = input.consistencyLevel
      coreStateCid = csCid
      payer = input.owner
      feeAllocation = None
  pure PublishMessageOutput with
    sequence = msg.sequence
    emitterChain = 72
    emitterAddress = em.emitterAddress
    payload = msg.payload

----------------------------------------------------------------------
-- applyGovernance
----------------------------------------------------------------------

data ApplyGovernanceInput = ApplyGovernanceInput with
    operator : Party
    vaaBytes : Text
    pubKeys  : [(Int, Text)]
  deriving (Eq, Show)

data ApplyGovernanceOutput = ApplyGovernanceOutput with
    messageFee : Int
  deriving (Eq, Show)

-- | Apply a `guardian sign-governance` VAA (currently: SetMessageFee only) to the live
-- CoreState. Submitted as @operator@ alone -- 'SubmitGovernanceVAA' inherits
-- guardianGovernance's authority from the archived CoreState it replaces, exactly as
-- Test.TestCore:testGovernanceSetMessageFee does.
applyGovernance : ApplyGovernanceInput -> Script ApplyGovernanceOutput
applyGovernance input = do
  csCid <- resolveCoreState input.operator
  newCsId <- submit input.operator do
    exerciseCmd csCid SubmitGovernanceVAA with
      encodedVAA = input.vaaBytes
      pubKeys = input.pubKeys
  Some cs <- queryContractId input.operator newCsId
  pure ApplyGovernanceOutput with messageFee = cs.messageFee

----------------------------------------------------------------------
-- receiveVaa
----------------------------------------------------------------------

data ReceiveVaaInput = ReceiveVaaInput with
    operator  : Party
    managerId : Int
    admin     : Party  -- the deployment's replay-trie consumer (Playground.Deploy:deployNtt)
    tokenKind : Text   -- selects the token disclosure (see resolveTokenDisclosure)
    executor  : Party
    recipient : Party
    vaaBytes  : Text
    pubKeys   : [(Int, Text)]
    -- 'None' on the same-participant fast path; 'Some' when the CLI ran
    -- 'Playground.Prepare:prepareReceive' on the operator's own participant first (phase 5) --
    -- only relevant for an explicit '--executor' that routes off the default participant.
    remote    : Optional RemoteSeam
  deriving (Eq, Show)

data ReceiveVaaOutput = ReceiveVaaOutput with
    recipientChain : Int
    amount         : Int
    decimals       : Int
  deriving (Eq, Show)

receiveVaa : ReceiveVaaInput -> Script ReceiveVaaOutput
receiveVaa input = do
  -- Receiving is out of scope for the real-Amulet flow: resolveTokenSeam's Cip56Custody case
  -- deliberately returns registryCid = None (there is no mock factory to fall back to), so
  -- aborting here explains why clearly instead of surfacing a generic "registry transfer
  -- factory cid required" error from deep inside Cip56CustodyToken.mintOrUnlockImpl.
  when (parseTokenKind input.tokenKind == Cip56Custody) $
    abort "playground: cip56-custody receive/unlock not supported by the playground"
  let kind = parseTokenKind input.tokenKind

  -- See transferOut's identical None/Some split: 'None' resolves everything fresh (unchanged
  -- fast path); 'Some' takes a pre-fetched RemoteSeam (Playground.Prepare:prepareReceive, run
  -- on the operator's/admin's own participant) instead -- relevant only when an explicit
  -- '--executor' routes this submit off the default participant.
  (mgrCid, csCid, nodeCid, registryCid, preCid, submitOpts) <- case input.remote of
    None -> do
      (mgrCid, _mgr) <- resolveManager input.operator input.managerId
      csCid <- resolveCoreState input.operator
      let digest = (parseVAA input.vaaBytes).hash
      (nodeCid, nodeDisc) <- coveringDisclosure input.operator input.admin digest
      dMgr <- fromSome <$> queryDisclosure input.operator mgrCid
      dCs <- fromSome <$> queryDisclosure input.operator csCid
      -- The nested MintOrUnlock reaches the token hook AND its admin-signed registry factory;
      -- disclose both (as transferOut does for the outbound leg) so a non-admin executor can
      -- resolve them. Receive is executor-only: the recipient is passive. For an owner-signed
      -- kind its authority arrives through a standing DepositPreapproval, resolved and
      -- disclosed here; if the recipient has not opted in, pass None and let the on-ledger
      -- mint gate abort.
      (_, registryCid, dTokens) <- resolveTokenSeam input.admin kind
      (preCid, dPre) <- resolvePreapproval input.admin kind input.recipient
      let baseOpts = actAs input.executor <> disclose dMgr <> disclose dCs <> disclose nodeDisc
          submitOpts = foldl (\opts d -> opts <> disclose d) baseOpts (dTokens <> dPre)
      pure (mgrCid, csCid, nodeCid, registryCid, preCid, submitOpts)
    Some seam -> do
      let mgrCid  = fromSomeNote "playground: remote seam missing mgrCid" seam.mgrCid
          csCid   = fromSomeNote "playground: remote seam missing csCid" seam.csCid
          nodeCid = fromSomeNote "playground: remote seam missing replayNodeCid" seam.replayNodeCid
          registryCid = seam.registryCid
          preCid  = seam.preapprovalCid
      seed <- mkSeedDisclosure input.executor
      let toDisc = map (toDisclosureByName seed) seam.disclosed
          submitOpts = foldl (\opts d -> opts <> disclose d) (actAs input.executor) toDisc
      pure (mgrCid, csCid, nodeCid, registryCid, preCid, submitOpts)

  ntt <- submit submitOpts do
    exerciseCmd mgrCid Receive with
      executor = input.executor
      coreStateCid = csCid
      replayNodeCid = nodeCid
      vaaBytes = input.vaaBytes
      pubKeys = input.pubKeys
      recipient = input.recipient
      inputHoldingCids = []
      depositPreapprovalCid = preCid
      registryCid
      extraArgs = emptyExtraArgs

  pure ReceiveVaaOutput with
    recipientChain = ntt.recipientChain
    amount = ntt.amount
    decimals = ntt.decimals

----------------------------------------------------------------------
-- preapproveDeposit / revokeDeposit
----------------------------------------------------------------------

data PreapproveDepositInput = PreapproveDepositInput with
    admin     : Party  -- the deployment's token admin (co-signatory of the pre-approval)
    tokenKind : Text   -- selects the token disclosure (see resolveTokenSeam)
    user      : Party  -- the recipient opting in
    -- 'None' on the same-participant fast path; 'Some' when the CLI ran
    -- 'Playground.Prepare:preparePreapprove' on the admin's own participant first (phase 5).
    remote    : Optional RemoteSeam
  deriving (Eq, Show)

data PreapproveDepositOutput = PreapproveDepositOutput with
    preapproved : Bool   -- False when the kind needs no pre-approval (mock no-op)
  deriving (Eq, Show)

-- | @user@ opts in to receive owner-signed deposits: exercises 'PreApproveDeposit'
-- on the deployment's token hook (disclosed to @user@), creating a standing,
-- dual-signed 'DepositPreapproval'. Returns @preapproved = False@ when the choice
-- returns 'None' (the admin-signed mock, which needs no consent). No cid is
-- persisted -- the pre-approval is resolved fresh by 'resolvePreapproval' at
-- receive time. The custody kind's on-ledger 'preApproveImpl' abort surfaces as the
-- command error.
preapproveDeposit : PreapproveDepositInput -> Script PreapproveDepositOutput
preapproveDeposit input = do
  (tokenCid, submitOpts) <- case input.remote of
    None -> do
      (tokenCid, _registryCid, dTokens) <- resolveTokenSeam input.admin (parseTokenKind input.tokenKind)
      pure (tokenCid, foldl (\opts d -> opts <> disclose d) (actAs input.user) dTokens)
    Some seam -> do
      let tokenCid = fromSomeNote "playground: remote seam missing tokenCid" seam.tokenCid
      seed <- mkSeedDisclosure input.user
      let toDisc = map (toDisclosureByName seed) seam.disclosed
      pure (tokenCid, foldl (\opts d -> opts <> disclose d) (actAs input.user) toDisc)
  mCid <- submit submitOpts do
    exerciseCmd tokenCid PreApproveDeposit with user = input.user
  pure PreapproveDepositOutput with preapproved = isSome mCid

data RevokeDepositInput = RevokeDepositInput with
    admin : Party  -- the pre-approval's admin co-signatory (resolves it)
    user  : Party  -- the owner tearing down its consent
  deriving (Eq, Show)

data RevokeDepositOutput = RevokeDepositOutput with
    revoked : Bool
  deriving (Eq, Show)

-- | @user@ (owner) tears down its standing 'Cip56DepositPreapproval' via the
-- owner-only 'Revoke'. Resolved by query as @admin@ (a signatory), filtered by
-- owner; aborts cleanly if none exists.
revokeDeposit : RevokeDepositInput -> Script RevokeDepositOutput
revokeDeposit input = do
  pres <- query @Cip56DepositPreapproval input.admin
  case [ cid | (cid, p) <- pres, p.owner == input.user ] of
    cid :: _ -> do
      dPre <- fromSome <$> queryDisclosure input.admin cid
      _ <- submit (actAs input.user <> disclose dPre) do
        exerciseCmd (toInterfaceContractId @DepositPreapproval cid) Revoke
      pure RevokeDepositOutput with revoked = True
    [] -> abort "playground: no deposit pre-approval to revoke for this user"
