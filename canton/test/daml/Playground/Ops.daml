-- | Per-deployment operations: peer configuration, outbound transfers (with the
-- recompute-outbound-message pattern -- see the module-level note below), inbound relaying,
-- and mock-registry funding/pre-approval for the "mock" token kind. Every entrypoint resolves
-- its contracts fresh by identity (Playground.Types resolvers); no cid is ever persisted to
-- the CLI's state file.
--
-- ## Outbound observation without an event stream
--
-- 'Wormhole.Core.State.WormholeMessage' is a choice result, not a template, so nothing can
-- query it after 'Wormhole.Ntt.Manager.Transfer' returns. 'transferOut' instead reads the
-- deployment's transceiver 'Emitter' sequence *before* exercising 'Transfer' and recomputes
-- the exact published payload with the same 'Wormhole.Ntt.Payload' encoders 'Transfer' uses
-- internally -- bit-exact input for `guardian sign-vaa`, matching what a real off-ledger
-- watcher would have observed.
--
-- ## Receive requires prior recipient opt-in, both modes
--
-- Both 'Wormhole.Ntt.Manager.Mint' (burn/mint) and 'Wormhole.Ntt.Manager.Release'
-- (lock/unlock, "mock" kind, via 'Playground.MockRegistry') need the recipient's standing
-- pre-approval to supply the recipient's own signature to a nested create/exercise the
-- executor-only relay itself cannot reach -- see 'Playground.MockRegistry' and
-- 'Wormhole.Ntt.Deposit'. If the recipient hasn't opted in, the on-ledger gate aborts before
-- the VAA digest is consumed, so the same VAA stays deliverable once the recipient opts in.
module Playground.Ops where

import Daml.Script
import DA.Map qualified as Map
import DA.Optional (fromSome, fromSomeNote)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.BurnMintV1 (BurnMintFactory)
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId (..))
import Splice.Api.Token.MetadataV1 (AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyMetadata)
import Wormhole.Core.Bytes (normalizeHex, leftPadTo, intToBytesN)
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Core.State (SubmitGovernanceVAA (..), PublishMessage (..))
import Wormhole.Core.VAA (parseVAA)
import Wormhole.Ntt.Amount (trimAmount)
import Wormhole.Ntt.Deposit
import Wormhole.Ntt.Deposit qualified as Deposit
import Wormhole.Ntt.Manager hiding (resolveLedger)
import Wormhole.Ntt.Payload
import Test.TestCore qualified as TestCore
import Test.TestNtt (Cip56MockHolding (..), MockBurnMintFactory (..))
import Test.TestReplay (coveringDisclosure)

import Playground.Amulet (AmuletSeam (..), amuletHoldings, toDisclosure)
import Playground.MockRegistry
import Playground.MockRegistry qualified as MockRegistry
import Playground.Types

----------------------------------------------------------------------
-- allocatePlaygroundParty
----------------------------------------------------------------------

data AllocatePartyInput = AllocatePartyInput with
    hint : Text
  deriving (Eq, Show)

data AllocatePartyOutput = AllocatePartyOutput with
    party : Party
  deriving (Eq, Show)

-- | Allocate a fresh party under a CLI-supplied display-name hint (e.g. "Alice", "Relayer1")
-- -- the playground's generic identity source for `--user`/`--recipient`/`--executor`
-- flags. The Go CLI resolves a hint once and remembers the resulting full party id
-- (playground.state.json's Users map) for every later reference to that hint.
allocatePlaygroundParty : AllocatePartyInput -> Script AllocatePartyOutput
allocatePlaygroundParty input = do
  party <- allocateParty input.hint
  pure AllocatePartyOutput with party

----------------------------------------------------------------------
-- setPeer
----------------------------------------------------------------------

data SetPeerInput = SetPeerInput with
    operator        : Party
    managerId       : Int
    admin           : Party
    chain           : Int
    peerManager     : Text
    peerTransceiver : Text
  deriving (Eq, Show)

data SetPeerOutput = SetPeerOutput with
    managerId : Int
  deriving (Eq, Show)

setPeer : SetPeerInput -> Script SetPeerOutput
setPeer input = do
  (mgrCid, _mgr) <- resolveManager input.operator input.managerId
  _ <- submit input.admin do
    exerciseCmd mgrCid SetPeer with
      chainId = input.chain
      peer = Peer with managerAddress = input.peerManager, transceiverAddress = input.peerTransceiver
  pure SetPeerOutput with managerId = input.managerId

----------------------------------------------------------------------
-- fundUser ("mock" kind only; "amulet" funds via a real Amulet tap, off-ledger)
----------------------------------------------------------------------

data FundUserInput = FundUserInput with
    guardianGovernance : Party  -- the funding faucet's Deposit-controlling instrument admin (gg)
    admin              : Party  -- the deployment's admin, to resolve its committed faucet factory
    owner              : Party
    amount             : Decimal
  deriving (Eq, Show)

data FundUserOutput = FundUserOutput with
    holdingCid : ContractId Holding
  deriving (Eq, Show)

-- | Mint a 'Test.TestNtt.Cip56MockHolding' of @amount@ (CIP-56 decimal units) owned by
-- @owner@, via the recipient's standing 'Wormhole.Ntt.Deposit.DepositPreapproval' and this
-- deployment's committed burn/mint factory (the funding faucet -- see
-- 'Playground.Deploy.deployRegistry'; a lock/unlock deployment's users hold a
-- 'DepositPreapproval' purely for this). @owner@'s pre-approval must already exist; the CLI
-- ensures it (via 'preapprove') before calling this. The returned cid is only ever valid for
-- the immediately-following `transfer --sign`; the CLI must not cache it.
fundUser : FundUserInput -> Script FundUserOutput
fundUser input = do
  let gg = input.guardianGovernance
      -- The faucet's nonce is fixed at 0 -- fundUser/preapprove/revoke are per-operation
      -- calls with no instrumentNonce input, so (like 'Test.TestNtt.deploy') this playground
      -- phase only supports one bridged instrument per admin. See this file's header.
      instrumentId = InstrumentId with admin = gg, id = nttInstrumentIdFor input.admin 0
  facs <- query @MockBurnMintFactory gg
  facCid <- case [ cid | (cid, f) <- facs, f.instrument == instrumentId ] of
    [cid] -> pure cid
    [] -> abort "playground: no MockBurnMintFactory for this deployment's instrument -- run `deploy` first"
    _ -> abort "playground: more than one MockBurnMintFactory for this instrument"
  pres <- query @DepositPreapproval input.owner
  preCid <- case [ cid | (cid, p) <- pres, p.instrumentId == instrumentId ] of
    [cid] -> pure cid
    [] -> abort "playground: owner has no DepositPreapproval for this instrument -- run `preapprove` first"
    _ -> abort "playground: more than one DepositPreapproval for this instrument"

  before <- query @Cip56MockHolding gg
  _ <- submit gg do
    exerciseCmd preCid Deposit with
      amount = input.amount
      factoryCid = toInterfaceContractId @BurnMintFactory facCid
      extraArgs = emptyExtraArgs
  after <- query @Cip56MockHolding gg
  let beforeCids = map fst before
  holdingCid <- case
    [ cid | (cid, h) <- after, cid `notElem` beforeCids, h.owner == input.owner, h.instrument == instrumentId ] of
    [cid] -> pure (toInterfaceContractId @Holding cid)
    _ -> abort "playground: fundUser could not uniquely resolve the freshly minted holding"
  pure FundUserOutput with holdingCid

----------------------------------------------------------------------
-- transferOut
----------------------------------------------------------------------

data TransferOutInput = TransferOutInput with
    operator         : Party
    managerId        : Int
    admin            : Party
    tokenKind        : Text  -- "mock" | "amulet"
    user             : Party
    recipientChain   : Int
    recipientAddress : Text
    sourceToken      : Text
    rawAmount        : Int
    nonce            : Int
    consistencyLevel : Int
    inputHoldingCids : [ContractId Holding]
    -- "amulet" only: the real Amulet registry's transfer-factory cid, choice context, and
    -- disclosures, resolved off-ledger by Go (internal/amulet.GetTransferFactory) for THIS
    -- call -- never cached across calls. 'None' for "mock".
    amulet           : Optional AmuletSeam
  deriving (Eq, Show)

-- | Bit-exact recomputation of the published VAA payload -- what `guardian sign-vaa` needs.
data TransferOutOutput = TransferOutOutput with
    outboundSequence : Int
    emitterChain     : Int    -- 72, cantonChainId
    emitterAddress   : Text   -- this deployment's transceiver Emitter address
    nonce            : Int
    consistencyLevel : Int
    payload          : Text  -- encoded WormholeTransceiverMessage, hex
  deriving (Eq, Show)

-- | Resolve the manager/emitter/(lock-unlock) ledger/committed-factory contracts, submit
-- @user@'s 'Wormhole.Ntt.Manager.Transfer', and recompute the exact published payload from
-- the emitter's pre-exercise sequence -- see the module header. "amulet" additionally
-- compares the CLI-resolved factory cid against @mgr.factory@ and submits 'SetFactory' as
-- admin first on a mismatch (plan §4.4's upgrade path).
transferOut : TransferOutInput -> Script TransferOutOutput
transferOut input = do
  (mgrCid0, mgr0) <- resolveManager input.operator input.managerId
  (emCid, em) <- resolveEmitter input.operator mgr0.transceiverEmitterId
  csCid <- resolveCoreState input.operator
  csDisc <- fromSome <$> queryDisclosure input.operator csCid
  emDisc <- fromSome <$> queryDisclosure input.operator emCid

  -- Lock/unlock (either kind) needs the ledger cid + its disclosure; burn/mint has none. A
  -- non-first lock also needs the EXISTING custody pot holding disclosed: 'Transfer' merges
  -- the fresh deposit into it (Wormhole.Ntt.Manager.daml's 'sumCustodyHoldings'/consolidation
  -- step, run with the sending user's own authority alone), and that pot is owned by the
  -- admin/custodian -- not the sender -- so the sender's participant has no other way to see
  -- it (same reasoning as receiveVaa's potDiscs below).
  (ledgerCidOpt, ledgerDiscs) <- case mgr0.tokenConfig of
    BurnMint -> pure (None, [])
    LockUnlock -> do
      (lcid, ledger) <- resolveLedger input.operator mgr0.managerAddress
      ld <- fromSome <$> queryDisclosure input.operator lcid
      potDiscs <- case ledger.custodyHoldingCid of
        None -> pure []
        Some potCid -> do
          d <- fromSome <$> queryDisclosure mgr0.guardianGovernance (coerceContractId potCid : ContractId Cip56MockHolding)
          pure [d]
      pure (Some lcid, ld :: potDiscs)

  (mgrCid, mgr, extraDiscs, extraArgs, holdingCids) <- case parseTokenKind input.tokenKind of
    -- The registry recreates its factory contract occasionally; compare the CLI-resolved
    -- cid against the committed one and rotate it (admin-submitted) before the transfer if
    -- it moved (plan §4.4's upgrade path).
    Amulet -> do
      let seam = fromSomeNote "playground: amulet transferOut requires a resolved 'amulet' seam" input.amulet
          resolvedFactory = TransferFactoryCid (coerceContractId seam.factoryCid)
      mgrCid' <-
        if resolvedFactory == mgr0.factory
          then pure mgrCid0
          else submit input.admin do exerciseCmd mgrCid0 SetFactory with newFactory = resolvedFactory
      Some mgr' <- queryContractId input.operator mgrCid'
      let discs = map (toDisclosure csDisc) seam.disclosed
          ea = ExtraArgs with context = seam.choiceContext, meta = emptyMetadata
      -- The real registry's 'TransferFactory_Transfer' requires at least one input
      -- holding (unlike the mock, which creates the receiver's holding out of nothing);
      -- the CLI intentionally leaves 'input.inputHoldingCids' empty for "amulet" (see
      -- transfer.go), so this in-script enumeration of the sender's own unlocked Amulet
      -- (Playground.Amulet.amuletHoldings) is what actually supplies it.
      hcids <- amuletHoldings input.user mgr'.instrumentId.admin
      hcids' <- if null hcids
        then abort "playground: amulet transferOut found no unlocked Amulet for the sender -- tap first"
        else pure hcids
      pure (mgrCid', mgr', discs, ea, hcids')
    Mock -> do
      let gg = mgr0.guardianGovernance
      facDisc <- case mgr0.factory of
        BurnMintFactoryCid cid -> fromSome <$> queryDisclosure gg (coerceContractId cid : ContractId MockBurnMintFactory)
        TransferFactoryCid cid -> fromSome <$> queryDisclosure gg (coerceContractId cid : ContractId MockPreapprovedTransferFactory)
      (ea, preDiscs) <- case mgr0.tokenConfig of
        BurnMint -> pure (emptyExtraArgs, [])
        LockUnlock -> do
          -- The admin is the lock's custodian/receiver; its standing preapproval is what
          -- lets ANY sender's lock deliver to it (plan §4.2 -- no promotion needed).
          pres <- query @MockTransferPreapproval gg
          preCid <- case [ cid | (cid, p) <- pres, p.owner == mgr0.admin, p.instrument == mgr0.instrumentId ] of
            [cid] -> pure cid
            [] -> abort "playground: admin has no standing transfer pre-approval -- run `deploy` first"
            _ -> abort "playground: more than one MockTransferPreapproval for the admin"
          preDisc <- fromSome <$> queryDisclosure gg preCid
          let ctx = ExtraArgs with
                context = ChoiceContext with
                  values = TextMap.fromList
                    [(mockTransferPreapprovalContextKey, AV_ContractId (coerceContractId preCid))]
                meta = emptyMetadata
          pure (ctx, [preDisc])
      pure (mgrCid0, mgr0, facDisc :: preDiscs, ea, input.inputHoldingCids)

  mgrDisc <- fromSome <$> queryDisclosure input.operator mgrCid

  -- Recompute the exact published payload from the emitter's PRE-exercise sequence -- see
  -- the module header; this is what `guardian sign-vaa` needs.
  let peer = fromSomeNote ("playground: no peer for chain " <> show input.recipientChain)
               (Map.lookup input.recipientChain mgr.peers)
      trimmed = trimAmount input.rawAmount mgr.tokenDecimals
      ntt = NativeTokenTransfer with
        decimals = trimmed.decimals
        amount = trimmed.amount
        sourceToken = normalizeHex input.sourceToken
        recipientAddress = normalizeHex input.recipientAddress
        recipientChain = input.recipientChain
        additionalPayload = ""
      mm = NttManagerMessage with
        id = leftPadTo 32 (intToBytesN em.sequence 8)
        sender = mgr.managerAddress
        payload = encodeNativeTokenTransfer ntt
      wm = WormholeTransceiverMessage with
        sourceManager = mgr.managerAddress
        recipientManager = peer.managerAddress
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""

  let discs = csDisc :: emDisc :: mgrDisc :: (ledgerDiscs ++ extraDiscs)
  _ <- submit (foldl (\opts d -> opts <> disclose d) (actAs input.user) discs) do
    exerciseCmd mgrCid Transfer with
      user = input.user
      transceiverEmitterCid = emCid
      coreStateCid = csCid
      ledgerCid = ledgerCidOpt
      recipientChain = input.recipientChain
      recipientAddress = input.recipientAddress
      sourceToken = input.sourceToken
      rawAmount = input.rawAmount
      nonce = input.nonce
      consistencyLevel = input.consistencyLevel
      inputHoldingCids = holdingCids
      feeAllocation = None  -- playground MVP assumes fee 0; see Playground.Init's note
      extraArgs

  pure TransferOutOutput with
    outboundSequence = em.sequence
    emitterChain = 72
    emitterAddress = em.emitterAddress
    nonce = input.nonce
    consistencyLevel = input.consistencyLevel
    payload = encodeWormholeTransceiverMessage wm

----------------------------------------------------------------------
-- registerEmitter (standalone, not tied to any NTT deployment)
----------------------------------------------------------------------

data RegisterEmitterInput = RegisterEmitterInput with
    operator : Party
    owner    : Party
  deriving (Eq, Show)

data RegisterEmitterOutput = RegisterEmitterOutput with
    emitterId      : Int
    emitterAddress : Text
  deriving (Eq, Show)

-- | Register a standalone core-bridge 'Emitter' for @owner@, not tied to any NTT
-- deployment -- the same requester-submitted 'Test.TestCore:registerEmitter' path
-- 'Wormhole.Ntt.Governance.RegisterManager' uses internally for a deployment's own
-- transceiver. The returned identity pair is what the CLI persists; the cid is not.
registerEmitter : RegisterEmitterInput -> Script RegisterEmitterOutput
registerEmitter input = do
  emCid <- TestCore.registerEmitter input.operator input.owner
  Some em <- queryContractId input.owner emCid
  pure RegisterEmitterOutput with
    emitterId = em.emitterId
    emitterAddress = em.emitterAddress

----------------------------------------------------------------------
-- publishMessage
----------------------------------------------------------------------

data PublishMessageInput = PublishMessageInput with
    operator         : Party
    owner            : Party
    emitterId        : Int
    payload          : Text
    nonce            : Int
    consistencyLevel : Int
  deriving (Eq, Show)

data PublishMessageOutput = PublishMessageOutput with
    sequence       : Int
    emitterChain   : Int   -- 72, cantonChainId
    emitterAddress : Text
    payload        : Text
  deriving (Eq, Show)

-- | Publish an arbitrary message from a standalone emitter. Unlike 'transferOut' there is
-- nothing to recompute: 'PublishMessage''s choice result -- the 'WormholeMessage' a real
-- watcher decodes from the exercise result -- is directly available here, so its sequence
-- and payload are returned verbatim (the address comes from the resolved 'Emitter'; the
-- 'WormholeMessage' carries only the identity components a watcher hashes itself). @owner@
-- is its own payer, collapsing the choice's @owner, payer@ controller set to one party;
-- the CoreState is disclosed for the fee read, with @feeAllocation = None@ under the
-- playground's fee-0 assumption (same as 'transferOut').
publishMessage : PublishMessageInput -> Script PublishMessageOutput
publishMessage input = do
  (emCid, em) <- resolveEmitter input.operator input.emitterId
  csCid <- resolveCoreState input.operator
  dCs <- fromSome <$> queryDisclosure input.operator csCid
  msg <- submit (actAs input.owner <> disclose dCs) do
    exerciseCmd emCid PublishMessage with
      nonce = input.nonce
      payload = normalizeHex input.payload
      consistencyLevel = input.consistencyLevel
      coreStateCid = csCid
      payer = input.owner
      feeAllocation = None
  pure PublishMessageOutput with
    sequence = msg.sequence
    emitterChain = 72
    emitterAddress = em.emitterAddress
    payload = msg.payload

----------------------------------------------------------------------
-- applyGovernance
----------------------------------------------------------------------

data ApplyGovernanceInput = ApplyGovernanceInput with
    operator : Party
    vaaBytes : Text
    pubKeys  : [(Int, Text)]
  deriving (Eq, Show)

data ApplyGovernanceOutput = ApplyGovernanceOutput with
    messageFee : Int
  deriving (Eq, Show)

-- | Apply a `guardian sign-governance` VAA (currently: SetMessageFee only) to the live
-- CoreState. Submitted as @operator@ alone -- 'SubmitGovernanceVAA' inherits
-- guardianGovernance's authority from the archived CoreState it replaces, exactly as
-- Test.TestCore:testGovernanceSetMessageFee does.
applyGovernance : ApplyGovernanceInput -> Script ApplyGovernanceOutput
applyGovernance input = do
  csCid <- resolveCoreState input.operator
  newCsId <- submit input.operator do
    exerciseCmd csCid SubmitGovernanceVAA with
      encodedVAA = input.vaaBytes
      pubKeys = input.pubKeys
  Some cs <- queryContractId input.operator newCsId
  pure ApplyGovernanceOutput with messageFee = cs.messageFee

----------------------------------------------------------------------
-- receiveVaa
----------------------------------------------------------------------

data ReceiveVaaInput = ReceiveVaaInput with
    operator  : Party
    managerId : Int
    admin     : Party  -- the deployment's admin (lock/unlock custodian; unused for burn/mint)
    tokenKind : Text   -- "mock" | "amulet" ("amulet" is rejected outright, receive out of scope)
    executor  : Party
    recipient : Party
    vaaBytes  : Text
    pubKeys   : [(Int, Text)]
  deriving (Eq, Show)

data ReceiveVaaOutput = ReceiveVaaOutput with
    recipientChain : Int
    amount         : Int
    decimals       : Int
  deriving (Eq, Show)

-- | Relay a VAA through 'Wormhole.Ntt.Manager.Mint' (burn/mint) or 'Release' (lock/unlock),
-- executor-only both ways (see the module header). "amulet" aborts outright -- receiving
-- against real Amulet is out of scope for the playground (unchanged posture).
receiveVaa : ReceiveVaaInput -> Script ReceiveVaaOutput
receiveVaa input =
  case parseTokenKind input.tokenKind of
    Amulet -> abort "playground: amulet receive/unlock not supported by the playground"
    Mock -> do
      (mgrCid, mgr) <- resolveManager input.operator input.managerId
      csCid <- resolveCoreState input.operator
      csDisc <- fromSome <$> queryDisclosure input.operator csCid
      mgrDisc <- fromSome <$> queryDisclosure input.operator mgrCid
      let gg = mgr.guardianGovernance
          digest = (parseVAA input.vaaBytes).hash
      (nodeCid, nodeDisc) <- coveringDisclosure input.operator gg mgr.namespace digest

      case mgr.tokenConfig of
        BurnMint -> do
          pres <- query @DepositPreapproval gg
          preCid <- case
            [ cid | (cid, p) <- pres, p.owner == input.recipient, p.instrumentId == mgr.instrumentId ] of
            [cid] -> pure cid
            [] -> abort "playground: recipient has no DepositPreapproval -- run `preapprove` first"
            _ -> abort "playground: more than one DepositPreapproval for the recipient"
          -- The recipient's own DepositPreapproval: 'Mint' 'fetch'es it, so the executor-only
          -- submission needs it disclosed (gg is its observer) -- same pattern as the
          -- LockUnlock branch below's preapproval disclosure.
          preDisc <- fromSome <$> queryDisclosure gg preCid
          -- The committed burn/mint factory: 'Deposit' (nested inside 'Mint') exercises it
          -- directly, so it needs disclosing too -- same pattern as transferOut's Mock branch
          -- and the LockUnlock branch below's facDisc.
          facDisc <- case mgr.factory of
            BurnMintFactoryCid cid -> fromSome <$> queryDisclosure gg (coerceContractId cid : ContractId MockBurnMintFactory)
            TransferFactoryCid _ -> abort "playground: burn/mint deployment has a lock/unlock factory -- inconsistent state"

          ntt <- submit (actAs input.executor <> disclose csDisc <> disclose mgrDisc <> disclose nodeDisc <> disclose preDisc <> disclose facDisc) do
            exerciseCmd mgrCid Mint with
              executor = input.executor
              coreStateCid = csCid
              replayNodeCid = nodeCid
              vaaBytes = input.vaaBytes
              pubKeys = input.pubKeys
              recipient = input.recipient
              depositPreapprovalCid = preCid
              extraArgs = emptyExtraArgs
          pure ReceiveVaaOutput with
            recipientChain = ntt.recipientChain
            amount = ntt.amount
            decimals = ntt.decimals

        LockUnlock -> do
          (ledgerCid, ledger) <- resolveLedger input.operator mgr.managerAddress
          ledgerDisc <- fromSome <$> queryDisclosure input.operator ledgerCid
          potDiscs <- case ledger.custodyHoldingCid of
            None -> pure []
            Some potCid -> do
              d <- fromSome <$> queryDisclosure gg (coerceContractId potCid : ContractId Cip56MockHolding)
              pure [d]
          facDisc <- case mgr.factory of
            BurnMintFactoryCid cid -> fromSome <$> queryDisclosure gg (coerceContractId cid : ContractId MockBurnMintFactory)
            TransferFactoryCid cid -> fromSome <$> queryDisclosure gg (coerceContractId cid : ContractId MockPreapprovedTransferFactory)
          pres <- query @MockTransferPreapproval gg
          preCid <- case
            [ cid | (cid, p) <- pres, p.owner == input.recipient, p.instrument == mgr.instrumentId ] of
            [cid] -> pure cid
            [] -> abort "playground: recipient has no standing transfer pre-approval -- run `preapprove` first"
            _ -> abort "playground: more than one MockTransferPreapproval for the recipient"
          preDisc <- fromSome <$> queryDisclosure gg preCid

          let extraArgs = ExtraArgs with
                context = ChoiceContext with
                  values = TextMap.fromList
                    [(mockTransferPreapprovalContextKey, AV_ContractId (coerceContractId preCid))]
                meta = emptyMetadata
              discs = [mgrDisc, csDisc, nodeDisc, ledgerDisc, facDisc, preDisc] ++ potDiscs

          (_, ntt) <- submit (foldl (\opts d -> opts <> disclose d) (actAs input.executor) discs) do
            exerciseCmd mgrCid Release with
              executor = input.executor
              coreStateCid = csCid
              replayNodeCid = nodeCid
              vaaBytes = input.vaaBytes
              pubKeys = input.pubKeys
              recipient = input.recipient
              ledgerCid
              inputHoldingCids = []
              extraArgs
          pure ReceiveVaaOutput with
            recipientChain = ntt.recipientChain
            amount = ntt.amount
            decimals = ntt.decimals

----------------------------------------------------------------------
-- preapprove / revoke
----------------------------------------------------------------------

data PreapproveInput = PreapproveInput with
    admin              : Party  -- the deployment's admin (resolves its committed factory context)
    guardianGovernance : Party  -- the registry admin (gg): observer/co-signatory of the created pre-approval
    tokenKind          : Text   -- "mock" | "amulet"
    mode               : Text   -- "burn-mint" | "lock-unlock" -- selects the template for "mock"
    user               : Party  -- the recipient opting in
  deriving (Eq, Show)

data PreapproveOutput = PreapproveOutput with
    -- False when the kind needs no local pre-approval concept ("amulet": real Amulet's own
    -- TransferPreapproval is out of this script's scope).
    preapproved : Bool
  deriving (Eq, Show)

-- | @user@ opts in to receive inbound deliveries: for "mock" burn-mint, a self-signed
-- 'Wormhole.Ntt.Deposit.DepositPreapproval' create; for "mock" lock-unlock, a self-signed
-- 'Playground.MockRegistry.MockTransferPreapproval' create. No cid is persisted -- the
-- pre-approval is resolved fresh at receive/fund time. Idempotent: 'transfer' (Go CLI) calls
-- this to ENSURE a standing pre-approval exists before every mock-kind send, so a second call
-- for the same (user, instrument) must be a no-op rather than a duplicate create -- otherwise
-- 'fundUser'/'receiveVaa's single-contract lookups would start aborting with "more than one
-- DepositPreapproval/MockTransferPreapproval" the moment a user transfers or is preapproved
-- twice.
preapprove : PreapproveInput -> Script PreapproveOutput
preapprove input =
  case parseTokenKind input.tokenKind of
    -- Real Amulet's own TransferPreapproval is out of this script's scope.
    Amulet -> pure PreapproveOutput with preapproved = False
    Mock -> do
      let gg = input.guardianGovernance
          -- Fixed nonce 0 -- see fundUser's note; this playground phase supports one
          -- bridged instrument per admin.
          instrumentId = InstrumentId with admin = gg, id = nttInstrumentIdFor input.admin 0
      case parseTokenMode input.mode of
        BurnMint -> do
          pres <- query @DepositPreapproval input.user
          case [ () | (_, p) <- pres, p.instrumentId == instrumentId ] of
            [] -> do
              _ <- submit input.user do
                createCmd DepositPreapproval with owner = input.user, instrumentId
              pure ()
            _ -> pure () -- already preapproved for this instrument -- no-op
        LockUnlock -> do
          pres <- query @MockTransferPreapproval input.user
          case [ () | (_, p) <- pres, p.instrument == instrumentId ] of
            [] -> do
              _ <- submit input.user do
                createCmd MockTransferPreapproval with
                  owner = input.user
                  registryAdmin = gg
                  instrument = instrumentId
              pure ()
            _ -> pure () -- already preapproved for this instrument -- no-op
      pure PreapproveOutput with preapproved = True

data RevokeInput = RevokeInput with
    guardianGovernance : Party  -- the pre-approval's registry-admin co-signatory/observer (gg), resolves it
    tokenKind          : Text   -- "mock" | "amulet"
    mode               : Text   -- "burn-mint" | "lock-unlock"
    user               : Party  -- the owner tearing down its consent
  deriving (Eq, Show)

data RevokeOutput = RevokeOutput with
    revoked : Bool
  deriving (Eq, Show)

-- | @user@ (owner) tears down its standing pre-approval (either template, selected the same
-- way as 'preapprove') via the owner-only @Revoke@ choice. Aborts cleanly if none exists.
revoke : RevokeInput -> Script RevokeOutput
revoke input =
  case parseTokenKind input.tokenKind of
    Amulet -> pure RevokeOutput with revoked = False
    Mock -> do
      case parseTokenMode input.mode of
        BurnMint -> do
          pres <- query @DepositPreapproval input.user
          case pres of
            [(cid, _)] -> do
              _ <- submit input.user do exerciseCmd cid Deposit.Revoke
              pure ()
            [] -> abort "playground: no DepositPreapproval to revoke"
            _ -> abort "playground: more than one DepositPreapproval visible to user"
        LockUnlock -> do
          pres <- query @MockTransferPreapproval input.user
          case pres of
            [(cid, _)] -> do
              _ <- submit input.user do exerciseCmd cid MockRegistry.Revoke
              pure ()
            [] -> abort "playground: no MockTransferPreapproval to revoke"
            _ -> abort "playground: more than one MockTransferPreapproval visible to user"
      pure RevokeOutput with revoked = True
