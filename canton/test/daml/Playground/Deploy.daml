-- | Parameterized deployment, split in two steps per the new 'Wormhole.Ntt.Governance'
-- model:
--
--   1. 'deployRegistry' (gg-submitted): stand up this deployment's mock registry factory
--      contract(s) -- nothing for "amulet" (the real Splice registry's factory already
--      exists).
--   2. 'deployNtt' (admin-submitted): resolve the core registries and the committed
--      factory, then a single registration call that atomically mints the deployment's
--      gg-owned transceiver 'Emitter', claims its gg-scoped replay-trie root, and creates the
--      'NttManager' (plus, for lock/unlock, its zero-balance 'LockedLedger'). No more separate
--      `registerEmitter`/`registerReplayRoot` steps.
--
--      "mock" lock/unlock and "amulet" use 'Wormhole.Ntt.Governance.RegisterManager' directly
--      (admin-only controller there). "mock" burn/mint uses
--      'Wormhole.Ntt.Governance.RegisterManagerByVaa' instead: plain 'RegisterManager' makes
--      gg (the mock instrument's admin) a co-controller for burn/mint, and gg lives on its own
--      participant in a real topology -- one submit cannot carry both admin's and gg's
--      authority across participants. 'RegisterManagerByVaa' is admin-only and instead takes a
--      guardian-signed 'Wormhole.Ntt.Payload.RegisterBurnMintManager' VAA, so gg never signs
--      live (see that module's doc comment). Its 'requireCanonicalFactory' guard also only
--      ever accepts the genuine 'Token.CIP0056.CoinFactory.CoinFactory' template (a VAA
--      cannot name a contract id, so it cannot vet an arbitrary factory) -- "mock" burn/mint's
--      committed factory is that canonical template, not a look-alike mock.
module Playground.Deploy where

import Daml.Script
import DA.Optional (fromSome, fromSomeNote)

import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Core.State (EmitterRegistry, ReplayRootRegistry)
import Token.CIP0056.CoinFactory (CoinFactory (..))
import Wormhole.Ntt.Governance (RegisterManager (..), RegisterManagerByVaa (..))
import Wormhole.Ntt.Manager (NttFactory (..), NttTokenConfig (..), nttInstrumentIdFor)

import Playground.Disclose (RemoteSeam (..), toDisclosureByName, mkSeedDisclosure)
import Playground.MockRegistry (MockPreapprovedTransferFactory (..), MockTransferPreapproval (..))
import Playground.Types
import Test.TestNtt (cantonChainId)

----------------------------------------------------------------------
-- deployRegistry (gg-submitted)
----------------------------------------------------------------------

data DeployRegistryInput = DeployRegistryInput with
    guardianGovernance : Party
    admin              : Party  -- the deployment's registering admin (burn/mint instrument binding target)
    mode               : Text   -- "burn-mint" | "lock-unlock"
    tokenKind          : Text   -- "mock" | "amulet"
    instrumentNonce    : Int    -- the nonce in the burn/mint instrument-id binding
  deriving (Eq, Show)

data DeployRegistryOutput = DeployRegistryOutput with
    -- False for "amulet": the real Splice registry's factory already exists, so there is
    -- nothing for this deployment to stand up.
    registered : Bool
    -- The deployment's own committed factory cid this same script just created (mock only;
    -- 'None' for "amulet"), untyped ('coerceContractId'-only, like
    -- 'Playground.Amulet.AmuletSeam.factoryCid'/'DeployInput.amuletFactoryCid') -- handed back
    -- to the Go CLI and threaded into 'deployNtt' below via 'DeployInput.factoryCid'. This is
    -- deliberately NOT re-resolved via a fresh 'query' inside 'deployNtt': gg (this factory's
    -- sole signatory) lives on its own participant in the multi-participant topology, which
    -- 'deployNtt''s admin-hosted participant cannot query as gg from -- the exact same
    -- cross-participant gap 'Playground.MockRegistry' closes for RECEIVER visibility, but here
    -- for the CLI's OWN two-step call sequence instead.
    factoryCid : Optional (ContractId ())
  deriving (Eq, Show)

-- | Stand up this deployment's mock registry factory contract(s), gg-submitted (per plan
-- §4.2/§5): for "mock" burn-mint, the canonical 'Token.CIP0056.CoinFactory.CoinFactory' --
-- the only factory 'Wormhole.Ntt.Governance.RegisterManagerByVaa' may ever commit (see this
-- module's header); for "mock" lock-unlock, a
-- 'Playground.MockRegistry.MockPreapprovedTransferFactory' PLUS the same 'CoinFactory' (the
-- funding faucet 'Playground.Ops.fundUser' mints from, per the deposit-preapproval-based
-- funding design -- 'CoinFactory' is instrument-agnostic, gated only on
-- @guardianGovernance@, so any instance serves any instrument gg administers); no-op
-- ("amulet") for the real registry.
deployRegistry : DeployRegistryInput -> Script DeployRegistryOutput
deployRegistry input =
  case parseTokenKind input.tokenKind of
    -- The real Splice registry's factory already exists; nothing to stand up.
    Amulet -> pure DeployRegistryOutput with registered = False, factoryCid = None
    Mock -> do
      let gg = input.guardianGovernance
      -- The canonical burn/mint factory: the deployment's own committed factory for
      -- "burn-mint", or the funding faucet 'Playground.Ops.fundUser' mints from for
      -- "lock-unlock".
      bmCid <- submit gg do createCmd CoinFactory with admin = gg
      committedCid <- case parseTokenMode input.mode of
        BurnMint -> pure (coerceContractId bmCid)
        LockUnlock -> do
          tfCid <- submit gg do createCmd MockPreapprovedTransferFactory with admin = gg
          pure (coerceContractId tfCid)
      pure DeployRegistryOutput with registered = True, factoryCid = Some committedCid

----------------------------------------------------------------------
-- deployNtt (admin-submitted)
----------------------------------------------------------------------

data DeployInput = DeployInput with
    operator           : Party
    guardianGovernance : Party
    admin              : Party  -- CLI-allocated (with actAs rights granted; see Playground.Init's note)
    mode               : Text   -- "burn-mint" | "lock-unlock"
    tokenKind          : Text   -- "mock" | "amulet"
    tokenDecimals      : Int
    instrumentNonce    : Int    -- the nonce in the burn/mint instrument-id binding (matches deployRegistry's)
    -- "amulet" only: the real DSO party (InstrumentId.admin for "Amulet"). 'None' for every
    -- other kind -- the Go CLI always sends the field, null when unused.
    instrumentAdmin    : Optional Party
    -- "amulet" only: the real Amulet registry's CLI-resolved transfer-factory cid
    -- (internal/amulet.GetTransferFactory's FactoryID, resolved by setupAmuletAdmin against
    -- the now-onboarded admin's own standing TransferPreapproval). 'None' for every other
    -- kind -- the Go CLI always sends the field, null when unused. Untyped here (a raw
    -- registry cid, like Playground.Amulet.AmuletSeam.factoryCid); 'coerceContractId' gives
    -- it the 'TIV1.TransferFactory' type 'RegisterManager' wants.
    amuletFactoryCid   : Optional (ContractId ())
    -- "mock" only: the deployment's committed factory cid, as returned by THIS SAME CLI
    -- invocation's earlier 'deployRegistry' call ('DeployRegistryOutput.factoryCid') -- 'None'
    -- for "amulet" (uses amuletFactoryCid instead). Threaded through Go rather than re-resolved
    -- via a fresh 'query @CoinFactory gg'/'query @MockPreapprovedTransferFactory gg'
    -- here: gg (the factory's sole signatory) lives on its own participant in the
    -- multi-participant topology, which this admin-hosted script cannot query as gg from (see
    -- 'DeployRegistryOutput.factoryCid''s doc comment).
    factoryCid         : Optional (ContractId ())
    -- "mock" burn-mint only: the guardian-signed 'Wormhole.Ntt.Payload.RegisterBurnMintManager'
    -- VAA authorizing 'Wormhole.Ntt.Governance.RegisterManagerByVaa' (see this module's header
    -- for why burn/mint alone needs this). 'None'/empty for every other (mode, tokenKind) pair.
    vaaBytes           : Optional Text
    pubKeys            : [(Int, Text)]
    -- "mock" burn-mint only: a pre-fetched 'Playground.Prepare:prepareDeployNtt' RemoteSeam
    -- disclosing the committed 'Token.CIP0056.CoinFactory:CoinFactory' to @admin@ --
    -- 'RegisterManagerByVaa' (unlike plain 'RegisterManager') fetches this factory via
    -- 'requireCanonicalFactory', and gg is its sole signatory, so admin needs it explicitly
    -- disclosed. 'None' on a single-participant profile (sandbox), where 'deployNtt' resolves
    -- the disclosure locally as gg instead, or for every other (mode, tokenKind) pair.
    remote             : Optional RemoteSeam
  deriving (Eq, Show)

data DeployOutput = DeployOutput with
    managerId          : Int
    managerAddress     : Text
    transceiverAddress : Text
    admin              : Party
    instrumentAdmin    : Party  -- gg for "mock"; the real DSO for "amulet"
    instrumentId        : Text
  deriving (Eq, Show)

-- | Resolve the core registries (EmitterRegistry, ReplayRootRegistry), the deployment's
-- typed committed factory (from the CLI-resolved 'DeployInput.factoryCid'/'amuletFactoryCid',
-- per kind -- see those fields' doc comments for why this is never a fresh gg-side query), and
-- this deployment's bound instrument id, then a single
-- 'Wormhole.Ntt.Governance.RegisterManager' call (fee-0 devnet: every fee arg 'None').
-- Lock-unlock "mock" additionally self-creates the admin's own
-- 'Playground.MockRegistry.MockTransferPreapproval' in this same script -- the admin is the
-- lock's custodian/receiver (Manager.daml's admin-owned custody), so this is what makes "lock
-- by any user works with admin-owned custody, no promotion needed" (plan §4.2).
deployNtt : DeployInput -> Script DeployOutput
deployNtt input =
  case parseTokenKind input.tokenKind of
    -- The admin is already onboarded as a Splice wallet user with its own standing
    -- TransferPreapproval by the time this runs (Go's setupAmuletAdmin, plan §4.3's spike --
    -- verified live against a real LocalNet validator, not just type-checked). The CLI
    -- resolves the registry's current transfer-factory cid the same way (plan §4.4);
    -- 'RegisterManager' only ever stores 'factory' as a field, never fetches/exercises it, so
    -- no disclosure is needed here (contrast 'Playground.Ops:transferOut', which does fetch
    -- it at transfer time).
    Amulet -> do
      let dso = fromSomeNote
            "playground: amulet deployNtt requires instrumentAdmin (the real DSO party)"
            input.instrumentAdmin
          config = parseTokenMode input.mode
          instrumentId = InstrumentId with admin = dso, id = "Amulet"

      govCid <- resolveGovernance input.operator
      govDisc <- fromSome <$> queryDisclosure input.operator govCid
      [(emReg, _)] <- query @EmitterRegistry input.operator
      emRegDisc <- fromSome <$> queryDisclosure input.operator emReg
      [(rrReg, _)] <- query @ReplayRootRegistry input.operator
      rrRegDisc <- fromSome <$> queryDisclosure input.operator rrReg

      factory <- case input.amuletFactoryCid of
        None -> abort "playground: amulet deployNtt needs a CLI-resolved transfer-factory cid -- run setupAmuletAdmin first"
        Some cid -> pure (TransferFactoryCid (coerceContractId cid))

      -- RegisterManager bundles the TransceiverInit broadcast, so CoreState is mandatory
      -- (it funds the publish) and needs disclosing to admin's submit.
      csCid <- resolveCoreState input.operator
      csDisc <- fromSome <$> queryDisclosure input.operator csCid

      (_, mgrCid, emitterCid, _ledgerCid, _msg) <-
        submit (actAs input.admin <> disclose govDisc <> disclose emRegDisc <> disclose rrRegDisc <> disclose csDisc) do
          exerciseCmd govCid RegisterManager with
            admin = input.admin
            chainId = cantonChainId
            emitterRegistryCid = emReg
            replayRootRegistryCid = rrReg
            instrumentId
            instrumentNonce = input.instrumentNonce
            tokenConfig = config
            tokenDecimals = input.tokenDecimals
            factory
            coreStateCid = csCid
            consistencyLevel = 0
            emitterFeeAllocation = None
            claimFeeAllocation = None
            feeAllocation = None

      Some mgr <- queryContractId input.operator mgrCid
      -- Re-resolve the transceiver by id: the bundled TransceiverInit publish is a consuming
      -- PublishMessage, so the emitterCid RegisterManager returned is already archived.
      (_, em) <- resolveEmitter input.operator mgr.transceiverEmitterId
      pure DeployOutput with
        managerId = mgr.managerId
        managerAddress = mgr.managerAddress
        transceiverAddress = em.emitterAddress
        admin = input.admin
        instrumentAdmin = dso
        instrumentId = instrumentId.id
    Mock -> do
      let gg = input.guardianGovernance
          config = parseTokenMode input.mode
          instrumentId = InstrumentId with
            admin = gg
            id = nttInstrumentIdFor input.admin input.instrumentNonce

      govCid <- resolveGovernance input.operator
      govDisc <- fromSome <$> queryDisclosure input.operator govCid
      [(emReg, _)] <- query @EmitterRegistry input.operator
      emRegDisc <- fromSome <$> queryDisclosure input.operator emReg
      [(rrReg, _)] <- query @ReplayRootRegistry input.operator
      rrRegDisc <- fromSome <$> queryDisclosure input.operator rrReg

      let factoryCid = fromSomeNote
            "playground: mock deployNtt needs a CLI-resolved factory cid -- run deployRegistry first"
            input.factoryCid
          factory = case config of
            BurnMint -> BurnMintFactoryCid (coerceContractId factoryCid)
            LockUnlock -> TransferFactoryCid (coerceContractId factoryCid)

      (_, mgrCid, emitterCid, _ledgerCid, _msg) <- case config of
        -- Guardian-VAA-gated: co-signed by the guardian quorum's off-chain signature instead
        -- of a live gg signature -- see this module's header. CoreState/its disclosure are
        -- needed here because RegisterManagerByVaa's VAA verification is mandatory
        -- regardless of fees (and CoreState now also funds the TransceiverInit broadcast).
        BurnMint -> do
          csCid <- resolveCoreState input.operator
          csDisc <- fromSome <$> queryDisclosure input.operator csCid
          let vaaBytes = fromSomeNote
                "playground: mock burn-mint deployNtt needs a guardian-signed registration VAA"
                input.vaaBytes
          -- The committed CoinFactory: gg's sole signatory, and requireCanonicalFactory
          -- fetches it, so admin's submit needs it disclosed on EVERY profile -- visibility
          -- is party-scoped, not participant-scoped, so co-location with gg does not help.
          -- Single-participant profiles resolve the disclosure locally as gg (the same
          -- fast path as Ops.daml's None branches); multi-participant profiles attach the
          -- prepareDeployNtt seam (see DeployInput.remote's doc comment).
          facDiscs <- case input.remote of
            None -> do
              d <- fromSome <$> queryDisclosure input.guardianGovernance
                (coerceContractId factoryCid : ContractId CoinFactory)
              pure [d]
            Some seam -> do
              seed <- mkSeedDisclosure input.admin
              pure (map (toDisclosureByName seed) seam.disclosed)
          let submitOpts = foldl (\opts d -> opts <> disclose d)
                (actAs input.admin <> disclose govDisc <> disclose emRegDisc <> disclose rrRegDisc <> disclose csDisc)
                facDiscs
          -- trySubmit, not a bare submit: a bare submit's MustSucceed failure is a hard,
          -- uncatchable script stop (handled out-of-band, never a Daml exception), so no
          -- caller could ever observe it gracefully. Converting a Left into 'abort' below
          -- raises a genuine Daml exception instead, catchable via 'tryFailureStatus' --
          -- exactly what 'Test.TestPlayground.testPlaygroundDeployMockBurnMint' needs to
          -- pin this wiring without a live guardian signature (its VAA can never match, see
          -- this module's header). The real CLI path is unaffected: a genuinely
          -- guardian-signed VAA still succeeds identically.
          res <- trySubmit submitOpts do
            exerciseCmd govCid RegisterManagerByVaa with
              admin = input.admin
              emitterRegistryCid = emReg
              replayRootRegistryCid = rrReg
              instrumentNonce = input.instrumentNonce
              factory
              coreStateCid = csCid
              consistencyLevel = 0
              emitterFeeAllocation = None
              claimFeeAllocation = None
              feeAllocation = None
              vaaBytes
              pubKeys = input.pubKeys
              extraArgs = emptyExtraArgs
          case res of
            Right r -> pure r
            Left err -> abort (show err)
        LockUnlock -> do
          -- CoreState is mandatory here too now: RegisterManager bundles the
          -- TransceiverInit broadcast, which CoreState funds.
          csCid <- resolveCoreState input.operator
          csDisc <- fromSome <$> queryDisclosure input.operator csCid
          submit (actAs input.admin <> disclose govDisc <> disclose emRegDisc <> disclose rrRegDisc <> disclose csDisc) do
            exerciseCmd govCid RegisterManager with
              admin = input.admin
              chainId = cantonChainId
              emitterRegistryCid = emReg
              replayRootRegistryCid = rrReg
              instrumentId
              instrumentNonce = input.instrumentNonce
              tokenConfig = config
              tokenDecimals = input.tokenDecimals
              factory
              coreStateCid = csCid
              consistencyLevel = 0
              emitterFeeAllocation = None
              claimFeeAllocation = None
              feeAllocation = None

      -- Lock/unlock: the admin is the lock's custodian/receiver (Manager.daml's admin-owned
      -- custody), so it self-creates its own standing preapproval here -- this is what makes
      -- "lock by any user works with admin-owned custody, no promotion needed" (plan §4.2).
      case config of
        LockUnlock -> do
          _ <- submit input.admin do
            createCmd MockTransferPreapproval with
              owner = input.admin
              registryAdmin = gg
              instrument = instrumentId
          pure ()
        BurnMint -> pure ()

      Some mgr <- queryContractId input.operator mgrCid
      -- Re-resolve the transceiver by id: the bundled TransceiverInit publish is a consuming
      -- PublishMessage, so the emitterCid RegisterManager returned is already archived.
      (_, em) <- resolveEmitter input.operator mgr.transceiverEmitterId
      pure DeployOutput with
        managerId = mgr.managerId
        managerAddress = mgr.managerAddress
        transceiverAddress = em.emitterAddress
        admin = input.admin
        instrumentAdmin = gg
        instrumentId = instrumentId.id
