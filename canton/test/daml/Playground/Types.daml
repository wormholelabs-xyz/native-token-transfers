-- | JSON-serializable input/output records for the playground CLI's `dpm script`
-- entrypoints (Playground.Init/Deploy/Ops/Query), plus the shared by-identity resolvers
-- every op script uses instead of persisting contract ids (see the CLI README's cid-churn
-- rule: CoreState, NttManager, Emitter, LockedLedger, and NttGovernance all churn on every
-- consuming exercise, so every script re-resolves them from the ACS by stable identity --
-- party + managerId/emitterId/managerAddress -- rather than trusting a cid the CLI cached
-- from a previous invocation).
--
-- Enums travel as plain 'Text' (not Daml variants) so the JSON the CLI parses/emits stays a
-- boring, flat shape; 'parseTokenMode'/'showTokenMode' and 'parseTokenKind'/'showTokenKind'
-- are the only places that convert to/from the real Daml types.
module Playground.Types where

import Daml.Script
import DA.Map qualified as Map
import Wormhole.Core.Bytes (Bytes32)
import Wormhole.Core.State (CoreState, Emitter)
import Wormhole.Ntt.Governance (NttGovernance)
import Wormhole.Ntt.Ledger (LockedLedger)
import Wormhole.Ntt.Manager (NttManager, NttTokenConfig (..))

----------------------------------------------------------------------
-- Text enums
----------------------------------------------------------------------

parseTokenMode : Text -> NttTokenConfig
parseTokenMode "burn-mint" = BurnMint
parseTokenMode "lock-unlock" = LockUnlock
parseTokenMode other = error ("playground: unknown mode " <> other <> " (want burn-mint|lock-unlock)")

showTokenMode : NttTokenConfig -> Text
showTokenMode BurnMint = "burn-mint"
showTokenMode LockUnlock = "lock-unlock"

-- | Which registry backs a deployment's committed factory: a local playground mock
-- ('Playground.MockRegistry', both burn/mint and lock/unlock), or the real Canton Coin
-- (Amulet) registry on Splice LocalNet. Collapsed from the pre-CIP-56-rework model's four
-- kinds ("mock-admin-signed" | "cip56-burn-mint-mock" | "cip56-custody-mock" |
-- "cip56-custody") now that 'Playground.MockToken' (the admin-signed double with no
-- recipient consent) is gone and the mock registry's receiver-preapproval design (see
-- 'Playground.MockRegistry') gives both mock modes real recipient-consent semantics
-- identical to Amulet's.
data TokenKind
  = Mock
  | Amulet
  deriving (Eq, Show)

parseTokenKind : Text -> TokenKind
parseTokenKind "mock" = Mock
parseTokenKind "amulet" = Amulet
parseTokenKind other = error ("playground: unknown tokenKind " <> other <> " (want mock|amulet)")

showTokenKind : TokenKind -> Text
showTokenKind Mock = "mock"
showTokenKind Amulet = "amulet"

----------------------------------------------------------------------
-- By-identity resolvers (never persist contract ids across CLI invocations)
----------------------------------------------------------------------

-- | The single live 'CoreState', as seen by @operator@ (a co-signatory of every genesis
-- CoreState this playground creates). Fails loudly if `initPlayground` was never run, or ran
-- more than once against the same participant without a network reset.
resolveCoreState : Party -> Script (ContractId CoreState)
resolveCoreState operator = do
  css <- query @CoreState operator
  case css of
    [(cid, _)] -> pure cid
    [] -> abort "playground: no CoreState -- run `init` first"
    _ -> abort "playground: more than one CoreState visible to operator -- reset the network"

-- | The single live 'NttGovernance' root, as seen by @operator@ (a co-signatory).
resolveGovernance : Party -> Script (ContractId NttGovernance)
resolveGovernance operator = do
  govs <- query @NttGovernance operator
  case govs of
    [(cid, _)] -> pure cid
    [] -> abort "playground: no NttGovernance -- run `init` first"
    _ -> abort "playground: more than one NttGovernance visible to operator -- reset the network"

-- | The 'NttManager' allocated at @managerId@ (Deploy's `RegisterManager` output), resolved
-- fresh from @operator@'s ACS view (operator co-signs every deployment).
resolveManager : Party -> Int -> Script (ContractId NttManager, NttManager)
resolveManager operator managerId = do
  mgrs <- query @NttManager operator
  case [ (cid, m) | (cid, m) <- mgrs, m.managerId == managerId ] of
    [one] -> pure one
    [] -> abort ("playground: no NttManager with id " <> show managerId)
    _ -> abort ("playground: more than one NttManager with id " <> show managerId)

-- | The transceiver 'Emitter' for a deployment's @transceiverEmitterId@, resolved from
-- @operator@'s ACS view ('Wormhole.Core.State.Emitter' is co-signed by the registry operator).
resolveEmitter : Party -> Int -> Script (ContractId Emitter, Emitter)
resolveEmitter operator emitterId = do
  ems <- query @Emitter operator
  case [ (cid, e) | (cid, e) <- ems, e.emitterId == emitterId ] of
    [one] -> pure one
    [] -> abort ("playground: no Emitter with id " <> show emitterId)
    _ -> abort ("playground: more than one Emitter with id " <> show emitterId)

-- | A lock/unlock deployment's 'LockedLedger', resolved from @operator@'s ACS view (a
-- signatory) by its owning @managerAddress@ -- the ledger's stable identity across
-- 'TransferAdmin' handoffs (see 'Wormhole.Ntt.Ledger').
resolveLedger : Party -> Bytes32 -> Script (ContractId LockedLedger, LockedLedger)
resolveLedger operator managerAddress = do
  ledgers <- query @LockedLedger operator
  case [ (cid, l) | (cid, l) <- ledgers, l.managerAddress == managerAddress ] of
    [one] -> pure one
    [] -> abort ("playground: no LockedLedger for manager address " <> show managerAddress)
    _ -> abort ("playground: more than one LockedLedger for manager address " <> show managerAddress)

-- | All deployments' managers currently visible to @operator@ -- used by `queryStatus` to
-- enumerate every deployment without the caller needing to know ids up front.
allManagers : Party -> Script [(ContractId NttManager, NttManager)]
allManagers operator = query @NttManager operator

-- | A deployment's peer, flattened to a plain record (not a tuple) so the JSON the CLI reads
-- stays boring -- see the module-level note on Text enums/flat records.
data PeerStatus = PeerStatus with
    chain              : Int
    managerAddress     : Text
    transceiverAddress : Text
  deriving (Eq, Show)

peersList : NttManager -> [PeerStatus]
peersList mgr =
  [ PeerStatus with chain, managerAddress = p.managerAddress, transceiverAddress = p.transceiverAddress
  | (chain, p) <- Map.toList mgr.peers ]
