{-# LANGUAGE AllowAmbiguousTypes #-}
-- | Helpers for a real Canton Coin (Amulet) transfer held in custody under CIP-56. The Go
-- CLI resolves three values off-ledger from the token registry and passes them in: the
-- transfer factory contract id (the registry contract that moves tokens), its choice
-- context, and the contracts that must be disclosed alongside it. This module turns those
-- into the 'Disclosure' values 'Playground.Ops:transferOut' submits to lock Amulet through
-- the deployment's committed 'Wormhole.Ntt.Manager.NttFactory' (a
-- 'Splice.Api.Token.TransferInstructionV1.TransferFactory' for an "amulet" lock/unlock
-- deployment).
--
-- It imports 'splice-amulet' (see canton/dars/README.md) only to name the concrete template
-- types 'toDisclosure' needs a 'templateTypeRep' for; it never creates or exercises
-- anything. All submission goes through 'Playground.Ops:transferOut'.
module Playground.Amulet where

import DA.Text (isSuffixOf)
import Daml.Script
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId (..))
import Splice.Api.Token.MetadataV1 (ChoiceContext)
import Splice.AmuletRules qualified as AmuletRules
import Splice.Round qualified as Round
import Splice.ExternalPartyAmuletRules qualified as ExternalPartyAmuletRules
import Splice.ExternalPartyConfigState qualified as ExternalPartyConfigState

import Playground.Disclose (DisclosedContractIn)

-- 'DisclosedContractIn' (one registry-format disclosed contract, as Go's
-- internal/amulet.DisclosedContract sends it -- minus @synchronizerId@, which
-- 'Daml.Script.Disclosure' has no field for) now lives in 'Playground.Disclose', which both
-- this Amulet-specific seam and the general playground-template seam share.

-- | Everything 'Playground.Ops:transferOut''s "amulet" branch needs, resolved off-ledger by
-- Go (internal/amulet.GetTransferFactory) and passed through verbatim.
data AmuletSeam = AmuletSeam with
    factoryCid    : ContractId () -- the registry's transfer-factory cid (factoryId)
    choiceContext : ChoiceContext -- decoded Daml-JSON of the registry's choiceContextData.
                                  -- Splice.Api.Token.MetadataV1.ChoiceContext is a plain
                                  -- {values : TextMap AnyValue} record; AnyValue's variant
                                  -- tags Daml-JSON-encode exactly as captured from the live
                                  -- registry (e.g. {"tag": "AV_ContractId", "value": "<cid>"}).
    disclosed     : [DisclosedContractIn]
  deriving (Eq, Show)

-- | Map a registry @templateId@'s "<Module>:<Entity>" suffix to the vendored splice-amulet
-- type's 'templateTypeRep', producing a 'Disclosure' for @d@ by record-updating @seed@ (an
-- already-obtained 'Disclosure' from 'queryDisclosure'). 'Daml.Script' exports the
-- 'Disclosure' type but not its constructor, so record-updating a seed is the only way to
-- build one without an extra import. Aborts loudly on any unmapped templateId, so a live
-- registry response naming a contract this table does not cover fails fast instead of
-- silently dropping a disclosure the on-ledger call needs.
toDisclosure : Disclosure -> DisclosedContractIn -> Disclosure
toDisclosure seed d
  | "Splice.AmuletRules:AmuletRules" `isSuffixOf` d.templateId =
      mkDisclosure @AmuletRules.AmuletRules
  | "Splice.AmuletRules:TransferPreapproval" `isSuffixOf` d.templateId =
      mkDisclosure @AmuletRules.TransferPreapproval
  | "Splice.Round:OpenMiningRound" `isSuffixOf` d.templateId =
      mkDisclosure @Round.OpenMiningRound
  | "Splice.ExternalPartyAmuletRules:ExternalPartyAmuletRules" `isSuffixOf` d.templateId =
      mkDisclosure @ExternalPartyAmuletRules.ExternalPartyAmuletRules
  | "Splice.ExternalPartyConfigState:ExternalPartyConfigState" `isSuffixOf` d.templateId =
      mkDisclosure @ExternalPartyConfigState.ExternalPartyConfigState
  | otherwise =
      error ("playground: unmapped Amulet disclosed-contract templateId " <> d.templateId)
  where
    mkDisclosure : forall t. HasTemplateTypeRep t => Disclosure
    mkDisclosure =
      seed with
        templateId = templateTypeRep @t
        contractId = coerceContractId d.contractId
        blob = d.blob

-- | Unlocked real Amulet holdings owned by @owner@ under @dso@'s "Amulet" instrument, read
-- directly off the token-standard 'Holding' interface rather than over HTTP. Mirrors
-- 'Playground.Query:amuletBalance''s filter (unlocked, exact instrument, exact owner) but
-- returns cids rather than a sum, for use as @inputHoldingCids@.
amuletHoldings : Party -> Party -> Script [ContractId Holding]
amuletHoldings owner dso = do
  let instrument = InstrumentId with admin = dso, id = "Amulet"
  holdings <- queryInterface @Holding owner
  pure
    [ cid
    | (cid, Some v) <- holdings
    , v.instrumentId == instrument
    , v.lock == None
    , v.owner == owner
    ]
