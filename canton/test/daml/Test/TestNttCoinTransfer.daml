-- | Tests for the 'TransferFactory' v1 'NttCoin' transfer paths (CIP-0056),
-- independent of the burn/mint bridge flow.
module Test.TestNttCoinTransfer where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.TextMap qualified as TextMap
import DA.Time (hours, addRelTime)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.MetadataV1 (AnyValue(..), ChoiceContext(..), ExtraArgs(..), emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinTransfer
import Wormhole.Ntt.CoinFactory
import Test.TestNtt (nttCoinFactorySetup, expectAbort)
import Test.TestNttCoin (mintCoin)

asTransferFactoryV1 : ContractId NttCoinFactory -> ContractId TIV1.TransferFactory
asTransferFactoryV1 = toInterfaceContractId @TIV1.TransferFactory

-- | Build a v1 'TIV1.Transfer' with a 24h execution window from @requestedAt@.
mkTransferV1 : Time -> Party -> Party -> Decimal -> InstrumentId -> [ContractId Holding] -> TIV1.Transfer
mkTransferV1 requestedAt sender receiver amount instrumentId inputHoldingCids =
  TIV1.Transfer with
    sender, receiver, amount, instrumentId, requestedAt
    executeBefore = requestedAt `addRelTime` hours 24
    inputHoldingCids
    meta = emptyMetadata

extraArgsWithPreapproval : ContractId TransferPreapproval -> ExtraArgs
extraArgsWithPreapproval cid = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList [(transferPreapprovalContextKey, AV_ContractId (coerceContractId cid))]
  meta = emptyMetadata

-- | 'NttCoinFactory' is @signatory guardianGovernance@ alone; disclose it so
-- a non-gg submitter has visibility to exercise a choice on it.
discloseFactory : Party -> ContractId NttCoinFactory -> Script Disclosure
discloseFactory gg factoryCid = fromSome <$> queryDisclosure gg factoryCid

----------------------------------------------------------------------
-- Transfer v1 -- self-send, preapproval, pending/accept/reject/withdraw
----------------------------------------------------------------------

testNttCoinTransferSelfSendV1 : Script ()
testNttCoinTransferSelfSendV1 = do
  gg <- allocateParty "TransferSelfV1Gg"
  alice <- allocateParty "TransferSelfV1Alice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SELF-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice alice 0.004 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.amount === 0.004
    other -> abort ("expected Completed with one receiver coin, got: " <> show other)
  case res.senderChangeCids of
    [changeCid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      c.amount === 0.006
    other -> abort ("expected one change coin, got: " <> show other)

testNttCoinTransferWithPreapprovalCompletesSynchronouslyV1 : Script ()
testNttCoinTransferWithPreapprovalCompletesSynchronouslyV1 = do
  gg <- allocateParty "TransferPreapprovedV1Gg"
  alice <- allocateParty "TransferPreapprovedV1Alice"
  bob <- allocateParty "TransferPreapprovedV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-PREAPPROVED-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  preCid <- submit bob do createCmd TransferPreapproval with owner = bob, instrumentId
  factoryDisc <- discloseFactory gg factoryCid
  preDisc <- fromSome <$> queryDisclosure bob preCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc <> disclose preDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = extraArgsWithPreapproval preCid
  case res.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  case res.senderChangeCids of
    [changeCid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      c.owner === alice
      c.amount === 0.004
    other -> abort ("expected one sender change coin, got: " <> show other)

testNttCoinTransferWithoutPreapprovalIsPendingV1 : Script ()
testNttCoinTransferWithoutPreapprovalIsPendingV1 = do
  gg <- allocateParty "TransferPendingV1Gg"
  alice <- allocateParty "TransferPendingV1Alice"
  bob <- allocateParty "TransferPendingV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-PENDING-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV1.TransferInstructionResult_Pending{transferInstructionCid} -> do
      Some instr <- queryContractId gg (coerceContractId @TIV1.TransferInstruction @NttTransferInstruction transferInstructionCid)
      instr.sender === alice
      instr.receiver === bob
      instr.amount === 0.006
    other -> abort ("expected Pending, got: " <> show other)

-- | End-to-end continuation of the pending case: accept completes it.
testNttCoinTransferAcceptCompletesPendingV1 : Script ()
testNttCoinTransferAcceptCompletesPendingV1 = do
  gg <- allocateParty "TransferAcceptV1Gg"
  alice <- allocateParty "TransferAcceptV1Alice"
  bob <- allocateParty "TransferAcceptV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ACCEPT-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output
      instrCid = coerceContractId @TIV1.TransferInstruction @NttTransferInstruction transferInstructionCid

  submitMustFail alice do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  acceptRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg instrCid
  archived === None

testNttCoinTransferRejectReturnsFundsToSenderV1 : Script ()
testNttCoinTransferRejectReturnsFundsToSenderV1 = do
  gg <- allocateParty "TransferRejectV1Gg"
  alice <- allocateParty "TransferRejectV1Alice"
  bob <- allocateParty "TransferRejectV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-REJECT-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  submitMustFail alice do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  rejectRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  case rejectRes.output of
    TIV1.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.01
    other -> abort ("expected one returned coin, got: " <> show other)

testNttCoinTransferWithdrawBySenderReturnsFundsV1 : Script ()
testNttCoinTransferWithdrawBySenderReturnsFundsV1 = do
  gg <- allocateParty "TransferWithdrawV1Gg"
  alice <- allocateParty "TransferWithdrawV1Alice"
  bob <- allocateParty "TransferWithdrawV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-WITHDRAW-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  submitMustFail bob do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs
  withdrawRes <- submit alice do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs
  case withdrawRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
    other -> abort ("expected one returned coin, got: " <> show other)

testNttCoinTransferRejectsMismatchedPreapprovalV1 : Script ()
testNttCoinTransferRejectsMismatchedPreapprovalV1 = do
  gg <- allocateParty "TransferMismatchV1Gg"
  alice <- allocateParty "TransferMismatchV1Alice"
  bob <- allocateParty "TransferMismatchV1Bob"
  carol <- allocateParty "TransferMismatchV1Carol"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-MISMATCH-PRE-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  -- carol's preapproval, but alice claims to send to bob.
  carolPreCid <- submit carol do createCmd TransferPreapproval with owner = carol, instrumentId
  factoryDisc <- discloseFactory gg factoryCid
  carolPreDisc <- fromSome <$> queryDisclosure carol carolPreCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc <> disclose carolPreDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = extraArgsWithPreapproval carolPreCid
  -- receiver != owner mismatch aborts inside TransferPreapproval_Receive.
  expectAbort "preapproval owner is not this transfer's receiver" res

-- | With empty inputs and a negative amount, the positivity guard must abort
-- before the coverage/change arithmetic can mint a change coin from nothing.
testNttCoinTransferRejectsNegativeAmountV1 : Script ()
testNttCoinTransferRejectsNegativeAmountV1 = do
  gg <- allocateParty "TransferNegV1Gg"
  alice <- allocateParty "TransferNegV1Alice"
  bob <- allocateParty "TransferNegV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-NEG-V1"
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob (-0.01) instrumentId []
      extraArgs = emptyExtraArgs
  expectAbort "transfer amount must be positive" res
  coins <- query @NttCoin gg
  coins === []

----------------------------------------------------------------------
-- executeBefore / requestedAt window enforcement
----------------------------------------------------------------------

testNttCoinTransferRejectsExpiredExecuteBeforeV1 : Script ()
testNttCoinTransferRejectsExpiredExecuteBeforeV1 = do
  gg <- allocateParty "TransferExpiredV1Gg"
  alice <- allocateParty "TransferExpiredV1Alice"
  bob <- allocateParty "TransferExpiredV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-EXPIRED-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  let transfer = (mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid])
        with executeBefore = t0 `addRelTime` hours (-1)
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg, transfer, extraArgs = emptyExtraArgs
  expectAbort "executeBefore has passed" res

-- | A pending v1 transfer whose 'executeBefore' has passed by the time
-- accept is attempted: accept is gated, but reject/withdraw still return funds.
testNttCoinTransferAcceptRejectedAfterExecuteBefore : Script ()
testNttCoinTransferAcceptRejectedAfterExecuteBefore = do
  gg <- allocateParty "TransferAcceptExpiredGg"
  alice <- allocateParty "TransferAcceptExpiredAlice"
  bob <- allocateParty "TransferAcceptExpiredBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ACCEPT-EXPIRED"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  let transfer = (mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid])
        with executeBefore = t0 `addRelTime` hours 1
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg, transfer, extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  passTime (hours 2)

  acceptFailed <- trySubmit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  expectAbort "accept is no longer allowed" acceptFailed

  rejectRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)
