-- | A pending v1 transfer whose 'executeBefore' has passed by the time
-- accept is attempted: accept is gated, but reject/withdraw still return funds.
testNttCoinTransferAcceptRejectedAfterExecuteBefore : Script ()
testNttCoinTransferAcceptRejectedAfterExecuteBefore = do
  gg <- allocateParty "TransferAcceptExpiredGg"
  alice <- allocateParty "TransferAcceptExpiredAlice"
  bob <- allocateParty "TransferAcceptExpiredBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ACCEPT-EXPIRED"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  let transfer = (mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid])
        with executeBefore = t0 `addRelTime` hours 1
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg, transfer, extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  passTime (hours 2)

  acceptFailed <- trySubmit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  expectAbort "accept is no longer allowed" acceptFailed

  rejectRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

----------------------------------------------------------------------
-- Composability: provider-delegated accounts and sub-accounts on both the
-- send and receive sides of the v2 paths.
----------------------------------------------------------------------

-- | A provider-managed receiver completes synchronously only when both
-- owner and provider are present in @actors@; otherwise it falls to pending.
testTransferV2ToProviderManagedReceiver : Script ()
testTransferV2ToProviderManagedReceiver = do
  gg <- allocateParty "TransferV2ProviderRecvGg"
  alice <- allocateParty "TransferV2ProviderRecvAlice"
  bob <- allocateParty "TransferV2ProviderRecvBob"
  provider <- allocateParty "TransferV2ProviderRecvProvider"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-PROVIDER-RECV"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      receiverAcct = providerAccount bob provider
      mkTransfer requestedAt inputs = TIV2.Transfer with
        sender = basicAccount alice
        receiver = receiverAcct
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt
        executeBefore = requestedAt `addRelTime` hours 24
        inputHoldingCids = inputs
        meta = emptyMetadata
  factoryDisc <- discloseFactory gg factoryCid

  coinCid1 <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- submit (actAs alice <> actAs bob <> actAs provider <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = mkTransfer t0 [coerceContractId @Holding @HoldingV2.Holding coinCid1]
      actors = [alice, bob, provider]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some hv2 <- queryInterfaceContractId gg rcid
      hv2.account === receiverAcct
      hv2.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)

  coinCid2 <- mintCoin factoryCid gg instrumentId alice 0.01
  t1 <- getTime
  res2 <- submit (actAs alice <> actAs bob <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = mkTransfer t1 [coerceContractId @Holding @HoldingV2.Holding coinCid2]
      actors = [alice, bob]
      extraArgs = emptyExtraArgs
  case res2.output of
    TIV2.TransferInstructionResult_Pending _ -> pure ()
    other -> abort ("expected Pending when the provider's authority is missing, got: " <> show other)

-- | A sub-account sender transfers like a basic account; both the pending
-- instruction and the change coin carry the sub-account through.
testTransferV2FromSubAccountSender : Script ()
testTransferV2FromSubAccountSender = do
  gg <- allocateParty "TransferV2SubSenderGg"
  alice <- allocateParty "TransferV2SubSenderAlice"
  bob <- allocateParty "TransferV2SubSenderBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-SUB-SENDER"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      senderAcct = subAccount alice "sub-1"
  -- 'mintCoin' only produces basic accounts; create the sub-account holding
  -- directly to seed this test.
  coinCid <- submit (actAs gg <> actAs alice) do
    createCmd NttCoin with instrumentId, owner = alice, provider = None, accountId = "sub-1", amount = 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = senderAcct
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Pending{transferInstructionCid} -> do
      Some instr <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction transferInstructionCid)
      instr.senderAccount === senderAcct
    other -> abort ("expected Pending (bob not an actor), got: " <> show other)
  case res.senderChangeCids of
    [changeCid] -> do
      Some hv2 <- queryInterfaceContractId gg changeCid
      hv2.account === senderAcct
      hv2.amount === 0.004
    other -> abort ("expected one change coin carrying the sub-account, got: " <> show other)

-- | A provider-managed receiver with a matching standing preapproval (signed
-- by owner + provider jointly) completes synchronously, like the basic-account case.
testTransferV2PreapprovalProviderAccount : Script ()
testTransferV2PreapprovalProviderAccount = do
  gg <- allocateParty "TransferV2PreapprovalProviderGg"
  alice <- allocateParty "TransferV2PreapprovalProviderAlice"
  bob <- allocateParty "TransferV2PreapprovalProviderBob"
  provider <- allocateParty "TransferV2PreapprovalProviderProvider"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-PREAPPROVAL-PROVIDER"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      receiverAcct = providerAccount bob provider
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  preCid <- submit (actAs bob <> actAs provider) do
    createCmd TransferPreapproval with account = receiverAcct, instrumentId
  factoryDisc <- discloseFactory gg factoryCid
  preDisc <- fromSome <$> queryDisclosure bob preCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc <> disclose preDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = receiverAcct
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = extraArgsWithPreapproval preCid
  case res.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some hv2 <- queryInterfaceContractId gg rcid
      hv2.account === receiverAcct
      hv2.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)

-- | No standing preapproval, provider-managed receiver ⇒ pending; accepting
-- requires both owner and provider authority, and takes the direct
-- (non-nested) v2 accept path.
testTransferV2PendingProviderReceiverAccept : Script ()
testTransferV2PendingProviderReceiverAccept = do
  gg <- allocateParty "TransferV2PendingProviderGg"
  alice <- allocateParty "TransferV2PendingProviderAlice"
  bob <- allocateParty "TransferV2PendingProviderBob"
  provider <- allocateParty "TransferV2PendingProviderProvider"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-PENDING-PROVIDER"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      receiverAcct = providerAccount bob provider
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = receiverAcct
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  let TIV2.TransferInstructionResult_Pending{transferInstructionCid} = res.output
      instrCid = coerceContractId @TIV2.TransferInstruction @NttTransferInstruction transferInstructionCid

  -- bob alone lacks the provider's authority; accept must fail.
  submitMustFail bob do
    exerciseCmd transferInstructionCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs

  (acceptRes, tree) <- submitResultAndTree (actAs bob <> actAs provider) do
    exerciseCmd transferInstructionCid TIV2.TransferInstruction_Accept with
      actors = [bob, provider], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some hv2 <- queryInterfaceContractId gg rcid
      hv2.account === receiverAcct
      hv2.amount === 0.006
      case tree.rootEvents of
        [ExercisedEvent outer] ->
          case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Accept" outer.childEvents of
            [] -> pure ()
            other -> abort ("expected no nested v1 Accept exercise, got: " <> show other)
        other -> abort ("expected exactly one root event, got: " <> show other)
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg instrCid
  archived === None

----------------------------------------------------------------------
-- v2 TransferInstruction_Reject/Withdraw must validate `actors`
----------------------------------------------------------------------

-- | Reject returns funds to the sender, so without validating @actors@, any
-- party able to include itself (e.g. gg, an ambient signatory) could reject
-- on the receiver's behalf. Only the receiver's account authority may reject.
testNttCoinTransferV2RejectRequiresReceiverAuthority : Script ()
testNttCoinTransferV2RejectRequiresReceiverAuthority = do
  gg <- allocateParty "TransferV2RejectAuthGg"
  alice <- allocateParty "TransferV2RejectAuthAlice"
  bob <- allocateParty "TransferV2RejectAuthBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-REJECT-AUTH"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]

  -- gg is a signatory (no disclosure needed) but neither sender nor receiver.
  ggOnly <- trySubmit gg do
    exerciseCmd instrCid TIV2.TransferInstruction_Reject with actors = [gg], extraArgs = emptyExtraArgs
  expectAbort "recipient account's authority" ggOnly

  -- the sender is not the receiver either -- reject is the receiver's call.
  aliceOnly <- trySubmit alice do
    exerciseCmd instrCid TIV2.TransferInstruction_Reject with actors = [alice], extraArgs = emptyExtraArgs
  expectAbort "recipient account's authority" aliceOnly

  -- bob, the actual receiver, can reject -- funds return to the sender.
  rejectRes <- submit bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Reject with actors = [bob], extraArgs = emptyExtraArgs
  case rejectRes.output of
    TIV2.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

-- | Withdraw returns funds to the sender, so without validating @actors@, gg
-- or the receiver could withdraw on the sender's behalf. Only the sender's
-- account authority may withdraw.
testNttCoinTransferV2WithdrawRequiresSenderAuthority : Script ()
testNttCoinTransferV2WithdrawRequiresSenderAuthority = do
  gg <- allocateParty "TransferV2WithdrawAuthGg"
  alice <- allocateParty "TransferV2WithdrawAuthAlice"
  bob <- allocateParty "TransferV2WithdrawAuthBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-WITHDRAW-AUTH"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]

  -- gg is a signatory of the instruction but is neither sender nor receiver.
  ggOnly <- trySubmit gg do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with actors = [gg], extraArgs = emptyExtraArgs
  expectAbort "sender account's authority" ggOnly

  -- the receiver is not the sender either -- withdraw is the sender's call.
  bobOnly <- trySubmit bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with actors = [bob], extraArgs = emptyExtraArgs
  expectAbort "sender account's authority" bobOnly

  -- alice, the actual sender, can withdraw -- funds return to her.
  withdrawRes <- submit alice do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with actors = [alice], extraArgs = emptyExtraArgs
  case withdrawRes.output of
    TIV2.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case withdrawRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

----------------------------------------------------------------------
-- v1-nesting compatibility: v2 Reject/Withdraw nest v1's own consuming
-- choice unconditionally (unlike accept, there is no authority bottleneck).
----------------------------------------------------------------------

-- | v2 Reject nests v1's own 'TIV1.TransferInstruction_Reject' for every
-- account shape.
testNttCoinTransferV2RejectNestsV1 : Script ()
testNttCoinTransferV2RejectNestsV1 = do
  gg <- allocateParty "TransferV2RejectNestGg"
  alice <- allocateParty "TransferV2RejectNestAlice"
  bob <- allocateParty "TransferV2RejectNestBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-REJECT-NEST"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]
  (rejectRes, tree) <- submitResultAndTree bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Reject with actors = [bob], extraArgs = emptyExtraArgs
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Reject"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Reject" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Reject exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)
  case rejectRes.output of
    TIV2.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction instrCid)
  archived === None

-- | v2 Withdraw nests v1's own 'TIV1.TransferInstruction_Withdraw' for a
-- basic-account sender.
testNttCoinTransferV2WithdrawNestsV1 : Script ()
testNttCoinTransferV2WithdrawNestsV1 = do
  gg <- allocateParty "TransferV2WithdrawNestGg"
  alice <- allocateParty "TransferV2WithdrawNestAlice"
  bob <- allocateParty "TransferV2WithdrawNestBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-WITHDRAW-NEST"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]
  (withdrawRes, tree) <- submitResultAndTree alice do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with actors = [alice], extraArgs = emptyExtraArgs
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Withdraw"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Withdraw" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Withdraw exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)
  case withdrawRes.output of
    TIV2.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case withdrawRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction instrCid)
  archived === None

-- | v2 Withdraw nests v1's own 'TIV1.TransferInstruction_Withdraw' even for a
-- provider-managed sender, since the sender-side credit draws its authority
-- from the instruction's own signatories (which include the provider).
testNttCoinTransferV2WithdrawProviderManagedSenderNestsV1 : Script ()
testNttCoinTransferV2WithdrawProviderManagedSenderNestsV1 = do
  gg <- allocateParty "TransferV2WithdrawProviderSenderGg"
  alice <- allocateParty "TransferV2WithdrawProviderSenderAlice"
  bob <- allocateParty "TransferV2WithdrawProviderSenderBob"
  provider <- allocateParty "TransferV2WithdrawProviderSenderProvider"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-WITHDRAW-PROVIDER-SENDER"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      senderAcct = providerAccount alice provider
  -- 'mintCoin' only produces basic accounts; create the provider-managed
  -- holding directly.
  coinCid <- submit (actAs gg <> actAs alice <> actAs provider) do
    createCmd NttCoin with instrumentId, owner = alice, provider = Some provider, accountId = "", amount = 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  pendingRes <- submit (actAs alice <> actAs provider <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = senderAcct
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice, provider]
      extraArgs = emptyExtraArgs
  let TIV2.TransferInstructionResult_Pending{transferInstructionCid = instrCid} = pendingRes.output

  -- alice alone lacks the provider's authority to withdraw a
  -- provider-managed sender account.
  submitMustFail alice do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with actors = [alice], extraArgs = emptyExtraArgs

  (withdrawRes, tree) <- submitResultAndTree (actAs alice <> actAs provider) do
    exerciseCmd instrCid TIV2.TransferInstruction_Withdraw with
      actors = [alice, provider], extraArgs = emptyExtraArgs
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Withdraw"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Withdraw" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Withdraw exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)
  case withdrawRes.senderChangeCids of
    [cid] -> do
      Some hv2 <- queryInterfaceContractId gg cid
      hv2.account === senderAcct
      hv2.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction instrCid)
  archived === None
