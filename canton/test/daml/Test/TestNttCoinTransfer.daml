-- | Tests for the 'HoldingV2'/'TransferFactory' v1+v2 'NttCoin' transfer
-- paths (CIP-0056/CIP-0112), independent of the burn/mint bridge flow.
{-# LANGUAGE AllowAmbiguousTypes #-}
module Test.TestNttCoinTransfer where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.TextMap qualified as TextMap
import DA.Time (hours, addRelTime)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1 (AnyValue(..), ChoiceContext(..), ExtraArgs(..), emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Splice.Api.Token.TransferInstructionV2 qualified as TIV2
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinTransfer
import Wormhole.Ntt.CoinFactory
import Test.TestNtt (nttCoinFactorySetup, expectAbort)
import Test.TestNttCoin (mintCoin)

asTransferFactoryV1 : ContractId NttCoinFactory -> ContractId TIV1.TransferFactory
asTransferFactoryV1 = toInterfaceContractId @TIV1.TransferFactory

asTransferFactoryV2 : ContractId NttCoinFactory -> ContractId TIV2.TransferFactory
asTransferFactoryV2 = toInterfaceContractId @TIV2.TransferFactory

basicAccount : Party -> HoldingV2.Account
basicAccount p = HoldingV2.Account with owner = Some p, provider = None, id = ""

-- | A provider-delegated account: @owner@ is the account holder, @provider@
-- co-signs every movement.
providerAccount : Party -> Party -> HoldingV2.Account
providerAccount owner provider = HoldingV2.Account with owner = Some owner, provider = Some provider, id = ""

-- | A sub-account (no provider): distinguished only by a non-empty @id@.
subAccount : Party -> Text -> HoldingV2.Account
subAccount owner subId = HoldingV2.Account with owner = Some owner, provider = None, id = subId

-- | Build a v1 'TIV1.Transfer' with a 24h execution window from @requestedAt@.
mkTransferV1 : Time -> Party -> Party -> Decimal -> InstrumentId -> [ContractId Holding] -> TIV1.Transfer
mkTransferV1 requestedAt sender receiver amount instrumentId inputHoldingCids =
  TIV1.Transfer with
    sender, receiver, amount, instrumentId, requestedAt
    executeBefore = requestedAt `addRelTime` hours 24
    inputHoldingCids
    meta = emptyMetadata

extraArgsWithPreapproval : ContractId TransferPreapproval -> ExtraArgs
extraArgsWithPreapproval cid = ExtraArgs with
  context = ChoiceContext with
    values = TextMap.fromList [(transferPreapprovalContextKey, AV_ContractId (coerceContractId cid))]
  meta = emptyMetadata

-- | 'NttCoinFactory' is @signatory guardianGovernance@ alone; disclose it so
-- a non-gg submitter has visibility to exercise a choice on it.
discloseFactory : Party -> ContractId NttCoinFactory -> Script Disclosure
discloseFactory gg factoryCid = fromSome <$> queryDisclosure gg factoryCid

-- | Direct-child 'Exercised' events of a given choice name whose interface
-- template matches @t@, distinguishing e.g. a nested v1 accept from v2's own.
exercisesOf : forall t. HasTemplateTypeRep t => Text -> [TreeEvent] -> [Exercised]
exercisesOf choiceName events = [e | ExercisedEvent e <- events, e.choice == choiceName, matchesRep e]
  where
    matchesRep e = case e.argument of
      AnyChoice _ rep -> rep == templateTypeRep @t

----------------------------------------------------------------------
-- HoldingV2
----------------------------------------------------------------------

testNttCoinHoldingV2ViewMatchesV1 : Script ()
testNttCoinHoldingV2ViewMatchesV1 = do
  gg <- allocateParty "TransferHoldingV2Gg"
  alice <- allocateParty "TransferHoldingV2Alice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-HOLDINGV2"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  Some hv2 <- queryInterfaceContractId gg (coerceContractId @Holding @HoldingV2.Holding coinCid)
  hv2.account === basicAccount alice
  hv2.amount === 0.01
  hv2.instrumentId === HoldingV2.InstrumentId with admin = gg, id = instrumentId.id

----------------------------------------------------------------------
-- Transfer v1 -- self-send, preapproval, pending/accept/reject/withdraw
----------------------------------------------------------------------

testNttCoinTransferSelfSendV1 : Script ()
testNttCoinTransferSelfSendV1 = do
  gg <- allocateParty "TransferSelfV1Gg"
  alice <- allocateParty "TransferSelfV1Alice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SELF-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice alice 0.004 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.amount === 0.004
    other -> abort ("expected Completed with one receiver coin, got: " <> show other)
  case res.senderChangeCids of
    [changeCid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      c.amount === 0.006
    other -> abort ("expected one change coin, got: " <> show other)

testNttCoinTransferWithPreapprovalCompletesSynchronouslyV1 : Script ()
testNttCoinTransferWithPreapprovalCompletesSynchronouslyV1 = do
  gg <- allocateParty "TransferPreapprovedV1Gg"
  alice <- allocateParty "TransferPreapprovedV1Alice"
  bob <- allocateParty "TransferPreapprovedV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-PREAPPROVED-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  preCid <- submit bob do createCmd TransferPreapproval with account = basicAccount bob, instrumentId
  factoryDisc <- discloseFactory gg factoryCid
  preDisc <- fromSome <$> queryDisclosure bob preCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc <> disclose preDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = extraArgsWithPreapproval preCid
  case res.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  case res.senderChangeCids of
    [changeCid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      c.owner === alice
      c.amount === 0.004
    other -> abort ("expected one sender change coin, got: " <> show other)

testNttCoinTransferWithoutPreapprovalIsPendingV1 : Script ()
testNttCoinTransferWithoutPreapprovalIsPendingV1 = do
  gg <- allocateParty "TransferPendingV1Gg"
  alice <- allocateParty "TransferPendingV1Alice"
  bob <- allocateParty "TransferPendingV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-PENDING-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV1.TransferInstructionResult_Pending{transferInstructionCid} -> do
      Some instr <- queryContractId gg (coerceContractId @TIV1.TransferInstruction @NttTransferInstruction transferInstructionCid)
      instr.senderAccount === basicAccount alice
      instr.receiverAccount === basicAccount bob
      instr.amount === 0.006
    other -> abort ("expected Pending, got: " <> show other)

-- | End-to-end continuation of the pending case: accept completes it.
testNttCoinTransferAcceptCompletesPendingV1 : Script ()
testNttCoinTransferAcceptCompletesPendingV1 = do
  gg <- allocateParty "TransferAcceptV1Gg"
  alice <- allocateParty "TransferAcceptV1Alice"
  bob <- allocateParty "TransferAcceptV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ACCEPT-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.006 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output
      instrCid = coerceContractId @TIV1.TransferInstruction @NttTransferInstruction transferInstructionCid

  submitMustFail alice do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  acceptRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Accept with extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV1.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg instrCid
  archived === None

testNttCoinTransferRejectReturnsFundsToSenderV1 : Script ()
testNttCoinTransferRejectReturnsFundsToSenderV1 = do
  gg <- allocateParty "TransferRejectV1Gg"
  alice <- allocateParty "TransferRejectV1Alice"
  bob <- allocateParty "TransferRejectV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-REJECT-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  submitMustFail alice do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  rejectRes <- submit bob do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Reject with extraArgs = emptyExtraArgs
  case rejectRes.output of
    TIV1.TransferInstructionResult_Failed -> pure ()
    other -> abort ("expected Failed, got: " <> show other)
  case rejectRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.01
    other -> abort ("expected one returned coin, got: " <> show other)

testNttCoinTransferWithdrawBySenderReturnsFundsV1 : Script ()
testNttCoinTransferWithdrawBySenderReturnsFundsV1 = do
  gg <- allocateParty "TransferWithdrawV1Gg"
  alice <- allocateParty "TransferWithdrawV1Alice"
  bob <- allocateParty "TransferWithdrawV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-WITHDRAW-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = emptyExtraArgs
  let TIV1.TransferInstructionResult_Pending{transferInstructionCid} = res.output

  submitMustFail bob do exerciseCmd transferInstructionCid TIV1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs
  withdrawRes <- submit alice do
    exerciseCmd transferInstructionCid TIV1.TransferInstruction_Withdraw with extraArgs = emptyExtraArgs
  case withdrawRes.senderChangeCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
    other -> abort ("expected one returned coin, got: " <> show other)

testNttCoinTransferRejectsMismatchedPreapprovalV1 : Script ()
testNttCoinTransferRejectsMismatchedPreapprovalV1 = do
  gg <- allocateParty "TransferMismatchV1Gg"
  alice <- allocateParty "TransferMismatchV1Alice"
  bob <- allocateParty "TransferMismatchV1Bob"
  carol <- allocateParty "TransferMismatchV1Carol"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-MISMATCH-PRE-V1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  -- carol's preapproval, but alice claims to send to bob.
  carolPreCid <- submit carol do createCmd TransferPreapproval with account = basicAccount carol, instrumentId
  factoryDisc <- discloseFactory gg factoryCid
  carolPreDisc <- fromSome <$> queryDisclosure carol carolPreCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc <> disclose carolPreDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob 0.01 instrumentId [coinCid]
      extraArgs = extraArgsWithPreapproval carolPreCid
  -- receiver != owner mismatch aborts inside TransferPreapproval_Receive.
  expectAbort "preapproval owner is not this transfer's receiver" res

-- | With empty inputs and a negative amount, the positivity guard must abort
-- before the coverage/change arithmetic can mint a change coin from nothing.
testNttCoinTransferRejectsNegativeAmountV1 : Script ()
testNttCoinTransferRejectsNegativeAmountV1 = do
  gg <- allocateParty "TransferNegV1Gg"
  alice <- allocateParty "TransferNegV1Alice"
  bob <- allocateParty "TransferNegV1Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-NEG-V1"
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV1 factoryCid) TIV1.TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = mkTransferV1 t0 alice bob (-0.01) instrumentId []
      extraArgs = emptyExtraArgs
  expectAbort "transfer amount must be positive" res
  coins <- query @NttCoin gg
  coins === []

-- | v2 counterpart: same negative-amount exploit check, with both actors
-- present so the transfer would otherwise complete synchronously.
testNttCoinTransferRejectsNegativeAmountV2 : Script ()
testNttCoinTransferRejectsNegativeAmountV2 = do
  gg <- allocateParty "TransferNegV2Gg"
  alice <- allocateParty "TransferNegV2Alice"
  bob <- allocateParty "TransferNegV2Bob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = "NTT-COIN-NEG-V2"
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> actAs bob <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = -0.01
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = []
        meta = emptyMetadata
      actors = [alice, bob]
      extraArgs = emptyExtraArgs
  expectAbort "transfer amount must be positive" res
  coins <- query @NttCoin gg
  coins === []

----------------------------------------------------------------------
-- Transfer v2 -- actors-based synchronous completion + basic-account rejection
----------------------------------------------------------------------

testNttCoinTransferV2CompletesWhenBothActorsPresent : Script ()
testNttCoinTransferV2CompletesWhenBothActorsPresent = do
  gg <- allocateParty "TransferV2BothGg"
  alice <- allocateParty "TransferV2BothAlice"
  bob <- allocateParty "TransferV2BothBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-BOTH"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> actAs bob <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice, bob]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)

testNttCoinTransferV2PendingWhenOnlySenderIsActor : Script ()
testNttCoinTransferV2PendingWhenOnlySenderIsActor = do
  gg <- allocateParty "TransferV2PendingGg"
  alice <- allocateParty "TransferV2PendingAlice"
  bob <- allocateParty "TransferV2PendingBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-PENDING"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Pending _ -> pure ()
    other -> abort ("expected Pending, got: " <> show other)

-- | Sub-accounts and provider-delegated accounts are ordinary accounts; only
-- the null-owner account (reserved for mint/burn via 'BurnMintFactory') is
-- rejected here.
testNttCoinTransferV2RejectsNullOwnerAccount : Script ()
testNttCoinTransferV2RejectsNullOwnerAccount = do
  gg <- allocateParty "TransferV2NullOwnerGg"
  alice <- allocateParty "TransferV2NullOwnerAlice"
  bob <- allocateParty "TransferV2NullOwnerBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = "NTT-COIN-V2-NULLOWNER"
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = HoldingV2.Account with owner = None, provider = None, id = "cip-112/mint"
        receiver = basicAccount bob
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = []
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  expectAbort "null-owner accounts are for mint/burn only" res

----------------------------------------------------------------------
-- v2 TransferInstruction accept/reject/withdraw must self-archive
----------------------------------------------------------------------

-- | Drive a v2 transfer to pending (only the sender is an actor) and return
-- the resulting instruction handle.
mkPendingTransferV2
  : ContractId NttCoinFactory -> Party -> Party -> Party -> InstrumentId -> Decimal -> [ContractId Holding]
  -> Script (ContractId TIV2.TransferInstruction)
mkPendingTransferV2 factoryCid gg alice bob instrumentId amount inputHoldingCids = do
  let instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = basicAccount bob
        amount, instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = map (coerceContractId @Holding @HoldingV2.Holding) inputHoldingCids
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  case res.output of
    TIV2.TransferInstructionResult_Pending{transferInstructionCid} -> pure transferInstructionCid
    other -> error ("expected Pending, got: " <> show other)

testNttCoinTransferV2AcceptArchivesInstruction : Script ()
testNttCoinTransferV2AcceptArchivesInstruction = do
  gg <- allocateParty "TransferV2AcceptArchiveGg"
  alice <- allocateParty "TransferV2AcceptArchiveAlice"
  bob <- allocateParty "TransferV2AcceptArchiveBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-ACCEPT-ARCHIVE"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]
  acceptRes <- submit bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin rcid)
      r.owner === bob
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction instrCid)
  archived === None
  -- The instruction is gone -- a second accept must fail outright.
  submitMustFail bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs

----------------------------------------------------------------------
-- v1-nesting compatibility: v2 Accept/Reject/Withdraw nest the corresponding
-- v1 choice where possible, so v1 transaction parsers still see a familiar
-- v1 exercise node. Accept's nesting depends on the receiver account's
-- authority shape; Reject/Withdraw nest unconditionally.
----------------------------------------------------------------------

-- | Basic receiver account: v2 accept nests v1's own consuming Accept, and
-- the instruction is archived by that nested choice.
testNttCoinTransferV2AcceptNestsV1ForBasicReceiver : Script ()
testNttCoinTransferV2AcceptNestsV1ForBasicReceiver = do
  gg <- allocateParty "TransferV2AcceptNestBasicGg"
  alice <- allocateParty "TransferV2AcceptNestBasicAlice"
  bob <- allocateParty "TransferV2AcceptNestBasicBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-ACCEPT-NEST-BASIC"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  instrCid <- mkPendingTransferV2 factoryCid gg alice bob instrumentId 0.006 [coinCid]
  (acceptRes, tree) <- submitResultAndTree bob do
    exerciseCmd instrCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some r <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @TIV2.TransferInstruction @NttTransferInstruction instrCid)
  archived === None
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Accept"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Accept" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Accept exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)

-- | Sub-account receiver: same authority shape as a basic account, so
-- nesting applies here too and the sub-account id survives through.
testNttCoinTransferV2AcceptNestsV1ForSubAccountReceiver : Script ()
testNttCoinTransferV2AcceptNestsV1ForSubAccountReceiver = do
  gg <- allocateParty "TransferV2AcceptNestSubGg"
  alice <- allocateParty "TransferV2AcceptNestSubAlice"
  bob <- allocateParty "TransferV2AcceptNestSubBob"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-V2-ACCEPT-NEST-SUB"
      instrumentIdV2 = HoldingV2.InstrumentId with admin = gg, id = instrumentId.id
      receiverAcct = subAccount bob "sub-recv-1"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  res <- submit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asTransferFactoryV2 factoryCid) TIV2.TransferFactory_Transfer with
      transfer = TIV2.Transfer with
        sender = basicAccount alice
        receiver = receiverAcct
        amount = 0.006
        instrumentId = instrumentIdV2
        requestedAt = t0
        executeBefore = t0 `addRelTime` hours 24
        inputHoldingCids = [coerceContractId @Holding @HoldingV2.Holding coinCid]
        meta = emptyMetadata
      actors = [alice]
      extraArgs = emptyExtraArgs
  let TIV2.TransferInstructionResult_Pending{transferInstructionCid} = res.output
      instrCid = coerceContractId @TIV2.TransferInstruction @NttTransferInstruction transferInstructionCid

  (acceptRes, tree) <- submitResultAndTree bob do
    exerciseCmd transferInstructionCid TIV2.TransferInstruction_Accept with actors = [bob], extraArgs = emptyExtraArgs
  case acceptRes.output of
    TIV2.TransferInstructionResult_Completed{receiverHoldingCids = [rcid]} -> do
      Some hv2 <- queryInterfaceContractId gg rcid
      hv2.account === receiverAcct
      hv2.amount === 0.006
    other -> abort ("expected Completed, got: " <> show other)
  archived <- queryContractId gg instrCid
  archived === None
  case tree.rootEvents of
    [ExercisedEvent outer] -> do
      outer.choice === "TransferInstruction_Accept"
      case exercisesOf @TIV1.TransferInstruction "TransferInstruction_Accept" outer.childEvents of
        [_] -> pure ()
        other -> abort ("expected exactly one nested v1 Accept exercise, got: " <> show other)
    other -> abort ("expected exactly one root event, got: " <> show other)

testNttCoinTransferV2RejectArchivesInstruction : Script ()
testNttCoinTransferV2RejectArchivesInstruction = do
