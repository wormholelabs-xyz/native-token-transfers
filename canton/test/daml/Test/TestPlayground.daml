-- | Daml Script tests for the playground harness itself (canton/test/daml/Playground/*).
-- Phase 2 replaced every stubbed entrypoint these scripts exercise
-- (Playground.MockRegistry/Deploy/Ops) with its real implementation; all scripts below now
-- pin real behavior, not a stub's abort.
--
-- 'testMockRegistryPreapprovedDelivery'/'testMockRegistryRequiresPreapproval' pin the
-- compromise-free receive design on its own (no VAA, no NttManager) -- see
-- 'Playground.MockRegistry'. The rest exercise the playground's own Deploy/Ops entrypoints
-- against a real 'Wormhole.Ntt.Governance.NttGovernance' root (bootstrapped the same way
-- 'Test.TestNtt.nttSetup' does, mirroring 'Playground.Init.initPlayground').
module Test.TestPlayground where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Optional (fromSome)
import DA.Text (isInfixOf)
import DA.Time (hours, addRelTime)
import DA.TextMap qualified as TextMap

import DA.Text (isInfixOf)

import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Splice.Api.Token.MetadataV1
  ( AnyValue (..), ChoiceContext (..), ExtraArgs (..), emptyChoiceContext, emptyMetadata )
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory, TransferFactory_Transfer (..), Transfer (..)
  , TransferInstructionResult_Output (..) )
import Wormhole.Core.Bytes (leftPadTo, normalizeHex)
import Wormhole.Core.Replay (defaultSplitThreshold)
import Wormhole.Ntt.Amount (trimAmount, trimAmountTo)
import Token.CIP0056.Coin (Coin (..))
import Token.CIP0056.CoinFactory (CoinFactory (..))
import Wormhole.Ntt.Ledger
import Wormhole.Ntt.Manager (NttManager (..), NttTokenConfig (..), NttFactory (..), nttInstrumentIdFor, nttNamespaceFor)
import Wormhole.Ntt.Payload
  ( decodeWormholeTransceiverMessage, decodeNttManagerMessage, decodeNativeTokenTransfer )

import Test.TestCore (devnetGuardianPubKey)
import Test.TestNtt
  ( mkHolding, expectAbort, sendScaffold, nttSetup, registerHappyVAA, Cip56MockHolding
  , setupFixedManager, acceptAdminHappyVAA, cantonChainId, bridgedInstrument, cip56HoldingsOwnedBy )
import Test.TestReplay (registerReplayRoot)

import Playground.Deploy
import Playground.MockRegistry
import Playground.Ops
import Playground.Prepare (PrepareAcceptAdminInput (..), prepareAcceptAdmin)
import Playground.Types

----------------------------------------------------------------------
-- Playground.MockRegistry: the compromise-free receive design, in isolation
----------------------------------------------------------------------

-- | An executor-only submission (top-level 'actAs' only the SENDER, controller of
-- 'TransferFactory_Transfer' -- the receiver never acts) delivers to a non-signing receiver
-- when a matching 'MockTransferPreapproval' cid is present in 'ExtraArgs.context'.
testMockRegistryPreapprovedDelivery : Script ()
testMockRegistryPreapprovedDelivery = do
  gg <- allocateParty "MockRegDeliverGG"
  sender <- allocateParty "MockRegDeliverSender"
  receiver <- allocateParty "MockRegDeliverReceiver"
  let instrument = InstrumentId with admin = gg, id = "MOCKREG-DELIVER"

  facTplCid <- submit gg do createCmd MockPreapprovedTransferFactory with admin = gg
  let facCid = toInterfaceContractId @TransferFactory facTplCid
  facDisc <- fromSome <$> queryDisclosure gg facTplCid

  preCid <- submit receiver do
    createCmd MockTransferPreapproval with owner = receiver, registryAdmin = gg, instrument
  preDisc <- fromSome <$> queryDisclosure gg preCid

  senderHoldingCid <- mkHolding gg sender instrument 5.0

  now <- getTime
  let extraArgs = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [(mockTransferPreapprovalContextKey, AV_ContractId (coerceContractId preCid))]
        meta = emptyMetadata

  result <- submit (actAs sender <> disclose facDisc <> disclose preDisc) do
    exerciseCmd facCid TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = Transfer with
        sender
        receiver
        amount = 5.0
        instrumentId = instrument
        requestedAt = now
        executeBefore = addRelTime now (hours 24)
        inputHoldingCids = [senderHoldingCid]
        meta = emptyMetadata
      extraArgs

  case result.output of
    TransferInstructionResult_Completed receiverHoldingCids ->
      assertMsg "expected exactly one receiver holding from the preapproved delivery"
        (length receiverHoldingCids == 1)
    _ -> abort "expected TransferInstructionResult_Completed (executor-only preapproved delivery)"

-- | Delivery to a non-signing receiver with NO matching pre-approval in context aborts
-- clearly (permissionless relay must not silently drop value, and the "requires prior
-- opt-in" error must be legible).
testMockRegistryRequiresPreapproval : Script ()
testMockRegistryRequiresPreapproval = do
  gg <- allocateParty "MockRegNoPreGG"
  sender <- allocateParty "MockRegNoPreSender"
  receiver <- allocateParty "MockRegNoPreReceiver"
  let instrument = InstrumentId with admin = gg, id = "MOCKREG-NOPRE"

  facTplCid <- submit gg do createCmd MockPreapprovedTransferFactory with admin = gg
  let facCid = toInterfaceContractId @TransferFactory facTplCid
  facDisc <- fromSome <$> queryDisclosure gg facTplCid

  now <- getTime
  res <- trySubmit (actAs sender <> disclose facDisc) do
    exerciseCmd facCid TransferFactory_Transfer with
      expectedAdmin = gg
      transfer = Transfer with
        sender
        receiver
        amount = 5.0
        instrumentId = instrument
        requestedAt = now
        executeBefore = addRelTime now (hours 24)
        inputHoldingCids = []
        meta = emptyMetadata
      extraArgs = ExtraArgs with context = emptyChoiceContext, meta = emptyMetadata
  expectAbort "no standing transfer pre-approval" res

----------------------------------------------------------------------
-- Playground.Deploy: the gg-submitted deployRegistry -> admin-submitted deployNtt sequence
----------------------------------------------------------------------

-- | A "mock" burn-mint deployment: 'deployRegistry' (gg) creates the canonical
-- 'Token.CIP0056.CoinFactory.CoinFactory'; 'deployNtt' (admin) then routes registration
-- through 'Wormhole.Ntt.Governance.RegisterManagerByVaa', which needs a genuine guardian
-- signature over the freshly-allocated (operator, admin) pair -- something no static
-- Daml Script fixture can ever produce (registrationBinding commits to their real,
-- nondeterministic party fingerprints; see 'Test.TestNtt.testRegisterManagerByVaaBindingMismatch',
-- which accepts the identical limit). The true happy path is exercised only by the Go
-- LocalNet e2e suite, which signs against real allocated party ids. This test calls
-- 'deployNtt' itself -- so a wiring break upstream of the VAA check still fails it -- and
-- checks it fails at exactly the binding-mismatch gate, not earlier. 'deployNtt' uses
-- 'trySubmit' (not a bare 'submit') for this exercise precisely so the failure is a genuine
-- Daml exception here, catchable via 'tryFailureStatus'.
testPlaygroundDeployMockBurnMint : Script ()
testPlaygroundDeployMockBurnMint = do
  (operator, gg, _csId) <- nttSetup
  admin <- allocateParty "PlaygroundDeployBMAdmin"

  regOut <- deployRegistry DeployRegistryInput with
    guardianGovernance = gg
    admin
    mode = "burn-mint"
    tokenKind = "mock"
    instrumentNonce = 0

  outcome <- tryFailureStatus $ deployNtt DeployInput with
    operator
    guardianGovernance = gg
    admin
    mode = "burn-mint"
    tokenKind = "mock"
    tokenDecimals = 8
    instrumentNonce = 0
    instrumentAdmin = None
    amuletFactoryCid = None
    factoryCid = regOut.factoryCid
    vaaBytes = Some registerHappyVAA
    pubKeys = [(0, devnetGuardianPubKey)]
    remote = None

  case outcome of
    Left fs -> assertMsg
      ("expected failure containing 'registration binding does not match', got: " <> fs.message)
      ("registration binding does not match" `isInfixOf` fs.message)
    Right _ -> abort "deployNtt succeeded; expected a registration-binding mismatch"

-- | A "mock" lock-unlock deployment: 'deployRegistry' additionally creates a
-- 'Playground.MockRegistry.MockPreapprovedTransferFactory' (the lock/unlock committed
-- factory) plus the burn/mint funding faucet; 'deployNtt' yields a zero-balance
-- 'Wormhole.Ntt.Ledger.LockedLedger' and (per plan §4.2) the admin's own standing
-- 'Playground.MockRegistry.MockTransferPreapproval' (admin is the lock's custodian/receiver).
testPlaygroundDeployMockLockUnlock : Script ()
testPlaygroundDeployMockLockUnlock = do
  (operator, gg, _csId) <- nttSetup
  admin <- allocateParty "PlaygroundDeployLUAdmin"

  regOut <- deployRegistry DeployRegistryInput with
    guardianGovernance = gg
    admin
    mode = "lock-unlock"
    tokenKind = "mock"
    instrumentNonce = 0

  deployOut <- deployNtt DeployInput with
    operator
    guardianGovernance = gg
    admin
    mode = "lock-unlock"
    tokenKind = "mock"
    tokenDecimals = 8
    instrumentNonce = 0
    instrumentAdmin = None
    amuletFactoryCid = None
    factoryCid = regOut.factoryCid
    vaaBytes = None
    pubKeys = []
    remote = None

  (_, mgr) <- resolveManager operator deployOut.managerId
  mgr.tokenConfig === LockUnlock
  (_, ledger) <- resolveLedger operator mgr.managerAddress
  ledger.balance === 0.0

  -- The admin's own standing preapproval exists (plan §4.2: "lock by any user works with
  -- admin-owned custody, no promotion needed").
  pres <- query @MockTransferPreapproval gg
  case [ () | (_, p) <- pres, p.owner == admin, p.instrument == mgr.instrumentId ] of
    [_] -> pure ()
    _ -> abort "expected exactly one MockTransferPreapproval for the admin"

----------------------------------------------------------------------
-- Playground.Ops: fundUser / transferOut against a REAL deployment
-- (built via Test.TestNtt.deploy/sendScaffold, not the still-stubbed Playground.Deploy, so
-- these two tests isolate Ops.daml's own stubs from Deploy.daml's).
----------------------------------------------------------------------

-- | 'fundUser' mints exactly @amount@ to the owner via the preapproval-based faucet Deposit,
-- once the recipient has opted in with 'preapprove' (its own documented precondition -- the
-- 'Deposit' choice lives on the recipient's own standing 'DepositPreapproval', so there is
-- no way to fund a user who hasn't created one; the CLI ensures this before calling
-- 'fundUser', which this test mirrors).
testPlaygroundFundUserDeposits : Script ()
testPlaygroundFundUserDeposits = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundFundAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  recipient <- allocateParty "PlaygroundFundRecipient"

  -- fundUser mints via the canonical CoinFactory (Playground.Deploy.deployRegistry stands
  -- this up in the real flow); sendScaffold isolates Ops.daml from Deploy.daml (this module's
  -- header), so this test stands one up itself.
  _ <- submit gg do createCmd CoinFactory with admin = gg

  _ <- preapprove PreapproveInput with
    admin
    guardianGovernance = gg
    tokenKind = "mock"
    mode = "burn-mint"
    user = recipient

  out <- fundUser FundUserInput with
    guardianGovernance = gg
    admin
    owner = recipient
    amount = 0.5

  Some v <- queryContractId recipient (fromInterfaceContractId @Coin out.holdingCid)
  v.amount === 0.5
  v.owner === recipient

----------------------------------------------------------------------
-- Playground.Ops.mockHoldings: transferOut's in-script enumeration when the CLI leaves
-- inputHoldingCids empty (plan §5.5 -- funding moved out to `fund`, and under
-- --strict-participant-isolation the CLI cannot ask gg for the freshly minted holding's cid
-- either way).
----------------------------------------------------------------------

-- | A sender who already holds a 'Test.TestNtt.Cip56MockHolding' for the deployment's
-- instrument transfers successfully with an EMPTY 'TransferOutInput.inputHoldingCids' --
-- 'Playground.Ops:mockHoldings' enumerates it in-script, read as the sender itself (owner is
-- a signatory), with no disclosure at all.
testPlaygroundTransferOutEnumeratesMockHoldingsWhenEmpty : Script ()
testPlaygroundTransferOutEnumeratesMockHoldingsWhenEmpty = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundMockHoldingsAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  _holdingCid <- mkHolding gg admin d.instrumentId 1.0
  Some mgr <- queryContractId operator d.mgrCid

  out <- transferOut TransferOutInput with
    operator
    managerId = mgr.managerId
    admin
    tokenKind = "mock"
    user = admin
    recipientChain = 2
    recipientAddress = leftPadTo 32 "ee"
    sourceToken = leftPadTo 32 "dd"
    rawAmount = 1000000
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = [] -- the sender's own holding is enumerated in-script, not passed in
    amulet = None
    remote = None

  out.emitterChain === 72

-- | A sender with NO 'Cip56MockHolding' at all and an empty 'inputHoldingCids' aborts with a
-- clear, actionable message rather than falling through to 'Transfer''s own generic
-- insufficient-inputs failure -- catchable via 'tryFailureStatus' since 'transferOut' calls
-- plain 'abort' directly in the Script do-block (not inside a submitted choice, so
-- 'trySubmit'/'expectAbort' do not apply here; see 'Test.TestDisclose' for the same idiom).
testPlaygroundTransferOutEmptyHoldingsAbortsWithoutFunding : Script ()
testPlaygroundTransferOutEmptyHoldingsAbortsWithoutFunding = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundMockHoldingsNoneAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  Some mgr <- queryContractId operator d.mgrCid

  res <- tryFailureStatus $ transferOut TransferOutInput with
    operator
    managerId = mgr.managerId
    admin
    tokenKind = "mock"
    user = admin
    recipientChain = 2
    recipientAddress = leftPadTo 32 "ee"
    sourceToken = leftPadTo 32 "dd"
    rawAmount = 1000000
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = []
    amulet = None
    remote = None

  case res of
    Left fs -> assertMsg
      ("expected 'run `fund` first', got: " <> fs.message)
      ("run `fund` first" `isInfixOf` fs.message)
    Right _ -> abort "expected transferOut to abort with no holdings for the sender"

-- | The recomputed outbound payload matches what 'Wormhole.Ntt.Manager.Transfer' actually
-- publishes, and the recomputed sequence matches the pre-exercise 'Emitter.sequence' --
-- 'transferOut''s whole reason for existing (there is no event stream to read the
-- 'WormholeMessage' choice result back from). The pre-exercise read must happen BEFORE
-- 'transferOut' runs: 'Transfer' consumes and recreates the transceiver 'Emitter' (the
-- sequence-bearing cid churns on every publish, per Playground.Types's header note), so
-- 'd.emitterCid' is stale afterwards.
testPlaygroundTransferRecomputeMatches : Script ()
testPlaygroundTransferRecomputeMatches = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundRecomputeAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  holdingCid <- mkHolding gg admin d.instrumentId 1.0
  Some mgr <- queryContractId operator d.mgrCid
  Some emBefore <- queryContractId operator d.emitterCid

  out <- transferOut TransferOutInput with
    operator
    managerId = mgr.managerId
    admin
    tokenKind = "mock"
    user = admin
    recipientChain = 2
    recipientAddress = leftPadTo 32 "ee"
    sourceToken = leftPadTo 32 "dd"
    rawAmount = 1000000
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = [holdingCid]
    amulet = None
    remote = None

  out.outboundSequence === emBefore.sequence

  -- The recomputed payload decodes back to exactly what was requested -- a real check that
  -- transferOut's independent recompute (it never reads Transfer's own return value; see the
  -- module header) is bit-exact against the wire encoders 'Transfer' itself uses internally.
  let wm = decodeWormholeTransceiverMessage out.payload
      mm = decodeNttManagerMessage wm.managerPayload
      ntt = decodeNativeTokenTransfer mm.payload
      trimmed = trimAmount 1000000 mgr.tokenDecimals
  wm.recipientManager === leftPadTo 32 "bb"
  ntt.recipientChain === 2
  ntt.recipientAddress === normalizeHex (leftPadTo 32 "ee")
  ntt.sourceToken === normalizeHex (leftPadTo 32 "dd")
  ntt.decimals === trimmed.decimals
  ntt.amount === trimmed.amount

-- | The recompute is PEER-decimals-aware, not just local-token-decimals-aware:
-- 'transferOut''s independent recompute must match what 'Wormhole.Ntt.Manager.Transfer'
-- actually trims to on-ledger even when the peer's decimals differ from the deployment's own
-- 'tokenDecimals'. Pins two things at once: (1) the playground's own 'setPeer' entrypoint
-- threads 'SetPeerInput.decimals' through to the on-ledger 'Peer.decimals' (not a hardcoded
-- placeholder), and (2) the recompute uses 'trimAmountTo rawAmount tokenDecimals
-- peer.decimals' (peer-decimals-aware), not the peer-decimals-blind 'trimAmount' that
-- 'testPlaygroundTransferRecomputeMatches' above exercises (there every peer is at
-- decimals=8, same as tokenDecimals, so the two trims coincide and can't tell them apart).
testPlaygroundTransferRecomputeLowDecimalPeer : Script ()
testPlaygroundTransferRecomputeLowDecimalPeer = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundRecomputeLowDecimalsAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  holdingCid <- mkHolding gg admin d.instrumentId 1.0
  Some mgr <- queryContractId operator d.mgrCid

  -- Add a low-decimals peer via the playground's OWN setPeer entrypoint (not raw 'SetPeer'
  -- as 'sendScaffold' uses for chain 2) -- this is what pins 'SetPeerInput.decimals'
  -- threading, not just the core model's own guard.
  _ <- setPeer SetPeerInput with
    operator
    managerId = mgr.managerId
    admin
    chain = 5
    peerManager = leftPadTo 32 "aa"
    peerTransceiver = leftPadTo 32 "bb"
    decimals = 3

  out <- transferOut TransferOutInput with
    operator
    managerId = mgr.managerId
    admin
    tokenKind = "mock"
    user = admin
    recipientChain = 5
    recipientAddress = leftPadTo 32 "ee"
    sourceToken = leftPadTo 32 "dd"
    rawAmount = 500000  -- 500000 / 10^(8-3) == 5 at 3 decimals: rounds cleanly, no dust
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = [holdingCid]
    amulet = None
    remote = None

  let wm = decodeWormholeTransceiverMessage out.payload
      mm = decodeNttManagerMessage wm.managerPayload
      ntt = decodeNativeTokenTransfer mm.payload
      trimmed = trimAmountTo 500000 mgr.tokenDecimals 3
  ntt.decimals === 3
  ntt.amount === 5
  ntt.decimals === trimmed.decimals
  ntt.amount === trimmed.amount

----------------------------------------------------------------------
-- Playground.Ops: setPaused round-trip
----------------------------------------------------------------------

-- | The playground's 'setPaused' entrypoint threads through to
-- 'Wormhole.Ntt.Manager.NttManager.paused': pausing sets it, unpausing clears it, and a
-- normal 'transferOut' succeeds once unpaused. Positive path only -- the rejection-while-
-- paused case is deliberately NOT a Daml playground test: 'setPaused'/'transferOut' both
-- 'submit' internally (no 'trySubmit' seam to observe the abort from here), so that negative
-- case lives in e2e where `h.run` captures the CLI's own error output (same reasoning as
-- 'testPlaygroundTransferRecomputeLowDecimalPeer''s doc note on the dust/same-chain/zero-
-- address negatives above).
testPlaygroundSetPausedRoundTrip : Script ()
testPlaygroundSetPausedRoundTrip = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "PlaygroundPauseAdmin"
  (d, _discs) <- sendScaffold operator gg admin BurnMint csId
  holdingCid <- mkHolding gg admin d.instrumentId 1.0
  Some mgr <- queryContractId operator d.mgrCid

  _ <- setPaused SetPausedInput with
    operator
    managerId = mgr.managerId
    admin
    paused = True

  (_, mgrPaused) <- resolveManager operator mgr.managerId
  mgrPaused.paused === True

  _ <- setPaused SetPausedInput with
    operator
    managerId = mgr.managerId
    admin
    paused = False

  (_, mgrUnpaused) <- resolveManager operator mgr.managerId
  mgrUnpaused.paused === False

  -- A normal transferOut succeeds once unpaused -- proves 'setPaused False' actually clears
  -- the on-ledger halt, not just that the query reads back False.
  _ <- transferOut TransferOutInput with
    operator
    managerId = mgr.managerId
    admin
    tokenKind = "mock"
    user = admin
    recipientChain = 2
    recipientAddress = leftPadTo 32 "ee"
    sourceToken = leftPadTo 32 "dd"
    rawAmount = 1000000
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = [holdingCid]
    amulet = None
    remote = None

  pure ()

----------------------------------------------------------------------
-- Playground.Ops.acceptAdminTransferByVaa: the 'remote = Some seam' round trip
-- ('Playground.Prepare:prepareAcceptAdmin'), the RemoteSeam extension accept-gg-vaa previously
-- lacked -- both BurnMint (no ledger at all) and LockUnlock with a
-- NON-EMPTY custody pot (the harder path the e2e suite's own "gg custody opt-in via governance
-- VAA (lock-unlock)" subtest exercises live: the nested TransferAdmin pot move's receiver is gg
-- itself, so prepareAcceptAdmin additionally resolves the pot holding, the committed factory,
-- and gg's OWN standing MockTransferPreapproval). The 'remote = None' fast path is untouched by
-- this change (Ops.daml's 'None' branch is byte-identical to before it) and stays pinned by
-- Test.TestNtt's own 'testAcceptAdminByVaaHappyPath'/'testAcceptAdminByVaaLockUnlock' (the
-- Wormhole.Ntt.Manager choice itself) and the CLI's e2e suite (the Playground.Ops wrapper, same
-- deployment/executor shape 'admin accept-gg-vaa' drives in production).
----------------------------------------------------------------------

-- | The templates 'prepareAcceptAdmin' can disclose -- the full allow-list, mirroring how a
-- real --topology-config would name every template the CLI's disclosure service ever fetches
-- (internal/disclosure.DefaultDisclose, canton/testing/cli), not just the subset a given
-- deployment happens to need.
acceptAdminDiscloseTemplates : [Text]
acceptAdminDiscloseTemplates =
  [ "Wormhole.Ntt.Manager:NttManager"
  , "Wormhole.Ntt.Manager:AdminTransferProposal"
  , "Wormhole.Ntt.Governance:NttGovernance"
  , "Wormhole.Ntt.Ledger:LockedLedger"
  , "Wormhole.Core.State:CoreState"
  , "Wormhole.Core.State:Emitter"
  , "Wormhole.Core.Replay:ReplayNode"
  , "Wormhole.Ntt.Deposit:DepositPreapproval"
  , "Playground.MockRegistry:MockTransferPreapproval"
  , "Playground.MockRegistry:MockPreapprovedTransferFactory"
  , "Test.TestNtt:MockBurnMintFactory"
  , "Test.TestNtt:Cip56MockHolding"
  ]

-- | BurnMint: 'prepareAcceptAdmin' resolves only the manager/core-state/replay-node/proposal --
-- no ledger at all, mirroring 'acceptAdminTransferByVaa's own BurnMint branch, which needs
-- neither. Reuses 'Test.TestNtt.setupFixedManager' (the fixed managerAddress 0x00..aa, chainId
-- 72, factoryEpoch 0 that 'Test.TestNtt.acceptAdminHappyVAA' targets) and that same pinned VAA
-- fixture -- a Daml Script test cannot itself produce a guardian-signed VAA, so every
-- accept-admin test in this repo (Test.TestNtt's own included) reuses this one static fixture
-- rather than signing one live.
testPlaygroundAcceptAdminByVaaRemoteSeamBurnMint : Script ()
testPlaygroundAcceptAdminByVaaRemoteSeamBurnMint = do
  (operator, gg, _csId) <- nttSetup
  admin <- allocateParty "AcceptSeamBurnMintAdmin"
  executor <- allocateParty "AcceptSeamBurnMintExecutor"
  (mgrCid, _factory, _ledgerCid) <- setupFixedManager operator gg admin BurnMint
  Some mgr <- queryContractId operator mgrCid

  _ <- proposeAdminTransferToGg ProposeAdminTransferToGgInput with
    admin
    managerId = mgr.managerId

  seam <- prepareAcceptAdmin PrepareAcceptAdminInput with
    guardianGovernance = gg
    managerId = mgr.managerId
    vaaBytes = acceptAdminHappyVAA
    discloseTemplates = acceptAdminDiscloseTemplates

  out <- acceptAdminTransferByVaa AcceptAdminTransferByVaaInput with
    operator
    managerId = mgr.managerId
    executor
    vaaBytes = acceptAdminHappyVAA
    pubKeys = [(0, devnetGuardianPubKey)]
    remote = Some seam

  out.admin === gg
  (_, mgrAfter) <- resolveManager operator mgr.managerId
  mgrAfter.admin === gg

-- | LockUnlock with a NON-EMPTY custody pot -- the harder path. Built directly rather than via
-- 'Test.TestNtt.setupFixedManager', which backs its own LockUnlock fixture with
-- 'Test.TestNtt.MockTransferFactory' -- a template distinct from this package's own
-- 'Playground.MockRegistry.MockPreapprovedTransferFactory', the one the nested pot move
-- actually needs (only the latter understands the 'mockTransferPreapprovalContextKey'
-- extra-args convention 'Playground.MockRegistry's factory relies on -- see that module's
-- header). Otherwise mirrors 'setupFixedManager's own recipe exactly: the fixed
-- managerAddress 0x00..aa / chainId 72 / factoryEpoch 0 'acceptAdminHappyVAA' targets and a
-- claimed replay-trie root, plus a pre-funded admin-owned custody pot seeded directly via the
-- ledger's own 'Credit' choice (mirrors the accounting 'Test.TestNtt.testTransferAdminToGg's
-- own fixture ends up in, minus the full lock/transfer round trip needed to get there for
-- real) and gg's own standing 'MockTransferPreapproval' (the pot move's receiver).
testPlaygroundAcceptAdminByVaaRemoteSeamLockUnlockNonEmptyPot : Script ()
testPlaygroundAcceptAdminByVaaRemoteSeamLockUnlockNonEmptyPot = do
  (operator, gg, _csId) <- nttSetup
  admin <- allocateParty "AcceptSeamLockUnlockAdmin"
  executor <- allocateParty "AcceptSeamLockUnlockExecutor"

  let instrumentId = bridgedInstrument gg
      managerAddress = leftPadTo 32 "aa"
      managerId = 999
      namespace = nttNamespaceFor instrumentId admin managerId

  facCid <- submit gg do createCmd MockPreapprovedTransferFactory with admin = gg
  let factory = TransferFactoryCid (toInterfaceContractId @TransferFactory facCid)

  _ <- submit (actAs operator <> actAs admin <> actAs gg) do
    createCmd NttManager with
      operator
      namespace
      admin
      guardianGovernance = gg
      chainId = cantonChainId
      managerId
      managerAddress
      transceiverEmitterId = 999
      instrumentId
      tokenConfig = LockUnlock
      tokenDecimals = 8
      peers = Map.empty
      factory
      paused = False
      factoryEpoch = 0
  _ <- registerReplayRoot operator gg namespace defaultSplitThreshold

  -- A pre-funded admin-owned custody pot: the ledger's own 'Credit' choice (controller
  -- operator, guardianGovernance) alone seeds a non-empty balance without a full lock/transfer
  -- round trip.
  potCid <- mkHolding gg admin instrumentId 0.5
  lcid <- submit (actAs operator <> actAs gg) do
    createCmd LockedLedger with
      operator
      guardianGovernance = gg
      admin
      managerAddress
      balance = 0.0
      custodyHoldingCid = None
  _ <- submit (actAs operator <> actAs gg) do
    exerciseCmd lcid Credit with amount = 0.5, newCustodyHint = Some potCid

  -- gg's own standing pre-approval: the nested pot move's receiver is gg, and the mock
  -- registry's factory requires the RECEIVER's standing pre-approval unless sender == receiver
  -- (which doesn't apply here -- the sender is the deployment's admin).
  _ <- submit gg do
    createCmd MockTransferPreapproval with owner = gg, registryAdmin = gg, instrument = instrumentId

  _ <- proposeAdminTransferToGg ProposeAdminTransferToGgInput with
    admin
    managerId

  seam <- prepareAcceptAdmin PrepareAcceptAdminInput with
    guardianGovernance = gg
    managerId
    vaaBytes = acceptAdminHappyVAA
    discloseTemplates = acceptAdminDiscloseTemplates

  out <- acceptAdminTransferByVaa AcceptAdminTransferByVaaInput with
    operator
    managerId
    executor
    vaaBytes = acceptAdminHappyVAA
    pubKeys = [(0, devnetGuardianPubKey)]
    remote = Some seam

  out.admin === gg
  (_, mgrAfter) <- resolveManager operator managerId
  mgrAfter.admin === gg
  (_, ledgerAfter) <- resolveLedger operator managerAddress
  ledgerAfter.balance === 0.5

  -- The reserve moved to gg INTACT: gg now holds exactly what the admin held before the
  -- handoff, and the old admin holds none of it any more (mirrors the e2e suite's own
  -- balance-conservation assertion for this same handoff).
  ggCustody <- cip56HoldingsOwnedBy gg gg
  case ggCustody of
    [(_, h)] -> h.amount === 0.5
    _ -> abort ("expected exactly one gg-owned custody holding, got: " <> show ggCustody)
  adminCustody <- cip56HoldingsOwnedBy gg admin
  adminCustody === []
