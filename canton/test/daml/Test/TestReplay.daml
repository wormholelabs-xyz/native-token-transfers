-- | Tests for the replay-protection trie ('Wormhole.Core.Replay'), plus a
-- script-side simulation of the disclosure service: 'coveringNode' resolves the
-- unique active node whose prefix covers a digest (asserting the partition
-- invariant), and 'coveringDisclosure' packages it for a non-stakeholder.
-- Production runs the same logic off-ledger over an ACS index by
-- (consumer, namespace, prefix).
--
-- Trie tests use tiny thresholds so splits are cheap to reach (production uses
-- 'defaultSplitThreshold').
module Test.TestReplay where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.List (sort)
import DA.Optional (fromSome)
import DA.Set qualified as Set
import DA.Text qualified as T
import Wormhole.Core.Bytes
import Wormhole.Core.Replay
import Wormhole.Core.State
import Test.TestCore (claimedRootsNodeCovering, setup, govSetFeeVAA)

-- | Right-pad a hex fragment with zeros to a full 64-nibble digest.
pad64 : Text -> VaaDigest
pad64 t = parseHexTextOrAbort (t <> mconcat (replicate (64 - T.length t) "0"))

-- | The suffix of @digest@ under a node prefix of @prefixNibbles@ nibbles.
suffixAfter : Int -> VaaDigest -> DigestNibbleSuffix
suffixAfter prefixNibbles digest = parseHexTextOrAbort (T.drop prefixNibbles (hexTextOf digest))

nibblePrefix : Text -> DigestNibblePrefix
nibblePrefix = parseHexTextOrAbort

nibbles : [Text]
nibbles = T.explode "0123456789abcdef"

-- | The single namespace most tests run under.
ns : Text
ns = "test"

-- | Consumer-submitted root claim: the consumer holds the static disclosure of
-- the 'ReplayRootRegistry' anchor and submits alone.
-- @payer = consumer@: a direct claim is its own payer, controller set collapses.
registerReplayRoot : Party -> Party -> Text -> Int -> Script (ContractId ReplayNode)
registerReplayRoot guardianGovernance consumer namespace threshold = do
  [(regCid, _)] <- query @ReplayRootRegistry guardianGovernance
  regDisc <- fromSome <$> queryDisclosure guardianGovernance regCid
  (claimedRootsNodeCid, claimedRootsNodeDisclosure) <- claimedRootsNodeCovering guardianGovernance consumer namespace
  submit (actAs consumer <> disclose regDisc <> disclose claimedRootsNodeDisclosure) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer
      namespace
      splitThreshold = threshold
      payer = consumer
      coreStateCid = None    -- claimFee is 0 in the fixture
      feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
      claimedRootsNodeCid

-- | The disclosure-service lookup: the unique active node of @consumer@'s
-- @namespace@ trie covering @digest@. Aborts unless coverage is exactly one —
-- checking the partition invariant and detecting a forked trie (parallel
-- roots).
coveringNode : Party -> Text -> VaaDigest -> Script (ContractId ReplayNode, ReplayNode)
coveringNode consumer namespace digest = do
  nodes <- query @ReplayNode consumer
  let digestHex = hexTextOf digest
  case filter (\(_, n) -> n.consumer == consumer && n.namespace == namespace && hexTextOf n.prefix `T.isPrefixOf` digestHex) nodes of
    [one] -> pure one
    covering -> abort ("partition invariant violated: " <> show (length covering) <> " covering nodes")

-- | 'coveringNode' plus the disclosure a non-stakeholder attaches. @reader@ is
-- any party that sees the node.
coveringDisclosure : Party -> Party -> Text -> VaaDigest -> Script (ContractId ReplayNode, Disclosure)
coveringDisclosure reader consumer namespace digest = do
  (cid, _) <- coveringNode consumer namespace digest
  disc <- fromSome <$> queryDisclosure reader cid
  pure (cid, disc)

-- | Consume @digest@ into @consumer@'s @namespace@ trie via the
-- disclosure-service lookup.
consume : Party -> Text -> VaaDigest -> Script (ContractId ReplayNode)
consume consumer namespace digest = do
  (cid, _) <- coveringNode consumer namespace digest
  submit consumer do exerciseCmd cid ConsumeDigest with digest

consumeMustFail : Party -> Text -> VaaDigest -> Script ()
consumeMustFail consumer namespace digest = do
  (cid, _) <- coveringNode consumer namespace digest
  submitMustFail consumer do exerciseCmd cid ConsumeDigest with digest

-- | Fixture: bridge + one consumer with a threshold-@t@ trie root under 'ns'.
setupTrie : Int -> Script (Party, Party, ContractId ReplayNode)
setupTrie t = do
  (gg, _) <- setup
  consumer <- allocateParty "TrieConsumer"
  rootCid <- registerReplayRoot gg consumer ns t
  pure (gg, consumer, rootCid)

-- | Inserts land in the root and replays are rejected.
testTrieInsertAndReplay : Script ()
testTrieInsertAndReplay = do
  (_, consumer, _) <- setupTrie 4
  let dA = pad64 "a1"
      dB = pad64 "b2"
      dC = pad64 "c3"
  cid1 <- consume consumer ns dA
  (cid1', _) <- coveringNode consumer ns dB
  cid1' === cid1
  _ <- consume consumer ns dB
  _ <- consume consumer ns dC
  (_, root) <- coveringNode consumer ns dA
  root.prefix === nibblePrefix ""
  Set.size root.consumed === 3
  consumeMustFail consumer ns dA

-- | The consume that exceeds the threshold splits the node into exactly 16
-- children (empties included), suffixes bucketed by dropped first nibble; the
-- parent is archived.
testTrieSplit : Script ()
testTrieSplit = do
  (_, consumer, _) <- setupTrie 4
  let ds = map pad64 ["a1", "b2", "c3", "d4"]
  forA_ ds (consume consumer ns)
  -- 5th consume: 4 == threshold, so the root splits.
  childCid <- consume consumer ns (pad64 "e5")
  nodes <- query @ReplayNode consumer
  length nodes === 16
  sort (map (\(_, n) -> n.prefix) nodes) === map nibblePrefix nibbles
  -- All children inherit the parent's namespace.
  forA_ nodes \(_, n) -> n.namespace === ns
  -- Buckets: each consumed digest's suffix sits in its first-nibble child,
  -- nibble dropped; unused children are empty.
  forA_ nodes \(cid, n) -> case hexTextOf n.prefix of
    "a" -> do Set.toList n.consumed === [suffixAfter 1 (pad64 "a1")]
    "e" -> do
      Set.toList n.consumed === [suffixAfter 1 (pad64 "e5")]
      cid === childCid
    "b" -> Set.size n.consumed === 1
    "c" -> Set.size n.consumed === 1
    "d" -> Set.size n.consumed === 1
    _   -> Set.size n.consumed === 0
  -- Post-split, both old and new digests remain replay-protected.
  consumeMustFail consumer ns (pad64 "a1")
  consumeMustFail consumer ns (pad64 "e5")
  -- A fresh digest under a now-empty child inserts normally.
  _ <- consume consumer ns (pad64 "f6")
  pure ()

-- | Digests sharing a first nibble force an over-threshold child at the first
-- split (legal and transient); its next consume splits it one level deeper.
testMultiLevelSplit : Script ()
testMultiLevelSplit = do
  (_, consumer, _) <- setupTrie 2
  forA_ (map pad64 ["f0", "f1"]) (consume consumer ns)
  -- Third consume splits the root; all three suffixes share the 'f' bucket.
  _ <- consume consumer ns (pad64 "f2")
  (_, childF) <- coveringNode consumer ns (pad64 "f0")
  childF.prefix === nibblePrefix "f"
  Set.size childF.consumed === 3   -- over the threshold of 2, by design
  -- Fourth consume under 'f' splits the over-full child into grandchildren.
  _ <- consume consumer ns (pad64 "f3")
  nodes <- query @ReplayNode consumer
  length nodes === 31   -- 15 depth-1 siblings + 16 depth-2 children of "f"
  (_, gf) <- coveringNode consumer ns (pad64 "f2")
  gf.prefix === nibblePrefix "f2"
  Set.toList gf.consumed === [suffixAfter 2 (pad64 "f2")]
  -- Replay still rejected across both levels.
  consumeMustFail consumer ns (pad64 "f0")
  consumeMustFail consumer ns (pad64 "f3")

-- | Input hygiene: a 'VaaDigest' has one form, so uppercase and malformed
-- digests fail to parse (the core forged-value test covers the Ledger API).
testDigestValidation : Script ()
testDigestValidation = do
  (_, consumer, rootCid) <- setupTrie 4
  _ <- consume consumer ns (pad64 "ab")
  forA_ [ ("uppercase", "AB" <> mconcat (replicate 62 "0"), "VaaDigest: not lowercase hex")
        , ("too short", mconcat (replicate 63 "0"), "VaaDigest: odd hex length 63")
        , ("too long", mconcat (replicate 66 "0"), "VaaDigest: expected 32 bytes, got 66 hex characters")
        , ("0x prefix", "0x" <> mconcat (replicate 62 "0"), "VaaDigest: not lowercase hex")
        , ("not hex", "g" <> mconcat (replicate 63 "0"), "VaaDigest: not lowercase hex")
        ] \(label, badHex, expectedError) ->
    assertMsg ("digest case " <> label) (parseHexText @VaaDigest badHex == Left expectedError)
  -- rootCid is stale after the first consume: distinct failure from hygiene.
  submitMustFail consumer do exerciseCmd rootCid ConsumeDigest with digest = pad64 "cd"

-- | A node rejects digests outside its prefix (the wrong-node case); the digest
-- stays consumable via the right node.
testWrongNodeRejected : Script ()
testWrongNodeRejected = do
  (_, consumer, _) <- setupTrie 4
  forA_ (map pad64 ["a0", "b1", "c2", "d3", "e4"]) (consume consumer ns)  -- forces the split
  (wrongCid, wrong) <- coveringNode consumer ns (pad64 "a0")
  wrong.prefix === nibblePrefix "a"
  submitMustFail consumer do exerciseCmd wrongCid ConsumeDigest with digest = pad64 "b9"
  _ <- consume consumer ns (pad64 "b9")
  pure ()

-- | The retry protocol: a consume against a stale cid fails on activeness; the
-- retry against the fresh node succeeds; a blind retry of a committed consume
-- fails on membership — never a double consume.
testStaleCidAndRetry : Script ()
testStaleCidAndRetry = do
  (_, consumer, rootCid) <- setupTrie 4
  _ <- submit consumer do exerciseCmd rootCid ConsumeDigest with digest = pad64 "11"
  -- rootCid is now archived: a consume of a DIFFERENT digest against it fails.
  submitMustFail consumer do exerciseCmd rootCid ConsumeDigest with digest = pad64 "22"
  -- Retry against the fresh covering node succeeds.
  _ <- consume consumer ns (pad64 "22")
  -- Ambiguous-timeout case: the original commit actually landed; the blind
  -- retry hits the membership check, a clean idempotency signal.
  consumeMustFail consumer ns (pad64 "11")

-- | Depth-63 nodes only insert, never split (single-nibble suffixes, bounded at
-- 16); the 'ensure' shape invariants reject degenerate nodes.
testDepth63NeverSplits : Script ()
testDepth63NeverSplits = do
  (gg, consumer, _) <- setupTrie 4
  let deepPrefixHex = mconcat (replicate 63 "f")
  -- Direct creation needs both signatories — fine for a test fixture.
  deepCid <- submit (actAs consumer <> actAs gg) do
    createCmd ReplayNode with
      consumer, guardianGovernance = gg, namespace = ns, prefix = nibblePrefix deepPrefixHex, splitThreshold = 1, consumed = Set.empty
  -- Two inserts exceed threshold 1, yet the node never splits.
  deepCid' <- submit consumer do exerciseCmd deepCid ConsumeDigest with digest = parseHexTextOrAbort (deepPrefixHex <> "0")
  deepCid'' <- submit consumer do exerciseCmd deepCid' ConsumeDigest with digest = parseHexTextOrAbort (deepPrefixHex <> "1")
  Some deep <- queryContractId consumer deepCid''
  deep.prefix === nibblePrefix deepPrefixHex
  Set.size deep.consumed === 2
  submitMustFail consumer do exerciseCmd deepCid'' ConsumeDigest with digest = parseHexTextOrAbort (deepPrefixHex <> "0")
  -- Depth-64 prefixes fail to parse; non-positive thresholds and wrong-length
  -- suffixes fail the ensure.
  parseHexText @DigestNibblePrefix (hexTextOf (pad64 ""))
    === Left "DigestNibblePrefix: expected 0 to 63 nibbles, got 64"
  submitMustFail (actAs consumer <> actAs gg) do
    createCmd ReplayNode with
      consumer, guardianGovernance = gg, namespace = ns, prefix = nibblePrefix "", splitThreshold = 0, consumed = Set.empty
  submitMustFail (actAs consumer <> actAs gg) do
    createCmd ReplayNode with
      consumer, guardianGovernance = gg, namespace = ns, prefix = nibblePrefix "", splitThreshold = 4
      consumed = Set.fromList [parseHexTextOrAbort "00"]

-- | Scopes are independent, authorization per-consumer: one party can neither
-- advance another's trie nor be affected by it.
testCrossConsumerScopes : Script ()
testCrossConsumerScopes = do
  (gg, alice, _) <- setupTrie 4
  bob <- allocateParty "TrieBob"
  _ <- registerReplayRoot gg bob ns 4
  _ <- consume alice ns (pad64 "aa")
  -- Bob cannot exercise Alice's node, even seeing it via disclosure.
  (aliceCid, _) <- coveringNode alice ns (pad64 "bb")
  aliceDisc <- fromSome <$> queryDisclosure alice aliceCid
  submitMustFail (actAs bob <> disclose aliceDisc) do
    exerciseCmd aliceCid ConsumeDigest with digest = pad64 "bb"
  -- The same digest consumes independently in Bob's own trie.
  _ <- consume bob ns (pad64 "aa")
  pure ()

-- | Nodes are co-signed: neither consumer nor guardianGovernance can archive a node alone.
testNodeArchiveNeedsBoth : Script ()
testNodeArchiveNeedsBoth = do
  (gg, consumer, rootCid) <- setupTrie 4
  submitMustFail consumer do archiveCmd rootCid
  submitMustFail gg do archiveCmd rootCid
  -- Both together can — coverage for the auto-generated Archive choices.
  submit (actAs consumer <> actAs gg) do archiveCmd rootCid
  [(regCid, _)] <- query @ReplayRootRegistry gg
  submit gg do archiveCmd regCid

-- | Root claims are free and self-serve; the registry pins WHOSE scope a claim
-- touches. Claiming for a consumer needs that consumer's authority — nobody can
-- fork someone else's scope. A second claim of one (consumer, namespace) fails
-- with "digest already consumed". Roots can't be minted outside the registry —
-- the consumer alone lacks the guardianGovernance signature.
testRootClaims : Script ()
testRootClaims = do
  (gg, consumer, rootCid) <- setupTrie 4
  Some root <- queryContractId consumer rootCid
  root.prefix === nibblePrefix ""
  root.splitThreshold === 4
  Set.size root.consumed === 0
  [(regCid, _)] <- query @ReplayRootRegistry gg
  regDisc <- fromSome <$> queryDisclosure gg regCid
  -- A third party cannot claim a root for someone else's scope.
  mallory <- allocateParty "TrieMallory"
  (malloryNodeCid, malloryNodeDisc) <- claimedRootsNodeCovering gg consumer "mallory-scope"
  submitMustFail (actAs mallory <> disclose regDisc <> disclose malloryNodeDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer
      namespace = "mallory-scope"
      splitThreshold = 4
      payer = consumer
      coreStateCid = None
      feeAllocation = None
      expectedGuardianGovernance = gg
      claimedRootsNodeCid = malloryNodeCid
  -- The consumer cannot duplicate its own root.
  (duplicateNodeCid, duplicateNodeDisc) <- claimedRootsNodeCovering gg consumer ns
  duplicateResult <- trySubmit (actAs consumer <> disclose regDisc <> disclose duplicateNodeDisc) do
    exerciseCmd regCid ClaimReplayRoot with
      consumer
      namespace = ns
      splitThreshold = 4
      payer = consumer
      coreStateCid = None
      feeAllocation = None
      expectedGuardianGovernance = gg
      claimedRootsNodeCid = duplicateNodeCid
  case duplicateResult of
    Left (FailureStatusError failure) -> assertMsg ("duplicate root: " <> failure.message) ("digest already consumed" `T.isInfixOf` failure.message)
    Left submitError -> abort ("duplicate root: unexpected rejection " <> show submitError)
    Right _ -> abort "duplicate root committed"
  roots <- query @ReplayNode consumer
  length roots === 1
  -- The consumer cannot create a co-signed node alone.
  submitMustFail consumer do
    createCmd ReplayNode with
      consumer, guardianGovernance = gg, namespace = ns, prefix = nibblePrefix "", splitThreshold = 4, consumed = Set.empty

-- | End-to-end verify + consume through 'VerifyAndConsumeVAA' with a real
-- guardian-signed VAA: replay fails on membership; a second consumer has its own
-- scope; nodes outside the (consumer, namespace, guardianGovernance) scope are rejected.
testVerifyAndConsumeVAA : Script ()
testVerifyAndConsumeVAA = do
  (gg, csId) <- setup
  ntt <- allocateParty "NttManager"
  rootCid <- registerReplayRoot gg ntt ns defaultSplitThreshold
  csDisc <- fromSome <$> queryDisclosure gg csId
  (vaa, nodeCid) <- submit (actAs ntt <> disclose csDisc) do
    exerciseCmd csId VerifyAndConsumeVAA with
      encodedVAA = govSetFeeVAA
      consumer = ntt
      namespace = ns
      replayNodeCid = rootCid
  Some node <- queryContractId ntt nodeCid
  Set.member (suffixAfter 0 vaa.hash) node.consumed === True
  -- Replay: resolve the FRESH covering node, still rejected (membership).
  (freshCid, _) <- coveringNode ntt ns vaa.hash
  freshCid === nodeCid
  submitMustFail (actAs ntt <> disclose csDisc) do
    exerciseCmd csId VerifyAndConsumeVAA with
      encodedVAA = govSetFeeVAA
      consumer = ntt
      namespace = ns
      replayNodeCid = freshCid
  -- A different consumer party consumes the same VAA in its own trie.
  other <- allocateParty "OtherApp"
  otherRoot <- registerReplayRoot gg other ns defaultSplitThreshold
  _ <- submit (actAs other <> disclose csDisc) do
    exerciseCmd csId VerifyAndConsumeVAA with
      encodedVAA = govSetFeeVAA
      consumer = other
      namespace = ns
      replayNodeCid = otherRoot
  -- Consumer mismatch: ntt cannot consume into other's trie.
  (otherFresh, _) <- coveringNode other ns vaa.hash
  otherDisc <- fromSome <$> queryDisclosure other otherFresh
  submitMustFail (actAs ntt <> disclose csDisc <> disclose otherDisc) do
    exerciseCmd csId VerifyAndConsumeVAA with
      encodedVAA = govSetFeeVAA
      consumer = ntt
      namespace = ns
      replayNodeCid = otherFresh
  -- guardianGovernance mismatch: a shadow trie co-signed by a rogue gg is
  -- rejected even though the consumer authority and namespace match.
  rogueGuardianGovernance <- allocateParty "RogueGuardianGovernance"
  shadowCid <- submit (actAs ntt <> actAs rogueGuardianGovernance) do
    createCmd ReplayNode with
      consumer = ntt, guardianGovernance = rogueGuardianGovernance, namespace = ns, prefix = nibblePrefix ""
      splitThreshold = 4, consumed = Set.empty
  submitMustFail (actAs ntt <> disclose csDisc) do
    exerciseCmd csId VerifyAndConsumeVAA with
      encodedVAA = govSetFeeVAA
      consumer = ntt
      namespace = ns
      replayNodeCid = shadowCid
