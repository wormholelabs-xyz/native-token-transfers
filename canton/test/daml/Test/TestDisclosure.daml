-- | Tests for 'Test.Disclosure', the per-flow disclosure-set library.
--
-- Two proof obligations per flow, run against the real NTT choices (never a
-- mock of the visibility check):
--
--   1. SUFFICIENCY: a fresh executor party -- a stakeholder of nothing --
--      submits with only the library's disclosures attached, actAs alone.
--      Where a flow's happy path needs a receive VAA whose recipientAddress
--      binds to a live, freshly allocated Party (Release, Mint), no static
--      fixture can complete it; the submission is required to fail with the
--      documented DEEPEST reachable abort instead, which proves every
--      visibility-sensitive fetch before that point already succeeded.
--   2. MINIMALITY: for every disclosure the flow's abort/success actually
--      depends on, dropping it alone must turn the same submission into a
--      failure. Elements that sit past an unreachable gate are excluded from
--      this drop-one (dropping an unused disclosure never changes an
--      outcome) and are called out below instead.
--
-- KNOWN LIMITS (both stem from the same cause: a receive VAA's
-- recipientAddress must equal keccak256 of a Party id that does not exist
-- until Daml Script allocates it, so no static fixture can drive these
-- choices to a full commit):
--
--   * Release's custody-pot 'Holding' and committed 'TransferFactory' legs
--     are fetched only once 'verifyInboundTransfer' succeeds. They are
--     pinned instead via 'AcceptAdminTransferByVaa' on a LockUnlock
--     deployment carrying a real, nonzero-balance pot: 'TransferAdmin's own
--     LockUnlock branch calls the identical 'sumCustodyHoldings' /
--     'requireTransferFactory' pair Release does, off a deterministic VAA
--     (accept-admin's binding is a fixed manager address, not a party
--     fingerprint).
--   * Mint's 'DepositPreapproval' and committed 'BurnMintFactory' legs have
--     no such proxy -- no other choice fetches them under a deterministic
--     VAA. They are included in 'mintDisclosures' output (the canonical
--     allow-list a real relayer needs) and proven sufficient, but their
--     necessity is established only by reading 'NttManager.Mint': it fetches
--     both strictly after the recipient check, so this file's drop-one
--     covers only the reachable prefix [NttManager, CoreState, ReplayNode].
--     The full path is exercised by the live, Go-signed
--     'Test.TestNtt.integrationNttReceiveMatch' harness.
--
-- registerDisclosures' ByVaa-only CoinFactory leg has the same shape: no
-- static registration VAA can satisfy 'nttRegistrationBindingFor' (see
-- 'Test.TestNtt.testRegisterManagerByVaaBindingMismatch'), so it is proven
-- via 'SetFactoryByVaa' instead, which runs the identical
-- 'requireCanonicalFactory' check off a deterministic rotation VAA.
module Test.TestDisclosure where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (fromSome)

import Splice.Api.Token.BurnMintV1 (BurnMintFactory)
import Splice.Api.Token.TransferInstructionV1 (TransferFactory)

import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Core.VAA (parseVAA)
import Wormhole.Ntt.Deposit (DepositPreapproval(..))
import Wormhole.Ntt.Governance (NttGovernance, RegisterManager(..))
import Wormhole.Ntt.Ledger (LockedLedger(..))
import Wormhole.Ntt.Manager
import Test.TestReplay (coveringDisclosure)
import Test.TestCore (devnetGuardianPubKey)
import Test.TestNtt

import Test.Disclosure

----------------------------------------------------------------------
-- Shared minimality helper
----------------------------------------------------------------------

-- | For each labeled index into @discs@, resubmit @run@ with that one
-- disclosure dropped and require failure. A label ties a failing case back
-- to the element whose absence broke it. Callers check the FULL set's
-- outcome (success or the documented abort) separately -- this only proves
-- every element is load-bearing.
dropOneMustFail : [Text] -> [Disclosure] -> ([Disclosure] -> Script (Either SubmitError a)) -> Script ()
dropOneMustFail labels discs run = do
  assertMsg "dropOneMustFail: one label per disclosure" (length labels == length discs)
  assertMsg "dropOneMustFail: at least one disclosure to drop" (not (null discs))
  forA_ (zip [0 .. length labels - 1] labels) \(i, label) -> do
    let trial = [ d | (j, d) <- zip [0 .. length discs - 1] discs, j /= i ]
    res <- run trial
    case res of
      Left _ -> pure ()
      Right _ -> abort ("minimality violated: dropping '" <> label <> "' still succeeded")

----------------------------------------------------------------------
-- releaseDisclosures
----------------------------------------------------------------------

-- | Reachable prefix: a stranger relayer gets all the way to the
-- recipient-binding check, the deepest abort a static fixture can reach.
-- Dropping any of the four elements the check actually depends on turns that
-- abort into an earlier, visibility-related failure; the fifth element
-- (committed TransferFactory -- there is no pot yet at this fixture's zero
-- balance) sits past the check and is excluded, per the module header.
testReleaseDisclosuresReachablePrefix : Script ()
testReleaseDisclosuresReachablePrefix = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "RelDiscAdmin"
  relayer <- allocateParty "RelDiscRelayer"
  wrongRecipient <- allocateParty "RelDiscWrongRecipient"
  (mgrCid, _, ledgerCid) <- setupFixedManager operator gg admin LockUnlock csId
  let lcid = fromSome ledgerCid
  (nodeCid, discs) <- releaseDisclosures operator gg mgrCid csId lcid nttTransferDigest
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
  length discs === 5

  let cmd trial = trySubmitWithDiscs relayer trial do
        exerciseCmd mgrCid Release with
          executor = relayer
          coreStateCid = csId
          replayNodeCid = nodeCid
          vaaBytes = nttTransferVAA
          pubKeys = [(0, devnetGuardianPubKey)]
          recipient = wrongRecipient
          ledgerCid = lcid
          inputHoldingCids = []
          extraArgs = emptyExtraArgs

  res <- cmd discs
  expectAbort "recipient does not match" res

  dropOneMustFail
    ["NttManager", "CoreState", "covering ReplayNode", "LockedLedger"]
    (take 4 discs)
    cmd

-- | The custody-pot Holding and committed TransferFactory legs, pinned via
-- 'AcceptAdminTransferByVaa' on a real, nonzero-balance LockUnlock
-- deployment -- see the module header.
testReleaseDisclosuresPotAndFactoryLegs : Script ()
testReleaseDisclosuresPotAndFactoryLegs = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "RelDiscPotAdmin"
  relayer <- allocateParty "RelDiscPotRelayer"
  (mgrCid0, _, ledgerCid) <- setupFixedManager operator gg admin LockUnlock csId
  let lcid = fromSome ledgerCid
  Some mgr0 <- queryContractId operator mgrCid0
  emitterCid0 <- resolveEmitter gg mgr0.transceiverEmitterId
  csDisc <- fromSome <$> queryDisclosure operator csId
  emitterDisc0 <- fromSome <$> queryDisclosure operator emitterCid0
  (mgrCid, _) <- submit (actAs admin <> disclose csDisc <> disclose emitterDisc0) do
    exerciseCmd mgrCid0 SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc", decimals = 8
      transceiverEmitterCid = emitterCid0
      coreStateCid = csId
      consistencyLevel = 0
      payer = admin
      feeAllocation = None
  Some mgr1 <- queryContractId operator mgrCid
  emitterCid1 <- resolveEmitter gg mgr1.transceiverEmitterId
  -- Admin locks its own tokens: a nonzero balance and a real custody pot.
  -- The mock factory can only create a receiver holding when the receiver's
  -- signature is reachable -- here, the sender's own.
  holding <- mkHolding gg admin (bridgedInstrument gg) 1.0
  emitterDisc1 <- fromSome <$> queryDisclosure operator emitterCid1
  factoryDisc <- discloseTransferFactory gg
  _ <- submit (actAs admin <> disclose csDisc <> disclose emitterDisc1 <> disclose factoryDisc) do
    exerciseCmd mgrCid Transfer with
      user = admin
      transceiverEmitterCid = emitterCid1
      coreStateCid = csId
      ledgerCid = Some lcid
      recipientChain = 2
      recipientAddress = b32 "ee"
      rawAmount = 1000000
      nonce = 0
      consistencyLevel = 0
      inputHoldingCids = [holding]
      feeAllocation = None
      extraArgs = emptyExtraArgs
  -- 'Credit' is consuming: the lock churns the ledger cid, so re-resolve it.
  [(freshLcid, ledgerAfterLock)] <- query @LockedLedger operator
  ledgerAfterLock.balance === 0.01
  assertMsg "expected a custody pot after the lock" (ledgerAfterLock.custodyHoldingCid /= None)

  propCid <- submit admin do
    createCmd AdminTransferProposal with admin, newAdmin = gg, managerAddress = mgr1.managerAddress
  (nodeCid, discs) <- acceptAdminDisclosures operator gg admin mgrCid csId propCid (Some freshLcid) (parseVAA acceptAdminHappyVAA).hash
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
  length discs === 7   -- NttManager, CoreState, node, proposal, LockedLedger, pot, TransferFactory

  let cmd trial = trySubmitWithDiscs relayer trial do
        exerciseCmd mgrCid AcceptAdminTransferByVaa with
          executor = relayer
          proposalCid = propCid
          coreStateCid = csId
          replayNodeCid = nodeCid
          vaaBytes = acceptAdminHappyVAA
          pubKeys = [(0, devnetGuardianPubKey)]
          ledgerCid = Some freshLcid
          extraArgs = emptyExtraArgs

  dropOneMustFail
    [ "NttManager", "CoreState", "covering ReplayNode", "AdminTransferProposal"
    , "LockedLedger", "custody pot Holding", "committed TransferFactory" ]
    discs
    cmd

  Right (mgrCid', ledgerCid') <- cmd discs
  Some mgrDone <- queryContractId operator mgrCid'
  mgrDone.admin === gg
  Some ledgerDone <- queryContractId operator (fromSome ledgerCid')
  ledgerDone.balance === 0.01

----------------------------------------------------------------------
-- mintDisclosures
----------------------------------------------------------------------

-- | Reachable prefix only; DepositPreapproval and the committed
-- BurnMintFactory are included in the returned set but not drop-one tested
-- here -- see the module header.
testMintDisclosuresReachablePrefix : Script ()
testMintDisclosuresReachablePrefix = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "MintDiscAdmin"
  relayer <- allocateParty "MintDiscRelayer"
  recipient <- allocateParty "MintDiscRecipient"
  wrongRecipient <- allocateParty "MintDiscWrongRecipient"
  (mgrCid, _, _) <- setupFixedManager operator gg admin BurnMint csId
  preapprovalCid <- submit recipient do
    createCmd DepositPreapproval with owner = recipient, instrumentId = bridgedInstrument gg
  (nodeCid, discs) <- mintDisclosures operator gg mgrCid csId preapprovalCid nttTransferDigest
    (discloseConcrete @MockBurnMintFactory gg "committed BurnMintFactory")
  length discs === 5

  let cmd trial = trySubmitWithDiscs relayer trial do
        exerciseCmd mgrCid Mint with
          executor = relayer
          coreStateCid = csId
          replayNodeCid = nodeCid
          vaaBytes = nttTransferVAA
          pubKeys = [(0, devnetGuardianPubKey)]
          recipient = wrongRecipient
          depositPreapprovalCid = preapprovalCid
          extraArgs = emptyExtraArgs

  res <- cmd discs
  expectAbort "recipient does not match" res

  dropOneMustFail
    ["NttManager", "CoreState", "covering ReplayNode"]
    (take 3 discs)
    cmd

----------------------------------------------------------------------
-- acceptAdminDisclosures
----------------------------------------------------------------------

testAcceptAdminDisclosuresBurnMint : Script ()
testAcceptAdminDisclosuresBurnMint = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "AcceptDiscBurnAdmin"
  relayer <- allocateParty "AcceptDiscBurnRelayer"
  fx <- acceptAdminFixture operator gg admin BurnMint csId
  (nodeCid, discs) <- acceptAdminDisclosures operator gg admin fx.mgrCid csId fx.propCid fx.ledgerCid (parseVAA acceptAdminHappyVAA).hash
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
  length discs === 4

  let cmd trial = trySubmitWithDiscs relayer trial do
        acceptAdminByVaaCmd relayer fx csId nodeCid acceptAdminHappyVAA

  dropOneMustFail ["NttManager", "CoreState", "covering ReplayNode", "AdminTransferProposal"] discs cmd

  Right (mgrCid', _) <- cmd discs
  Some mgr <- queryContractId operator mgrCid'
  mgr.admin === gg

-- | LockUnlock at zero balance: LockedLedger is always disclosed (it is
-- always fetched to hand over observership), but there is no pot yet, so
-- no pot/factory leg is present -- length 5, not 7.
testAcceptAdminDisclosuresLockUnlockZeroBalance : Script ()
testAcceptAdminDisclosuresLockUnlockZeroBalance = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "AcceptDiscLockAdmin"
  relayer <- allocateParty "AcceptDiscLockRelayer"
  fx <- acceptAdminFixture operator gg admin LockUnlock csId
  (nodeCid, discs) <- acceptAdminDisclosures operator gg admin fx.mgrCid csId fx.propCid fx.ledgerCid (parseVAA acceptAdminHappyVAA).hash
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
  length discs === 5

  let cmd trial = trySubmitWithDiscs relayer trial do
        acceptAdminByVaaCmd relayer fx csId nodeCid acceptAdminHappyVAA

  dropOneMustFail
    ["NttManager", "CoreState", "covering ReplayNode", "AdminTransferProposal", "LockedLedger"]
    discs
    cmd

  Right (mgrCid', ledgerCid') <- cmd discs
  Some mgr <- queryContractId operator mgrCid'
  mgr.admin === gg
  Some ledger <- queryContractId operator (fromSome ledgerCid')
  ledger.balance === 0.0

----------------------------------------------------------------------
-- setPeerByVaaDisclosures
----------------------------------------------------------------------

testSetPeerByVaaDisclosures : Script ()
testSetPeerByVaaDisclosures = do
  (operator, gg, csId) <- nttSetup
  relayer <- allocateParty "SetPeerDiscRelayer"
  (mgrCid, _, _) <- setupFixedManagerOn operator gg gg BurnMint cantonChainId csId
  Some mgr <- queryContractId operator mgrCid
  emitterCid <- resolveEmitter gg mgr.transceiverEmitterId
  (nodeCid, discs) <- setPeerByVaaDisclosures operator gg mgrCid csId emitterCid (parseVAA setPeerHappyVAA).hash
  length discs === 4

  let cmd trial = trySubmitWithDiscs relayer trial do
        exerciseCmd mgrCid SetPeerByVaa with
          executor = relayer
          coreStateCid = csId
          replayNodeCid = nodeCid
          vaaBytes = setPeerHappyVAA
          pubKeys = [(0, devnetGuardianPubKey)]
          transceiverEmitterCid = emitterCid
          consistencyLevel = 0
          feeAllocation = None

  dropOneMustFail ["NttManager", "CoreState", "transceiver Emitter", "covering ReplayNode"] discs cmd

  Right (mgrCid', _) <- cmd discs
  Some mgrDone <- queryContractId operator mgrCid'
  Map.lookup 3 mgrDone.peers
    === Some (Peer with managerAddress = b32 "dd", transceiverAddress = b32 "ee", decimals = 9)

----------------------------------------------------------------------
-- transferDisclosures
----------------------------------------------------------------------

-- | LockUnlock, cross-hosted user: bob is a stakeholder of nothing. Admin is
-- handed to gg first -- the mock factory can only create a receiver holding
-- when the receiver's signature is reachable (the sender's own, or gg's).
testTransferDisclosuresLockUnlockCrossHostedUser : Script ()
testTransferDisclosuresLockUnlockCrossHostedUser = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "XferDiscAdmin"
  bob <- allocateParty "XferDiscBob"
  d <- deploy operator gg admin LockUnlock csId
  csDisc0 <- fromSome <$> queryDisclosure operator csId
  emitterDisc0 <- fromSome <$> queryDisclosure operator d.emitterCid
  (mgrCid0, _) <- submit (actAs admin <> disclose csDisc0 <> disclose emitterDisc0) do
    exerciseCmd d.mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc", decimals = 8
      transceiverEmitterCid = d.emitterCid
      coreStateCid = csId
      consistencyLevel = 0
      payer = admin
      feeAllocation = None
  Some mgrPostSetPeer <- queryContractId operator mgrCid0
  emitterCid <- resolveEmitter gg mgrPostSetPeer.transceiverEmitterId
  (mgrCid, ledgerCid') <- submit (actAs admin <> actAs gg) do
    exerciseCmd mgrCid0 TransferAdmin with
      newAdmin = gg
      ledgerCid = Some (fromSome d.ledgerCid)
      vettedFactory = d.factory
      extraArgs = emptyExtraArgs
  let d' = d with mgrCid, ledgerCid = ledgerCid', emitterCid

  discs <- transferDisclosures operator gg mgrCid emitterCid csId ledgerCid'
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
    (discloseConcrete @MockBurnMintFactory gg "committed BurnMintFactory")
  length discs === 5   -- NttManager, Emitter, CoreState, LockedLedger, TransferFactory -- no pot on the first lock

  holding <- mkHolding gg bob d'.instrumentId 0.01
  let cmd trial = trySubmitWithDiscs bob trial do sendTransfer bob d' csId [holding]

  dropOneMustFail
    ["NttManager", "transceiver Emitter", "CoreState", "LockedLedger", "committed TransferFactory"]
    discs
    cmd

  _ <- submitWithDiscs bob discs do sendTransfer bob d' csId [holding]
  [(_, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.01

-- | BurnMint, cross-hosted user: burning needs no receiver-signature
-- workaround, since the burner spends and keeps its own change.
testTransferDisclosuresBurnMintCrossHostedUser : Script ()
testTransferDisclosuresBurnMintCrossHostedUser = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "XferBurnDiscAdmin"
  bob <- allocateParty "XferBurnDiscBob"
  (d, _) <- sendScaffold operator gg admin BurnMint csId
  holding <- mkHolding gg bob d.instrumentId 0.01

  discs <- transferDisclosures operator gg d.mgrCid d.emitterCid csId None
    (discloseConcrete @Cip56MockHolding gg "custody pot Holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
    (discloseConcrete @MockBurnMintFactory gg "committed BurnMintFactory")
  length discs === 4   -- NttManager, Emitter, CoreState, BurnMintFactory

  let cmd trial = trySubmitWithDiscs bob trial do sendTransfer bob d csId [holding]
  dropOneMustFail ["NttManager", "transceiver Emitter", "CoreState", "committed BurnMintFactory"] discs cmd

  _ <- submitWithDiscs bob discs do sendTransfer bob d csId [holding]
  remaining <- cip56HoldingsOwnedBy gg bob
  remaining === []   -- exact burn, no change

----------------------------------------------------------------------
-- registerDisclosures
----------------------------------------------------------------------

-- | Plain, admin-driven RegisterManager: fully reachable, so all four base
-- elements are directly drop-one tested.
testRegisterDisclosuresDirect : Script ()
testRegisterDisclosuresDirect = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "RegDiscAdmin"
  fc <- submit gg do createCmd MockTransferFactory with admin = gg, pending = False, skim = 0.0
  let factory = TransferFactoryCid (toInterfaceContractId @TransferFactory fc)
  [(govCid, _)] <- query @NttGovernance operator
  (emReg, _, rrReg, _) <- coreRegistries operator
  discs <- registerDisclosures operator gg govCid emReg rrReg csId None
  length discs === 4

  let cmd trial = trySubmitWithDiscs admin trial do
        exerciseCmd govCid RegisterManager with
          admin
          chainId = cantonChainId
          emitterRegistryCid = emReg
          replayRootRegistryCid = rrReg
          instrumentId = bridgedInstrument gg
          instrumentNonce = 0
          tokenConfig = LockUnlock
          tokenDecimals = 8
          factory
          coreStateCid = csId
          consistencyLevel = 0
          emitterFeeAllocation = None
          claimFeeAllocation = None
          feeAllocation = None

  dropOneMustFail ["NttGovernance", "EmitterRegistry", "ReplayRootRegistry", "CoreState"] discs cmd

  Right (_, mgrCid', _, _, _) <- cmd discs
  Some mgr <- queryContractId operator mgrCid'
  mgr.admin === admin

-- | The ByVaa variant's CoinFactory leg, via the deterministic
-- 'SetFactoryByVaa' proxy -- see the module header.
testRegisterDisclosuresCoinFactoryLegViaRotateProxy : Script ()
testRegisterDisclosuresCoinFactoryLegViaRotateProxy = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "RegDiscCoinAdmin"
  (mgrCid, _, _) <- setupFixedManager operator gg admin BurnMint csId
  Some mgr <- queryContractId operator mgrCid
  realFactoryCid <- nttCoinFactorySetup gg
  let newFactory = BurnMintFactoryCid (toInterfaceContractId @BurnMintFactory realFactoryCid)
  csDisc <- fromSome <$> queryDisclosure operator csId
  factoryDisc <- fromSome <$> queryDisclosure gg realFactoryCid
  (nodeCid, dNode) <- coveringDisclosure operator gg mgr.namespace (parseVAA rotateHappyVAA).hash
  let discs = [csDisc, factoryDisc, dNode]
      cmd trial = trySubmitWithDiscs admin trial do
        rotateByVaaCmd mgrCid newFactory csId nodeCid rotateHappyVAA

  dropOneMustFail ["CoreState", "canonical CoinFactory", "covering ReplayNode"] discs cmd

  Right mgrCid' <- cmd discs
  Some mgrDone <- queryContractId operator mgrCid'
  mgrDone.factory === newFactory

----------------------------------------------------------------------
-- consolidateDisclosures
----------------------------------------------------------------------

testConsolidateDisclosures : Script ()
testConsolidateDisclosures = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "ConsDiscAdmin"
  caller <- allocateParty "ConsDiscCaller"
  (d, _) <- sendScaffold operator gg admin LockUnlock csId
  frag1 <- mkHolding gg admin d.instrumentId 1.0
  frag2 <- mkHolding gg admin d.instrumentId 2.0
  discs <- consolidateDisclosures operator gg d.mgrCid (fromSome d.ledgerCid) [frag1, frag2]
    (discloseConcrete @Cip56MockHolding gg "custody holding")
    (discloseConcrete @MockTransferFactory gg "committed TransferFactory")
  length discs === 5   -- NttManager, LockedLedger, 2 holdings, TransferFactory

  let cmd trial = trySubmitWithDiscs caller trial do
        exerciseCmd d.mgrCid ConsolidateCustody with
          caller
          ledgerCid = fromSome d.ledgerCid
          custodyHoldingCids = [frag1, frag2]
          extraArgs = emptyExtraArgs

  dropOneMustFail
    ["NttManager", "LockedLedger", "custody holding 1", "custody holding 2", "committed TransferFactory"]
    discs
    cmd

  Right ledgerCid' <- cmd discs
  Some ledger <- queryContractId operator ledgerCid'
  assertMsg "expected a consolidated pot" (ledger.custodyHoldingCid /= None)
  custody <- cip56HoldingsOwnedBy gg admin
  case custody of
    [(_, h)] -> h.amount === 3.0
    _ -> abort ("expected one merged custody holding, got: " <> show custody)
