-- | Daml Script tests for the NTT package: wire codec, crankless deployment, the
-- outbound send (sender self-pays the fee), and the inbound receive (executor
-- relays a VAA, verify+consume via the trie, pin the guardian root, bind the
-- recipient, mint, reject replays).
--
-- Two mocks: 'MockToken' below is the CIP-56-shaped bridged token (the 'NttToken'
-- seam); 'Test.MockToken' provides fee allocations. The receive VAA fixture is
-- generated by node/pkg/cantonclient/vectorgen_test.go (TestGenerateNttVector).
module Test.TestNtt where

import Daml.Script
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import DA.Text (isInfixOf)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding, HoldingView(..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.BurnMintV1
  (BurnMintFactory, BurnMintFactory_BurnMintResult(..), BurnMintFactoryView(..))
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory, TransferFactoryView(..)
  , TransferInstruction, TransferInstructionView(..), TransferInstructionStatus(..)
  , TransferInstructionResult(..), TransferInstructionResult_Output(..)
  )
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Wormhole.Core.Bytes
import Wormhole.Core.Fees (feeToDecimal)
import Wormhole.Core.Replay (ReplayNode, defaultSplitThreshold)
import Wormhole.Core.Setup (mkInitialCoreState, solanaGovernanceChainId, defaultGovernanceContract)
import Wormhole.Core.State (Emitter, CoreState, emitterAddressTag, SubmitGovernanceVAA(..))
import Wormhole.Core.VAA (parseVAA)
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token
import Wormhole.Ntt.Manager
import Wormhole.Ntt.TokenCip56 (Cip56BurnMintToken(..), Cip56CustodyToken(..))
import Test.MockToken (mintAndAllocate, mockBalance)
import Test.TestReplay (registerReplayRoot, coveringDisclosure)
import Test.TestCore
  ( setup, setupWithInstrument, registerEmitter
  , govSetFeeVAA, devnetGuardianPubKey )

----------------------------------------------------------------------
-- MockToken: a CIP-56-shaped NttToken (bridged token) for tests
----------------------------------------------------------------------

-- | A minted/custodied balance. Signed by the token @admin@ only, so a mint needs
-- no recipient authority — which is why a third-party executor can drive 'Receive'
-- against this mock (a real owner-signed token needs a pre-approval; README §10).
template MockHolding
  with
    admin  : Party
    owner  : Party
    amount : Int
  where
    signatory admin
    observer owner

-- | The token hook. Admin-signed (its authority backs the holdings) and observed
-- by the @manager@.
template MockToken
  with
    admin   : Party
    manager : Party
    mode    : TokenMode
  where
    signatory admin
    observer manager

    interface instance NttToken for MockToken where
      view = NttTokenView with admin, manager, mode
      -- The mock ignores the CIP-56 handles; a real token uses them (TokenCip56).
      lockOrBurnImpl _sender amt _inputHoldingCids _extraArgs = do
        -- lock (owner = admin); burn is modelled the same way here
        create MockHolding with admin, owner = admin, amount = amt.amount
        pure ()
      mintOrUnlockImpl recipient amt _inputHoldingCids _extraArgs = do
        create MockHolding with admin, owner = recipient, amount = amt.amount
        pure ()

----------------------------------------------------------------------
-- Cip56BurnMintToken harness: local mocks of the vendored Holding /
-- BurnMintFactory interfaces, driving the REAL production lockOrBurnImpl.
----------------------------------------------------------------------

-- | Owner-signed holding backing 'Cip56MockHolding'/'MockBurnMintFactory' below;
-- signatory admin AND owner (mirrors a real CIP-56 holding) so archiving it
-- genuinely requires the owner's authority, not just the admin's.
template Cip56MockHolding
  with
    admin      : Party
    owner      : Party
    instrument : InstrumentId
    amount     : Decimal
  where
    signatory admin, owner

    interface instance Holding for Cip56MockHolding where
      view = HoldingView with
        owner
        instrumentId = instrument
        amount
        lock = None
        meta = emptyMetadata

-- | A local 'BurnMintFactory': archives the burned inputs and creates one
-- 'Cip56MockHolding' per output, so a test can observe exactly the outputs list
-- the fixed 'Cip56BurnMintToken.lockOrBurnImpl' constructs.
template MockBurnMintFactory
  with
    admin      : Party
    instrument : InstrumentId
  where
    signatory admin

    interface instance BurnMintFactory for MockBurnMintFactory where
      view = BurnMintFactoryView with admin, meta = emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        forA_ arg.inputHoldingCids archive
        outputCids <- forA arg.outputs \o ->
          toInterfaceContractId @Holding <$> create Cip56MockHolding with
            admin
            owner = o.owner
            instrument
            amount = o.amount
        pure BurnMintFactory_BurnMintResult with outputCids

      burnMintFactory_publicFetchImpl _self _arg =
        pure BurnMintFactoryView with admin, meta = emptyMetadata

-- | Stand up a burn/mint 'Cip56BurnMintToken' over a fresh 'MockBurnMintFactory'.
mkBurnMintToken : Party -> Party -> InstrumentId -> Script (ContractId NttToken)
mkBurnMintToken admin manager instrumentId = do
  factoryCid <- toInterfaceContractId @BurnMintFactory <$> submit admin do
    createCmd MockBurnMintFactory with admin, instrument = instrumentId
  toInterfaceContractId @NttToken <$> submit admin do
    createCmd Cip56BurnMintToken with admin, manager, instrumentId, burnMintFactoryCid = factoryCid

-- | Create a 'Cip56MockHolding' owned by @owner@, as its interface cid. Both
-- @admin@ and @owner@ must authorize (the holding is signed by both).
mkHolding : Party -> Party -> InstrumentId -> Decimal -> Script (ContractId Holding)
mkHolding admin owner instrument amount =
  toInterfaceContractId @Holding <$> submit (actAs admin <> actAs owner) do
    createCmd Cip56MockHolding with admin, owner, instrument, amount

-- | Query the 'Cip56MockHolding's currently owned by @owner@, as seen by @admin@.
cip56HoldingsOwnedBy : Party -> Party -> Script [(ContractId Cip56MockHolding, Cip56MockHolding)]
cip56HoldingsOwnedBy admin owner = do
  hs <- query @Cip56MockHolding admin
  pure [ (cid, h) | (cid, h) <- hs, h.owner == owner ]

----------------------------------------------------------------------
-- Cip56CustodyToken harness: a local 'TransferFactory' mock whose result
-- (Completed/Pending) is configurable, driving the real lockOrBurnImpl.
----------------------------------------------------------------------

-- | Placeholder 'TransferInstruction' returned by 'MockTransferFactory' in
-- pending mode; never exercised by these tests (the Pending case is rejected
-- before anyone would act on it).
template MockTransferInstruction
  with
    admin    : Party
    transfer : TIV1.Transfer
  where
    signatory admin, transfer.sender

    interface instance TransferInstruction for MockTransferInstruction where
      view = TransferInstructionView with
        originalInstructionCid = None
        transfer
        status = TransferPendingReceiverAcceptance
        meta = emptyMetadata
      transferInstruction_acceptImpl _self _arg = error "unused"
      transferInstruction_rejectImpl _self _arg = error "unused"
      transferInstruction_withdrawImpl _self _arg = error "unused"
      transferInstruction_updateImpl _self _arg = error "unused"

-- | A local 'TransferFactory': in Completed mode it archives the transfer's
-- input holdings and creates a 'Cip56MockHolding' for the receiver, mirroring a
-- real synchronous registry; in Pending mode it moves nothing and returns a
-- 'TransferInstructionResult_Pending' placeholder, driving the Fix-2
-- synchronous-settle check in 'Cip56CustodyToken.lockOrBurnImpl'.
template MockTransferFactory
  with
    admin   : Party
    pending : Bool
  where
    signatory admin

    interface instance TransferFactory for MockTransferFactory where
      view = TransferFactoryView with admin, meta = emptyMetadata

      transferFactory_transferImpl _self arg =
        if pending
          then do
            instrCid <- toInterfaceContractId @TransferInstruction <$>
              create MockTransferInstruction with admin, transfer = arg.transfer
            pure TransferInstructionResult with
              output = TransferInstructionResult_Pending with transferInstructionCid = instrCid
              senderChangeCids = []
              meta = emptyMetadata
          else do
            forA_ arg.transfer.inputHoldingCids archive
            rcid <- toInterfaceContractId @Holding <$> create Cip56MockHolding with
              admin
              owner = arg.transfer.receiver
              instrument = arg.transfer.instrumentId
              amount = arg.transfer.amount
            pure TransferInstructionResult with
              output = TransferInstructionResult_Completed with receiverHoldingCids = [rcid]
              senderChangeCids = []
              meta = emptyMetadata

      transferFactory_publicFetchImpl _self _arg =
        pure TransferFactoryView with admin, meta = emptyMetadata

-- | Stand up a lock/unlock 'Cip56CustodyToken' over a fresh 'MockTransferFactory'
-- in either Completed (@pending = False@) or Pending (@pending = True@) mode.
mkCustodyToken : Party -> Party -> Party -> InstrumentId -> Bool -> Script (ContractId NttToken)
mkCustodyToken admin manager custody instrumentId pending = do
  factoryCid <- toInterfaceContractId @TransferFactory <$> submit admin do
    createCmd MockTransferFactory with admin, pending
  toInterfaceContractId @NttToken <$> submit admin do
    createCmd Cip56CustodyToken with admin, manager, custody, instrumentId, transferFactoryCid = factoryCid

-- | Fix 2 (lock path): a Completed transfer settles synchronously, so
-- 'lockOrBurnImpl' succeeds and the sender's holding lands on 'custody'.
-- 'custody = admin' here: 'Cip56MockHolding' is owner-signed, so creating the
-- receiver holding needs the receiver's live authority too; this test is about
-- the Completed/Pending branch (Fix 2), not third-party receive authority
-- (covered separately by 'testLockOrBurnOwnerSignedSucceeds' for the sender side).
testCustodyLockCompletedSucceeds : Script ()
testCustodyLockCompletedSucceeds = do
  admin <- allocateParty "CustodyOkAdmin"
  manager <- allocateParty "CustodyOkManager"
  let custody = admin
  let sender = admin
  let instrumentId = InstrumentId with admin, id = "LOCK"
  tokenCid <- mkCustodyToken admin manager custody instrumentId False
  holdingCid <- mkHolding admin sender instrumentId 0.01

  _ <- submit (actAs manager <> actAs admin) do
    exerciseCmd tokenCid LockOrBurn with
      sender
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [holdingCid]
      extraArgs = emptyExtraArgs

  custodyHoldings <- cip56HoldingsOwnedBy admin custody
  case custodyHoldings of
    [(_, h)] -> h.amount === 0.01
    _ -> abort ("expected exactly one custody holding, got: " <> show custodyHoldings)

-- | Fix 2 (lock path): a Pending transfer has NOT moved the tokens into
-- custody. Before the fix this was silently ignored (emit-without-lock); the
-- fix must reject with the synchronous-settle assertion.
testCustodyLockPendingRejected : Script ()
testCustodyLockPendingRejected = do
  admin <- allocateParty "CustodyPendingAdmin"
  manager <- allocateParty "CustodyPendingManager"
  custody <- allocateParty "CustodyPendingCustody"
  let sender = admin
  let instrumentId = InstrumentId with admin, id = "LOCK"
  tokenCid <- mkCustodyToken admin manager custody instrumentId True
  holdingCid <- mkHolding admin sender instrumentId 0.01

  res <- trySubmit (actAs manager <> actAs admin) do
    exerciseCmd tokenCid LockOrBurn with
      sender
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [holdingCid]
      extraArgs = emptyExtraArgs
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a synchronous-settle failure, got: " <> fs.message)
        ("did not settle synchronously" `isInfixOf` fs.message)
    Left err -> abort ("expected a synchronous-settle failure, got: " <> show err)
    Right _ -> abort "pending lock succeeded: tokens were never moved to custody"

-- | Fix 1: a genuinely owner-signed sender ('alice', distinct from admin and
-- manager) drives a real burn. 'Cip56MockHolding' is signatory @admin, owner@,
-- so archiving alice's holding needs her live authority; that authority only
-- reaches the seam because 'LockOrBurn' now lists 'sender' as a controller
-- alongside 'manager'. Submitted as @actAs manager <> actAs alice@ — no admin
-- actAs (only a visibility disclosure of the factory) — proving the manager
-- alone can no longer drive someone else's holding, and alice's
-- co-authorization is what makes it work.
testLockOrBurnOwnerSignedSucceeds : Script ()
testLockOrBurnOwnerSignedSucceeds = do
  admin <- allocateParty "OwnerBurnAdmin"
  manager <- allocateParty "OwnerBurnManager"
  alice <- allocateParty "OwnerBurnAlice"
  let instrumentId = InstrumentId with admin, id = "BURN"
  tokenCid <- mkBurnMintToken admin manager instrumentId
  holdingCid <- mkHolding admin alice instrumentId 0.01
  [(factoryCid, _)] <- query @MockBurnMintFactory admin
  factoryDisc <- fromSome <$> queryDisclosure admin factoryCid

  _ <- submit (actAs manager <> actAs alice <> disclose factoryDisc) do
    exerciseCmd tokenCid LockOrBurn with
      sender = alice
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [holdingCid]
      extraArgs = emptyExtraArgs

  remaining <- cip56HoldingsOwnedBy admin alice
  remaining === []

-- | Under-burn / inflation: the input holdings sum to LESS than the intended
-- trimmed burn amount. With the bug, this would silently under-burn (destroy
-- 0.004, still emit 0.01 on the wire) — the fix's cover check must reject it.
-- 'sender' = 'admin' here to keep the conservation setup minimal; a distinct
-- third-party sender is covered by 'testLockOrBurnOwnerSignedSucceeds' below.
testBurnMintUnderBurnRejected : Script ()
testBurnMintUnderBurnRejected = do
  admin <- allocateParty "BurnUnderAdmin"
  manager <- allocateParty "BurnUnderManager"
  let sender = admin
  let instrumentId = InstrumentId with admin, id = "BURN"
  tokenCid <- mkBurnMintToken admin manager instrumentId
  holdingCid <- mkHolding admin sender instrumentId 0.004

  res <- trySubmit (actAs manager <> actAs admin) do
    exerciseCmd tokenCid LockOrBurn with
      sender
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [holdingCid]
      extraArgs = emptyExtraArgs
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a burn cover-check failure, got: " <> fs.message)
        ("do not cover" `isInfixOf` fs.message)
    Left err -> abort ("expected a burn cover-check failure, got: " <> show err)
    Right _ -> abort "under-covered burn succeeded: unbacked mint would follow"

-- | Happy path + change conservation: input holdings sum to MORE than the
-- intended burn amount. The burn must succeed, archive both inputs, and leave
-- the sender with exactly one change holding of (sum - intended).
testBurnMintReturnsChange : Script ()
testBurnMintReturnsChange = do
  admin <- allocateParty "BurnChangeAdmin"
  manager <- allocateParty "BurnChangeManager"
  let sender = admin
  let instrumentId = InstrumentId with admin, id = "BURN"
  tokenCid <- mkBurnMintToken admin manager instrumentId
  hold1 <- mkHolding admin sender instrumentId 0.01
  hold2 <- mkHolding admin sender instrumentId 0.005

  _ <- submit (actAs manager <> actAs admin) do
    exerciseCmd tokenCid LockOrBurn with
      sender
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [hold1, hold2]
      extraArgs = emptyExtraArgs

  remaining <- cip56HoldingsOwnedBy admin sender
  case remaining of
    [(_, h)] -> h.amount === 0.005
    _ -> abort ("expected exactly one change holding for sender, got: " <> show remaining)

-- | Exact cover: input holdings sum to exactly the intended amount, so the
-- fix's 'outputs = []' branch fires and no change holding is created.
testBurnMintExactCoverNoChange : Script ()
testBurnMintExactCoverNoChange = do
  admin <- allocateParty "BurnExactAdmin"
  manager <- allocateParty "BurnExactManager"
  let sender = admin
  let instrumentId = InstrumentId with admin, id = "BURN"
  tokenCid <- mkBurnMintToken admin manager instrumentId
  holdingCid <- mkHolding admin sender instrumentId 0.01

  _ <- submit (actAs manager <> actAs admin) do
    exerciseCmd tokenCid LockOrBurn with
      sender
      amount = TrimmedAmount with decimals = 8, amount = 1_000_000
      inputHoldingCids = [holdingCid]
      extraArgs = emptyExtraArgs

  remaining <- cip56HoldingsOwnedBy admin sender
  remaining === []

-- | 32-byte hex from a short tail (@b32 "aa"@ = 0x00..aa), matching the fixture.
b32 : Text -> Bytes32
b32 = leftPadTo 32

----------------------------------------------------------------------
-- Codec round-trips
----------------------------------------------------------------------

testNttCodec : Script ()
testNttCodec = do
  let ntt = NativeTokenTransfer with
        decimals = 8
        amount = 1000000
        sourceToken = b32 "dd"
        recipientAddress = b32 "ee"
        recipientChain = 72
        additionalPayload = ""
  decodeNativeTokenTransfer (encodeNativeTokenTransfer ntt) === ntt

  let mm = NttManagerMessage with
        id = b32 "01"
        sender = b32 "bb"
        payload = encodeNativeTokenTransfer ntt
  decodeNttManagerMessage (encodeNttManagerMessage mm) === mm

  let wm = WormholeTransceiverMessage with
        sourceManager = b32 "bb"
        recipientManager = b32 "aa"
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""
  decodeWormholeTransceiverMessage (encodeWormholeTransceiverMessage wm) === wm

  -- 18-decimal amount trims to 8 (drops the low 10 digits); untrim recovers all
  -- but the lost dust.
  let t = trimAmount 1234567890123456789 18
  t.decimals === 8
  t.amount === 123456789
  untrimAmount t 18 === 1234567890000000000
  pure ()

----------------------------------------------------------------------
-- Deployment
----------------------------------------------------------------------

-- | Bootstrap the core 'CoreState' + 'EmitterRegistry' (fee 0) plus the
-- 'NttManagerRegistry' (shared by all deployments in a test). Surfaces
-- @guardianGovernance@ — the trust anchor a deployment pins at registration.
nttSetup : Script (Party, Party, ContractId CoreState)
nttSetup = do
  (operator, _, csId) <- setup
  _ <- submit operator do createCmd NttManagerRegistry with operator, nextId = 0
  Some cs <- queryContractId operator csId
  pure (operator, cs.guardianGovernance, csId)

-- | 'nttSetup' with a mock fee instrument, for the fee tests. Also returns the
-- mock token admin, the fee instrument, and the fee recipient.
nttSetupFee : Script (Party, Party, ContractId CoreState, Party, InstrumentId, Party)
nttSetupFee = do
  mockAdmin <- allocateParty "NttFeeMockAdmin"
  let inst = InstrumentId with admin = mockAdmin, id = "MOCK"
  (operator, _, csId) <- setupWithInstrument (Some inst)
  _ <- submit operator do createCmd NttManagerRegistry with operator, nextId = 0
  Some cs <- queryContractId operator csId
  pure (operator, cs.guardianGovernance, csId, mockAdmin, inst, cs.feeRecipient)

-- | Register a core Emitter for @admin@, create a MockToken, and stand up an NTT
-- deployment via 'RegisterManager' (crankless; operator co-signature inherited
-- from the disclosed registry). Returns what the send/receive tests need.
deploy : Party -> Party -> Party -> TokenMode
      -> Script (ContractId NttManager, ContractId Emitter)
deploy operator guardianGovernance admin mode = do
  emitterCid <- registerEmitter operator admin
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode
  let tokenCid = toInterfaceContractId @NttToken mockCid
  [(regCid, _)] <- query @NttManagerRegistry operator
  regDisc <- fromSome <$> queryDisclosure operator regCid
  (_, mgrId) <- submit (actAs admin <> disclose regDisc) do
    exerciseCmd regCid RegisterManager with
      admin
      guardianGovernance
      transceiverEmitterCid = emitterCid
      tokenCid
      mode
      tokenDecimals = 8
  pure (mgrId, emitterCid)

-- | Two deployments get distinct managers with sequential ids and owner-bound
-- addresses.
testNttDeployment : Script ()
testNttDeployment = do
  (operator, guardianGovernance, _) <- nttSetup
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  (mgrA, _) <- deploy operator guardianGovernance alice LockUnlock
  (mgrB, _) <- deploy operator guardianGovernance bob BurnMint
  Some ma <- queryContractId operator mgrA
  Some mb <- queryContractId operator mgrB
  ma.managerId === 0
  mb.managerId === 1
  ma.managerAddress === nttManagerAddressFor operator alice 0
  mb.managerAddress === nttManagerAddressFor operator bob 1
  assert (ma.managerAddress /= mb.managerAddress)

  -- Pin the manager-address encoding against the cross-language vector; confirm
  -- the emitter/manager tags separate identical ordinals.
  derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "vector-operator::1220deadbeef") (OwnerText "vector-owner::1220cafebabe") (RegistryId 7)
    === "27d9c172814411dbdacf4842ae5de98cf78ce21e77def6f76f0f75387a28c93b"
  assert (derivedAddressFromText (DomainTag emitterAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0)
            /= derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0))

----------------------------------------------------------------------
-- Send (with the sender self-paying the message fee)
----------------------------------------------------------------------

-- | A send publishes via the Emitter AND pays the governance-set fee from the
-- sender's own wallet. The fee lands whole on the fee recipient; a fee-less send
-- is rejected.
testNttSend : Script ()
testNttSend = do
  (operator, guardianGovernance, csId, mockAdmin, inst, feeRecipient) <- nttSetupFee
  alice <- allocateParty "SendAlice"
  (mgrId, emitterCid) <- deploy operator guardianGovernance alice LockUnlock
  mgrId <- submit alice do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  -- Governance raises the message fee to 1000 (1e-7 tokens).
  csId <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  csDisc <- fromSome <$> queryDisclosure operator csId
  [(mgrCid, _)] <- query @NttManager operator

  let doTransfer feeAlloc = exerciseCmd mgrCid Transfer with
        user = alice
        transceiverEmitterCid = emitterCid
        coreStateCid = csId
        recipientChain = 2
        recipientAddress = b32 "ee"
        sourceToken = b32 "dd"
        rawAmount = 1000000
        nonce = 7
        consistencyLevel = 0
        inputHoldingCids = []
        feeAllocation = feeAlloc
        extraArgs = emptyExtraArgs

  -- Fee due but none attached: rejected (the send is never fee-exempt).
  submitMustFail (actAs alice <> disclose csDisc) do doTransfer None

  -- Exact fee from alice's wallet: succeeds, fee lands on gg.
  feePay <- mintAndAllocate mockAdmin alice feeRecipient inst (feeToDecimal 1000)
  _ <- submit (actAs alice <> disclose csDisc) do doTransfer (Some feePay)

  -- Sequence advanced, Emitter published, token locked, fee reached the recipient.
  [(_, m1)] <- query @NttManager operator
  m1.outboundSequence === 1
  [(_, em)] <- query @Emitter alice
  em.sequence === 1
  [(_, h)] <- query @MockHolding alice
  h.owner === alice
  h.amount === 1000000
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 1000

----------------------------------------------------------------------
-- Receive (+ replay protection)
----------------------------------------------------------------------

-- Signed NTT transfer VAA (guardian set 0, devnet guardian): source chain 2,
-- emitter (peer transceiver) 0x..cc, peer manager 0x..bb, our manager 0x..aa,
-- transfer of 1_000_000 @ 8 decimals of token 0x..dd to 0x..ee on chain 72.
-- Generated by node/pkg/cantonclient/vectorgen_test.go:TestGenerateNttVector.
nttTransferVAA : Bytes
nttTransferVAA = ""

-- | The digest the fixture VAA consumes (the disclosure service computes the same
-- to resolve the covering replay node).
nttTransferDigest : Text
nttTransferDigest = (parseVAA nttTransferVAA).hash

-- | Pins the recipient-binding formula against fixed text (a live Party's
-- fingerprint is nondeterministic and can't be pinned). Go side in
-- vectorgen_test.go:TestGenerateAddressVectors.
testRecipientAddressForVector : Script ()
testRecipientAddressForVector = do
  recipientAddressFromText "vector-recipient::1220deadbeef"
    === "dbd2d1b09ea5715be3e45d0e38e5c5c0f6fcd0f181d45a9620dfb20f8ae3a4d9"
  assert (recipientAddressFromText "vector-recipient::1220deadbeef"
            /= recipientAddressFromText "vector-recipient::1220cafebabe")

-- | Create a manager whose @managerAddress@ is exactly the fixture's
-- recipientManager (0x..aa) — the static signed fixture needs a fixed address
-- that a nondeterministic party can't reproduce. Also sets the peer and claims
-- the replay-trie root.
setupReceiveManager
  : Party -> Party -> Party -> Script (ContractId NttManager, ContractId MockToken)
setupReceiveManager operator guardianGovernance admin = do
  mockCid <- submit admin do createCmd MockToken with admin, manager = operator, mode = BurnMint
  let tokenCid = toInterfaceContractId @NttToken mockCid
  mgrId <- submit (actAs operator <> actAs admin) do
    createCmd NttManager with
      operator
      admin
      guardianGovernance
      managerId = 999
      managerAddress = b32 "aa"
      transceiverEmitterId = 999
      tokenCid
      mode = BurnMint
      tokenDecimals = 8
      peers = Map.empty
      outboundSequence = 0
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  _ <- registerReplayRoot operator admin defaultSplitThreshold
  pure (mgrId, mockCid)

-- | Receive is permissionless: a third-party @relayer@ relays the VAA with only
-- disclosures. It passes verification, replay-consume, peer, and manager-binding,
-- failing only on the recipient binding (a nondeterministic Party can't hash to
-- the fixture's baked-in recipientAddress). Reaching that gate proves the executor
-- carries no authority — only visibility is required.
testNttReceiveByExecutorRecipientMismatchFails : Script ()
testNttReceiveByExecutorRecipientMismatchFails = do
  (operator, guardianGovernance, csId) <- nttSetup
  admin <- allocateParty "RecvAdmin"
  relayer <- allocateParty "Relayer"
  wrongRecipient <- allocateParty "WrongRecipient"
  (mgrId, mockCid) <- setupReceiveManager operator guardianGovernance admin
  (nodeCid, nodeDisc) <- coveringDisclosure operator admin nttTransferDigest
  dMgr  <- fromSome <$> queryDisclosure operator mgrId
  dCs   <- fromSome <$> queryDisclosure operator csId
  dMock <- fromSome <$> queryDisclosure operator mockCid

  res <- trySubmit (actAs relayer <> disclose dMgr <> disclose dCs <> disclose nodeDisc <> disclose dMock) do
    exerciseCmd mgrId Receive with
      executor = relayer
      coreStateCid = csId
      replayNodeCid = nodeCid
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = wrongRecipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a recipient-binding failure, got: " <> fs.message)
        ("recipient does not match" `isInfixOf` fs.message)
    Left err -> abort ("expected a recipient-binding failure, got: " <> show err)
    Right _ -> abort "Receive succeeded with a mismatched recipient"

-- | The guardian root is pinned to the admin-committed @guardianGovernance@, not
-- merely the operator. A compromised operator could co-sign a forged 'CoreState'
-- (throwaway gg, attacker guardian set) that passes an operator-pin; carrying gg =
-- @rogueGov@, it fails the guardianGovernance pin before any verification runs.
testNttReceivePinsGuardianGovernance : Script ()
testNttReceivePinsGuardianGovernance = do
  (operator, guardianGovernance, _) <- nttSetup
  admin <- allocateParty "PinAdmin"
  recipient <- allocateParty "PinRecipient"
  rogueGov <- allocateParty "RogueGovernance"
  rogueObserver <- allocateParty "RogueObserver"
  -- A ledger-valid but forged CoreState: real operator + a throwaway gg,
  -- carrying an attacker guardian set.
  let rogueInst = InstrumentId with admin = rogueGov, id = "UNUSED"
  fakeCsId <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId defaultGovernanceContract
                 ["1111111111111111111111111111111111111111"] rogueObserver rogueInst rogueGov)
  -- The manager is pinned to the real guardianGovernance.
  (mgrId, _) <- setupReceiveManager operator guardianGovernance admin
  (nodeCid, _) <- coveringDisclosure operator admin nttTransferDigest

  res <- trySubmit operator do
    exerciseCmd mgrId Receive with
      executor = operator
      coreStateCid = fakeCsId
      replayNodeCid = nodeCid
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  case res of
    Left (FailureStatusError fs) ->
      assertMsg ("expected a guardian-governance pin failure, got: " <> fs.message)
        ("committed guardian trust anchor" `isInfixOf` fs.message)
    Left err -> abort ("expected a guardian-governance pin failure, got: " <> show err)
    Right _ -> abort "Receive accepted a forged CoreState under a throwaway gg"

----------------------------------------------------------------------
-- Receive (matching recipient), live two-step harness
----------------------------------------------------------------------
--
-- No static VAA can match a nondeterministic Party's hash, so the matching-
-- recipient path can't be tested in one dpm-script call. Instead a two-step,
-- Go-orchestrated live-sandbox flow (ntt_recipient_match_integration_test.go):
--
--   1. 'integrationNttReceiveMatchSetup' allocates the recipient and returns
--      'recipientAddressFor recipient', computed on-ledger.
--   2. Go signs a fresh VAA against that hash.
--   3. 'integrationNttReceiveMatch' relays it against the same manager/recipient
--      (state persists), asserting the mint landed and a replay is rejected.

-- | Step 1: allocate everything 'Receive' needs; return the hash Go signs against
-- plus the cids the relay step needs.
data NttReceiveMatchSetup = NttReceiveMatchSetup with
    mgrId            : ContractId NttManager
    operator         : Party
    recipient        : Party
    coreStateCid     : ContractId CoreState
    replayNodeCid    : ContractId ReplayNode
    recipientAddress : Bytes32
  deriving (Eq, Show)

integrationNttReceiveMatchSetup : Script NttReceiveMatchSetup
integrationNttReceiveMatchSetup = do
  (operator, guardianGovernance, csId) <- nttSetup
  admin <- allocateParty "MatchAdmin"
  recipient <- allocateParty "MatchRecipient"
  (mgrId, _) <- setupReceiveManager operator guardianGovernance admin
  -- Single root node here, so it covers every digest.
  [(nodeCid, _)] <- query @ReplayNode operator
  pure NttReceiveMatchSetup with
    mgrId
    operator
    recipient
    coreStateCid = csId
    replayNodeCid = nodeCid
    recipientAddress = recipientAddressFor recipient

-- | Step 2 input: step 1's pieces plus the fresh VAA Go signed against its
-- 'recipientAddress'.
data NttReceiveMatchInput = NttReceiveMatchInput with
    mgrId         : ContractId NttManager
    operator      : Party
    recipient     : Party
    coreStateCid  : ContractId CoreState
    replayNodeCid : ContractId ReplayNode
    vaaBytes      : Bytes
  deriving (Eq, Show)

-- | Step 2: relay the fresh VAA (as @operator@ here; the third-party path is
-- covered by 'testNttReceiveByExecutorRecipientMismatchFails'). Succeeds and mints
-- to 'recipient'; a second relay is rejected (replay).
integrationNttReceiveMatch : NttReceiveMatchInput -> Script ()
integrationNttReceiveMatch input = do
  ntt <- submit input.operator do
    exerciseCmd input.mgrId Receive with
      executor = input.operator
      coreStateCid = input.coreStateCid
      replayNodeCid = input.replayNodeCid
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  ntt.recipientChain === 72

  holdings <- query @MockHolding input.recipient
  case holdings of
    [(_, h)] -> do
      h.owner === input.recipient
      h.amount === ntt.amount
    _ -> abort "expected exactly one holding minted to the matching recipient"

  -- Replay: digest now consumed. Re-resolve the covering node and relay again —
  -- rejected on membership.
  (freshNode, _) <- coveringDisclosure input.operator input.recipient (parseVAA input.vaaBytes).hash
  submitMustFail input.operator do
    exerciseCmd input.mgrId Receive with
      executor = input.operator
      coreStateCid = input.coreStateCid
      replayNodeCid = freshNode
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  pure ()

----------------------------------------------------------------------
-- Send by a user other than the deployment admin (still self-paying)
----------------------------------------------------------------------

-- | A party other than the admin initiates Transfer alone and pays its own fee —
-- admin is never active. The nested LockOrBurn/PublishMessage ride on NttManager's
-- inherited authority; bob co-controls PublishMessage as payer. The only extra
-- requirement is visibility: the contracts are disclosed to bob.
testNttTransferByDifferentUser : Script ()
testNttTransferByDifferentUser = do
  (operator, guardianGovernance, csId, mockAdmin, inst, feeRecipient) <- nttSetupFee
  admin <- allocateParty "TransferAdmin"
  bob <- allocateParty "TransferBob"
  (mgrId, emitterCid) <- deploy operator guardianGovernance admin LockUnlock
  [(mockCid, _)] <- query @MockToken admin
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"

  csId <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  [(mgrCid, _)] <- query @NttManager operator

  feePay <- mintAndAllocate mockAdmin bob feeRecipient inst (feeToDecimal 1000)
  dMgr     <- fromSome <$> queryDisclosure admin mgrCid
  dEmitter <- fromSome <$> queryDisclosure admin emitterCid
  dMock    <- fromSome <$> queryDisclosure admin mockCid
  dCs      <- fromSome <$> queryDisclosure operator csId
  _ <- submit (actAs bob <> disclose dMgr <> disclose dEmitter <> disclose dMock <> disclose dCs) do
    exerciseCmd mgrCid Transfer with
      user = bob
      transceiverEmitterCid = emitterCid
      coreStateCid = csId
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 1
      consistencyLevel = 0
      inputHoldingCids = []
      feeAllocation = Some feePay
      extraArgs = emptyExtraArgs

  [(_, m)] <- query @NttManager operator
  m.outboundSequence === 1
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 1000

-- | Two negative cases: (1) admin alone can't transfer on bob's behalf (admin is
-- never a controller); (2) bob alone without disclosure fails on visibility, not
-- authority — a non-stakeholder can't even see NttManager.
testNttTransferRequiresUserAuthority : Script ()
testNttTransferRequiresUserAuthority = do
  (operator, guardianGovernance, csId) <- nttSetup
  admin <- allocateParty "ReqAdmin"
  bob <- allocateParty "ReqBob"
  (mgrId, emitterCid) <- deploy operator guardianGovernance admin LockUnlock
  mgrId <- submit admin do
    exerciseCmd mgrId SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  let doTransfer = exerciseCmd mgrId Transfer with
        user = bob
        transceiverEmitterCid = emitterCid
        coreStateCid = csId
        recipientChain = 2
        recipientAddress = b32 "ee"
        sourceToken = b32 "dd"
        rawAmount = 1000000
        nonce = 1
        consistencyLevel = 0
        inputHoldingCids = []
        feeAllocation = None
        extraArgs = emptyExtraArgs

  submitMustFail admin do doTransfer
  submitMustFail bob do doTransfer
  pure ()
