-- | Daml Script tests for the NTT package: the wire codec, deployment through
-- the 'NttGovernance' root (including the burn/mint instrument-id binding),
-- outbound sends (lock accounting, burn cover and change, the message fee),
-- the recipient deposit pre-approval, and the inbound gate ('Release'/'Mint').
--
-- The bridged token is the CIP-56 mock harness below ('Cip56MockHolding' over
-- 'MockBurnMintFactory' / 'MockTransferFactory'), which the manager drives
-- through the standard interfaces exactly as it would a real registry. One
-- simplification: the mock factory cannot model a real registry's receiver
-- pre-approval, so it can only create a receiver holding when the receiver's
-- signature is otherwise reachable — the sender's own, or the factory-signing
-- @gg@'s. Unpromoted lock tests therefore use a sender who is also the
-- deployment admin (the custodian), and the different-user lock test runs
-- promoted (custodian gg). Every instrument admin is gg for the same reason (a
-- real lock/unlock deployment would bridge a foreign token whose admin is not
-- gg). 'Test.MockToken' is unrelated: it backs the separate fee instrument.
--
-- The signed receive VAA fixture is generated by
-- node/pkg/cantonclient/vectorgen_test.go in the wormhole repo. A static
-- fixture cannot name a freshly allocated Party, so the matching-recipient
-- receive path is covered by the live two-step harness at the bottom of this
-- file, driven from testing/go.
module Test.TestNtt where

import Daml.Script hiding (AnyContractId)
import DA.Assert ((===))
import DA.Foldable (forA_)
import DA.Map qualified as Map
import DA.Optional (fromSome)
import DA.Text (isInfixOf, isPrefixOf)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding, HoldingView(..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.BurnMintV1
  (BurnMintFactory, BurnMintFactory_BurnMintResult(..), BurnMintFactoryView(..))
import Splice.Api.Token.TransferInstructionV1
  ( TransferFactory, TransferFactoryView(..)
  , TransferInstruction, TransferInstructionView(..), TransferInstructionStatus(..)
  , TransferInstructionResult(..), TransferInstructionResult_Output(..)
  )
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Wormhole.Core.Bytes
import Wormhole.Core.Fees (feeToDecimal, emptyExtraArgs)
import Wormhole.Core.Replay (ReplayNode, defaultSplitThreshold)
import Wormhole.Core.Setup (mkInitialCoreState, solanaGovernanceChainId, defaultGovernanceContract)
import Wormhole.Core.State (Emitter, CoreState, WormholeMessage, emitterAddressTag, SubmitGovernanceVAA(..))
import Wormhole.Core.VAA (parseVAA)
import Wormhole.Ntt.Amount
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Deposit
import Wormhole.Ntt.Ledger
import Wormhole.Ntt.Manager
import Wormhole.Ntt.Governance
import Test.MockToken (mintAndAllocate, mockBalance)
import Test.TestReplay (registerReplayRoot, coveringDisclosure)
import Test.TestCore
  ( setup, setupWithInstrument, registerEmitter
  , govSetFeeVAA, devnetGuardianPubKey )

----------------------------------------------------------------------
-- CIP-56 mocks: local implementations of the vendored Holding /
-- BurnMintFactory / TransferFactory interfaces.
----------------------------------------------------------------------

-- | The instrument bridged by lock/unlock test deployments. Burn/mint
-- deployments cannot use a fixed id: registration requires the id to be bound
-- to the deployment admin (see 'deploy').
bridgedInstrument : Party -> InstrumentId
bridgedInstrument gg = InstrumentId with admin = gg, id = "NTT"

-- | Owner-signed holding backing the mock factories. Signed by admin and
-- owner, like a real CIP-56 holding, so spending or creating one genuinely
-- requires the owner's authority.
template Cip56MockHolding
  with
    admin      : Party
    owner      : Party
    instrument : InstrumentId
    amount     : Decimal
  where
    signatory admin, owner

    interface instance Holding for Cip56MockHolding where
      view = HoldingView with
        owner
        instrumentId = instrument
        amount
        lock = None
        meta = emptyMetadata

-- | A local 'BurnMintFactory': archives the burned inputs and creates one
-- 'Cip56MockHolding' per output.
template MockBurnMintFactory
  with
    admin      : Party
    instrument : InstrumentId
  where
    signatory admin

    interface instance BurnMintFactory for MockBurnMintFactory where
      view = BurnMintFactoryView with admin, meta = emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        forA_ arg.inputHoldingCids archive
        outputCids <- forA arg.outputs \o ->
          toInterfaceContractId @Holding <$> create Cip56MockHolding with
            admin
            owner = o.owner
            instrument
            amount = o.amount
        pure BurnMintFactory_BurnMintResult with outputCids

      burnMintFactory_publicFetchImpl _self _arg =
        pure BurnMintFactoryView with admin, meta = emptyMetadata

-- | Placeholder 'TransferInstruction' returned by 'MockTransferFactory' in
-- pending mode; never exercised by these tests.
template MockTransferInstruction
  with
    admin    : Party
    transfer : TIV1.Transfer
  where
    signatory admin, transfer.sender

    interface instance TransferInstruction for MockTransferInstruction where
      view = TransferInstructionView with
        originalInstructionCid = None
        transfer
        status = TransferPendingReceiverAcceptance
        meta = emptyMetadata
      transferInstruction_acceptImpl _self _arg = error "unused"
      transferInstruction_rejectImpl _self _arg = error "unused"
      transferInstruction_withdrawImpl _self _arg = error "unused"
      transferInstruction_updateImpl _self _arg = error "unused"

-- | A local 'TransferFactory'. In completed mode it archives the inputs and
-- creates a holding for the receiver; in pending mode it moves nothing and
-- returns a placeholder instruction, which must trip the manager's
-- synchronous-settlement check.
template MockTransferFactory
  with
    admin   : Party
    pending : Bool
  where
    signatory admin

    interface instance TransferFactory for MockTransferFactory where
      view = TransferFactoryView with admin, meta = emptyMetadata

      transferFactory_transferImpl _self arg =
        if pending
          then do
            instrCid <- toInterfaceContractId @TransferInstruction <$>
              create MockTransferInstruction with admin, transfer = arg.transfer
            pure TransferInstructionResult with
              output = TransferInstructionResult_Pending with transferInstructionCid = instrCid
              senderChangeCids = []
              meta = emptyMetadata
          else do
            -- Like a real registry: require the inputs to cover the amount and
            -- return the surplus to the sender as a single change holding.
            views <- forA arg.transfer.inputHoldingCids \cid -> view <$> fetch cid
            let total = sum (map (.amount) views)
            assertMsg "mock: inputs do not cover the transfer amount"
              (total >= arg.transfer.amount)
            forA_ arg.transfer.inputHoldingCids archive
            rcid <- toInterfaceContractId @Holding <$> create Cip56MockHolding with
              admin
              owner = arg.transfer.receiver
              instrument = arg.transfer.instrumentId
              amount = arg.transfer.amount
            changeCids <-
              if total > arg.transfer.amount
                then do
                  c <- create Cip56MockHolding with
                    admin
                    owner = arg.transfer.sender
                    instrument = arg.transfer.instrumentId
                    amount = total - arg.transfer.amount
                  pure [toInterfaceContractId @Holding c]
                else pure []
            pure TransferInstructionResult with
              output = TransferInstructionResult_Completed with receiverHoldingCids = [rcid]
              senderChangeCids = changeCids
              meta = emptyMetadata

      transferFactory_publicFetchImpl _self _arg =
        pure TransferFactoryView with admin, meta = emptyMetadata

-- | Create a 'Cip56MockHolding' owned by @owner@.
mkHolding : Party -> Party -> InstrumentId -> Decimal -> Script (ContractId Holding)
mkHolding admin owner instrument amount =
  toInterfaceContractId @Holding <$> submit (actAs admin <> actAs owner) do
    createCmd Cip56MockHolding with admin, owner, instrument, amount

-- | The 'Cip56MockHolding's currently owned by @owner@, as seen by @admin@.
cip56HoldingsOwnedBy : Party -> Party -> Script [(ContractId Cip56MockHolding, Cip56MockHolding)]
cip56HoldingsOwnedBy admin owner = do
  hs <- query @Cip56MockHolding admin
  pure [ (cid, h) | (cid, h) <- hs, h.owner == owner ]

-- | Disclose the gg-signed burn/mint factory so a non-gg submitter can drive
-- the nested BurnMintFactory_BurnMint.
discloseBurnMintFactory : Party -> Script Disclosure
discloseBurnMintFactory gg = do
  [(cid, _)] <- query @MockBurnMintFactory gg
  fromSome <$> queryDisclosure gg cid

-- | Disclose the gg-signed transfer factory so a non-gg submitter can drive
-- the nested TransferFactory_Transfer.
discloseTransferFactory : Party -> Script Disclosure
discloseTransferFactory gg = do
  [(cid, _)] <- query @MockTransferFactory gg
  fromSome <$> queryDisclosure gg cid

-- | 32-byte hex from a short tail (@b32 "aa"@ = 0x00..aa), matching the fixture.
b32 : Text -> Bytes32
b32 = leftPadTo 32

-- | Assert that a submission failed with a message containing @needle@.
expectAbort : Text -> Either SubmitError a -> Script ()
expectAbort needle res = case res of
  Left (FailureStatusError fs) ->
    assertMsg ("expected failure containing '" <> needle <> "', got: " <> fs.message)
      (needle `isInfixOf` fs.message)
  Left err -> abort ("expected failure containing '" <> needle <> "', got: " <> show err)
  Right _ -> abort ("submission succeeded; expected failure containing '" <> needle <> "'")

----------------------------------------------------------------------
-- Codec and derivation vectors
----------------------------------------------------------------------

testNttCodec : Script ()
testNttCodec = do
  let ntt = NativeTokenTransfer with
        decimals = 8
        amount = 1000000
        sourceToken = b32 "dd"
        recipientAddress = b32 "ee"
        recipientChain = 72
        additionalPayload = ""
  decodeNativeTokenTransfer (encodeNativeTokenTransfer ntt) === ntt

  let mm = NttManagerMessage with
        id = b32 "01"
        sender = b32 "bb"
        payload = encodeNativeTokenTransfer ntt
  decodeNttManagerMessage (encodeNttManagerMessage mm) === mm

  let wm = WormholeTransceiverMessage with
        sourceManager = b32 "bb"
        recipientManager = b32 "aa"
        managerPayload = encodeNttManagerMessage mm
        transceiverPayload = ""
  decodeWormholeTransceiverMessage (encodeWormholeTransceiverMessage wm) === wm

  let t = trimAmount 1234567890123456789 18
  t.decimals === 8
  t.amount === 123456789
  untrimAmount t 18 === 1234567890000000000

  -- Inbound conversion: exact at matching decimals, truncating below them.
  untrimToDecimal (TrimmedAmount with decimals = 8, amount = 1000000) 8 === 0.01
  untrimToDecimal (TrimmedAmount with decimals = 8, amount = 123) 6 === 0.000001
  untrimToDecimal (TrimmedAmount with decimals = 8, amount = 99) 6 === 0.0
  pure ()

-- | Pins the recipient-binding formula against fixed text.
testRecipientAddressForVector : Script ()
testRecipientAddressForVector = do
  recipientAddressFromText "vector-recipient::1220deadbeef"
    === "dbd2d1b09ea5715be3e45d0e38e5c5c0f6fcd0f181d45a9620dfb20f8ae3a4d9"
  assert (recipientAddressFromText "vector-recipient::1220deadbeef"
            /= recipientAddressFromText "vector-recipient::1220cafebabe")

-- | The burn/mint instrument-id binding: fixed prefix, and distinct per admin
-- and per nonce (so one admin can run several deployments, and no admin can
-- produce another admin's binding).
testNttInstrumentIdBinding : Script ()
testNttInstrumentIdBinding = do
  let a0 = nttInstrumentIdFromText "vector-admin::1220deadbeef" 0
      a1 = nttInstrumentIdFromText "vector-admin::1220deadbeef" 1
      b0 = nttInstrumentIdFromText "vector-admin::1220cafebabe" 0
  a0 === "wormhole-ntt:a18ac0519eb929c6247f1924492c28a752101aa9c542eda3bd8fee8a296f7133"
  assert ("wormhole-ntt:" `isPrefixOf` a0)
  assert (a0 /= a1)
  assert (a0 /= b0)

----------------------------------------------------------------------
-- Setup + deployment
----------------------------------------------------------------------

-- | Bootstrap the core (CoreState + fee-0 EmitterRegistry) and the gg-signed
-- 'NttGovernance' root. @gg@ is both the trust anchor and the custody/mint
-- authority.
nttSetup : Script (Party, Party, ContractId CoreState)
nttSetup = do
  (operator, _, csId) <- setup
  Some cs <- queryContractId operator csId
  let gg = cs.guardianGovernance
  _ <- submit (actAs operator <> actAs gg) do
    createCmd NttGovernance with operator, guardianGovernance = gg, nextId = 0
  pure (operator, gg, csId)

-- | 'nttSetup' with a mock fee instrument, for the fee tests.
nttSetupFee : Script (Party, Party, ContractId CoreState, Party, InstrumentId, Party)
nttSetupFee = do
  mockAdmin <- allocateParty "NttFeeMockAdmin"
  let inst = InstrumentId with admin = mockAdmin, id = "MOCK"
  (operator, _, csId) <- setupWithInstrument (Some inst)
  Some cs <- queryContractId operator csId
  let gg = cs.guardianGovernance
  _ <- submit (actAs operator <> actAs gg) do
    createCmd NttGovernance with operator, guardianGovernance = gg, nextId = 0
  pure (operator, gg, csId, mockAdmin, inst, cs.feeRecipient)

-- | A registered deployment and the handles its tests need.
data Deployment = Deployment with
    mgrCid       : ContractId NttManager
    emitterCid   : ContractId Emitter
    factory      : NttFactory
    instrumentId : InstrumentId
    ledgerCid    : Optional (ContractId LockedLedger)  -- lock/unlock only
  deriving (Eq, Show)

-- | Unwrap a burn/mint deployment's typed factory.
theBurnMintFactory : NttFactory -> ContractId BurnMintFactory
theBurnMintFactory = \case
  BurnMintFactoryCid cid -> cid
  TransferFactoryCid _ -> error "not a burn/mint factory"

-- | Register a core Emitter for @admin@, create the gg-signed mock registry
-- factory, and register the manager through the shared 'NttGovernance' root.
-- For burn/mint the instrument id must be bound to the admin, so each
-- deployment gets its own instrument; lock/unlock uses the shared
-- 'bridgedInstrument'.
deploy : Party -> Party -> Party -> NttTokenConfig -> Script Deployment
deploy operator gg admin config = do
  emitterCid <- registerEmitter operator admin
  (instrumentId, factory) <- case config of
    BurnMint -> do
      let inst = InstrumentId with admin = gg, id = nttInstrumentIdFor admin 0
      fc <- submit gg do createCmd MockBurnMintFactory with admin = gg, instrument = inst
      pure (inst, BurnMintFactoryCid (toInterfaceContractId @BurnMintFactory fc))
    LockUnlock -> do
      fc <- submit gg do createCmd MockTransferFactory with admin = gg, pending = False
      pure (bridgedInstrument gg, TransferFactoryCid (toInterfaceContractId @TransferFactory fc))
  [(govCid, _)] <- query @NttGovernance operator
  govDisc <- fromSome <$> queryDisclosure operator govCid
  (_, mgrCid, ledgerCid) <- submit (actAs admin <> disclose govDisc) do
    exerciseCmd govCid RegisterManager with
      admin
      transceiverEmitterCid = emitterCid
      instrumentId
      instrumentNonce = 0
      tokenConfig = config
      tokenDecimals = 8
      factory
  pure Deployment with mgrCid, emitterCid, factory, instrumentId, ledgerCid

-- | Two deployments get distinct managers with sequential ids and owner-bound
-- addresses; a lock/unlock deployment gets a zero-balance ledger.
testNttDeployment : Script ()
testNttDeployment = do
  (operator, gg, _) <- nttSetup
  alice <- allocateParty "Alice"
  bob <- allocateParty "Bob"
  dA <- deploy operator gg alice LockUnlock
  dB <- deploy operator gg bob BurnMint
  Some ma <- queryContractId operator dA.mgrCid
  Some mb <- queryContractId operator dB.mgrCid
  ma.managerId === 0
  mb.managerId === 1
  ma.managerAddress === nttManagerAddressFor operator alice 0
  mb.managerAddress === nttManagerAddressFor operator bob 1
  assert (ma.managerAddress /= mb.managerAddress)
  Some ledger <- queryContractId operator (fromSome dA.ledgerCid)
  ledger.balance === 0.0
  ledger.managerAddress === ma.managerAddress
  dB.ledgerCid === None

  -- Pin the manager-address encoding against the cross-language vector, and
  -- confirm the emitter/manager domain tags separate identical ordinals.
  derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "vector-operator::1220deadbeef") (OwnerText "vector-owner::1220cafebabe") (RegistryId 7)
    === "27d9c172814411dbdacf4842ae5de98cf78ce21e77def6f76f0f75387a28c93b"
  assert (derivedAddressFromText (DomainTag emitterAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0)
            /= derivedAddressFromText (DomainTag nttManagerAddressTag) (RegistrarText "p::1") (OwnerText "q::2") (RegistryId 0))

-- | Burn/mint registration rejects an instrument id that is not bound to the
-- registering admin.
testBurnMintRegistrationRequiresBoundInstrument : Script ()
testBurnMintRegistrationRequiresBoundInstrument = do
  (operator, gg, _) <- nttSetup
  admin <- allocateParty "BindAdmin"
  emitterCid <- registerEmitter operator admin
  [(govCid, _)] <- query @NttGovernance operator
  govDisc <- fromSome <$> queryDisclosure operator govCid
  res <- trySubmit (actAs admin <> disclose govDisc) do
    exerciseCmd govCid RegisterManager with
      admin
      transceiverEmitterCid = emitterCid
      instrumentId = InstrumentId with admin = gg, id = "NTT"
      instrumentNonce = 0
      tokenConfig = BurnMint
      tokenDecimals = 8
      factory = BurnMintFactoryCid (coerceContractId emitterCid)   -- unused; registration fails first
  expectAbort "not bound to this admin" res

-- | The exclusivity attack the binding exists to stop: mallory registers her
-- own manager for an instrument that alice already bridges (it is
-- gg-administered, so the admin check alone would pass), aiming to mint it
-- against VAAs from a peer she controls. The id is bound to alice, so
-- mallory's registration fails no matter what nonce she picks.
testBurnMintInstrumentIsExclusiveToItsAdmin : Script ()
testBurnMintInstrumentIsExclusiveToItsAdmin = do
  (operator, gg, _) <- nttSetup
  alice <- allocateParty "ExclAlice"
  mallory <- allocateParty "ExclMallory"
  d <- deploy operator gg alice BurnMint
  emitterCid <- registerEmitter operator mallory
  [(govCid, _)] <- query @NttGovernance operator
  govDisc <- fromSome <$> queryDisclosure operator govCid
  forA_ [0, 1, 7] \nonce -> do
    res <- trySubmit (actAs mallory <> disclose govDisc) do
      exerciseCmd govCid RegisterManager with
        admin = mallory
        transceiverEmitterCid = emitterCid
        instrumentId = d.instrumentId
        instrumentNonce = nonce
        tokenConfig = BurnMint
        tokenDecimals = 8
        factory = BurnMintFactoryCid (coerceContractId emitterCid)   -- unused; registration fails first
    expectAbort "not bound to this admin" res

-- | Burn/mint registration rejects an instrument that gg does not administer
-- (the manager could never mint it), and any registration rejects decimals a
-- Daml Decimal cannot represent exactly.
testRegistrationBounds : Script ()
testRegistrationBounds = do
  (operator, gg, _) <- nttSetup
  admin <- allocateParty "BoundsAdmin"
  outsider <- allocateParty "BoundsOutsider"
  emitterCid <- registerEmitter operator admin
  [(govCid, _)] <- query @NttGovernance operator
  govDisc <- fromSome <$> queryDisclosure operator govCid

  res <- trySubmit (actAs admin <> disclose govDisc) do
    exerciseCmd govCid RegisterManager with
      admin
      transceiverEmitterCid = emitterCid
      instrumentId = InstrumentId with admin = outsider, id = nttInstrumentIdFor admin 0
      instrumentNonce = 0
      tokenConfig = BurnMint
      tokenDecimals = 8
      factory = BurnMintFactoryCid (coerceContractId emitterCid)   -- unused; registration fails first
  expectAbort "requires guardianGovernance to administer" res

  res <- trySubmit (actAs admin <> disclose govDisc) do
    exerciseCmd govCid RegisterManager with
      admin
      transceiverEmitterCid = emitterCid
      instrumentId = bridgedInstrument gg
      instrumentNonce = 0
      tokenConfig = LockUnlock
      tokenDecimals = 11
      factory = TransferFactoryCid (coerceContractId emitterCid)   -- unused; registration fails first
  expectAbort "tokenDecimals must be between 0 and 10" res

  -- The committed factory's type must match the mode: a lock/unlock
  -- registration with a burn/mint factory is rejected.
  res <- trySubmit (actAs admin <> disclose govDisc) do
    exerciseCmd govCid RegisterManager with
      admin
      transceiverEmitterCid = emitterCid
      instrumentId = bridgedInstrument gg
      instrumentNonce = 0
      tokenConfig = LockUnlock
      tokenDecimals = 8
      factory = BurnMintFactoryCid (coerceContractId emitterCid)
  expectAbort "factory type does not match" res

----------------------------------------------------------------------
-- The locked ledger
----------------------------------------------------------------------

-- | 'Debit' enforces the per-deployment release cap, and no single signatory
-- can move the balance (the controller set is all three).
testLockedLedgerCap : Script ()
testLockedLedgerCap = do
  (operator, gg, _) <- nttSetup
  alice <- allocateParty "LedgerAlice"
  d <- deploy operator gg alice LockUnlock
  let trio = actAs operator <> actAs alice <> actAs gg
  lcid <- submit trio do
    exerciseCmd (fromSome d.ledgerCid) Credit with amount = 5.0, newCustodyHint = None

  res <- trySubmit trio do exerciseCmd lcid Debit with amount = 6.0, newCustodyHint = None
  expectAbort "exceeds this deployment's locked balance" res

  submitMustFail alice do exerciseCmd lcid Debit with amount = 1.0, newCustodyHint = None
  submitMustFail gg do exerciseCmd lcid Debit with amount = 1.0, newCustodyHint = None
  submitMustFail operator do exerciseCmd lcid Debit with amount = 1.0, newCustodyHint = None

  lcid <- submit trio do exerciseCmd lcid Debit with amount = 5.0, newCustodyHint = None
  Some ledger <- queryContractId operator lcid
  ledger.balance === 0.0

----------------------------------------------------------------------
-- Send: lock accounting, burn cover and change, settlement
----------------------------------------------------------------------

-- | A deployment wired up for outbound sends at fee 0: peer set, plus the
-- disclosures a non-stakeholder sender needs (CoreState, factory, and the
-- ledger for lock/unlock).
sendScaffold
  : Party -> Party -> Party -> NttTokenConfig -> ContractId CoreState
  -> Script (Deployment, [Disclosure])
sendScaffold operator gg admin config csId = do
  d <- deploy operator gg admin config
  mgrCid <- submit admin do
    exerciseCmd d.mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  csDisc <- fromSome <$> queryDisclosure operator csId
  factoryDisc <- case config of
    BurnMint -> discloseBurnMintFactory gg
    LockUnlock -> discloseTransferFactory gg
  ledgerDiscs <- case d.ledgerCid of
    Some lcid -> do
      ld <- fromSome <$> queryDisclosure operator lcid
      pure [ld]
    None -> pure []
  pure ((d with mgrCid), csDisc :: factoryDisc :: ledgerDiscs)

-- | Submit as @p@ with a list of disclosures attached.
submitWithDiscs : Party -> [Disclosure] -> Commands a -> Script a
submitWithDiscs p discs = submit (foldl (<>) (actAs p) (map disclose discs))

trySubmitWithDiscs : Party -> [Disclosure] -> Commands a -> Script (Either SubmitError a)
trySubmitWithDiscs p discs = trySubmit (foldl (<>) (actAs p) (map disclose discs))

-- | A fee-0 outbound 'Transfer' of 1000000 raw units (0.01 at 8 decimals).
sendTransfer : Party -> Deployment -> ContractId CoreState -> [ContractId Holding] -> Commands WormholeMessage
sendTransfer user d csId holdings =
  exerciseCmd d.mgrCid Transfer with
    user
    transceiverEmitterCid = d.emitterCid
    coreStateCid = csId
    ledgerCid = d.ledgerCid
    recipientChain = 2
    recipientAddress = b32 "ee"
    sourceToken = b32 "dd"
    rawAmount = 1000000
    nonce = 0
    consistencyLevel = 0
    inputHoldingCids = holdings
    feeAllocation = None
    extraArgs = emptyExtraArgs

-- | A lock moves the sender's holding into the custodian's reserve — the
-- deployment admin's, before promotion — and credits the deployment's
-- 'LockedLedger' by the same amount. A second lock merges the fresh deposit
-- into the pot, so the custodian still holds exactly one custody holding and
-- the ledger's hint points at it.
testTransferLockAccounting : Script ()
testTransferLockAccounting = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "LockAlice"
  (d, discs) <- sendScaffold operator gg alice LockUnlock csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01

  _ <- submitWithDiscs alice discs do sendTransfer alice d csId [holdingCid]

  [(ledgerCid, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.01
  [(_, em)] <- query @Emitter alice
  em.sequence === 1
  custody <- cip56HoldingsOwnedBy gg alice
  potCid <- case custody of
    [(cid, h)] -> do
      h.amount === 0.01
      pure cid
    _ -> abort ("expected exactly one custody holding, got: " <> show custody)
  ledger.custodyHoldingCid === Some (toInterfaceContractId @Holding potCid)

  -- Second lock: the deposit is merged with the pot in the same transaction.
  -- The sender re-resolves the churned cids (emitter, ledger) and needs the
  -- pot holding disclosed too.
  holdingCid2 <- mkHolding gg alice d.instrumentId 0.005
  [(emitterCid2, _)] <- query @Emitter alice
  ledgerDisc <- fromSome <$> queryDisclosure operator ledgerCid
  potDisc <- fromSome <$> queryDisclosure gg potCid
  csDisc <- fromSome <$> queryDisclosure operator csId
  factoryDisc <- discloseTransferFactory gg
  _ <- submitWithDiscs alice [ledgerDisc, potDisc, csDisc, factoryDisc] do
    exerciseCmd d.mgrCid Transfer with
      user = alice
      transceiverEmitterCid = emitterCid2
      coreStateCid = csId
      ledgerCid = Some ledgerCid
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 500000
      nonce = 1
      consistencyLevel = 0
      inputHoldingCids = [holdingCid2]
      feeAllocation = None
      extraArgs = emptyExtraArgs

  [(_, ledger2)] <- query @LockedLedger operator
  ledger2.balance === 0.015
  custody2 <- cip56HoldingsOwnedBy gg alice
  case custody2 of
    [(cid, h)] -> do
      h.amount === 0.015
      ledger2.custodyHoldingCid === Some (toInterfaceContractId @Holding cid)
    _ -> abort ("expected one merged custody holding, got: " <> show custody2)

-- | Anyone can merge custody fragments back into one pot and repoint the
-- ledger's hint: the repair path for stale hints and explicit-input releases.
testConsolidateCustody : Script ()
testConsolidateCustody = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "ConsAlice"
  (d, _) <- sendScaffold operator gg alice LockUnlock csId
  -- Two pre-existing custody fragments (owned by the unpromoted custodian:
  -- the admin), hint not set (as after a registry-side reorganization).
  frag1 <- mkHolding gg alice d.instrumentId 1.0
  frag2 <- mkHolding gg alice d.instrumentId 2.0
  factoryDisc <- discloseTransferFactory gg
  f1Disc <- fromSome <$> queryDisclosure gg (fromInterfaceContractId @Cip56MockHolding frag1)
  f2Disc <- fromSome <$> queryDisclosure gg (fromInterfaceContractId @Cip56MockHolding frag2)

  _ <- submitWithDiscs alice [factoryDisc, f1Disc, f2Disc] do
    exerciseCmd d.mgrCid ConsolidateCustody with
      caller = alice
      ledgerCid = fromSome d.ledgerCid
      custodyHoldingCids = [frag1, frag2]
      extraArgs = emptyExtraArgs

  [(freshLedgerCid, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.0   -- consolidation never touches the balance
  custody <- cip56HoldingsOwnedBy gg alice
  case custody of
    [(cid, h)] -> do
      h.amount === 3.0
      ledger.custodyHoldingCid === Some (toInterfaceContractId @Holding cid)
    _ -> abort ("expected one merged custody holding, got: " <> show custody)

  -- A gg-owned holding is not this (unpromoted) deployment's custody. The
  -- choice body carries gg's signature, so only the explicit custodian check
  -- stands between it and spending gg's holdings — this is that check.
  ggHolding <- mkHolding gg gg d.instrumentId 1.0
  ghDisc <- fromSome <$> queryDisclosure gg (fromInterfaceContractId @Cip56MockHolding ggHolding)
  res <- trySubmitWithDiscs alice [factoryDisc, ghDisc] do
    exerciseCmd d.mgrCid ConsolidateCustody with
      caller = alice
      ledgerCid = freshLedgerCid
      custodyHoldingCids = [ggHolding]
      extraArgs = emptyExtraArgs
  expectAbort "not owned by the custodian" res

-- | A lock against a registry that answers Pending moves nothing, so the
-- manager's synchronous-settlement check aborts the send. Admin repoints the
-- deployment's committed factory to the pending one via 'SetFactory'.
testLockPendingSettlementRejected : Script ()
testLockPendingSettlementRejected = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "PendingAlice"
  (d, discs) <- sendScaffold operator gg alice LockUnlock csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01
  pendingFc <- submit gg do createCmd MockTransferFactory with admin = gg, pending = True
  pendingDisc <- fromSome <$> queryDisclosure gg pendingFc
  let pendingFactory = TransferFactoryCid (toInterfaceContractId @TransferFactory pendingFc)
  mgrCid <- submit alice do exerciseCmd d.mgrCid SetFactory with newFactory = pendingFactory

  res <- trySubmitWithDiscs alice (pendingDisc :: discs) do
    exerciseCmd mgrCid Transfer with
      user = alice
      transceiverEmitterCid = d.emitterCid
      coreStateCid = csId
      ledgerCid = d.ledgerCid
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 0
      consistencyLevel = 0
      inputHoldingCids = [holdingCid]
      feeAllocation = None
      extraArgs = emptyExtraArgs
  expectAbort "did not settle synchronously" res

-- | Before promotion, admin alone can repoint the committed factory, and a
-- send then routes through the new one (the upgrade path).
testSetFactory : Script ()
testSetFactory = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "SetFactoryAlice"
  (d, discs) <- sendScaffold operator gg alice LockUnlock csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01

  -- The other manager signatories see the contract but cannot repoint the
  -- factory; before promotion only admin controls 'SetFactory'.
  submitMustFail operator do exerciseCmd d.mgrCid SetFactory with newFactory = d.factory
  submitMustFail gg do exerciseCmd d.mgrCid SetFactory with newFactory = d.factory

  -- Admin repoints to a fresh (working) factory; the send routes through it.
  freshFc <- submit gg do createCmd MockTransferFactory with admin = gg, pending = False
  freshDisc <- fromSome <$> queryDisclosure gg freshFc
  let freshFactory = TransferFactoryCid (toInterfaceContractId @TransferFactory freshFc)
  mgrCid <- submit alice do exerciseCmd d.mgrCid SetFactory with newFactory = freshFactory

  _ <- submitWithDiscs alice (freshDisc :: discs) do
    sendTransfer alice (d with mgrCid) csId [holdingCid]

  [(_, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.01

----------------------------------------------------------------------
-- Custody promotion
----------------------------------------------------------------------

-- | Promotion moves the reserve from the admin to gg and preserves the
-- balance: an unpromoted lock lands in admin-owned custody; after 'Promote'
-- the pot is gg-owned and the ledger's hint tracks it; a post-promotion lock
-- merges into the gg pot.
testPromote : Script ()
testPromote = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "PromoteAlice"
  (d, discs) <- sendScaffold operator gg alice LockUnlock csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01
  _ <- submitWithDiscs alice discs do sendTransfer alice d csId [holdingCid]

  -- Unpromoted: the reserve is owned by the admin.
  [(ledgerCid, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.01
  adminCustody <- cip56HoldingsOwnedBy gg alice
  case adminCustody of
    [(_, h)] -> h.amount === 0.01
    _ -> abort ("expected one admin-owned custody holding, got: " <> show adminCustody)

  -- The promotion ceremony: admin and gg co-sign, naming the vetted factory.
  (mgrCid, ledgerCid) <- submit (actAs alice <> actAs gg) do
    exerciseCmd d.mgrCid Promote with
      ledgerCid
      vettedFactory = d.factory
      extraArgs = emptyExtraArgs

  Some ledger <- queryContractId operator ledgerCid
  ledger.balance === 0.01
  adminLeft <- cip56HoldingsOwnedBy gg alice
  adminLeft === []
  ggCustody <- cip56HoldingsOwnedBy gg gg
  potCid <- case ggCustody of
    [(cid, h)] -> do
      h.amount === 0.01
      pure cid
    _ -> abort ("expected one gg-owned custody holding, got: " <> show ggCustody)
  ledger.custodyHoldingCid === Some (toInterfaceContractId @Holding potCid)

  -- A post-promotion lock merges into the gg pot.
  holdingCid2 <- mkHolding gg alice d.instrumentId 0.005
  [(emitterCid2, _)] <- query @Emitter alice
  mgrDisc <- fromSome <$> queryDisclosure operator mgrCid
  ledgerDisc <- fromSome <$> queryDisclosure operator ledgerCid
  potDisc <- fromSome <$> queryDisclosure gg potCid
  csDisc <- fromSome <$> queryDisclosure operator csId
  factoryDisc <- discloseTransferFactory gg
  _ <- submitWithDiscs alice [mgrDisc, ledgerDisc, potDisc, csDisc, factoryDisc] do
    exerciseCmd mgrCid Transfer with
      user = alice
      transceiverEmitterCid = emitterCid2
      coreStateCid = csId
      ledgerCid = Some ledgerCid
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 500000
      nonce = 1
      consistencyLevel = 0
      inputHoldingCids = [holdingCid2]
      feeAllocation = None
      extraArgs = emptyExtraArgs

  [(_, ledger2)] <- query @LockedLedger operator
  ledger2.balance === 0.015
  ggCustody2 <- cip56HoldingsOwnedBy gg gg
  case ggCustody2 of
    [(_, h)] -> h.amount === 0.015
    _ -> abort ("expected one merged gg custody holding, got: " <> show ggCustody2)

-- | Promotion is a two-party ceremony with a factory pin: neither admin nor gg
-- alone can promote, the vetted factory must match the committed one, a
-- promoted deployment cannot be promoted again, and burn/mint deployments have
-- no reserve to promote.
testPromoteAuthority : Script ()
testPromoteAuthority = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "PromAuthAlice"
  (d, _) <- sendScaffold operator gg alice LockUnlock csId
  let lcid = fromSome d.ledgerCid
      doPromote mgr vetted = exerciseCmd mgr Promote with
        ledgerCid = lcid
        vettedFactory = vetted
        extraArgs = emptyExtraArgs

  submitMustFail alice do doPromote d.mgrCid d.factory
  submitMustFail gg do doPromote d.mgrCid d.factory

  res <- trySubmit (actAs alice <> actAs gg) do
    doPromote d.mgrCid (TransferFactoryCid (coerceContractId d.emitterCid))
  expectAbort "not the one the quorum vetted" res

  (mgrCid, _) <- submit (actAs alice <> actAs gg) do doPromote d.mgrCid d.factory
  res <- trySubmit (actAs alice <> actAs gg) do doPromote mgrCid d.factory
  expectAbort "already promoted" res

  bob <- allocateParty "PromAuthBob"
  dB <- deploy operator gg bob BurnMint
  res <- trySubmit (actAs bob <> actAs gg) do
    exerciseCmd dB.mgrCid Promote with
      ledgerCid = lcid
      vettedFactory = dB.factory
      extraArgs = emptyExtraArgs
  expectAbort "only lock/unlock deployments" res

-- | After promotion the committed factory is under governance: admin alone can
-- no longer rotate it; admin and gg together can.
testPromotedSetFactoryGovernance : Script ()
testPromotedSetFactoryGovernance = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "PromSetAlice"
  (d, _) <- sendScaffold operator gg alice LockUnlock csId
  (mgrCid, _) <- submit (actAs alice <> actAs gg) do
    exerciseCmd d.mgrCid Promote with
      ledgerCid = fromSome d.ledgerCid
      vettedFactory = d.factory
      extraArgs = emptyExtraArgs

  submitMustFail alice do exerciseCmd mgrCid SetFactory with newFactory = d.factory
  _ <- submit (actAs alice <> actAs gg) do
    exerciseCmd mgrCid SetFactory with newFactory = d.factory
  pure ()

-- | A lock/unlock transfer without the deployment's ledger cid is rejected;
-- so is a zero amount.
testTransferArgumentChecks : Script ()
testTransferArgumentChecks = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "ArgAlice"
  (d, discs) <- sendScaffold operator gg alice LockUnlock csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01

  res <- trySubmitWithDiscs alice discs do
    sendTransfer alice (d with ledgerCid = None) csId [holdingCid]
  expectAbort "ledger cid required" res

  res <- trySubmitWithDiscs alice discs do
    exerciseCmd d.mgrCid Transfer with
      user = alice
      transceiverEmitterCid = d.emitterCid
      coreStateCid = csId
      ledgerCid = d.ledgerCid
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 0
      nonce = 0
      consistencyLevel = 0
      inputHoldingCids = [holdingCid]
      feeAllocation = None
      extraArgs = emptyExtraArgs
  expectAbort "zero after trimming" res

-- | Under-burn: inputs sum to less than the burn amount; the cover check
-- rejects it before anything is published.
testBurnUnderBurnRejected : Script ()
testBurnUnderBurnRejected = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "BurnUnderAlice"
  (d, discs) <- sendScaffold operator gg alice BurnMint csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.004

  res <- trySubmitWithDiscs alice discs do sendTransfer alice d csId [holdingCid]
  expectAbort "do not cover" res

-- | Change conservation: inputs sum to more than the burn amount; the burn
-- archives both inputs and leaves exactly one change holding of the surplus.
testBurnReturnsChange : Script ()
testBurnReturnsChange = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "BurnChangeAlice"
  (d, discs) <- sendScaffold operator gg alice BurnMint csId
  hold1 <- mkHolding gg alice d.instrumentId 0.01
  hold2 <- mkHolding gg alice d.instrumentId 0.005

  _ <- submitWithDiscs alice discs do sendTransfer alice d csId [hold1, hold2]

  remaining <- cip56HoldingsOwnedBy gg alice
  case remaining of
    [(_, h)] -> h.amount === 0.005
    _ -> abort ("expected exactly one change holding, got: " <> show remaining)

-- | Exact cover: no change holding is created.
testBurnExactCoverNoChange : Script ()
testBurnExactCoverNoChange = do
  (operator, gg, csId) <- nttSetup
  alice <- allocateParty "BurnExactAlice"
  (d, discs) <- sendScaffold operator gg alice BurnMint csId
  holdingCid <- mkHolding gg alice d.instrumentId 0.01

  _ <- submitWithDiscs alice discs do sendTransfer alice d csId [holdingCid]

  remaining <- cip56HoldingsOwnedBy gg alice
  remaining === []

----------------------------------------------------------------------
-- Deposit pre-approval + mint (inbound burn/mint)
----------------------------------------------------------------------

-- | A recipient opts in with a single self-signed 'DepositPreapproval'.
testDepositPreapprovalCreatesStanding : Script ()
testDepositPreapprovalCreatesStanding = do
  (_, gg, _) <- nttSetup
  alice <- allocateParty "PreAlice"
  let instrumentId = bridgedInstrument gg
  _ <- submit alice do createCmd DepositPreapproval with owner = alice, instrumentId
  pres <- query @DepositPreapproval gg
  case [ p | (_, p) <- pres, p.owner == alice ] of
    [p] -> p.instrumentId === instrumentId
    _ -> abort "expected exactly one pre-approval owned by alice"

-- | The mint lands as an owner-signed holding while the owner is offline: gg
-- (the instrument admin) drives 'Deposit', and alice's signature comes from
-- the pre-approval contract itself.
testDepositMintSucceeds : Script ()
testDepositMintSucceeds = do
  (operator, gg, _) <- nttSetup
  alice <- allocateParty "MintAlice"
  d <- deploy operator gg alice BurnMint
  preCid <- submit alice do
    createCmd DepositPreapproval with owner = alice, instrumentId = d.instrumentId

  _ <- submit gg do
    exerciseCmd preCid Deposit with
      amount = 0.01
      factoryCid = theBurnMintFactory d.factory
      extraArgs = emptyExtraArgs

  holdings <- cip56HoldingsOwnedBy gg alice
  case holdings of
    [(_, h)] -> h.amount === 0.01
    _ -> abort ("expected exactly one holding minted to alice, got: " <> show holdings)

-- | Owner-only 'Revoke' tears down the standing consent; a deposit on the
-- stale cid then fails.
testRevokedPreapprovalFails : Script ()
testRevokedPreapprovalFails = do
  (operator, gg, _) <- nttSetup
  alice <- allocateParty "RevokeAlice"
  d <- deploy operator gg alice BurnMint
  preCid <- submit alice do
    createCmd DepositPreapproval with owner = alice, instrumentId = d.instrumentId
  submit alice do exerciseCmd preCid Revoke

  res <- trySubmit gg do
    exerciseCmd preCid Deposit with
      amount = 0.01
      factoryCid = theBurnMintFactory d.factory
      extraArgs = emptyExtraArgs
  case res of
    Left _ -> pure ()
    Right _ -> abort "deposit succeeded on a revoked pre-approval"

----------------------------------------------------------------------
-- Send with a nonzero message fee (the sender self-pays)
----------------------------------------------------------------------

-- | A send locks the user's tokens, publishes via the Emitter, and pays the
-- governance-set fee from the sender's own wallet. A fee-less send is
-- rejected.
testNttSend : Script ()
testNttSend = do
  (operator, gg, csId, mockAdmin, inst, feeRecipient) <- nttSetupFee
  alice <- allocateParty "SendAlice"
  d <- deploy operator gg alice LockUnlock
  holdingCid <- mkHolding gg alice d.instrumentId 0.01
  _ <- submit alice do
    exerciseCmd d.mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  [(mgrCid, _)] <- query @NttManager operator
  let d' = d with mgrCid

  -- Governance raises the message fee to 1000 (1e-7 tokens).
  csId <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  csDisc <- fromSome <$> queryDisclosure operator csId
  factoryDisc <- discloseTransferFactory gg
  ledgerDisc <- fromSome <$> queryDisclosure operator (fromSome d.ledgerCid)
  let discs = [csDisc, factoryDisc, ledgerDisc]

  let doTransfer feeAlloc = exerciseCmd d'.mgrCid Transfer with
        user = alice
        transceiverEmitterCid = d'.emitterCid
        coreStateCid = csId
        ledgerCid = d'.ledgerCid
        recipientChain = 2
        recipientAddress = b32 "ee"
        sourceToken = b32 "dd"
        rawAmount = 1000000
        nonce = 7
        consistencyLevel = 0
        inputHoldingCids = [holdingCid]
        feeAllocation = feeAlloc
        extraArgs = emptyExtraArgs

  -- Fee due but none attached: rejected.
  res <- trySubmitWithDiscs alice discs do doTransfer None
  assert (isLeft res)

  -- Exact fee from alice's wallet: succeeds, fee lands on the fee recipient.
  feePay <- mintAndAllocate mockAdmin alice feeRecipient inst (feeToDecimal 1000)
  msg <- submitWithDiscs alice discs do doTransfer (Some feePay)
  msg.sequence === 0

  [(_, em)] <- query @Emitter alice
  em.sequence === 1
  [(_, ledger)] <- query @LockedLedger operator
  ledger.balance === 0.01
  custody <- cip56HoldingsOwnedBy gg alice
  case custody of
    [(_, h)] -> h.amount === 0.01
    _ -> abort ("expected exactly one locked holding, got: " <> show custody)
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 1000
  where
    isLeft = \case
      Left _ -> True
      Right _ -> False

-- | A party other than the admin initiates 'Transfer' alone and pays its own
-- fee; the admin is never active. The nested lock and 'PublishMessage' run on
-- the manager's inherited authority; bob co-controls 'PublishMessage' as
-- payer. The only extra requirement is visibility: every referenced contract
-- is disclosed to bob.
--
-- The deployment is promoted first so the custody receiver is gg. The mock
-- factory can only create a receiver holding when it can reach the receiver's
-- signature (it cannot model a real registry's receiver pre-approval), which
-- for a sender other than the custodian means the gg-owned reserve.
testNttTransferByDifferentUser : Script ()
testNttTransferByDifferentUser = do
  (operator, gg, csId, mockAdmin, inst, feeRecipient) <- nttSetupFee
  admin <- allocateParty "TransferAdmin"
  bob <- allocateParty "TransferBob"
  d <- deploy operator gg admin LockUnlock
  holdingCid <- mkHolding gg bob d.instrumentId 0.01
  mgrCid <- submit admin do
    exerciseCmd d.mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  (mgrCid, _) <- submit (actAs admin <> actAs gg) do
    exerciseCmd mgrCid Promote with
      ledgerCid = fromSome d.ledgerCid
      vettedFactory = d.factory
      extraArgs = emptyExtraArgs
  let d' = d with mgrCid

  csId <- submit operator do
    exerciseCmd csId SubmitGovernanceVAA with
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]

  feePay <- mintAndAllocate mockAdmin bob feeRecipient inst (feeToDecimal 1000)
  dMgr     <- fromSome <$> queryDisclosure operator mgrCid
  dEmitter <- fromSome <$> queryDisclosure admin d.emitterCid
  dFactory <- discloseTransferFactory gg
  dCs      <- fromSome <$> queryDisclosure operator csId
  dLedger  <- fromSome <$> queryDisclosure operator (fromSome d.ledgerCid)
  _ <- submitWithDiscs bob [dMgr, dEmitter, dFactory, dCs, dLedger] do
    exerciseCmd mgrCid Transfer with
      user = bob
      transceiverEmitterCid = d'.emitterCid
      coreStateCid = csId
      ledgerCid = d'.ledgerCid
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 1
      consistencyLevel = 0
      inputHoldingCids = [holdingCid]
      feeAllocation = Some feePay
      extraArgs = emptyExtraArgs

  [(_, em)] <- query @Emitter admin
  em.sequence === 1
  custody <- cip56HoldingsOwnedBy gg gg
  case custody of
    [(_, h)] -> h.amount === 0.01
    _ -> abort ("expected exactly one locked holding, got: " <> show custody)
  bal <- mockBalance mockAdmin feeRecipient inst
  bal === feeToDecimal 1000

-- | Two negative cases: the admin alone cannot transfer on bob's behalf (bob
-- is the controller), and bob without disclosures fails on visibility.
testNttTransferRequiresUserAuthority : Script ()
testNttTransferRequiresUserAuthority = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "ReqAdmin"
  bob <- allocateParty "ReqBob"
  d <- deploy operator gg admin LockUnlock
  mgrCid <- submit admin do
    exerciseCmd d.mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  let doTransfer = exerciseCmd mgrCid Transfer with
        user = bob
        transceiverEmitterCid = d.emitterCid
        coreStateCid = csId
        ledgerCid = d.ledgerCid
        recipientChain = 2
        recipientAddress = b32 "ee"
        sourceToken = b32 "dd"
        rawAmount = 1000000
        nonce = 1
        consistencyLevel = 0
        inputHoldingCids = []
        feeAllocation = None
        extraArgs = emptyExtraArgs

  submitMustFail admin do doTransfer
  submitMustFail bob do doTransfer
  pure ()

----------------------------------------------------------------------
-- Receive (the inbound gate) + replay
----------------------------------------------------------------------

-- Signed NTT transfer VAA (guardian set 0, devnet guardian): source chain 2,
-- emitter (peer transceiver) 0x..cc, peer manager 0x..bb, our manager 0x..aa,
-- transfer of 1_000_000 @ 8 decimals of token 0x..dd to 0x..ee on chain 72.
nttTransferVAA : Bytes
nttTransferVAA = ""

-- | The digest the fixture VAA consumes.
nttTransferDigest : Text
nttTransferDigest = (parseVAA nttTransferVAA).hash

-- | Create a manager whose @managerAddress@ is exactly the fixture's
-- recipientManager (0x..aa), set the peer, and claim the replay-trie root. A
-- static signed fixture needs a fixed address that a nondeterministic Party
-- cannot reproduce, so the manager (and, for lock/unlock, its ledger) is
-- created directly with all three signatures rather than registered.
setupFixedManager
  : Party -> Party -> Party -> NttTokenConfig
  -> Script (ContractId NttManager, NttFactory, Optional (ContractId LockedLedger))
setupFixedManager operator gg admin config = do
  let instrumentId = bridgedInstrument gg
  factory <- case config of
    BurnMint -> do
      fc <- submit gg do createCmd MockBurnMintFactory with admin = gg, instrument = instrumentId
      pure (BurnMintFactoryCid (toInterfaceContractId @BurnMintFactory fc))
    LockUnlock -> do
      fc <- submit gg do createCmd MockTransferFactory with admin = gg, pending = False
      pure (TransferFactoryCid (toInterfaceContractId @TransferFactory fc))
  mgrCid <- submit (actAs operator <> actAs admin <> actAs gg) do
    createCmd NttManager with
      operator
      admin
      guardianGovernance = gg
      managerId = 999
      managerAddress = b32 "aa"
      transceiverEmitterId = 999
      instrumentId
      tokenConfig = config
      tokenDecimals = 8
      peers = Map.empty
      factory
      custody = AdminCustody
  mgrCid <- submit admin do
    exerciseCmd mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc"
  ledgerCid <- case config of
    LockUnlock -> Some <$> submit (actAs operator <> actAs admin <> actAs gg) do
      createCmd LockedLedger with
        operator
        admin
        guardianGovernance = gg
        managerAddress = b32 "aa"
        balance = 0.0
        custodyHoldingCid = None
    BurnMint -> pure None
  _ <- registerReplayRoot operator admin defaultSplitThreshold
  pure (mgrCid, factory, ledgerCid)

-- | Anyone can relay: a third party (@relayer@), a stakeholder of nothing,
-- submits 'Release' with only disclosed contracts and no recipient action. The
-- submission gets all the way to the recipient-binding check, and fails only
-- because a freshly allocated Party can never hash to the fixture VAA's
-- baked-in recipientAddress — not for lack of authority.
testReceiveByExecutorRecipientMismatchFails : Script ()
testReceiveByExecutorRecipientMismatchFails = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "RecvAdmin"
  relayer <- allocateParty "Relayer"
  wrongRecipient <- allocateParty "WrongRecipient"
  (mgrCid, _, ledgerCid) <- setupFixedManager operator gg admin LockUnlock
  (nodeCid, nodeDisc) <- coveringDisclosure operator admin nttTransferDigest
  dMgr <- fromSome <$> queryDisclosure operator mgrCid
  dCs  <- fromSome <$> queryDisclosure operator csId
  dLedger <- fromSome <$> queryDisclosure operator (fromSome ledgerCid)

  res <- trySubmitWithDiscs relayer [dMgr, dCs, nodeDisc, dLedger] do
    exerciseCmd mgrCid Release with
      executor = relayer
      coreStateCid = csId
      replayNodeCid = nodeCid
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = wrongRecipient
      ledgerCid = fromSome ledgerCid
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  expectAbort "recipient does not match" res

-- | The guardian trust root is pinned to the committed @guardianGovernance@,
-- not the operator. A compromised operator could co-sign a forged 'CoreState'
-- under a throwaway gg party; it fails the pin before any verification runs.
testReceivePinsGuardianGovernance : Script ()
testReceivePinsGuardianGovernance = do
  (operator, gg, _) <- nttSetup
  admin <- allocateParty "PinAdmin"
  recipient <- allocateParty "PinRecipient"
  rogueGov <- allocateParty "RogueGovernance"
  rogueObserver <- allocateParty "RogueObserver"
  let rogueInst = InstrumentId with admin = rogueGov, id = "UNUSED"
  fakeCsId <- submit (actAs operator <> actAs rogueGov) do
    createCmd (mkInitialCoreState operator rogueGov solanaGovernanceChainId defaultGovernanceContract
                 ["1111111111111111111111111111111111111111"] rogueObserver rogueInst rogueGov)
  (mgrCid, _, ledgerCid) <- setupFixedManager operator gg admin LockUnlock
  (nodeCid, _) <- coveringDisclosure operator admin nttTransferDigest

  res <- trySubmit (actAs operator) do
    exerciseCmd mgrCid Release with
      executor = operator
      coreStateCid = fakeCsId
      replayNodeCid = nodeCid
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      ledgerCid = fromSome ledgerCid
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  expectAbort "committed guardian trust anchor" res

-- | A 'Release' must present the deployment's own ledger; another
-- deployment's ledger (different manager address) is rejected before any
-- verification runs, so no deployment can spend against a foreign cap.
testReleaseRejectsForeignLedger : Script ()
testReleaseRejectsForeignLedger = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "ForeignAdmin"
  other <- allocateParty "ForeignOther"
  recipient <- allocateParty "ForeignRecipient"
  (mgrCid, _, _) <- setupFixedManager operator gg admin LockUnlock
  (nodeCid, _) <- coveringDisclosure operator admin nttTransferDigest
  -- A second deployment's ledger, owned by the same parties except the address.
  foreignLedger <- submit (actAs operator <> actAs admin <> actAs gg) do
    createCmd LockedLedger with
      operator
      admin
      guardianGovernance = gg
      managerAddress = b32 "ff"
      balance = 100.0
      custodyHoldingCid = None

  res <- trySubmit (actAs operator) do
    exerciseCmd mgrCid Release with
      executor = operator
      coreStateCid = csId
      replayNodeCid = nodeCid
      vaaBytes = nttTransferVAA
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient
      ledgerCid = foreignLedger
      inputHoldingCids = []
      extraArgs = emptyExtraArgs
  expectAbort "does not belong to this deployment" res

----------------------------------------------------------------------
-- Receive (matching recipient), live two-step harness
----------------------------------------------------------------------
--
-- No static VAA can match a nondeterministic Party's hash, so the matching-
-- recipient mint path is a two-step, Go-orchestrated live-sandbox flow
-- (ntt_recipient_match_integration_test.go): step 1 returns the on-ledger
-- 'recipientAddressFor recipient'; Go signs a fresh VAA against it; step 2
-- relays it through 'NttManager.Mint'. These are NOT run by `dpm test`
-- (argument-taking), only compiled — except the nullary setup, which runs.

data NttReceiveMatchSetup = NttReceiveMatchSetup with
    mgrId                 : ContractId NttManager
    operator              : Party
    admin                 : Party
    recipient             : Party
    coreStateCid          : ContractId CoreState
    replayNodeCid         : ContractId ReplayNode
    recipientAddress      : Bytes32
    depositPreapprovalCid : ContractId DepositPreapproval
    factoryCid            : ContractId BurnMintFactory
  deriving (Eq, Show)

integrationNttReceiveMatchSetup : Script NttReceiveMatchSetup
integrationNttReceiveMatchSetup = do
  (operator, gg, csId) <- nttSetup
  admin <- allocateParty "MatchAdmin"
  recipient <- allocateParty "MatchRecipient"
  (mgrId, factory, _) <- setupFixedManager operator gg admin BurnMint
  -- The recipient opts in once (a single self-signed create), then can stay
  -- offline.
  depositPreapprovalCid <- submit recipient do
    createCmd DepositPreapproval with owner = recipient, instrumentId = bridgedInstrument gg
  [(nodeCid, _)] <- query @ReplayNode operator
  pure NttReceiveMatchSetup with
    mgrId
    operator
    admin
    recipient
    coreStateCid = csId
    replayNodeCid = nodeCid
    recipientAddress = recipientAddressFor recipient
    depositPreapprovalCid
    factoryCid = theBurnMintFactory factory

data NttReceiveMatchInput = NttReceiveMatchInput with
    mgrId                 : ContractId NttManager
    operator              : Party
    admin                 : Party
    recipient             : Party
    coreStateCid          : ContractId CoreState
    replayNodeCid         : ContractId ReplayNode
    vaaBytes              : Bytes
    depositPreapprovalCid : ContractId DepositPreapproval
    factoryCid            : ContractId BurnMintFactory
  deriving (Eq, Show)

-- | Step 2: relay the fresh VAA through 'NttManager.Mint'. The recipient's
-- standing pre-approval supplies their signature for the mint; the parties
-- co-act only for visibility of the referenced contracts (the JSON boundary
-- stays plain party-id strings). The relay mints to the recipient; a second
-- relay of the same VAA is rejected as a replay.
integrationNttReceiveMatch : NttReceiveMatchInput -> Script ()
integrationNttReceiveMatch input = do
  Some mgr <- queryContractId input.operator input.mgrId
  let gg = mgr.guardianGovernance
  _ <- submit (actAs input.operator <> actAs input.admin <> actAs input.recipient <> actAs gg) do
    exerciseCmd input.mgrId Mint with
      executor = input.operator
      coreStateCid = input.coreStateCid
      replayNodeCid = input.replayNodeCid
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      depositPreapprovalCid = input.depositPreapprovalCid
      extraArgs = emptyExtraArgs

  holdings <- cip56HoldingsOwnedBy gg input.recipient
  case holdings of
    [(_, h)] -> h.amount === 0.01
    _ -> abort "expected exactly one holding minted to the matching recipient"

  -- Replay: the digest is now consumed. Re-resolve the covering node and
  -- relay again — rejected on membership.
  (freshNode, _) <- coveringDisclosure input.operator input.admin (parseVAA input.vaaBytes).hash
  submitMustFail (actAs input.operator <> actAs input.admin <> actAs input.recipient <> actAs gg) do
    exerciseCmd input.mgrId Mint with
      executor = input.operator
      coreStateCid = input.coreStateCid
      replayNodeCid = freshNode
      vaaBytes = input.vaaBytes
      pubKeys = [(0, devnetGuardianPubKey)]
      recipient = input.recipient
      depositPreapprovalCid = input.depositPreapprovalCid
      extraArgs = emptyExtraArgs
  pure ()
