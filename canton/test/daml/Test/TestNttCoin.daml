-- | Daml Script tests for 'Wormhole.Ntt.Coin': the genesis, gg-owned
-- 'NttCoinFactory' and its paired 'NttCoin' holding.
--
-- Unlike 'Test.TestNtt's single-instrument 'MockBurnMintFactory', the real
-- 'NttCoinFactory' is a multi-tenant singleton, so these tests pin down
-- @expectedAdmin@ validation, cross-instrument burn isolation, and sharing
-- across independent admins' deployments.
module Test.TestNttCoin where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.BurnMintV1
  ( BurnMintFactory, BurnMintFactory_BurnMint(..), BurnMintFactory_PublicFetch(..)
  , BurnMintOutput(..)
  )
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinFactory
import Wormhole.Ntt.Deposit (DepositPreapproval(..), Deposit(..))
import Wormhole.Ntt.Manager
import Test.TestNtt (nttSetup, nttCoinFactorySetup, b32, expectAbort)
import Test.TestFactoryAuthority (registerBurnMint)

-- | The interface-typed handle tests exercise choices on.
asBurnMintFactory : ContractId NttCoinFactory -> ContractId BurnMintFactory
asBurnMintFactory = toInterfaceContractId @BurnMintFactory

-- | Mint one coin directly against the factory — the only way to seed an
-- initial balance on a burn/mint chain outside of a real inbound transfer.
mintCoin : ContractId NttCoinFactory -> Party -> InstrumentId -> Party -> Decimal -> Script (ContractId Holding)
mintCoin factoryCid gg instrumentId owner amount = do
  res <- submit (actAs gg <> actAs owner) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId
      inputHoldingCids = []
      outputs = [BurnMintOutput with owner, amount, context = emptyExtraArgs.context]
      extraActors = [owner]
      extraArgs = emptyExtraArgs
  case res.outputCids of
    [cid] -> pure cid
    _ -> abort ("expected exactly one minted coin, got: " <> show res.outputCids)

----------------------------------------------------------------------
-- Genesis
----------------------------------------------------------------------

testNttCoinFactoryGenesis : Script ()
testNttCoinFactoryGenesis = do
  gg <- allocateParty "CoinGenesisGg"
  factoryCid <- nttCoinFactorySetup gg
  Some factory <- queryContractId gg factoryCid
  factory.guardianGovernance === gg

testNttCoinFactoryPublicFetch : Script ()
testNttCoinFactoryPublicFetch = do
  gg <- allocateParty "CoinFetchGg"
  rogue <- allocateParty "CoinFetchRogue"
  factoryCid <- nttCoinFactorySetup gg
  view <- submit gg do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_PublicFetch with
      expectedAdmin = gg
      actor = gg
  view.admin === gg

  submitMustFail gg do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_PublicFetch with
      expectedAdmin = rogue
      actor = gg

----------------------------------------------------------------------
-- Mint / burn mechanics
----------------------------------------------------------------------

testNttCoinMintEmptyInputsOneOutput : Script ()
testNttCoinMintEmptyInputsOneOutput = do
  gg <- allocateParty "CoinMintGg"
  alice <- allocateParty "CoinMintAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-MINT"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  Some coin <- queryContractId gg (coerceContractId @Holding @NttCoin coinCid)
  coin.owner === alice
  coin.instrumentId === instrumentId
  coin.amount === 0.01

testNttCoinBurnOneInputWithChange : Script ()
testNttCoinBurnOneInputWithChange = do
  gg <- allocateParty "CoinBurnChangeGg"
  alice <- allocateParty "CoinBurnChangeAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-BURN-CHANGE"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01

  res <- submit (actAs gg <> actAs alice) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId
      inputHoldingCids = [coinCid]
      outputs = [BurnMintOutput with owner = alice, amount = 0.004, context = emptyExtraArgs.context]
      extraActors = [alice]
      extraArgs = emptyExtraArgs

  archived <- queryContractId gg (coerceContractId @Holding @NttCoin coinCid)
  archived === None
  case res.outputCids of
    [changeCid] -> do
      Some change <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      change.amount === 0.004
    _ -> abort ("expected exactly one change coin, got: " <> show res.outputCids)

testNttCoinBurnOneInputZeroChange : Script ()
testNttCoinBurnOneInputZeroChange = do
  gg <- allocateParty "CoinBurnExactGg"
  alice <- allocateParty "CoinBurnExactAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-BURN-EXACT"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01

  res <- submit (actAs gg <> actAs alice) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId
      inputHoldingCids = [coinCid]
      outputs = []
      extraActors = [alice]
      extraArgs = emptyExtraArgs

  res.outputCids === []
  archived <- queryContractId gg (coerceContractId @Holding @NttCoin coinCid)
  archived === None

testBurnMintRejectsZeroAmountOutput : Script ()
testBurnMintRejectsZeroAmountOutput = do
  gg <- allocateParty "CoinZeroOutputGg"
  alice <- allocateParty "CoinZeroOutputAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ZERO-OUTPUT"

  res <- trySubmit (actAs gg <> actAs alice) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId
      inputHoldingCids = []
      outputs = [BurnMintOutput with owner = alice, amount = 0.0, context = emptyExtraArgs.context]
      extraActors = [alice]
      extraArgs = emptyExtraArgs
  expectAbort "NttCoin" res

----------------------------------------------------------------------
-- Defensive checks specific to a multi-tenant factory
----------------------------------------------------------------------

testNttCoinRejectsMismatchedAdminInstrument : Script ()
testNttCoinRejectsMismatchedAdminInstrument = do
  gg <- allocateParty "CoinMismatchGg"
  notGg <- allocateParty "CoinMismatchNotGg"
  alice <- allocateParty "CoinMismatchAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = notGg, id = "NTT-COIN-MISMATCH"

  res <- trySubmit (actAs gg <> actAs notGg <> actAs alice) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId
      inputHoldingCids = []
      outputs = [BurnMintOutput with owner = alice, amount = 0.01, context = emptyExtraArgs.context]
      extraActors = [alice]
      extraArgs = emptyExtraArgs
  expectAbort "only serves instruments administered by guardianGovernance" res

testNttCoinRejectsCrossInstrumentBurn : Script ()
testNttCoinRejectsCrossInstrumentBurn = do
  gg <- allocateParty "CoinCrossGg"
  alice <- allocateParty "CoinCrossAlice"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentA = InstrumentId with admin = gg, id = "NTT-COIN-CROSS-A"
      instrumentB = InstrumentId with admin = gg, id = "NTT-COIN-CROSS-B"
  coinCid <- mintCoin factoryCid gg instrumentA alice 0.01

  res <- trySubmit (actAs gg <> actAs alice) do
    exerciseCmd (asBurnMintFactory factoryCid) BurnMintFactory_BurnMint with
      expectedAdmin = gg
      instrumentId = instrumentB
      inputHoldingCids = [coinCid]
      outputs = []
      extraActors = [alice]
      extraArgs = emptyExtraArgs
  expectAbort "burn input's instrument does not match the requested instrumentId" res

----------------------------------------------------------------------
-- Canonical sharing across unrelated deployments
----------------------------------------------------------------------

-- | One 'NttCoinFactory' cid served to two different admins' deployments —
-- proving genuine sharing, not per-deployment duplication.
testNttCoinFactoryServesTwoDistinctAdmins : Script ()
testNttCoinFactoryServesTwoDistinctAdmins = do
  (operator, gg, _) <- nttSetup
  factoryCid <- nttCoinFactorySetup gg
  alice <- allocateParty "CoinSharedAlice"
  bob <- allocateParty "CoinSharedBob"
  let instA = InstrumentId with admin = gg, id = nttInstrumentIdFor alice 0
      instB = InstrumentId with admin = gg, id = nttInstrumentIdFor bob 0

  (discsA, registerA) <- registerBurnMint operator alice instA (asBurnMintFactory factoryCid)
  (mgrA, _) <- submit (actAs alice <> actAs gg <> mconcat (map disclose discsA)) registerA
  (discsB, registerB) <- registerBurnMint operator bob instB (asBurnMintFactory factoryCid)
  (mgrB, _) <- submit (actAs bob <> actAs gg <> mconcat (map disclose discsB)) registerB

  Some ma <- queryContractId operator mgrA
  Some mb <- queryContractId operator mgrB
  ma.factory === BurnMintFactoryCid (asBurnMintFactory factoryCid)
  mb.factory === BurnMintFactoryCid (asBurnMintFactory factoryCid)
  assert (ma.instrumentId /= mb.instrumentId)

----------------------------------------------------------------------
-- End-to-end round trip against the real factory
----------------------------------------------------------------------

-- | End-to-end round trip against the real factory: mint, burn via outbound
-- 'Transfer' (checking change), then re-mint via 'Deposit' -- not a
-- VAA-driven 'Mint', since a static VAA fixture can't name a fresh Party.
testNttCoinEndToEndRoundTrip : Script ()
testNttCoinEndToEndRoundTrip = do
  (operator, gg, csId) <- nttSetup
  factoryCid <- nttCoinFactorySetup gg
  alice <- allocateParty "CoinRoundTripAlice"
  let instrumentId = InstrumentId with admin = gg, id = nttInstrumentIdFor alice 0

  (discsReg, register) <- registerBurnMint operator alice instrumentId (asBurnMintFactory factoryCid)
  (mgrCid, emitterCid) <- submit (actAs alice <> actAs gg <> mconcat (map disclose discsReg)) register
  mgrCid' <- submit alice do
    exerciseCmd mgrCid SetPeer with
      chainId = 2
      peer = Peer with managerAddress = b32 "bb", transceiverAddress = b32 "cc", decimals = 8

  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01

  csDisc <- fromSome <$> queryDisclosure operator csId
  emitterDisc <- fromSome <$> queryDisclosure operator emitterCid
  factoryDisc <- fromSome <$> queryDisclosure gg factoryCid
  _ <- submit (actAs alice <> disclose csDisc <> disclose emitterDisc <> disclose factoryDisc) do
    exerciseCmd mgrCid' Transfer with
      user = alice
      transceiverEmitterCid = emitterCid
      coreStateCid = csId
      ledgerCid = None
      recipientChain = 2
      recipientAddress = b32 "ee"
      sourceToken = b32 "dd"
      rawAmount = 1000000
      nonce = 0
      consistencyLevel = 0
      inputHoldingCids = [coinCid]
      feeAllocation = None
      extraArgs = emptyExtraArgs

  remaining <- query @NttCoin gg
  [ cid | (cid, c) <- remaining, c.owner == alice ] === []

  preCid <- submit alice do
    createCmd DepositPreapproval with owner = alice, instrumentId
  _ <- submit gg do
    exerciseCmd preCid Deposit with
      amount = 0.02
      factoryCid = asBurnMintFactory factoryCid
      extraArgs = emptyExtraArgs

  minted <- query @NttCoin gg
  case [ c | (_, c) <- minted, c.owner == alice ] of
    [c] -> c.amount === 0.02
    other -> abort ("expected exactly one minted coin owned by alice, got: " <> show other)
