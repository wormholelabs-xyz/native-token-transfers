-- | Daml Script tests and devnet bootstrap for the Wormhole core bridge.
--
-- @setup@ seeds a devnet 'CoreState' with the standard Tilt/devnet guardian
-- (address 0xbeFA429d57cD18b7F8A4d91A2da9AB4AF05d0FBe).
module Test.TestCore where

import Daml.Script
import DA.Assert ((===))
import DA.Map qualified as Map
import DA.Optional (fromOptional, fromSome)
import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Wormhole.Core.Bytes
import Wormhole.Core.GuardianSet
import Wormhole.Core.State
import Wormhole.Core.Setup
import Wormhole.Core.VAA ()   -- HasField instances for VAA record-dot access

-- The well-known devnet guardian address used across Wormhole's Tilt setup.
devnetGuardian : Bytes20
devnetGuardian = "befa429d57cd18b7f8a4d91a2da9ab4af05d0fbe"

-- 65-byte uncompressed secp256k1 public key of the devnet guardian.
devnetGuardianPubKey : Bytes
devnetGuardianPubKey = "04d4a4629979f0c9fa0f0bb54edf33f87c8c5a1f42c0350a30d68f7e967023e34e495a8ebf5101036d0fd66e3b0a8c7c61b65fceeaf487ab3cd1b5b7b50beb7970"

-- A real governance VAA — SetMessageFee(chain=75, fee=1000), emitted by the
-- standard governance emitter (chain 1, 0x..04) and signed by the devnet
-- guardian (set 0). Regenerated by testing/go's TestReproduceGovSetFeeVAA
-- for the core cantonChainId (75).
govSetFeeVAA : Bytes
govSetFeeVAA = ""

-- | Bootstrap a devnet 'CoreState' (signed by @guardianGovernance@ and the fee
-- recipient @feeCustody@), the 'EmitterRegistry', and the 'ReplayRootRegistry'.
-- Returns @(guardianGovernance, coreState)@.
setup : Script (Party, ContractId CoreState)
setup = setupWithInstrument None

-- | 'setup' with a caller-supplied fee instrument (plain 'setup' uses a
-- placeholder, never validated since fees default to 0). Fee recipient is
-- @feeCustody@. Core 0.9.0 rejects @guardianGovernance@ as the fee recipient,
-- and @guardianGovernance@ and @feeCustody@ as the fee instrument admin.
setupWithInstrument : Optional InstrumentId -> Script (Party, ContractId CoreState)
setupWithInstrument mInstrument = do
  guardianGovernance <- allocateParty "GuardianGovernance"
  feeCustody <- allocateParty "FeeCustody"
  onboardingFeeAdmin <- allocateParty "OnboardingFeeAdmin"
  placeholderFeeInstrumentAdmin <- allocateParty "FeeInstrumentAdmin"
  let feeInstrument = fromOptional (InstrumentId with admin = placeholderFeeInstrumentAdmin, id = "UNUSED") mInstrument
      registryParties = RegistryParties with guardianGovernance, onboardingFeeAdmin
  csId <- submit (actAs guardianGovernance <> actAs feeCustody) do
    createCmd (mkInitialCoreState guardianGovernance solanaGovernanceChainId
                 defaultGovernanceContract
                 (GenesisGuardianSet with guardianSetIndex = 0, guardianAddresses = [devnetGuardian])
                 feeInstrument feeCustody)
  _ <- submit guardianGovernance do createCmd (mkInitialEmitterRegistry registryParties 0)
  _ <- submit guardianGovernance do createCmd (mkInitialReplayRootRegistry registryParties 0)
  pure (guardianGovernance, csId)

-- | Register an emitter for @owner@ the production way: the requester submits
-- alone against the disclosed 'EmitterRegistry' (gg signature inherited from
-- the registry). Zero-fee registries need no CoreState.
registerEmitter : Party -> Party -> Script (ContractId Emitter)
registerEmitter guardianGovernance owner = do
  [(regCid, _)] <- query @EmitterRegistry guardianGovernance
  regDisc <- fromSome <$> queryDisclosure guardianGovernance regCid
  (_, emCid) <- submit (actAs owner <> disclose regDisc) do
    exerciseCmd regCid RegisterEmitter with
      requester = owner
      payer = owner    -- direct registration: own payer, controller set collapses
      coreStateCid = None
      feeAllocation = None
      expectedGuardianGovernance = guardianGovernance
  pure emCid

-- | Publish with the 'CoreState' disclosed (fee read on every publish; at fee 0 no
-- allocation attached).
publishVia : Party -> ContractId CoreState -> Party -> ContractId Emitter -> Int -> Bytes -> Int -> Script WormholeMessage
publishVia guardianGovernance csId owner emCid nonce payload consistencyLevel = do
  csDisc <- fromSome <$> queryDisclosure guardianGovernance csId
  (_, msg) <- submit (actAs owner <> disclose csDisc) do
    exerciseCmd emCid PublishMessage with
      nonce, payload, consistencyLevel
      coreStateCid = csId
      payer = owner
      feeAllocation = None
  pure msg

-- | Publishing increments the per-emitter sequence and yields the expected
-- 'WormholeMessage' (carrying the emitter identity the watcher hashes into the
-- address); the second publish resolves the bumped successor from the owner's ACS.
testPublishMessage : Script ()
testPublishMessage = do
  (gg, csId) <- setup
  alice <- allocateParty "Alice"
  emitterId <- registerEmitter gg alice
  Some em <- queryContractId alice emitterId
  em.emitterId === 0
  em.emitterAddress === emitterAddressFor gg alice 0

  msg0 <- publishVia gg csId alice emitterId 7 "deadbeef" 0
  msg0.registrar === gg
  msg0.owner === alice
  msg0.emitterId === 0
  msg0.sequence === 0
  msg0.nonce === 7
  msg0.payload === "deadbeef"

  -- The bumped successor arrives on the owner's ACS, so the next publish addresses
  -- it directly.
  [(emitterId', _)] <- query @Emitter alice
  msg1 <- publishVia gg csId alice emitterId' 8 "cafe" 0
  msg1.sequence === 1
  msg1.registrar === gg
  msg1.owner === alice
  msg1.emitterId === 0
  pure ()

-- | Emitter ids are allocated sequentially and yield distinct, owner-bound
-- addresses; the registry's counter advances.
testRegistryAllocation : Script ()
testRegistryAllocation = do
  (gg, _) <- setup
  alice <- allocateParty "AllocAlice"
  bob <- allocateParty "AllocBob"
  aliceEm <- registerEmitter gg alice
  bobEm <- registerEmitter gg bob
  Some a <- queryContractId alice aliceEm
  Some b <- queryContractId bob bobEm
  a.emitterId === 0
  b.emitterId === 1
  assert (a.emitterAddress /= b.emitterAddress)
  [(_, reg)] <- query @EmitterRegistry gg
  reg.nextId === 2

-- | Pins the emitter-address encoding against the cross-language vector. If it
-- fails, the Daml and Go encoders have diverged — fix both and regenerate.
testAddressVector : Script ()
testAddressVector =
  derivedAddressFromText
      (DomainTag emitterAddressTag)
      (RegistrarText "vector-operator::1220deadbeef")
      (OwnerText "vector-owner::1220cafebabe")
      (RegistryId 7)
    === "45ae8886d1c165b071d3b1202fe81ebedc39f61a6a91a1d13140eb64857f3f2b"

-- | An emitter's address is bound to its owner. The address includes @owner@
-- and the 'Emitter' is owner-co-signed, so: (a) Mallory alone cannot create a
-- contract with Alice's address; (b) Mallory still needs guardianGovernance
-- for an emitter of her own; (c) with guardianGovernance, a different owner
-- derives a different address.
testImpersonationBlocked : Script ()
testImpersonationBlocked = do
  (gg, _) <- setup
  alice <- allocateParty "VictimAlice"
  mallory <- allocateParty "Mallory"
  aliceEm <- registerEmitter gg alice
  Some a <- queryContractId alice aliceEm

  -- (a) Mallory alone cannot forge Alice's address.
  submitMustFail mallory do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = alice
      emitterId = 0
      emitterAddress = a.emitterAddress, sequence = 0

  -- (b) Mallory without guardianGovernance cannot create an emitter.
  submitMustFail mallory do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = mallory
      emitterId = 0
      emitterAddress = emitterAddressFor gg mallory 0, sequence = 0

  -- (c) With guardianGovernance, a same-id emitter for Mallory has a different address.
  malloryEm <- submit (actAs mallory <> actAs a.guardianGovernance) do
    createCmd Emitter with
      guardianGovernance = a.guardianGovernance, owner = mallory
      emitterId = 0
      emitterAddress = emitterAddressFor gg mallory 0, sequence = 0
  Some m <- queryContractId mallory malloryEm
  assert (m.emitterAddress /= a.emitterAddress)

-- | A payload above the 750 bytes of whitepaper 0004 publishes (EVM parity,
-- core 0.8.3 and later).
testPublishAcceptsPayloadAbove750Bytes : Script ()
testPublishAcceptsPayloadAbove750Bytes = do
  (gg, csId) <- setup
  bob <- allocateParty "Bob"
  emitterId <- registerEmitter gg bob
  -- 751 bytes = 1502 hex chars.
  let payloadOf751Bytes = mconcat (replicate 1502 "f")
  message <- publishVia gg csId bob emitterId 0 payloadOf751Bytes 0
  message.payload === payloadOf751Bytes
  message.sequence === 0

-- | Sanity check on quorum thresholds (EVM parity: floor(n*2/3)+1).
testQuorum : Script ()
testQuorum = do
  quorum 1 === 1
  quorum 3 === 3
  quorum 4 === 3
  quorum 19 === 13
  pure ()

-- | The current guardian set is installed at index 0 and never expires.
testInitialGuardianSet : Script ()
testInitialGuardianSet = do
  (gg, csId) <- setup
  Some cs <- queryContractId gg csId
  cs.guardianSetIndex === 0
  let gs = fromSome (Map.lookup 0 cs.guardianSets)
  gs.keys === [devnetGuardian]
  gs.expirationTime === None

-- | On-chain VAA verification accepts a genuine guardian signature: parses the
-- VAA and verifies it against guardian set 0 (the devnet guardian). This
-- exercises the full keccak256 + DER + secp256k1WithEcdsaOnly path.
testParseAndVerifyVAA : Script ()
testParseAndVerifyVAA = do
  (gg, csId) <- setup
  vaa <- submit gg do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = gg
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1

-- | ParseAndVerifyVAA is genuinely permissionless: an external party with no
-- relationship to CoreState verifies a VAA as itself, given only CoreState
-- disclosed to it — a data attachment, not an approval.
testParseAndVerifyVAAByExternalVerifier : Script ()
testParseAndVerifyVAAByExternalVerifier = do
  (gg, csId) <- setup
  tokenBridge <- allocateParty "ExternalTokenBridge"
  Some dCs <- queryDisclosure gg csId
  vaa <- submitWithDisclosures tokenBridge [dCs] do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = tokenBridge
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1

-- | Integration entrypoint (Go test via `dpm script` against a live sandbox).
-- Same scenario as 'testParseAndVerifyVAAByExternalVerifier'; returns the
-- verifier's party id so the Go test can sanity-check it.
integrationParseAndVerifyVAAByExternalVerifier : Script Party
integrationParseAndVerifyVAAByExternalVerifier = do
  (gg, csId) <- setup
  tokenBridge <- allocateParty "IntegrationExternalVerifier"
  Some dCs <- queryDisclosure gg csId
  vaa <- submitWithDisclosures tokenBridge [dCs] do
    exerciseCmd csId ParseAndVerifyVAA with
      verifier = tokenBridge
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  vaa.guardianSetIndex === 0
  vaa.emitterChain === 1
  vaa.sequence === 1
  pure tokenBridge

-- | A SetMessageFee governance VAA verifies and updates the fee. A relayer
-- submits alone with the 'CoreState' disclosed (guardianGovernance's authority
-- inherited from the archived contract).
testGovernanceSetMessageFee : Script ()
testGovernanceSetMessageFee = do
  (gg, csId) <- setup
  relayer <- allocateParty "GovernanceRelayer"
  csDisc <- fromSome <$> queryDisclosure gg csId
  newCsId <- submit (actAs relayer <> disclose csDisc) do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = relayer
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  Some cs <- queryContractId gg newCsId
  cs.messageFee === 1000

-- | Governance replay protection (the 'consumedGovernance' set) still rejects
-- a resubmitted governance VAA.
testGovernanceReplayRejected : Script ()
testGovernanceReplayRejected = do
  (gg, csId) <- setup
  newCsId <- submit gg do
    exerciseCmd csId SubmitGovernanceVAA with
      submitter = gg
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]
  submitMustFail gg do
    exerciseCmd newCsId SubmitGovernanceVAA with
      submitter = gg
      encodedVAA = govSetFeeVAA
      pubKeys = [(0, devnetGuardianPubKey)]

-- | Integration entrypoint (Go test via `dpm script`): set up the bridge, register
-- an emitter, publish one message (nonce 42, payload 0x11223344), and return
-- guardianGovernance so the watcher can read the ledger as it. The watcher
-- derives the emitter address from the message identity.
integrationPublish : Script Party
integrationPublish = do
  (gg, csId) <- setup
  owner <- allocateParty "IntegrationEmitter"
  emId <- registerEmitter gg owner
  _ <- publishVia gg csId owner emId 42 "11223344" 0
  pure gg

-- | Exercise the auto-generated Archive choice on each template (for coverage).
testArchives : Script ()
testArchives = do
  (gg, csId) <- setup
  Some cs <- queryContractId gg csId
  -- CoreState is co-signed, so archiving needs guardianGovernance and feeRecipient.
  submitMustFail gg do archiveCmd csId
  submit (actAs gg <> actAs cs.feeRecipient) do archiveCmd csId
  bob <- allocateParty "ArchBob"
  emId <- registerEmitter gg bob
  -- Emitter is signed by owner and guardianGovernance; both must authorize.
  submitMustFail bob do archiveCmd emId
  submit (actAs bob <> actAs gg) do archiveCmd emId
  [(regId, _)] <- query @EmitterRegistry gg
  -- EmitterRegistry is signed by guardianGovernance alone.
  submitMustFail bob do archiveCmd regId
  submit gg do archiveCmd regId
  pure ()
