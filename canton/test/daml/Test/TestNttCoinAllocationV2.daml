-- | Daml Script tests for the 'Wormhole.Ntt.CoinFactory' 'AllocationFactory'
-- v2 and 'SettlementFactory' additions, and 'NttCoinAllocationV2': multi-leg
-- net settlement, iterated/committed allocations.
--
-- The critical property these tests exist to prove: a v2 allocation only
-- ever authorizes ONE party's side of a leg -- a real transfer between two
-- parties always needs TWO allocations (one per side), and value only
-- genuinely moves when 'SettlementFactory_SettleBatch' settles both together
-- in the same transaction. 'testSettleBatchHappyPathTwoAllocations' is the
-- direct proof of that.
module Test.TestNttCoinAllocationV2 where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.Time (hours, addRelTime)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.HoldingV1 (InstrumentId(..))
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.AllocationV2 qualified as AV2
import Splice.Api.Token.AllocationInstructionV2 qualified as AIV2
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinAllocationV2
import Wormhole.Ntt.CoinFactory
import Test.TestNtt (nttCoinFactorySetup, expectAbort)
import Test.TestNttCoin (mintCoin)

asAllocationFactoryV2 : ContractId NttCoinFactory -> ContractId AIV2.AllocationFactory
asAllocationFactoryV2 = toInterfaceContractId @AIV2.AllocationFactory

asSettlementFactory : ContractId NttCoinFactory -> ContractId AV2.SettlementFactory
asSettlementFactory = toInterfaceContractId @AV2.SettlementFactory

discloseFactory : Party -> ContractId NttCoinFactory -> Script Disclosure
discloseFactory gg factoryCid = fromSome <$> queryDisclosure gg factoryCid

basicAccount : Party -> HoldingV2.Account
basicAccount p = HoldingV2.Account with owner = Some p, provider = None, id = ""

-- | A provider-delegated account: @owner@ is the account holder, @provider@
-- co-signs every movement (see 'Wormhole.Ntt.Coin' module header).
providerAccount : Party -> Party -> HoldingV2.Account
providerAccount owner provider = HoldingV2.Account with owner = Some owner, provider = Some provider, id = ""

mkSettlement : [Party] -> Text -> AV2.SettlementInfo
mkSettlement executors sid = AV2.SettlementInfo with executors, id = sid, cid = None, meta = emptyMetadata

mkLeg : Text -> AV2.TransferSide -> Party -> Decimal -> Text -> AV2.TransferLegSide
mkLeg transferLegId side otherside amount instrumentId =
  AV2.TransferLegSide with transferLegId, side, otherside = basicAccount otherside, amount, instrumentId, meta = emptyMetadata

mkSpec : Party -> Party -> [AV2.TransferLegSide] -> AV2.AllocationSpecification
mkSpec admin authorizer transferLegSides =
  AV2.AllocationSpecification with
    admin, authorizer = basicAccount authorizer, transferLegSides
    settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata

mintCoinV2 : ContractId NttCoinFactory -> Party -> InstrumentId -> Party -> Decimal -> Script (ContractId HoldingV2.Holding)
mintCoinV2 factoryCid gg instrumentId owner amount =
  coerceContractId <$> mintCoin factoryCid gg instrumentId owner amount

tryAllocate
  : ContractId NttCoinFactory -> Party -> Party -> AV2.SettlementInfo -> AV2.AllocationSpecification -> [ContractId HoldingV2.Holding]
  -> Script (Either SubmitError AIV2.AllocationInstructionResult)
tryAllocate factoryCid gg authorizerOwner settlement spec inputHoldingCids = do
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  trySubmit (actAs authorizerOwner <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0, inputHoldingCids
      extraArgs = emptyExtraArgs, actors = [authorizerOwner]

allocate
  : ContractId NttCoinFactory -> Party -> Party -> AV2.SettlementInfo -> AV2.AllocationSpecification -> [ContractId HoldingV2.Holding]
  -> Script AIV2.AllocationInstructionResult
allocate factoryCid gg authorizerOwner settlement spec inputHoldingCids = do
  res <- tryAllocate factoryCid gg authorizerOwner settlement spec inputHoldingCids
  case res of
    Right ok -> pure ok
    Left err -> abort ("expected AllocationFactory_Allocate to succeed, got: " <> show err)

theAllocationCidV2 : AIV2.AllocationInstructionResult -> ContractId AV2.Allocation
theAllocationCidV2 res = case res.output of
  AIV2.AllocationInstructionResult_Completed{allocationCid} -> allocationCid
  other -> error ("expected AllocationInstructionResult_Completed, got: " <> show other)

asConcrete : ContractId AV2.Allocation -> ContractId NttCoinAllocationV2
asConcrete = coerceContractId

trySettleBatch
  : ContractId NttCoinFactory -> Party -> AV2.SettlementInfo -> [AV2.TransferLeg] -> [AV2.FinalizedAllocation] -> [Party]
  -> Script (Either SubmitError AV2.SettlementFactory_SettleBatchResult)
trySettleBatch factoryCid gg settlement transferLegs allocations actors = do
  factoryDisc <- discloseFactory gg factoryCid
  trySubmit (foldl (<>) (disclose factoryDisc) (map actAs actors)) do
    exerciseCmd (asSettlementFactory factoryCid) AV2.SettlementFactory_SettleBatch with
      settlement, transferLegs, allocations, actors, extraArgs = emptyExtraArgs

settleBatch
  : ContractId NttCoinFactory -> Party -> AV2.SettlementInfo -> [AV2.TransferLeg] -> [AV2.FinalizedAllocation] -> [Party]
  -> Script AV2.SettlementFactory_SettleBatchResult
settleBatch factoryCid gg settlement transferLegs allocations actors = do
  res <- trySettleBatch factoryCid gg settlement transferLegs allocations actors
  case res of
    Right ok -> pure ok
    Left err -> abort ("expected SettlementFactory_SettleBatch to succeed, got: " <> show err)

finalized : ContractId AV2.Allocation -> AV2.FinalizedAllocation
finalized cid = AV2.FinalizedAllocation with allocationCid = cid, extraTransferLegSides = [], nextIterationFunding = None

----------------------------------------------------------------------
-- Allocate
----------------------------------------------------------------------

testAllocateV2SingleLeg : Script ()
testAllocateV2SingleLeg = do
  gg <- allocateParty "AllocV2SingleGg"
  alice <- allocateParty "AllocV2SingleAlice"
  bob <- allocateParty "AllocV2SingleBob"
  carol <- allocateParty "AllocV2SingleCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-SINGLE"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-single"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-SINGLE"]
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = asConcrete (theAllocationCidV2 res)
  Some alloc <- queryContractId gg allocCid
  alloc.numIterations === 0
  alloc.originalAllocationCid === None
  TextMap.lookup "NTT-COIN-ALLOCV2-SINGLE" alloc.lockedAmounts === Some 0.006

testAllocateV2MultiLegMultiInstrument : Script ()
testAllocateV2MultiLegMultiInstrument = do
  gg <- allocateParty "AllocV2MultiGg"
  alice <- allocateParty "AllocV2MultiAlice"
  bob <- allocateParty "AllocV2MultiBob"
  carol <- allocateParty "AllocV2MultiCarol"
  dave <- allocateParty "AllocV2MultiDaveExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instA = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-MULTI-A"
      instB = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-MULTI-B"
  coinA <- mintCoinV2 factoryCid gg instA alice 0.01
  coinB <- mintCoinV2 factoryCid gg instB alice 0.02
  let settlement = mkSettlement [dave] "settlement-multi"
      spec = mkSpec gg alice
        [ mkLeg "leg-a" AV2.SenderSide bob 0.01 "NTT-COIN-ALLOCV2-MULTI-A"
        , mkLeg "leg-b" AV2.SenderSide carol 0.02 "NTT-COIN-ALLOCV2-MULTI-B"
        ]
  res <- allocate factoryCid gg alice settlement spec [coinA, coinB]
  let allocCid = asConcrete (theAllocationCidV2 res)
  Some alloc <- queryContractId gg allocCid
  TextMap.lookup "NTT-COIN-ALLOCV2-MULTI-A" alloc.lockedAmounts === Some 0.01
  TextMap.lookup "NTT-COIN-ALLOCV2-MULTI-B" alloc.lockedAmounts === Some 0.02

testAllocateV2ReturnsStrayInstrumentChangeUntouched : Script ()
testAllocateV2ReturnsStrayInstrumentChangeUntouched = do
  gg <- allocateParty "AllocV2StrayGg"
  alice <- allocateParty "AllocV2StrayAlice"
  bob <- allocateParty "AllocV2StrayBob"
  carol <- allocateParty "AllocV2StrayCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let leg = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-STRAY-LEG"
      stray = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-STRAY-EXTRA"
  legCoin <- mintCoinV2 factoryCid gg leg alice 0.006
  strayCoin <- mintCoinV2 factoryCid gg stray alice 0.05
  let settlement = mkSettlement [carol] "settlement-stray"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-STRAY-LEG"]
  res <- allocate factoryCid gg alice settlement spec [legCoin, strayCoin]
  case TextMap.lookup "NTT-COIN-ALLOCV2-STRAY-EXTRA" res.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.amount === 0.05
    other -> abort ("expected stray instrument fully returned as change, got: " <> show other)

testAllocateV2RejectsUnderfundedRequiredTotal : Script ()
testAllocateV2RejectsUnderfundedRequiredTotal = do
  gg <- allocateParty "AllocV2UnderfundedGg"
  alice <- allocateParty "AllocV2UnderfundedAlice"
  bob <- allocateParty "AllocV2UnderfundedBob"
  carol <- allocateParty "AllocV2UnderfundedCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-UNDERFUNDED"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-underfunded"
      spec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-UNDERFUNDED"])
        with nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ALLOCV2-UNDERFUNDED", 0.01)])
  res <- tryAllocate factoryCid gg alice settlement spec [coinCid]
  expectAbort "do not cover the allocation's required funding" res

-- | 'nextIterationFunding' feeds @requiredTotals@/@change@ unchecked; a
-- NEGATIVE reserve entry would let @change = have - need@ mint a positive
-- coin larger than what was actually put in.
testAllocateV2RejectsNegativeNextIterationFunding : Script ()
testAllocateV2RejectsNegativeNextIterationFunding = do
  gg <- allocateParty "AllocV2NegReserveGg"
  alice <- allocateParty "AllocV2NegReserveAlice"
  bob <- allocateParty "AllocV2NegReserveBob"
  carol <- allocateParty "AllocV2NegReserveCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let settlement = mkSettlement [carol] "settlement-negreserve"
      spec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-NEGRESERVE"])
        with nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ALLOCV2-NEGRESERVE", -0.01)])
  res <- tryAllocate factoryCid gg alice settlement spec []
  expectAbort "nextIterationFunding amounts must be positive" res

----------------------------------------------------------------------
-- SettlementFactory_SettleBatch -- the critical value-movement proof
----------------------------------------------------------------------

testSettleBatchHappyPathTwoAllocations : Script ()
testSettleBatchHappyPathTwoAllocations = do
  gg <- allocateParty "SettleHappyGg"
  alice <- allocateParty "SettleHappyAlice"
  bob <- allocateParty "SettleHappyBob"
  carol <- allocateParty "SettleHappyCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SETTLE-HAPPY"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-happy"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-SETTLE-HAPPY"]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "NTT-COIN-SETTLE-HAPPY"]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let aliceAllocCid = theAllocationCidV2 aliceRes
      bobAllocCid = theAllocationCidV2 bobRes
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-SETTLE-HAPPY", meta = emptyMetadata]
  settleRes <- settleBatch factoryCid gg settlement transferLegs
    [finalized aliceAllocCid, finalized bobAllocCid] [carol]
  case settleRes.allocationSettleResults of
    [r1, r2] -> do
      let outputs = [r1.output, r2.output]
      assertMsg "expected both allocations to settle fully with no next iteration"
        (all (\o -> o == AV2.AllocationResult_Settled with nextIterationAllocationCid = None) outputs)
    other -> abort ("expected two settle results, got: " <> show other)
  bobHoldings <- query @NttCoin gg
  case [c | (_, c) <- bobHoldings, c.owner == bob] of
    [c] -> c.amount === 0.006
    other -> abort ("expected bob to receive exactly one coin, got: " <> show other)
  archivedAlice <- queryContractId gg (asConcrete aliceAllocCid)
  archivedBob <- queryContractId gg (asConcrete bobAllocCid)
  archivedAlice === None
  archivedBob === None

testSettleBatchRejectsMissingSenderSideAuthorization : Script ()
testSettleBatchRejectsMissingSenderSideAuthorization = do
  gg <- allocateParty "SettleMissingSenderGg"
  alice <- allocateParty "SettleMissingSenderAlice"
  bob <- allocateParty "SettleMissingSenderBob"
  carol <- allocateParty "SettleMissingSenderCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SETTLE-NOSENDER"
      settlement = mkSettlement [carol] "settlement-nosender"
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "NTT-COIN-SETTLE-NOSENDER"]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-SETTLE-NOSENDER", meta = emptyMetadata]
  res <- trySettleBatch factoryCid gg settlement transferLegs [finalized (theAllocationCidV2 bobRes)] [carol]
  expectAbort "no matching SenderSide allocation" res

testSettleBatchRejectsMissingReceiverSideAuthorization : Script ()
testSettleBatchRejectsMissingReceiverSideAuthorization = do
  gg <- allocateParty "SettleMissingReceiverGg"
  alice <- allocateParty "SettleMissingReceiverAlice"
  bob <- allocateParty "SettleMissingReceiverBob"
  carol <- allocateParty "SettleMissingReceiverCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SETTLE-NORECEIVER"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-noreceiver"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-SETTLE-NORECEIVER"]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-SETTLE-NORECEIVER", meta = emptyMetadata]
  res <- trySettleBatch factoryCid gg settlement transferLegs [finalized (theAllocationCidV2 aliceRes)] [carol]
  expectAbort "no matching ReceiverSide allocation" res

testSettleBatchRejectsUncoveredAllocationSides : Script ()
testSettleBatchRejectsUncoveredAllocationSides = do
  gg <- allocateParty "SettleUncoveredGg"
  alice <- allocateParty "SettleUncoveredAlice"
  bob <- allocateParty "SettleUncoveredBob"
  dave <- allocateParty "SettleUncoveredDave"
  carol <- allocateParty "SettleUncoveredCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SETTLE-UNCOVERED"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.012
  let settlement = mkSettlement [carol] "settlement-uncovered"
      -- alice authorizes TWO legs, but only leg-0 will be in the batch's transferLegs.
      aliceSpec = mkSpec gg alice
        [ mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-SETTLE-UNCOVERED"
        , mkLeg "leg-1" AV2.SenderSide dave 0.006 "NTT-COIN-SETTLE-UNCOVERED"
        ]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "NTT-COIN-SETTLE-UNCOVERED"]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-SETTLE-UNCOVERED", meta = emptyMetadata]
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  expectAbort "not covered by the given transferLegs" res

testSettleBatchRejectsWrongActors : Script ()
testSettleBatchRejectsWrongActors = do
  gg <- allocateParty "SettleWrongActorsGg"
  alice <- allocateParty "SettleWrongActorsAlice"
  bob <- allocateParty "SettleWrongActorsBob"
  carol <- allocateParty "SettleWrongActorsCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-SETTLE-WRONGACTORS"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-wrongactors"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-SETTLE-WRONGACTORS"]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 "NTT-COIN-SETTLE-WRONGACTORS"]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-SETTLE-WRONGACTORS", meta = emptyMetadata]
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [alice]
  case res of
    Left _ -> pure ()
    Right _ -> abort "expected non-executor submitter to fail"

----------------------------------------------------------------------
-- Cancel / Withdraw
----------------------------------------------------------------------

testCancelReturnsAllLockedFundsAcrossInstruments : Script ()
testCancelReturnsAllLockedFundsAcrossInstruments = do
  gg <- allocateParty "CancelV2Gg"
  alice <- allocateParty "CancelV2Alice"
  bob <- allocateParty "CancelV2Bob"
  carol <- allocateParty "CancelV2Carol"
  dave <- allocateParty "CancelV2DaveExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instA = InstrumentId with admin = gg, id = "NTT-COIN-CANCELV2-A"
      instB = InstrumentId with admin = gg, id = "NTT-COIN-CANCELV2-B"
  coinA <- mintCoinV2 factoryCid gg instA alice 0.01
  coinB <- mintCoinV2 factoryCid gg instB alice 0.02
  let settlement = mkSettlement [dave] "settlement-cancel"
      spec = mkSpec gg alice
        [ mkLeg "leg-a" AV2.SenderSide bob 0.01 "NTT-COIN-CANCELV2-A"
        , mkLeg "leg-b" AV2.SenderSide carol 0.02 "NTT-COIN-CANCELV2-B"
        ]
  res <- allocate factoryCid gg alice settlement spec [coinA, coinB]
  let allocCid = theAllocationCidV2 res
  cancelRes <- submit dave do exerciseCmd allocCid AV2.Allocation_Cancel with actors = [dave], extraArgs = emptyExtraArgs
  cancelRes.output === AV2.AllocationResult_Cancelled
  case TextMap.lookup "NTT-COIN-CANCELV2-A" cancelRes.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.amount === 0.01
    other -> abort ("expected instrument A returned, got: " <> show other)
  case TextMap.lookup "NTT-COIN-CANCELV2-B" cancelRes.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.amount === 0.02
    other -> abort ("expected instrument B returned, got: " <> show other)

testCancelByAdminAloneSucceeds : Script ()
testCancelByAdminAloneSucceeds = do
  gg <- allocateParty "CancelAdminV2Gg"
  alice <- allocateParty "CancelAdminV2Alice"
  bob <- allocateParty "CancelAdminV2Bob"
  dave <- allocateParty "CancelAdminV2DaveExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-CANCELADMINV2"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [dave] "settlement-canceladmin"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-CANCELADMINV2"]
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  cancelRes <- submit gg do exerciseCmd allocCid AV2.Allocation_Cancel with actors = [gg], extraArgs = emptyExtraArgs
  cancelRes.output === AV2.AllocationResult_Cancelled

testWithdrawUncommittedIsAuthorizerUnilateral : Script ()
testWithdrawUncommittedIsAuthorizerUnilateral = do
  gg <- allocateParty "WithdrawV2Gg"
  alice <- allocateParty "WithdrawV2Alice"
  bob <- allocateParty "WithdrawV2Bob"
  carol <- allocateParty "WithdrawV2CarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-WITHDRAWV2"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-withdraw"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-WITHDRAWV2"]
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  submitMustFail bob do exerciseCmd allocCid AV2.Allocation_Withdraw with actors = [bob], extraArgs = emptyExtraArgs
  withdrawRes <- submit alice do
    exerciseCmd allocCid AV2.Allocation_Withdraw with actors = [alice], extraArgs = emptyExtraArgs
  withdrawRes.output === AV2.AllocationResult_Withdrawn

testWithdrawCommittedRejectedBeforeDeadline : Script ()
testWithdrawCommittedRejectedBeforeDeadline = do
  gg <- allocateParty "WithdrawCommittedBeforeGg"
  alice <- allocateParty "WithdrawCommittedBeforeAlice"
  bob <- allocateParty "WithdrawCommittedBeforeBob"
  carol <- allocateParty "WithdrawCommittedBeforeCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-WITHDRAWCOMMITTEDBEFORE"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  t0 <- getTime
  let settlement = mkSettlement [carol] "settlement-withdrawcommittedbefore"
      spec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-WITHDRAWCOMMITTEDBEFORE"])
        with committed = True, settlementDeadline = Some (t0 `addRelTime` hours 1)
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  submitMustFail alice do exerciseCmd allocCid AV2.Allocation_Withdraw with actors = [alice], extraArgs = emptyExtraArgs

testWithdrawCommittedAllowedAfterDeadline : Script ()
testWithdrawCommittedAllowedAfterDeadline = do
  gg <- allocateParty "WithdrawCommittedAfterGg"
  alice <- allocateParty "WithdrawCommittedAfterAlice"
  bob <- allocateParty "WithdrawCommittedAfterBob"
  carol <- allocateParty "WithdrawCommittedAfterCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-WITHDRAWCOMMITTEDAFTER"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  t0 <- getTime
  let settlement = mkSettlement [carol] "settlement-withdrawcommittedafter"
      spec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-WITHDRAWCOMMITTEDAFTER"])
        with committed = True, settlementDeadline = Some (t0 `addRelTime` hours (-1))
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  withdrawRes <- submit alice do
    exerciseCmd allocCid AV2.Allocation_Withdraw with actors = [alice], extraArgs = emptyExtraArgs
  withdrawRes.output === AV2.AllocationResult_Withdrawn

----------------------------------------------------------------------
-- Iterated settlement
----------------------------------------------------------------------

testIteratedSettlementCarriesForwardAndReturnsLeftover : Script ()
testIteratedSettlementCarriesForwardAndReturnsLeftover = do
  gg <- allocateParty "IteratedGg"
  alice <- allocateParty "IteratedAlice"
  bob <- allocateParty "IteratedBob"
  carol <- allocateParty "IteratedCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ITERATED"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.03
  let settlement = mkSettlement [carol] "settlement-iterated"
      aliceSpec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 "NTT-COIN-ITERATED"])
        with nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ITERATED", 0.015)])
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 "NTT-COIN-ITERATED"]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  -- Only the required total (senderTotal 0.01 + reserve 0.015 = 0.025) gets
  -- locked; the 0.005 surplus over that comes back immediately as allocate-time
  -- change, not as settle-time leftover.
  case TextMap.lookup "NTT-COIN-ITERATED" aliceRes.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.amount === 0.005
    other -> abort ("expected allocate-time change of 0.005, got: " <> show other)
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = "NTT-COIN-ITERATED", meta = emptyMetadata]
      aliceFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ITERATED", 0.015)])
      bobFa = finalized (theAllocationCidV2 bobRes)
  round1 <- settleBatch factoryCid gg settlement transferLegs [aliceFa, bobFa] [carol]
  let [aliceResult1, _bobResult1] = round1.allocationSettleResults
  nextAliceCid <- case aliceResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected alice's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")
  -- 0.025 locked - 0.01 spent - 0.015 carried = 0 leftover this round.
  TextMap.lookup "NTT-COIN-ITERATED" aliceResult1.authorizerHoldingCids === None
  Some nextAlloc <- queryContractId gg (asConcrete nextAliceCid)
  nextAlloc.numIterations === 1
  TextMap.lookup "NTT-COIN-ITERATED" nextAlloc.lockedAmounts === Some 0.015

  -- Round 2: settle the carried-forward allocation fully (no further iteration).
  bobRes2 <- allocate factoryCid gg bob settlement bobSpec []
  let round2Fa = finalized nextAliceCid
      round2BobFa = finalized (theAllocationCidV2 bobRes2)
  round2 <- settleBatch factoryCid gg settlement transferLegs [round2Fa, round2BobFa] [carol]
  let [aliceResult2, _bobResult2] = round2.allocationSettleResults
  aliceResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  case TextMap.lookup "NTT-COIN-ITERATED" aliceResult2.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.amount === 0.005
    other -> abort ("expected round-2 leftover of 0.005, got: " <> show other)

----------------------------------------------------------------------
-- Defensive checks
----------------------------------------------------------------------

testAllocateV2RejectsMismatchedAdmin : Script ()
testAllocateV2RejectsMismatchedAdmin = do
  gg <- allocateParty "AllocV2MismatchGg"
  notGg <- allocateParty "AllocV2MismatchNotGg"
  alice <- allocateParty "AllocV2MismatchAlice"
  bob <- allocateParty "AllocV2MismatchBob"
  carol <- allocateParty "AllocV2MismatchCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let settlement = mkSettlement [carol] "settlement-mismatch"
      spec = mkSpec notGg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-MISMATCH"]
  res <- tryAllocate factoryCid gg alice settlement spec []
  expectAbort "admin does not match this factory's admin" res

testAllocateV2RejectsNonAuthorizerActor : Script ()
testAllocateV2RejectsNonAuthorizerActor = do
  gg <- allocateParty "AllocV2NonAuthGg"
  alice <- allocateParty "AllocV2NonAuthAlice"
  bob <- allocateParty "AllocV2NonAuthBob"
  carol <- allocateParty "AllocV2NonAuthCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  factoryDisc <- discloseFactory gg factoryCid
  let settlement = mkSettlement [carol] "settlement-nonauth"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-NONAUTH"]
  t0 <- getTime
  res <- trySubmit (actAs bob <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0, inputHoldingCids = []
      extraArgs = emptyExtraArgs, actors = [bob]
  expectAbort "requires the authorizer account's owner and provider authority" res

----------------------------------------------------------------------
-- Footgun guard: naked Allocation_Settle outside SettleBatch
----------------------------------------------------------------------

-- | A direct 'Allocation_Settle' has no automatic counterparty and so no
-- automatic soundness check -- a footgun guard, not a security boundary.
testNakedAllocationSettleIsRejected : Script ()
testNakedAllocationSettleIsRejected = do
  gg <- allocateParty "NakedSettleGg"
  alice <- allocateParty "NakedSettleAlice"
  bob <- allocateParty "NakedSettleBob"
  carol <- allocateParty "NakedSettleCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-NAKEDSETTLE"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  let settlement = mkSettlement [carol] "settlement-nakedsettle"
      spec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-NAKEDSETTLE"]
  res <- allocate factoryCid gg alice settlement spec [coinCid]
  let allocCid = theAllocationCidV2 res
  naked <- trySubmit (actAs gg <> actAs carol) do
    exerciseCmd allocCid AV2.Allocation_Settle with
      actors = [gg, carol], extraTransferLegSides = [], nextIterationFunding = None
      extraArgs = emptyExtraArgs
  expectAbort "must be driven through SettlementFactory_SettleBatch" naked

----------------------------------------------------------------------
-- Iterated settlement: standing legs recur every round
----------------------------------------------------------------------

-- | A standing leg is not "consumed" after round 1 -- it recurs on the
-- carried-forward allocation in round 2, for both sender and receiver.
testIteratedSettlementRoundTwoCompletes : Script ()
testIteratedSettlementRoundTwoCompletes = do
  gg <- allocateParty "IteratedRound2Gg"
  alice <- allocateParty "IteratedRound2Alice"
  bob <- allocateParty "IteratedRound2Bob"
  carol <- allocateParty "IteratedRound2CarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ITERATEDROUND2"
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.02
  let settlement = mkSettlement [carol] "settlement-iteratedround2"
      aliceSpec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 "NTT-COIN-ITERATEDROUND2"])
        with nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ITERATEDROUND2", 0.01)])
      bobSpec = (mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 "NTT-COIN-ITERATEDROUND2"])
        with nextIterationFunding = Some TextMap.empty
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  -- 0.02 minted, 0.02 required (0.01 round-1 SenderSide + 0.01 reserve) -- no
  -- allocate-time change.
  aliceRes.authorizerChangeCids === TextMap.empty
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = "NTT-COIN-ITERATEDROUND2", meta = emptyMetadata]
      aliceFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-ITERATEDROUND2", 0.01)])
      bobFa = AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes, extraTransferLegSides = []
        nextIterationFunding = Some TextMap.empty

  round1 <- settleBatch factoryCid gg settlement transferLegs [aliceFa, bobFa] [carol]
  let [aliceResult1, bobResult1] = round1.allocationSettleResults
  nextAliceCid <- case aliceResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected alice's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")
  nextBobCid <- case bobResult1.output of
    AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
    other -> do
      _ <- abort ("expected bob's round 1 to carry forward, got: " <> show other)
      pure (error "unreachable")

  case TextMap.lookup "NTT-COIN-ITERATEDROUND2" bobResult1.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === bob
      c.amount === 0.01
    other -> abort ("expected bob credited 0.01 in round 1, got: " <> show other)

  Some nextAlice <- queryContractId gg (asConcrete nextAliceCid)
  nextAlice.numIterations === 1
  TextMap.lookup "NTT-COIN-ITERATEDROUND2" nextAlice.lockedAmounts === Some 0.01

  -- Round 2: settle the carried-forward pair fully, no further iteration.
  let round2AliceFa = finalized nextAliceCid
      round2BobFa = finalized nextBobCid
  round2 <- settleBatch factoryCid gg settlement transferLegs [round2AliceFa, round2BobFa] [carol]
  let [aliceResult2, bobResult2] = round2.allocationSettleResults
  aliceResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None
  bobResult2.output === AV2.AllocationResult_Settled with nextIterationAllocationCid = None

  case TextMap.lookup "NTT-COIN-ITERATEDROUND2" bobResult2.authorizerHoldingCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === bob
      c.amount === 0.01
    other -> abort ("expected bob credited a second 0.01 in round 2, got: " <> show other)

  -- Bob received two separate 0.01 coins across the two rounds -- total 0.02,
  -- no stray change, and both of alice's and bob's iteration contracts are gone.
  bobHoldings <- query @NttCoin gg
  case [c.amount | (_, c) <- bobHoldings, c.owner == bob] of
    amounts | length amounts == 2 && sum amounts == 0.02 -> pure ()
    other -> abort ("expected bob to hold exactly two 0.01 coins, got: " <> show other)
  archivedAlice1 <- queryContractId gg (asConcrete (theAllocationCidV2 aliceRes))
  archivedAlice2 <- queryContractId gg (asConcrete nextAliceCid)
  archivedBob1 <- queryContractId gg (asConcrete (theAllocationCidV2 bobRes))
  archivedBob2 <- queryContractId gg (asConcrete nextBobCid)
  archivedAlice1 === None
  archivedAlice2 === None
  archivedBob1 === None
  archivedBob2 === None

----------------------------------------------------------------------
-- Composability: a provider-delegated account as an allocation's authorizer
----------------------------------------------------------------------

-- | An authorizer account with a provider requires BOTH the owner and the
-- provider in @actors@ to allocate -- the input holding's signatories must
-- all be part of the transaction's authority to archive it.
testAllocateV2ProviderAuthorizer : Script ()
testAllocateV2ProviderAuthorizer = do
  gg <- allocateParty "AllocV2ProviderGg"
  alice <- allocateParty "AllocV2ProviderAlice"
  aliceProvider <- allocateParty "AllocV2ProviderAliceProvider"
  bob <- allocateParty "AllocV2ProviderBob"
  carol <- allocateParty "AllocV2ProviderCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOCV2-PROVIDER"
      authorizerAcct = providerAccount alice aliceProvider
      settlement = mkSettlement [carol] "settlement-provider"
      spec = AV2.AllocationSpecification with
        admin = gg, authorizer = authorizerAcct
        transferLegSides = [mkLeg "leg-0" AV2.SenderSide bob 0.006 "NTT-COIN-ALLOCV2-PROVIDER"]
        settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata
  -- 'mintCoinV2' only produces basic accounts -- create the provider-managed
  -- holding directly, under owner + provider's joint authority.
  coinCid <- submit (actAs gg <> actAs alice <> actAs aliceProvider) do
    createCmd NttCoin with
      instrumentId, owner = alice, provider = Some aliceProvider, accountId = "", amount = 0.01
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime

  -- Owner alone, missing the provider, is rejected.
  noProviderRes <- trySubmit (actAs alice <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0
      inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
      extraArgs = emptyExtraArgs, actors = [alice]
  expectAbort "requires the authorizer account's owner and provider authority" noProviderRes

  -- Owner + provider jointly succeeds; change is credited to the full
  -- authorizer account (owner + provider).
  allocRes <- trySubmit (actAs alice <> actAs aliceProvider <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactoryV2 factoryCid) AIV2.AllocationFactory_Allocate with
      settlement, allocation = spec, requestedAt = t0
      inputHoldingCids = [toInterfaceContractId @HoldingV2.Holding coinCid]
      extraArgs = emptyExtraArgs, actors = [alice, aliceProvider]
  aliceRes <- case allocRes of
    Right ok -> pure ok
    Left err -> abort ("expected AllocationFactory_Allocate to succeed with owner + provider, got: " <> show err)
  let aliceAllocCid = theAllocationCidV2 aliceRes
  case TextMap.lookup "NTT-COIN-ALLOCV2-PROVIDER" aliceRes.authorizerChangeCids of
    Some [cid] -> do
      Some c <- queryContractId gg (coerceContractId @HoldingV2.Holding @NttCoin cid)
      c.owner === alice
      c.provider === Some aliceProvider
      c.amount === 0.004
    other -> abort ("expected allocate-time change of 0.004 credited to the full account, got: " <> show other)

  -- bob's ReceiverSide leg must name alice's FULL account as its otherside --
  -- 'mkLeg' only builds basic othersides, so this one is constructed directly.
  let bobSpec = AV2.AllocationSpecification with
        admin = gg, authorizer = basicAccount bob
        transferLegSides =
          [ AV2.TransferLegSide with
              transferLegId = "leg-0", side = AV2.ReceiverSide, otherside = authorizerAcct
              amount = 0.006, instrumentId = "NTT-COIN-ALLOCV2-PROVIDER", meta = emptyMetadata
          ]
        settlementDeadline = None, nextIterationFunding = None, committed = False, meta = emptyMetadata
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = authorizerAcct, receiver = basicAccount bob
        amount = 0.006, instrumentId = "NTT-COIN-ALLOCV2-PROVIDER", meta = emptyMetadata]
  settleRes <- settleBatch factoryCid gg settlement transferLegs
    [finalized aliceAllocCid, finalized (theAllocationCidV2 bobRes)] [carol]
  case settleRes.allocationSettleResults of
    [r1, r2] -> do
      let outputs = [r1.output, r2.output]
      assertMsg "expected both allocations to settle fully with no next iteration"
        (all (\o -> o == AV2.AllocationResult_Settled with nextIterationAllocationCid = None) outputs)
    other -> abort ("expected two settle results, got: " <> show other)
  bobHoldings <- query @NttCoin gg
  case [c | (_, c) <- bobHoldings, c.owner == bob] of
    [c] -> c.amount === 0.006
    other -> abort ("expected bob to receive exactly one coin, got: " <> show other)

----------------------------------------------------------------------
-- Conservation: total supply plus outstanding lockedAmounts stays constant
----------------------------------------------------------------------

totalSupply : Party -> Text -> Script Decimal
totalSupply gg instr = do
  coins <- query @NttCoin gg
  pure (sum [c.amount | (_, c) <- coins, c.instrumentId.id == instr])

totalLocked : Party -> Text -> Script Decimal
totalLocked gg instr = do
  allocs <- query @NttCoinAllocationV2 gg
  pure (sum [a | (_, alloc) <- allocs, Some a <- [TextMap.lookup instr alloc.lockedAmounts]])

totalValue : Party -> Text -> Script Decimal
totalValue gg instr = (+) <$> totalSupply gg instr <*> totalLocked gg instr

nextCid : AV2.AllocationResult -> Script (ContractId AV2.Allocation)
nextCid r = case r.output of
  AV2.AllocationResult_Settled{nextIterationAllocationCid = Some cid} -> pure cid
  other -> abort ("expected a carried-forward allocation, got: " <> show other)

-- | Multi-leg NET settlement: alice and bob are each sender on one leg and
-- receiver on the other, in the same batch.
testNettedTwoWayBatchConservesValue : Script ()
testNettedTwoWayBatchConservesValue = do
  gg <- allocateParty "NetGg"
  alice <- allocateParty "NetAlice"
  bob <- allocateParty "NetBob"
  carol <- allocateParty "NetCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrX = "NTT-COIN-NET-X"
      instrY = "NTT-COIN-NET-Y"
  coinX <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instrX) alice 0.01
  coinY <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instrY) bob 0.02
  let settlement = mkSettlement [carol] "settlement-net"
      aliceSpec = mkSpec gg alice
        [ mkLeg "leg-x" AV2.SenderSide bob 0.01 instrX
        , mkLeg "leg-y" AV2.ReceiverSide bob 0.02 instrY
        ]
      bobSpec = mkSpec gg bob
        [ mkLeg "leg-x" AV2.ReceiverSide alice 0.01 instrX
        , mkLeg "leg-y" AV2.SenderSide alice 0.02 instrY
        ]
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-x", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instrX, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-y", sender = basicAccount bob, receiver = basicAccount alice
            amount = 0.02, instrumentId = instrY, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinX]
  bobRes <- allocate factoryCid gg bob settlement bobSpec [coinY]
  _ <- settleBatch factoryCid gg settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
  vx <- totalValue gg instrX
  vy <- totalValue gg instrY
  vx === 0.01
  vy === 0.02
  coins <- query @NttCoin gg
  [c.amount | (_, c) <- coins, c.owner == bob, c.instrumentId.id == instrX] === [0.01]
  [c.amount | (_, c) <- coins, c.owner == alice, c.instrumentId.id == instrY] === [0.02]

-- | An extra SenderSide leg naming an instrument with NO locked balance --
-- 'fromOptional 0.0' must fail closed, not treat a missing key as unlimited.
testExtraSenderLegOnUnlockedInstrumentRejected : Script ()
testExtraSenderLegOnUnlockedInstrumentRejected = do
  gg <- allocateParty "UnlockedGg"
  alice <- allocateParty "UnlockedAlice"
  bob <- allocateParty "UnlockedBob"
  carol <- allocateParty "UnlockedCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrA = "NTT-COIN-UNLOCKED-A"
      instrB = "NTT-COIN-UNLOCKED-B"
  coinA <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instrA) alice 0.01
  let settlement = mkSettlement [carol] "settlement-unlocked"
      aliceSpec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instrA])
        with nextIterationFunding = Some TextMap.empty
      bobSpec = (mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instrA])
        with nextIterationFunding = Some TextMap.empty
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instrA, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-b", sender = basicAccount alice, receiver = basicAccount bob
            amount = 99.0, instrumentId = instrB, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinA]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes
        extraTransferLegSides = [mkLeg "leg-b" AV2.SenderSide bob 99.0 instrB]
        nextIterationFunding = None
    , AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes
        extraTransferLegSides = [mkLeg "leg-b" AV2.ReceiverSide alice 99.0 instrB]
        nextIterationFunding = None
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> do
      v <- totalValue gg instrB
      abort ("unlocked-instrument SenderSide leg accepted; instrument B value now " <> show v)

-- | A carry naming an instrument that has no @remaining@ balance at all.
testCarryOnUnknownInstrumentRejected : Script ()
testCarryOnUnknownInstrumentRejected = do
  gg <- allocateParty "CarryUnknownGg"
  alice <- allocateParty "CarryUnknownAlice"
  bob <- allocateParty "CarryUnknownBob"
  carol <- allocateParty "CarryUnknownCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-CARRYUNKNOWN"
  coinCid <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.02
  let settlement = mkSettlement [carol] "settlement-carryunknown"
      aliceSpec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some (TextMap.fromList [(instr, 0.01)])
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [("NTT-COIN-NOT-AN-INSTRUMENT", 7.0)])
    , finalized (theAllocationCidV2 bobRes)
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "carry on an instrument with no remaining balance was accepted"

-- | Extras / carry on an allocation that never enabled iterated settlement.
testExtrasRejectedWhenIterationDisabled : Script ()
testExtrasRejectedWhenIterationDisabled = do
  gg <- allocateParty "NoIterGg"
  alice <- allocateParty "NoIterAlice"
  bob <- allocateParty "NoIterBob"
  carol <- allocateParty "NoIterCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-NOITER"
  coinCid <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.02
  let settlement = mkSettlement [carol] "settlement-noiter"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes, extraTransferLegSides = []
        nextIterationFunding = Some (TextMap.fromList [(instr, 0.005)])
    , finalized (theAllocationCidV2 bobRes)
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "nextIterationFunding accepted on a non-iterated allocation"

-- | A zero-amount extra leg: the guard is @> 0.0@, so 0.0 must be rejected.
testZeroAmountExtraLegRejected : Script ()
testZeroAmountExtraLegRejected = do
  gg <- allocateParty "ZeroExtraGg"
  alice <- allocateParty "ZeroExtraAlice"
  bob <- allocateParty "ZeroExtraBob"
  carol <- allocateParty "ZeroExtraCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-ZEROEXTRA"
  coinCid <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-zeroextra"
      aliceSpec = (mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      bobSpec = (mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr])
        with nextIterationFunding = Some TextMap.empty
      transferLegs =
        [ AV2.TransferLeg with
            transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.01, instrumentId = instr, meta = emptyMetadata
        , AV2.TransferLeg with
            transferLegId = "leg-z", sender = basicAccount alice, receiver = basicAccount bob
            amount = 0.0, instrumentId = instr, meta = emptyMetadata
        ]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [ AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 aliceRes
        extraTransferLegSides = [mkLeg "leg-z" AV2.SenderSide bob 0.0 instr]
        nextIterationFunding = None
    , AV2.FinalizedAllocation with
        allocationCid = theAllocationCidV2 bobRes
        extraTransferLegSides = [mkLeg "leg-z" AV2.ReceiverSide alice 0.0 instr]
        nextIterationFunding = None
    ] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "zero-amount extra leg accepted"

-- | An allocation may be settled once only; a second batch naming the same
-- (now archived) cid must fail rather than re-mint. Also: the same cid listed
-- twice within one batch.
testAllocationCannotSettleTwice : Script ()
testAllocationCannotSettleTwice = do
  gg <- allocateParty "TwiceGg"
  alice <- allocateParty "TwiceAlice"
  bob <- allocateParty "TwiceBob"
  carol <- allocateParty "TwiceCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-TWICE"
  coinCid <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-twice"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let aliceCid = theAllocationCidV2 aliceRes
      bobCid = theAllocationCidV2 bobRes
  _ <- settleBatch factoryCid gg settlement transferLegs [finalized aliceCid, finalized bobCid] [carol]
  replay <- trySettleBatch factoryCid gg settlement transferLegs
    [finalized aliceCid, finalized bobCid] [carol]
  case replay of
    Left _ -> pure ()
    Right _ -> abort "settled allocation was settled a second time"
  coin2 <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.01
  alice2 <- allocate factoryCid gg alice settlement aliceSpec [coin2]
  bob2 <- allocate factoryCid gg bob settlement bobSpec []
  dup <- trySettleBatch factoryCid gg settlement transferLegs
    [ finalized (theAllocationCidV2 alice2)
    , finalized (theAllocationCidV2 alice2)
    , finalized (theAllocationCidV2 bob2)
    ] [carol]
  case dup of
    Left _ -> pure ()
    Right _ -> abort "the same allocation was accepted twice in one batch"
  v <- totalValue gg instr
  v === 0.02

-- | Settling after a cancel, and cancelling after a settle, must both fail.
testNoSettleAfterCancelOrWithdraw : Script ()
testNoSettleAfterCancelOrWithdraw = do
  gg <- allocateParty "AfterGg"
  alice <- allocateParty "AfterAlice"
  bob <- allocateParty "AfterBob"
  carol <- allocateParty "AfterCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-AFTER"
  coinCid <- mintCoinV2 factoryCid gg (InstrumentId with admin = gg, id = instr) alice 0.01
  let settlement = mkSettlement [carol] "settlement-after"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.01 instr]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.01 instr]
      transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.01, instrumentId = instr, meta = emptyMetadata]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  let aliceCid = theAllocationCidV2 aliceRes
  _ <- submit carol do
    exerciseCmd aliceCid AV2.Allocation_Cancel with actors = [carol], extraArgs = emptyExtraArgs
  v1 <- totalValue gg instr
  v1 === 0.01
  res <- trySettleBatch factoryCid gg settlement transferLegs
    [finalized aliceCid, finalized (theAllocationCidV2 bobRes)] [carol]
  case res of
    Left _ -> pure ()
    Right _ -> abort "a cancelled allocation was settled"
  v2 <- totalValue gg instr
  v2 === 0.01

testHappyPathConservesValue : Script ()
testHappyPathConservesValue = do
  gg <- allocateParty "HappyGg"
  alice <- allocateParty "HappyAlice"
  bob <- allocateParty "HappyBob"
  carol <- allocateParty "HappyCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instr = "NTT-COIN-HAPPY"
      instrumentId = InstrumentId with admin = gg, id = instr
  coinCid <- mintCoinV2 factoryCid gg instrumentId alice 0.006
  v0 <- totalValue gg instr
  v0 === 0.006
  let settlement = mkSettlement [carol] "settlement-happy"
      aliceSpec = mkSpec gg alice [mkLeg "leg-0" AV2.SenderSide bob 0.006 instr]
      bobSpec = mkSpec gg bob [mkLeg "leg-0" AV2.ReceiverSide alice 0.006 instr]
  aliceRes <- allocate factoryCid gg alice settlement aliceSpec [coinCid]
  bobRes <- allocate factoryCid gg bob settlement bobSpec []
  v1 <- totalValue gg instr
  v1 === 0.006
  let transferLegs = [AV2.TransferLeg with
        transferLegId = "leg-0", sender = basicAccount alice, receiver = basicAccount bob
        amount = 0.006, instrumentId = instr, meta = emptyMetadata]
  _ <- settleBatch factoryCid gg settlement transferLegs
    [finalized (theAllocationCidV2 aliceRes), finalized (theAllocationCidV2 bobRes)] [carol]
