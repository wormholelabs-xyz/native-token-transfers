-- | Daml Script tests for the 'Wormhole.Ntt.CoinFactory' 'AllocationFactory'
-- v1 addition and 'NttCoinAllocation': DvP/atomic-settlement-style
-- reservation of 'NttCoin' funds, independent of NTT's own burn/mint bridge
-- flow.
--
-- v1 only -- 'AllocationV2'/'AllocationInstructionV2'/'SettlementFactory'
-- (multi-leg net settlement, iterated/committed allocations) have their own
-- dedicated test module, 'Test.TestNttCoinAllocationV2'.
module Test.TestNttCoinAllocation where

import Daml.Script
import DA.Assert ((===))
import DA.Optional (fromSome)
import DA.Time (hours, addRelTime)

import Splice.Api.Token.HoldingV1 (InstrumentId(..), Holding)
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationInstructionV1
import Wormhole.Core.Fees (emptyExtraArgs)
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinAllocation
import Wormhole.Ntt.CoinFactory
import Test.TestNtt (nttCoinFactorySetup, expectAbort)
import Test.TestNttCoin (mintCoin)

asAllocationFactory : ContractId NttCoinFactory -> ContractId AllocationFactory
asAllocationFactory = toInterfaceContractId @AllocationFactory

-- | 'NttCoinFactory' is @signatory guardianGovernance@ alone -- see
-- 'Test.TestNttCoinTransfer.discloseFactory' for why this is needed.
discloseFactory : Party -> ContractId NttCoinFactory -> Script Disclosure
discloseFactory gg factoryCid = fromSome <$> queryDisclosure gg factoryCid

mkAllocationSpec : Time -> Party -> Party -> Party -> Decimal -> InstrumentId -> AllocationSpecification
mkAllocationSpec requestedAt executor sender receiver amount instrumentId =
  AllocationSpecification with
    settlement = SettlementInfo with
      executor
      settlementRef = Reference with id = "settlement-1", cid = None
      requestedAt
      allocateBefore = requestedAt `addRelTime` hours 1
      settleBefore = requestedAt `addRelTime` hours 2
      meta = emptyMetadata
    transferLegId = "leg-0"
    transferLeg = TransferLeg with sender, receiver, amount, instrumentId, meta = emptyMetadata

tryAllocate
  : ContractId NttCoinFactory -> Party -> AllocationSpecification -> [ContractId Holding]
  -> Script (Either SubmitError AllocationInstructionResult)
tryAllocate factoryCid gg spec inputHoldingCids = do
  factoryDisc <- discloseFactory gg factoryCid
  t0 <- getTime
  trySubmit (actAs spec.transferLeg.sender <> disclose factoryDisc) do
    exerciseCmd (asAllocationFactory factoryCid) AllocationFactory_Allocate with
      expectedAdmin = gg
      allocation = spec
      requestedAt = t0
      inputHoldingCids
      extraArgs = emptyExtraArgs

allocate
  : ContractId NttCoinFactory -> Party -> AllocationSpecification -> [ContractId Holding]
  -> Script AllocationInstructionResult
allocate factoryCid gg spec inputHoldingCids = do
  res <- tryAllocate factoryCid gg spec inputHoldingCids
  case res of
    Right ok -> pure ok
    Left err -> abort ("expected AllocationFactory_Allocate to succeed, got: " <> show err)

theAllocationCid : AllocationInstructionResult -> ContractId Allocation
theAllocationCid res = case res.output of
  AllocationInstructionResult_Completed{allocationCid} -> allocationCid
  other -> error ("expected AllocationInstructionResult_Completed, got: " <> show other)

----------------------------------------------------------------------
-- Allocate + ExecuteTransfer -- joint executor/sender/receiver authority
----------------------------------------------------------------------

testNttCoinAllocateExecuteTransferHappyPath : Script ()
testNttCoinAllocateExecuteTransferHappyPath = do
  gg <- allocateParty "AllocExecGg"
  alice <- allocateParty "AllocExecAlice"
  bob <- allocateParty "AllocExecBob"
  carol <- allocateParty "AllocExecCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-EXEC"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  -- Missing exactly one of {executor, sender, receiver} must fail.
  submitMustFail (actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs
  submitMustFail (actAs carol <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs
  submitMustFail (actAs carol <> actAs alice) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs

  execRes <- submit (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs
  case execRes.receiverHoldingCids of
    [rcid] -> do
      Some r <- queryContractId gg (coerceContractId @Holding @NttCoin rcid)
      r.owner === bob
      r.amount === 0.006
    other -> abort ("expected exactly one receiver coin, got: " <> show other)
  archived <- queryContractId gg (coerceContractId @Allocation @NttCoinAllocation allocCid)
  archived === None

testNttCoinAllocateReturnsChangeToSender : Script ()
testNttCoinAllocateReturnsChangeToSender = do
  gg <- allocateParty "AllocChangeGg"
  alice <- allocateParty "AllocChangeAlice"
  bob <- allocateParty "AllocChangeBob"
  carol <- allocateParty "AllocChangeCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-CHANGE"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.004 instrumentId) [coinCid]
  case res.senderChangeCids of
    [changeCid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin changeCid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one change coin, got: " <> show other)

----------------------------------------------------------------------
-- Allocate + Cancel -- same joint-authority requirement
----------------------------------------------------------------------

testNttCoinAllocateCancelReturnsFundsToSender : Script ()
testNttCoinAllocateCancelReturnsFundsToSender = do
  gg <- allocateParty "AllocCancelGg"
  alice <- allocateParty "AllocCancelAlice"
  bob <- allocateParty "AllocCancelBob"
  carol <- allocateParty "AllocCancelCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-CANCEL"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  submitMustFail (actAs carol <> actAs alice) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs
  cancelRes <- submit (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs
  case cancelRes.senderHoldingCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

----------------------------------------------------------------------
-- Allocate + Withdraw -- sender-unilateral, pre-settlement
----------------------------------------------------------------------

testNttCoinAllocateWithdrawIsSenderUnilateral : Script ()
testNttCoinAllocateWithdrawIsSenderUnilateral = do
  gg <- allocateParty "AllocWithdrawGg"
  alice <- allocateParty "AllocWithdrawAlice"
  bob <- allocateParty "AllocWithdrawBob"
  carol <- allocateParty "AllocWithdrawCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-WITHDRAW"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  submitMustFail bob do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  submitMustFail carol do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  withdrawRes <- submit alice do
    exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  case withdrawRes.senderHoldingCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

----------------------------------------------------------------------
-- Defensive check
----------------------------------------------------------------------

testNttCoinAllocateRejectsMismatchedAdminInstrument : Script ()
testNttCoinAllocateRejectsMismatchedAdminInstrument = do
  gg <- allocateParty "AllocMismatchGg"
  notGg <- allocateParty "AllocMismatchNotGg"
  alice <- allocateParty "AllocMismatchAlice"
  bob <- allocateParty "AllocMismatchBob"
  carol <- allocateParty "AllocMismatchCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = notGg, id = "NTT-COIN-ALLOC-MISMATCH"
  t0 <- getTime
  res <- tryAllocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) []
  expectAbort "only serves instruments administered by guardianGovernance" res

-- | With a NEGATIVE amount and EMPTY inputs, the coverage check would pass
-- and @change = total - leg.amount@ would mint a positive coin from nothing.
testNttCoinAllocateV1RejectsNegativeAmount : Script ()
testNttCoinAllocateV1RejectsNegativeAmount = do
  gg <- allocateParty "AllocNegGg"
  alice <- allocateParty "AllocNegAlice"
  bob <- allocateParty "AllocNegBob"
  carol <- allocateParty "AllocNegCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-NEG"
  t0 <- getTime
  res <- tryAllocate factoryCid gg (mkAllocationSpec t0 carol alice bob (-0.01) instrumentId) []
  expectAbort "allocation amount must be positive" res

----------------------------------------------------------------------
-- Deadline enforcement -- allocateBefore / settleBefore
----------------------------------------------------------------------

-- | 'AllocationV1.Allocation_ExecuteTransfer' documents its deadline check as
-- a SHOULD; this suite promotes it to a checked assertion.
testNttCoinAllocateRejectsPastAllocateBefore : Script ()
testNttCoinAllocateRejectsPastAllocateBefore = do
  gg <- allocateParty "AllocPastAllocateBeforeGg"
  alice <- allocateParty "AllocPastAllocateBeforeAlice"
  bob <- allocateParty "AllocPastAllocateBeforeBob"
  carol <- allocateParty "AllocPastAllocateBeforeCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-PASTALLOCATEBEFORE"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  let base = mkAllocationSpec t0 carol alice bob 0.006 instrumentId
      spec = base with settlement = base.settlement with allocateBefore = t0 `addRelTime` hours (-1)
  res <- tryAllocate factoryCid gg spec [coinCid]
  expectAbort "allocation window (allocateBefore) has passed" res

testNttCoinExecuteTransferRejectsPastSettleBefore : Script ()
testNttCoinExecuteTransferRejectsPastSettleBefore = do
  gg <- allocateParty "AllocPastSettleBeforeGg"
  alice <- allocateParty "AllocPastSettleBeforeAlice"
  bob <- allocateParty "AllocPastSettleBeforeBob"
  carol <- allocateParty "AllocPastSettleBeforeCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-COIN-ALLOC-PASTSETTLEBEFORE"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  -- settleBefore = requestedAt + 2h (see mkAllocationSpec) -- move past it.
  passTime (hours 3)

  submitMustFail (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs

  -- Cancel remains the recovery path after the settlement window closes.
  cancelRes <- submit (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs
  case cancelRes.senderHoldingCids of
    [cid] -> do
      Some c <- queryContractId gg (coerceContractId @Holding @NttCoin cid)
      c.owner === alice
      c.amount === 0.006
    other -> abort ("expected one returned coin, got: " <> show other)

----------------------------------------------------------------------
-- Replay and deadline-boundary properties
----------------------------------------------------------------------

-- | Total genuine 'NttCoin' balance of one party for one instrument, as seen
-- by gg (a signatory of every 'NttCoin').
v1CoinBalance : Party -> Party -> InstrumentId -> Script Decimal
v1CoinBalance gg owner instrumentId = do
  coins <- query @NttCoin gg
  pure (sum [c.amount | (_, c) <- coins, c.owner == owner, c.instrumentId == instrumentId])

-- | 'Allocation_Withdraw' must be consuming -- it never explicitly archives
-- the allocation, so a nonconsuming choice here would allow unbounded mint.
testV1WithdrawIsNotReplayable : Script ()
testV1WithdrawIsNotReplayable = do
  gg <- allocateParty "AuthV1WdrGg"
  alice <- allocateParty "AuthV1WdrAlice"
  bob <- allocateParty "AuthV1WdrBob"
  carol <- allocateParty "AuthV1WdrCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-WDR"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  _ <- submit alice do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  gone <- queryContractId gg (coerceContractId @Allocation @NttCoinAllocation allocCid)
  gone === None
  submitMustFail alice do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  bal <- v1CoinBalance gg alice instrumentId
  bal === 0.01

testV1CancelIsNotReplayable : Script ()
testV1CancelIsNotReplayable = do
  gg <- allocateParty "AuthV1CancelGg"
  alice <- allocateParty "AuthV1CancelAlice"
  bob <- allocateParty "AuthV1CancelBob"
  carol <- allocateParty "AuthV1CancelCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-CANCEL"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  _ <- submit (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs
  gone <- queryContractId gg (coerceContractId @Allocation @NttCoinAllocation allocCid)
  gone === None
  submitMustFail (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs
  bal <- v1CoinBalance gg alice instrumentId
  bal === 0.01

-- | The headline double-spend: settle the allocation to the receiver, then
-- try to also pull it back to the sender.
testV1ExecuteThenWithdrawIsBlocked : Script ()
testV1ExecuteThenWithdrawIsBlocked = do
  gg <- allocateParty "AuthV1DblGg"
  alice <- allocateParty "AuthV1DblAlice"
  bob <- allocateParty "AuthV1DblBob"
  carol <- allocateParty "AuthV1DblCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-DBL"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  _ <- submit (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs
  submitMustFail alice do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs
  submitMustFail (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_Cancel with extraArgs = emptyExtraArgs

  aliceBal <- v1CoinBalance gg alice instrumentId
  bobBal <- v1CoinBalance gg bob instrumentId
  aliceBal === 0.004
  bobBal === 0.006

-- | 'allocation_executeTransferImpl' uses a STRICT @now < settleBefore@. Pin
-- the exact boundary: at @now == settleBefore@ execute must fail.
testV1ExecuteAtExactSettleBefore : Script ()
testV1ExecuteAtExactSettleBefore = do
  gg <- allocateParty "AuthV1BoundGg"
  alice <- allocateParty "AuthV1BoundAlice"
  bob <- allocateParty "AuthV1BoundBob"
  carol <- allocateParty "AuthV1BoundCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-BOUND"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  -- settleBefore = t0 + 2h exactly.
  passTime (hours 2)
  submitMustFail (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs

-- | 'allocationFactory_allocateImpl' uses a STRICT @now < allocateBefore@. At
-- @now == allocateBefore@ allocate must fail.
testV1AllocateAtExactAllocateBefore : Script ()
testV1AllocateAtExactAllocateBefore = do
  gg <- allocateParty "AuthV1AllocBoundGg"
  alice <- allocateParty "AuthV1AllocBoundAlice"
  bob <- allocateParty "AuthV1AllocBoundBob"
  carol <- allocateParty "AuthV1AllocBoundCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-ALLOC-BOUND"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  let spec = mkAllocationSpec t0 carol alice bob 0.006 instrumentId
      atDeadline = spec with
        settlement = spec.settlement with allocateBefore = t0
  res <- tryAllocate factoryCid gg atDeadline [coinCid]
  case res of
    Left _ -> pure ()
    Right _ -> abort "allocate succeeded at exactly allocateBefore (expected strict <)"

-- | v1 'Allocation_Withdraw' has no deadline check -- the sender can pull
-- funds mid-settlement, leaving the executor/receiver with nothing.
testV1WithdrawDuringSettlementWindow : Script ()
testV1WithdrawDuringSettlementWindow = do
  gg <- allocateParty "AuthV1WindowGg"
  alice <- allocateParty "AuthV1WindowAlice"
  bob <- allocateParty "AuthV1WindowBob"
  carol <- allocateParty "AuthV1WindowCarolExecutor"
  factoryCid <- nttCoinFactorySetup gg
  let instrumentId = InstrumentId with admin = gg, id = "NTT-AUTH-V1-WINDOW"
  coinCid <- mintCoin factoryCid gg instrumentId alice 0.01
  t0 <- getTime
  res <- allocate factoryCid gg (mkAllocationSpec t0 carol alice bob 0.006 instrumentId) [coinCid]
  let allocCid = theAllocationCid res

  -- Well inside the settlement window (settleBefore = t0 + 2h).
  passTime (hours 1)
  _ <- submit alice do exerciseCmd allocCid Allocation_Withdraw with extraArgs = emptyExtraArgs

  submitMustFail (actAs carol <> actAs alice <> actAs bob) do
    exerciseCmd allocCid Allocation_ExecuteTransfer with extraArgs = emptyExtraArgs
  bobBal <- v1CoinBalance gg bob instrumentId
  bobBal === 0.0
