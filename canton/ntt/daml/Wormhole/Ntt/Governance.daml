-- | The NTT bootstrap root and manager registry.
--
-- 'NttGovernance' is created once per operator by a guardian quorum ceremony —
-- the same k-of-n external-signing flow that creates the genesis @CoreState@.
-- That ceremony is the only time @guardianGovernance@ (gg) actively signs for
-- NTT. Afterwards, 'RegisterManager' lends the root's inherited signatures to
-- create a fully co-signed 'NttManager' per deployment, so deployment stays
-- permissionless and crankless: any admin with a disclosure of this root can
-- register (for burn/mint, co-signed by the instrument's admin — see
-- 'RegisterManager'), and no fresh quorum runs per manager. This is the same
-- signed-anchor pattern the core uses for @EmitterRegistry@.
--
-- Lending gg's signature this way is safe because 'RegisterManager' only ever
-- creates the fixed 'NttManager' (and 'LockedLedger') templates, whose choices
-- gate every movement of gg's value behind VAA verification, plus (now) a
-- fresh gg-owned transceiver 'Emitter' and a gg-scoped replay-trie root — both
-- minted atomically in the same registration transaction, contending on the
-- core's 'EmitterRegistry' and 'ReplayRootRegistry' anchors in addition to
-- this root.
module Wormhole.Ntt.Governance where

import DA.Map qualified as Map
import DA.Set (Set)
import DA.Set qualified as Set
import Splice.Api.Token.AllocationV1 (Allocation)
import Splice.Api.Token.HoldingV1 (InstrumentId (..))
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Wormhole.Core.Bytes (Bytes, Bytes32, normalizeHex)
import Wormhole.Core.Replay (ReplayNode, defaultSplitThreshold)
import Wormhole.Core.State
  ( Emitter, CoreState, EmitterRegistry, ReplayRootRegistry
  , RegisterEmitter (..), ClaimReplayRoot (..), ParseAndVerifyVAA (..) )
import Wormhole.Core.VAA ()   -- HasField instances for VAA record-dot access
import Wormhole.Ntt.Ledger
import Wormhole.Ntt.Manager
import Wormhole.Ntt.Payload (NttGovernanceAction (..), parseNttGovernance)

template NttGovernance
  with
    operator           : Party
    guardianGovernance : Party
    nextId             : Int
    consumedGovernance : Set Bytes32  -- Replay protection for RegisterManagerByVaa
                                      -- (by VAA digest); mirrors CoreState.consumedGovernance,
                                      -- untouched by plain RegisterManager.
  where
    signatory guardianGovernance, operator

    -- | Stand up a deployment, atomically: allocate the next manager id, mint
    -- the deployment's gg-owned transceiver 'Emitter' and claim its gg-scoped
    -- replay-trie root, then create the 'NttManager' (plus, for lock/unlock,
    -- its zero-balance 'LockedLedger'). @admin@ is the transferable
    -- operational role. For lock/unlock it is the sole controller — gg's
    -- authority (the transceiver owner, the replay consumer) is inherited
    -- from this contract's own signatories, and no separate namespace party
    -- exists anymore. For burn/mint the instrument's admin co-signs; see the
    -- controller note below.
    --
    -- The deployment's stable identity is the derived @namespace : Text@:
    -- @"ntt:" <> keccak256(tag ‖ instrument.admin ‖ instrument.id ‖
    -- registering admin ‖ managerId)@ ('nttNamespaceFor'). The manager and
    -- transceiver addresses are likewise bound to the registering @admin@
    -- ('nttManagerAddressFor'). Both survive 'Wormhole.Ntt.Manager.TransferAdmin'
    -- because they are computed once, here, and stored, never recomputed
    -- against the current admin.
    --
    -- A lock/unlock reserve is owned by the registering @admin@ (explicitly
    -- custodial) until the role is handed to the guardian quorum with
    -- 'Wormhole.Ntt.Manager.TransferAdmin'. That keeps registration
    -- permissionless without ever pooling an unvetted deployment's custody
    -- with anyone else's.
    --
    -- For burn/mint, two rules make the mint capability sound: the
    -- instrument's admin — the party whose mint authority the deployment
    -- borrows — must co-sign the registration (see the controller note
    -- below), and the instrument id must be hash-committed to the registering
    -- admin via 'nttInstrumentIdFor' — see there for why this keeps a bridged
    -- instrument exclusive to one deployment.
    --
    -- @coreStateCid@/@emitterFeeAllocation@/@claimFeeAllocation@ fund the
    -- registries' onboarding fees; @None@ when a registry charges none.
    -- INVARIANT: gg never pays fees. It is the requester/consumer of the
    -- nested 'RegisterEmitter'/'ClaimReplayRoot' for authority reasons only;
    -- @admin@ is the co-controlling @payer@ on both, so every charge draws
    -- from the registering admin's allocations.
    --
    -- Consuming, so concurrent registrations contend on this root (and, via
    -- the nested exercises, on the core's 'EmitterRegistry' and
    -- 'ReplayRootRegistry' anchors); a loser re-resolves the fresh cids and
    -- retries.
    choice RegisterManager
      : (ContractId NttGovernance, ContractId NttManager, ContractId Emitter, Optional (ContractId LockedLedger))
      with
        admin                 : Party
        chainId               : Int   -- this deployment's own Wormhole chain id (uint16)
        emitterRegistryCid    : ContractId EmitterRegistry
        replayRootRegistryCid : ContractId ReplayRootRegistry
        instrumentId          : InstrumentId
        instrumentNonce       : Int   -- the nonce in the burn/mint instrument-id binding
        tokenConfig           : NttTokenConfig
        tokenDecimals         : Int
        factory               : NttFactory  -- the registry's factory, typed by mode
        coreStateCid          : Optional (ContractId CoreState)  -- required iff either onboarding fee > 0
        emitterFeeAllocation  : Optional (ContractId Allocation, ExtraArgs)
        claimFeeAllocation    : Optional (ContractId Allocation, ExtraArgs)
      -- For burn/mint, the instrument's admin (the minter) co-signs, because
      -- it is lending its mint authority to this deployment. An external
      -- minter simply consents, so registration stays permissionless; when
      -- the minter is gg, the co-signature makes registration a governance
      -- action, so an attacker cannot stand up a gg-minted deployment behind
      -- a factory it controls. Lock/unlock has no minter and stays
      -- @admin@-only.
      controller admin :: (if tokenConfig == BurnMint then [instrumentId.admin] else [])
      do
        (mgr, emitterCid, ledger) <- registerManagerBody
          operator guardianGovernance nextId admin chainId
          emitterRegistryCid replayRootRegistryCid
          instrumentId instrumentNonce tokenConfig tokenDecimals factory
          coreStateCid emitterFeeAllocation claimFeeAllocation
        reg' <- create this with nextId = nextId + 1
        pure (reg', mgr, emitterCid, ledger)

    -- | Governance-VAA-gated registration of a gg-minted burn/mint deployment:
    -- the guardian quorum co-signs off-chain, alongside the registering
    -- @admin@, in a 'Wormhole.Ntt.Payload.RegisterBurnMintManager' VAA, so no
    -- live gg signature is needed. @chainId@, @tokenDecimals@, @tokenConfig@
    -- and @instrumentId@ are derived from the VAA, not caller-supplied.
    --
    -- Guardians should sign at most one 'NttGovernance' root per operator;
    -- a duplicate root under a different gg key would let a second party
    -- mint gg-administered instruments.
    --
    -- Guardians should sign this VAA in the same ceremony as a later
    -- 'Wormhole.Ntt.Manager.AcceptAdminTransferByVaa' handoff for the same
    -- deployment, if custody is meant to be quorum-owned from genesis;
    -- until that handoff runs, @admin@ still controls
    -- 'Wormhole.Ntt.Manager.SetPeer'.
    choice RegisterManagerByVaa
      : (ContractId NttGovernance, ContractId NttManager, ContractId Emitter, Optional (ContractId LockedLedger))
      with
        admin                 : Party
        emitterRegistryCid    : ContractId EmitterRegistry
        replayRootRegistryCid : ContractId ReplayRootRegistry
        instrumentNonce       : Int
        factory               : NttFactory
        coreStateCid          : ContractId CoreState  -- mandatory: needed for VAA verification even at zero fees
        emitterFeeAllocation  : Optional (ContractId Allocation, ExtraArgs)
        claimFeeAllocation    : Optional (ContractId Allocation, ExtraArgs)
        vaaBytes              : Bytes
        pubKeys               : [(Int, Bytes)]
        extraArgs             : ExtraArgs
      controller admin
      do
        -- 1. Pin CoreState before trusting any of its fields.
        cs <- fetch coreStateCid
        assertMsg "ntt governance: core state is not the committed guardian trust anchor"
          (cs.guardianGovernance == guardianGovernance)
        assertMsg "ntt governance: core state operator mismatch"
          (cs.operator == operator)

        -- 2. Read-only VAA signature verification; nothing consumed yet.
        vaa <- exercise coreStateCid ParseAndVerifyVAA with
          verifier = admin
          encodedVAA = vaaBytes
          pubKeys

        -- 3. Governance hardening.
        assertMsg "ntt governance: not signed by current guardian set"
          (vaa.guardianSetIndex == cs.guardianSetIndex)
        assertMsg "ntt governance: wrong emitter chain"
          (vaa.emitterChain == cs.governanceChainId)
        assertMsg "ntt governance: wrong emitter address"
          (normalizeHex vaa.emitterAddress == normalizeHex cs.governanceContract)

        -- 4. Exhaustive constructor dispatch: reject any non-registration action.
        (chainId, registrationBinding, tokenDecimals) <- case parseNttGovernance vaa.payload of
          RegisterBurnMintManager chain binding decimals -> pure (chain, binding, decimals)
          _ -> abort "ntt governance: not a register-burn-mint-manager action"

        -- 5. Replay, checked before the binding check below.
        assertMsg "ntt governance: registration VAA already consumed"
          (not (Set.member vaa.hash consumedGovernance))

        -- 6. Derived-value range asserts, reachable ahead of the binding
        -- check (also re-asserted inside 'registerManagerBody').
        assertMsg "ntt: tokenDecimals must be between 0 and 10"
          (tokenDecimals >= 0 && tokenDecimals <= 10)
        assertMsg "ntt: chainId must be a positive uint16"
          (chainId > 0 && chainId <= 65535)

        -- 7. Binding: no static VAA can pass this, since party fingerprints
        -- are nondeterministic and only known once parties are allocated.
        assertMsg "ntt governance: registration binding does not match"
          (normalizeHex registrationBinding == nttRegistrationBindingFor operator admin instrumentNonce)

        -- 8. Factory template-pin.
        requireCanonicalFactory guardianGovernance factory

        let instrumentId = InstrumentId with
              admin = guardianGovernance
              id = nttInstrumentIdFor admin instrumentNonce

        -- 9. Run the shared registration body; recreate the root once.
        (mgr, emitterCid, ledger) <- registerManagerBody
          operator guardianGovernance nextId admin chainId
          emitterRegistryCid replayRootRegistryCid
          instrumentId instrumentNonce BurnMint tokenDecimals factory
          (Some coreStateCid) emitterFeeAllocation claimFeeAllocation
        reg' <- create this with
          nextId = nextId + 1
          consumedGovernance = Set.insert vaa.hash consumedGovernance
        pure (reg', mgr, emitterCid, ledger)

-- | Registration body shared by 'RegisterManager' and
-- 'RegisterManagerByVaa': mints the transceiver 'Emitter', claims the
-- replay-trie root, and creates the 'NttManager' (plus 'LockedLedger' for
-- lock/unlock). Module-level, not a choice, so 'RegisterManagerByVaa' can
-- call it after consuming @self@, without nest-exercising 'RegisterManager'.
-- Callers create the successor 'NttGovernance' root themselves.
registerManagerBody
  : Party                          -- operator
  -> Party                          -- guardianGovernance
  -> Int                            -- nextId (this deployment's managerId)
  -> Party                          -- admin (the registering admin)
  -> Int                            -- chainId
  -> ContractId EmitterRegistry
  -> ContractId ReplayRootRegistry
  -> InstrumentId
  -> Int                            -- instrumentNonce
  -> NttTokenConfig
  -> Int                            -- tokenDecimals
  -> NttFactory
  -> Optional (ContractId CoreState)
  -> Optional (ContractId Allocation, ExtraArgs)  -- emitterFeeAllocation
  -> Optional (ContractId Allocation, ExtraArgs)  -- claimFeeAllocation
  -> Update (ContractId NttManager, ContractId Emitter, Optional (ContractId LockedLedger))
registerManagerBody
  operator guardianGovernance nextId admin chainId
  emitterRegistryCid replayRootRegistryCid
  instrumentId instrumentNonce tokenConfig tokenDecimals factory
  coreStateCid emitterFeeAllocation claimFeeAllocation = do
    -- Decimal conversions ('untrimToDecimal') are exact only up to the 10
    -- fractional digits a Daml Decimal carries.
    assertMsg "ntt: tokenDecimals must be between 0 and 10"
      (tokenDecimals >= 0 && tokenDecimals <= 10)
    assertMsg "ntt: chainId must be a positive uint16"
      (chainId > 0 && chainId <= 65535)
    case tokenConfig of
      BurnMint ->
        -- The instrument's admin co-signs via the controller, so no on-ledger
        -- consent check is needed; the id binding keeps the instrument
        -- exclusive to one deployment (see 'nttInstrumentIdFor').
        assertMsg "ntt: burn/mint instrument id is not bound to the registering admin"
          (instrumentId.id == nttInstrumentIdFor admin instrumentNonce)
      LockUnlock -> pure ()
    assertMsg "ntt: factory type does not match the token config"
      (factoryMatchesConfig tokenConfig factory)

    -- Mint the deployment's transceiver: gg's requester authority is
    -- inherited from the calling choice's own signatories; @admin@ pays.
    (_, emitterCid) <- exercise emitterRegistryCid RegisterEmitter with
      requester = guardianGovernance
      payer = admin
      coreStateCid
      feeAllocation = emitterFeeAllocation
    emitter <- fetch emitterCid
    assertMsg "ntt: emitter registry is not this bridge instance's"
      (emitter.operator == operator && emitter.guardianGovernance == guardianGovernance)

    let managerAddress = nttManagerAddressFor operator admin nextId
        namespace = nttNamespaceFor instrumentId admin nextId

    -- Claim the deployment's replay-trie root, sub-scoped under gg by the
    -- derived namespace.
    rootCid <- exercise replayRootRegistryCid ClaimReplayRoot with
      consumer = guardianGovernance
      namespace
      splitThreshold = defaultSplitThreshold
      payer = admin
      coreStateCid
      feeAllocation = claimFeeAllocation
    root <- fetch rootCid
    assertMsg "ntt: replay root registry is not this bridge instance's"
      (root.operator == operator)

    mgr <- create NttManager with
      operator
      namespace
      admin
      guardianGovernance
      chainId
      managerId = nextId
      managerAddress
      transceiverEmitterId = emitter.emitterId
      instrumentId
      tokenConfig
      tokenDecimals
      peers = Map.empty
      factory
      paused = False
      factoryEpoch = 0
      -- An external minter (instrument admin ≠ gg) becomes a manager
      -- signatory so burn/mint runs on its authority; gg-minted
      -- deployments carry None and mint on gg's inherited signature.
      minter = case tokenConfig of
        BurnMint | instrumentId.admin /= guardianGovernance -> Some instrumentId.admin
        _ -> None
    ledger <- case tokenConfig of
      LockUnlock -> Some <$> create LockedLedger with
        operator
        guardianGovernance
        admin
        managerAddress
        balance = 0.0
        custodyHoldingCid = None
      BurnMint -> pure None
    pure (mgr, emitterCid, ledger)
