-- | Per-deployment accounting for lock/unlock custody.
--
-- Every lock/unlock deployment deposits into the same custodian party
-- (@guardianGovernance@), so the physical holdings form one fungible pot. Each
-- deployment therefore keeps its own 'LockedLedger': the manager credits it on
-- every lock and debits it on every release, and 'Debit' rejects any amount
-- above the balance. A deployment can release at most what it locked, which is
-- what keeps a deployment with a hostile peer away from other deployments'
-- collateral. The cap is sound even though the pot is fungible: credits and
-- debits are atomic with the corresponding deposit and release, so the sum of
-- all ledger balances never exceeds the custodian's physical holdings.
--
-- The ledger also carries @custodyHoldingCid@, a pointer to the deployment's
-- single consolidated custody holding. The manager maintains a single-holding
-- invariant: locks merge the fresh deposit into the pot, releases spend the
-- pot and record the change, so relayers never need an off-chain index of
-- custody fragments. The pointer is a hint, not a trust anchor: holdings are
-- validated (owner, instrument) at use time, the registry may reorganize its
-- holdings out from under it, and 'Wormhole.Ntt.Manager.ConsolidateCustody'
-- rebuilds it from explicit cids when it goes stale.
--
-- The ledger is a separate contract rather than a field on 'NttManager' so
-- that transfer traffic does not consume the manager: the manager changes only
-- when the admin edits the peer table, and its cid stays stable for everyone
-- who holds a disclosure of it.
module Wormhole.Ntt.Ledger where

import Splice.Api.Token.HoldingV1 (Holding)
import Wormhole.Core.Bytes (Bytes32)

template LockedLedger
  with
    operator           : Party
    admin              : Party
    guardianGovernance : Party
    managerAddress     : Bytes32   -- the owning NttManager
    balance            : Decimal
    custodyHoldingCid  : Optional (ContractId Holding)  -- hint: the consolidated pot
  where
    -- Same signatories as the owning manager. Creating a ledger needs all
    -- three signatures, and the only code path that has them is
    -- 'Wormhole.Ntt.Governance.RegisterManager', which creates exactly one
    -- ledger per lock/unlock deployment. The manager checks the four identity
    -- fields before using a caller-supplied ledger cid.
    signatory operator, admin, guardianGovernance
    ensure balance >= 0.0

    -- The controllers are the full signatory set, so only a choice body that
    -- already carries all three authorities (in practice: the owning manager's
    -- choices) can update the ledger.
    choice Credit : ContractId LockedLedger
      with
        amount            : Decimal
        newCustodyHint    : Optional (ContractId Holding)
      controller operator, admin, guardianGovernance
      do
        assertMsg "ntt: ledger credit must be positive" (amount > 0.0)
        create this with
          balance = balance + amount
          custodyHoldingCid = newCustodyHint

    choice Debit : ContractId LockedLedger
      with
        amount            : Decimal
        newCustodyHint    : Optional (ContractId Holding)
      controller operator, admin, guardianGovernance
      do
        assertMsg "ntt: ledger debit must be positive" (amount > 0.0)
        assertMsg "ntt: release exceeds this deployment's locked balance"
          (amount <= balance)
        create this with
          balance = balance - amount
          custodyHoldingCid = newCustodyHint

    -- | Repoint the custody hint without touching the balance; the repair
    -- path after a consolidation or a registry-side reorganization.
    choice SetCustodyHint : ContractId LockedLedger
      with
        newCustodyHint : Optional (ContractId Holding)
      controller operator, admin, guardianGovernance
      do create this with custodyHoldingCid = newCustodyHint
