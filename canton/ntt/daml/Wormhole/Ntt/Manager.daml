-- | NttManager + its single (threshold-1) Wormhole transceiver for Canton.
--
-- Deployment is permissionless and crankless: an @admin@ with a disclosure to the
-- operator's 'NttManagerRegistry' calls 'RegisterManager' directly; @operator@'s
-- co-signature is inherited from the registry. @operator@ and @admin@ co-sign the
-- manager; neither controls transfer contents.
--
-- Addresses are key-derived ('derivedAddress'): the transceiver address is the
-- core 'Emitter' published through; the manager address ('nttManagerAddressFor')
-- has @admin@ in its preimage, so a compromised operator can't forge an existing
-- manager's address. No contract keys — contracts resolve by disclosed cid, and
-- both churn, so a sender re-resolves cids per send (README §4.7).
--
-- Send ('Transfer') publishes an ordinary core message via 'PublishMessage'.
-- Receive ('Receive') is permissionless: any executor relays an inbound VAA;
-- replay protection is the core per-consumer trie (scoped to @admin@), guardian
-- root pinned via the disclosed 'CoreState'. Minting an owner-signed token needs
-- the recipient's signature; it comes from a standing 'DepositPreapproval' the
-- recipient created earlier, so the recipient can stay offline at relay time.
module Wormhole.Ntt.Manager where

import DA.Crypto.Text (keccak256, toHex)
import DA.Map (Map)
import DA.Map qualified as Map
import DA.Optional (fromSomeNote)

import Splice.Api.Token.AllocationV1 (Allocation)
import Splice.Api.Token.HoldingV1 (Holding)
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Wormhole.Core.Bytes
import Wormhole.Core.Replay (ReplayNode)
import Wormhole.Core.State
  ( Emitter, CoreState
  , GetGuardianGovernance (..), VerifyAndConsumeVAA (..), PublishMessage (..) )
import Wormhole.Core.VAA ()   -- HasField instances for VAA record-dot access
import Wormhole.Ntt.Payload
import Wormhole.Ntt.Token

-- | A peer NTT deployment on another chain: its manager address (the
-- @recipientManager@/@sourceManager@ in the transceiver message) and transceiver
-- address (the inbound VAA emitter). Both 32 bytes.
data Peer = Peer with
    managerAddress     : Bytes32
    transceiverAddress : Bytes32
  deriving (Eq, Show)

normalizePeer : Peer -> Peer
normalizePeer p = Peer with
    managerAddress = normalizeHex p.managerAddress
    transceiverAddress = normalizeHex p.transceiverAddress

-- | Domain-separation tag for NTT manager addresses. Distinct from
-- 'emitterAddressTag' so an emitter and manager with the same
-- @(operator, admin, id)@ derive different addresses.
nttManagerAddressTag : Text
nttManagerAddressTag = "wormhole:ntt-manager:v1"

-- | The 32-byte NTT manager address of the 'NttManager' allocated at
-- @managerId@ for @(operator, admin)@.
nttManagerAddressFor : Party -> Party -> Int -> Bytes32
nttManagerAddressFor operator admin managerId =
  derivedAddress (DomainTag nttManagerAddressTag) operator admin (RegistryId managerId)

-- | Domain-separation tag for NTT recipient-address bindings. Distinct from
-- every other domain tag so a binding can't collide with an emitter, manager, or
-- governance address.
recipientAddressTag : Text
recipientAddressTag = "wormhole:ntt-recipient:v1"

-- | @keccak256(tag ‖ lp(utf8(recipientText)))@ (@lp@ = 4-byte big-endian length
-- prefix). Text form split from 'recipientAddressFor' so tests can pin the
-- encoding against a fixed string (a live Party's fingerprint is
-- nondeterministic). Mirrors 'derivedAddressFromText'.
recipientAddressFromText : Text -> Bytes32
recipientAddressFromText recipientText =
  normalizeHex (keccak256 (toHex recipientAddressTag
    <> unLenPrefixed (lenPrefixed (toHex recipientText))))

-- | The 32-byte binding a sender computes off-chain for an outbound transfer's
-- @recipientAddress@ to reach @recipient@ on Canton. 'Receive' recomputes it from
-- the caller-supplied @recipient@ and checks it against the VAA.
recipientAddressFor : Party -> Bytes32
recipientAddressFor recipient = recipientAddressFromText (partyToText recipient)

-- | Allocates increasing manager ids, one registry per operator. Same caveat as
-- 'EmitterRegistry': counter discipline is behavioral, but address integrity is
-- cryptographic (admin co-signature + admin in the preimage). Resolved by
-- disclosed cid.
template NttManagerRegistry
  with
    operator : Party
    nextId   : Int
  where
    signatory operator

    -- | Stand up a deployment directly (crankless). Any @admin@ with a disclosure
    -- to this registry can register; @operator@'s co-signature is inherited from
    -- the registry. @admin@ passes its already-registered core 'Emitter' (the
    -- transceiver), fetched and bound here.
    --
    -- @guardianGovernance@ is the trust anchor 'Receive' pins. A bogus anchor only
    -- breaks the admin's own deployment (no authentic 'CoreState' carries it); it
    -- can't redirect transfers to a forged guardian set.
    choice RegisterManager : (ContractId NttManagerRegistry, ContractId NttManager)
      with
        admin                 : Party
        guardianGovernance    : Party
        transceiverEmitterCid : ContractId Emitter
        tokenCid              : ContractId NttToken
        mode                  : TokenMode
        tokenDecimals         : Int
      controller admin
      do
        transceiver <- fetch transceiverEmitterCid
        assertMsg "ntt: transceiver emitter is not owned by the admin"
          (transceiver.owner == admin)
        assertMsg "ntt: transceiver emitter is not from this operator"
          (transceiver.operator == operator)
        reg' <- create this with nextId = nextId + 1
        mgr <- create NttManager with
          operator
          admin
          guardianGovernance
          managerId = nextId
          managerAddress = nttManagerAddressFor operator admin nextId
          transceiverEmitterId = transceiver.emitterId
          tokenCid
          mode
          tokenDecimals
          peers = Map.empty
          outboundSequence = 0
        pure (reg', mgr)

template NttManager
  with
    operator             : Party
    admin                : Party
    guardianGovernance   : Party           -- guardian trust anchor 'Receive' pins on the CoreState
    managerId            : Int             -- registry-allocated; part of the address preimage
    managerAddress       : Bytes32         -- nttManagerAddressFor operator admin managerId
    transceiverEmitterId : Int             -- the deployment's transceiver Emitter (owner = admin)
    tokenCid             : ContractId NttToken
    mode                 : TokenMode
    tokenDecimals        : Int
    peers                : Map Int Peer     -- recipient / source chainId -> peer
    outboundSequence     : Int              -- next NttManagerMessage id
    -- (Inbound replay protection is the core per-consumer trie, not manager state.)
  where
    -- Admin co-signs: the manager address includes admin, so a compromised
    -- operator can't mint a manager with an existing deployment's address.
    signatory operator, admin

    -- | Register/replace a peer deployment.
    choice SetPeer : ContractId NttManager
      with
        chainId : Int
        peer    : Peer
      controller admin
      do create this with peers = Map.insert chainId (normalizePeer peer) peers

    -- | Outbound transfer. Trims the amount, locks/burns the token from @user@ via
    -- the seam, publishes the NTT message via the transceiver 'Emitter', advances
    -- the sequence. @user@ is sole controller; the nested @LockOrBurn@ and
    -- @PublishMessage@ ride on 'NttManager''s inherited signatory authority.
    --
    -- @user@ attaches a fee allocation from its own wallet — the governance-set
    -- fee every publish pays (empty at fee 0); a send is never fee-exempt. @user@
    -- is not a stakeholder of these contracts, so they must be disclosed to it.
    choice Transfer : ContractId NttManager
      with
        user                  : Party                 -- token owner initiating the transfer; pays the fee
        transceiverEmitterCid : ContractId Emitter     -- this deployment's transceiver (disclosed)
        coreStateCid          : ContractId CoreState   -- for the message-fee read (disclosed)
        recipientChain        : Int
        recipientAddress      : Bytes32
        sourceToken           : Bytes32
        rawAmount             : Int
        nonce                 : Int
        consistencyLevel      : Int
        inputHoldingCids      : [ContractId Holding]   -- CIP-56 holdings to lock/burn
        feeAllocation         : Optional (ContractId Allocation, ExtraArgs)  -- messageFee; None at fee 0
        extraArgs             : ExtraArgs              -- CIP-56 registry choice context
      controller user
      do
        let peer = fromSomeNote ("ntt: no peer for chain " <> show recipientChain)
                     (Map.lookup recipientChain peers)
            trimmed = trimAmount rawAmount tokenDecimals
        -- Bind the caller-supplied transceiver to this deployment before publishing.
        transceiver <- fetch transceiverEmitterCid
        assertMsg "ntt: transceiver emitter is not this deployment's"
          (transceiver.owner == admin
            && transceiver.operator == operator
            && transceiver.emitterId == transceiverEmitterId)
        -- Lock (custody) or burn the user's tokens via the token seam.
        exercise tokenCid LockOrBurn with
          sender = user, amount = trimmed, inputHoldingCids, extraArgs
        let ntt = NativeTokenTransfer with
              decimals = trimmed.decimals
              amount = trimmed.amount
              sourceToken = normalizeHex sourceToken
              recipientAddress = normalizeHex recipientAddress
              recipientChain
              additionalPayload = ""
            mm = NttManagerMessage with
              id = leftPadTo 32 (intToBytesN outboundSequence 8)
              sender = managerAddress
              payload = encodeNativeTokenTransfer ntt
            wm = WormholeTransceiverMessage with
              sourceManager = managerAddress
              recipientManager = peer.managerAddress
              managerPayload = encodeNttManagerMessage mm
              transceiverPayload = ""
        _ <- exercise transceiverEmitterCid PublishMessage with
               payload = encodeWormholeTransceiverMessage wm
               nonce
               consistencyLevel
               coreStateCid
               payer = user
               feeAllocation
        create this with outboundSequence = outboundSequence + 1

    -- | Inbound transfer, permissionless. Any @executor@ relays the VAA: verifies
    -- + claims it atomically via 'VerifyAndConsumeVAA' (per-consumer trie scoped to
    -- @admin@, so each deployment claims a VAA once), enforces the peer, binds
    -- @recipient@ to the VAA's @recipientAddress@, and mints/unlocks.
    --
    -- Anyone can be the @executor@: it is the sole controller, carries no special
    -- rights, and only supplies disclosures. Every signature the nested calls
    -- need comes from a contract rather than from the submitter: the
    -- @nonconsuming@ body inherits 'NttManager''s own signatories
    -- (@operator, admin@), and for an owner-signed token the recipient's
    -- signature comes from the standing 'DepositPreapproval' it created earlier
    -- (@depositPreapprovalCid@, forwarded to 'MintOrUnlock'; 'None' for the
    -- admin-signed mock, which needs no owner signature). The recipient stays
    -- offline throughout; relaying stays fully permissionless (README §10).
    --
    -- The disclosed 'CoreState' is authenticated by pinning its
    -- @guardianGovernance@ to the anchor @admin@ committed at deployment. Pinning
    -- the operator wouldn't stop a compromised operator forging a 'CoreState' under
    -- a throwaway gg; pinning @guardianGovernance@ (the guardians' k-of-n
    -- threshold, unforgeable by a hot operator key) does.
    --
    -- The executor can't supply an arbitrary @recipient@: 'recipientAddressFor
    -- recipient' must equal the VAA's @recipientAddress@ (sender-fixed, guardian-
    -- signed). This permanently binds the VAA to that Party id; a recipient needing
    -- a different party requires a re-send.
    --
    -- @pubKeys@ are untrusted hints (hint-free verification is a follow-up, §11).
    nonconsuming choice Receive : NativeTokenTransfer
      with
        executor              : Party                 -- any relayer; carries no authority
        coreStateCid          : ContractId CoreState   -- disclosed; pinned via guardianGovernance
        replayNodeCid         : ContractId ReplayNode   -- covering trie node for vaa.hash
        vaaBytes              : Bytes
        pubKeys               : [(Int, Bytes)]
        recipient             : Party
        inputHoldingCids      : [ContractId Holding]   -- custody holdings to unlock ([] for mint)
        depositPreapprovalCid : Optional (ContractId DepositPreapproval)  -- recipient consent (owner-signed kinds)
        extraArgs             : ExtraArgs             -- CIP-56 choice context
      controller executor
      do
        -- Authenticate the guardian trust root before verifying against it.
        csGg <- exercise coreStateCid GetGuardianGovernance with reader = executor
        assertMsg "ntt: core state is not the committed guardian trust anchor"
          (csGg == guardianGovernance)
        (vaa, _node) <- exercise coreStateCid VerifyAndConsumeVAA with
          encodedVAA = vaaBytes
          pubKeys
          consumer = admin
          replayNodeCid
        let peer = fromSomeNote ("ntt: no peer for source chain " <> show vaa.emitterChain)
                     (Map.lookup vaa.emitterChain peers)
        assertMsg "ntt: VAA emitter is not the configured peer transceiver"
          (normalizeHex vaa.emitterAddress == peer.transceiverAddress)
        let wm = decodeWormholeTransceiverMessage vaa.payload
        assertMsg "ntt: wrong recipient manager" (wm.recipientManager == managerAddress)
        assertMsg "ntt: source manager is not the peer manager"
          (wm.sourceManager == peer.managerAddress)
        let mm = decodeNttManagerMessage wm.managerPayload
            ntt = decodeNativeTokenTransfer mm.payload
        assertMsg "ntt: recipient does not match VAA recipientAddress"
          (recipientAddressFor recipient == normalizeHex ntt.recipientAddress)
        exercise tokenCid MintOrUnlock with
          recipient
          amount = TrimmedAmount with decimals = ntt.decimals, amount = ntt.amount
          inputHoldingCids
          depositPreapprovalCid
          extraArgs
        pure ntt
