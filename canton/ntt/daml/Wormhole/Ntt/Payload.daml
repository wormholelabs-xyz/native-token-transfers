-- | NTT wire codec: the three nested structures a Native Token Transfer travels
-- in, mirroring the spec and the EVM/Solana reference implementations.
--
-- Layouts (widths in BYTES; big-endian; hex 'Bytes' throughout):
--
-- > NativeTokenTransfer:
-- >   prefix(4) = 0x994E5454 ‖ decimals(1) ‖ amount(8) ‖ sourceToken(32)
-- >   ‖ recipientAddress(32) ‖ recipientChain(2)
-- >   [‖ additionalPayloadLen(2) ‖ additionalPayload]
-- >
-- > NttManagerMessage:
-- >   id(32) ‖ sender(32) ‖ payloadLen(2) ‖ payload
-- >
-- > WormholeTransceiverMessage (the VAA payload):
-- >   prefix(4) = 0x9945FF10 ‖ sourceManager(32) ‖ recipientManager(32)
-- >   ‖ managerPayloadLen(2) ‖ managerPayload ‖ transceiverPayloadLen(2) ‖ transceiverPayload
--
-- Decoders 'error' on malformed input (bad prefix / short buffer).
module Wormhole.Ntt.Payload where

import Wormhole.Core.Bytes

----------------------------------------------------------------------
-- Big-endian encoding helpers. 'intToBytesN' / 'leftPadTo' live in
-- Wormhole.Core.Bytes; this module adds only the NTT uint16 length prefix.
----------------------------------------------------------------------

-- | Encode a length-prefixed field: uint16 length ‖ bytes.
encodeLengthPrefixed : Bytes -> Bytes
encodeLengthPrefixed b = intToBytesN (byteLength b) 2 <> normalizeHex b

----------------------------------------------------------------------
-- Prefixes
----------------------------------------------------------------------

-- | @0x994E5454@ = 0x99 'N' 'T' 'T'.
nativeTokenTransferPrefix : Bytes
nativeTokenTransferPrefix = "994e5454"

-- | @0x9945FF10@, the Wormhole transceiver message prefix.
wormholeTransceiverPrefix : Bytes
wormholeTransceiverPrefix = "9945ff10"

----------------------------------------------------------------------
-- NativeTokenTransfer
----------------------------------------------------------------------

data NativeTokenTransfer = NativeTokenTransfer with
    decimals          : Int      -- uint8: trimmed-amount decimals
    amount            : Int      -- uint64: trimmed amount
    sourceToken       : Bytes32
    recipientAddress  : Bytes32
    recipientChain    : Int      -- uint16: Wormhole chain id
    additionalPayload : Bytes    -- "" when absent
  deriving (Eq, Show)

encodeNativeTokenTransfer : NativeTokenTransfer -> Bytes
encodeNativeTokenTransfer n =
  nativeTokenTransferPrefix
    <> intToHexByte n.decimals
    <> intToBytesN n.amount 8
    <> leftPadTo 32 n.sourceToken
    <> leftPadTo 32 n.recipientAddress
    <> intToBytesN n.recipientChain 2
    <> (if n.additionalPayload == "" then "" else encodeLengthPrefixed n.additionalPayload)

decodeNativeTokenTransfer : Bytes -> NativeTokenTransfer
decodeNativeTokenTransfer b =
  let prefix = normalizeHex (sliceBytes 0 4 b)
      decimals = bytesToInt (sliceBytes 4 1 b)
      amount = bytesToInt (sliceBytes 5 8 b)
      sourceToken = normalizeHex (sliceBytes 13 32 b)
      recipientAddress = normalizeHex (sliceBytes 45 32 b)
      recipientChain = bytesToInt (sliceBytes 77 2 b)
      additionalPayload =
        if byteLength b <= 79
          then ""
          else let rest = sliceFrom 79 b
                   alen = bytesToInt (sliceBytes 0 2 rest)
               in sliceBytes 2 alen rest
  in if prefix /= nativeTokenTransferPrefix
       then error ("ntt: bad NativeTokenTransfer prefix: " <> prefix)
       else NativeTokenTransfer with ..

----------------------------------------------------------------------
-- NttManagerMessage
----------------------------------------------------------------------

data NttManagerMessage = NttManagerMessage with
    id      : Bytes32   -- unique per (source manager) message id
    sender  : Bytes32   -- the sending manager address
    payload : Bytes     -- an encoded NativeTokenTransfer
  deriving (Eq, Show)

encodeNttManagerMessage : NttManagerMessage -> Bytes
encodeNttManagerMessage m =
  leftPadTo 32 m.id <> leftPadTo 32 m.sender <> encodeLengthPrefixed m.payload

decodeNttManagerMessage : Bytes -> NttManagerMessage
decodeNttManagerMessage b =
  let id = normalizeHex (sliceBytes 0 32 b)
      sender = normalizeHex (sliceBytes 32 32 b)
      plen = bytesToInt (sliceBytes 64 2 b)
      payload = sliceBytes 66 plen b
  in NttManagerMessage with ..

----------------------------------------------------------------------
-- WormholeTransceiverMessage (the Wormhole VAA payload)
----------------------------------------------------------------------

data WormholeTransceiverMessage = WormholeTransceiverMessage with
    sourceManager      : Bytes32
    recipientManager   : Bytes32
    managerPayload     : Bytes   -- an encoded NttManagerMessage
    transceiverPayload : Bytes   -- "" for the Wormhole transceiver
  deriving (Eq, Show)

encodeWormholeTransceiverMessage : WormholeTransceiverMessage -> Bytes
encodeWormholeTransceiverMessage w =
  wormholeTransceiverPrefix
    <> leftPadTo 32 w.sourceManager
    <> leftPadTo 32 w.recipientManager
    <> encodeLengthPrefixed w.managerPayload
    <> encodeLengthPrefixed w.transceiverPayload

decodeWormholeTransceiverMessage : Bytes -> WormholeTransceiverMessage
decodeWormholeTransceiverMessage b =
  let prefix = normalizeHex (sliceBytes 0 4 b)
      sourceManager = normalizeHex (sliceBytes 4 32 b)
      recipientManager = normalizeHex (sliceBytes 36 32 b)
      mlen = bytesToInt (sliceBytes 68 2 b)
      managerPayload = sliceBytes 70 mlen b
      tOffset = 70 + mlen
      tlen = bytesToInt (sliceBytes tOffset 2 b)
      transceiverPayload = sliceBytes (tOffset + 2) tlen b
  in if prefix /= wormholeTransceiverPrefix
       then error ("ntt: bad WormholeTransceiver prefix: " <> prefix)
       else WormholeTransceiverMessage with ..

----------------------------------------------------------------------
-- NTT governance packets
--
-- A governance packet is a VAA payload with the layout:
--
-- >  module(32) ‖ action(1) ‖ chain(2) ‖ <action-specific>
--
-- mirroring the core's own packet layout (@Wormhole.Core.Governance@) but under
-- NTT's own module id, so an NTT governance VAA can never be confused with (or
-- replayed as) a core one even before replay-trie scoping is considered.
----------------------------------------------------------------------

-- | The NTT governance module identifier: ASCII "Ntt" (0x4e7474) left-padded to
-- 32 bytes. Every NTT governance packet carries this value; a core ("Core")
-- packet routed here (or vice versa) is rejected at the module check.
nttGovernanceModule : Bytes32
nttGovernanceModule = "00000000000000000000000000000000000000000000000000000000004e7474"

-- | The guardian quorum accepts the admin role of the manager identified by
-- @(managerAddress, factoryEpoch)@ into @guardianGovernance@. See
-- 'Wormhole.Ntt.Manager.AcceptAdminTransferByVaa'.
nttGovernanceAcceptAdminAction : Int
nttGovernanceAcceptAdminAction = 1

-- | The guardian quorum co-signs a gg-minted burn/mint registration alongside
-- the registering admin. See 'Wormhole.Ntt.Governance.RegisterManagerByVaa'.
nttGovernanceRegisterBurnMintManagerAction : Int
nttGovernanceRegisterBurnMintManagerAction = 2

-- | The guardian quorum vets a factory rotation for a gg-minted deployment. See
-- 'Wormhole.Ntt.Manager.SetFactoryByVaa'.
nttGovernanceRotateToCanonicalFactoryAction : Int
nttGovernanceRotateToCanonicalFactoryAction = 3

-- | A parsed NTT governance action — a genuine sum type (contrast
-- 'Wormhole.Core.Governance.GovernanceAction', the core's own 4-constructor
-- analog): every call site (each in @Wormhole.Ntt.Manager@/@Wormhole.Ntt.Governance@)
-- does an EXHAUSTIVE constructor match and aborts on the wrong one — never a
-- shared field-extraction helper across constructors, even where fields line
-- up positionally (e.g. 'AcceptAdminToGovernance' and 'RotateToCanonicalFactory'
-- share a layout). This is deliberate: a guardian-signed VAA for one action
-- must never satisfy a different action's choice just because the bytes
-- happen to parse.
--
--   * 'AcceptAdminToGovernance': @chain@ must match the target manager's own
--     @Wormhole.Ntt.Manager.NttManager.chainId@ (72 on Canton) — the same
--     field 'Wormhole.Ntt.Manager.verifyInboundTransfer' checks an inbound
--     transfer's @recipientChain@ against; @managerAddress@ and
--     @factoryEpoch@ must match the target manager — see
--     'Wormhole.Ntt.Manager.AcceptAdminTransferByVaa'.
--   * 'RegisterBurnMintManager': @registrationBinding@ must equal
--     'Wormhole.Ntt.Manager.nttRegistrationBindingFor' for the registering
--     (operator, admin, instrumentNonce) — see
--     'Wormhole.Ntt.Governance.RegisterManagerByVaa'.
--   * 'RotateToCanonicalFactory': identical layout to
--     'AcceptAdminToGovernance', safe because both consume in the same
--     deployment replay trie and every call site dispatches on the
--     constructor, never the raw action byte alone — see
--     'Wormhole.Ntt.Manager.SetFactoryByVaa'.
data NttGovernanceAction
  = AcceptAdminToGovernance with
      chain          : Int      -- uint16: Wormhole chain id
      managerAddress : Bytes32
      factoryEpoch   : Int      -- uint64: the vetted (managerAddress, factoryEpoch) pair
  | RegisterBurnMintManager with
      chain               : Int      -- uint16: Wormhole chain id
      registrationBinding : Bytes32  -- nttRegistrationBindingFor operator admin instrumentNonce
      tokenDecimals       : Int      -- uint8: 0..10
  | RotateToCanonicalFactory with
      chain          : Int      -- uint16: Wormhole chain id
      managerAddress : Bytes32
      factoryEpoch   : Int      -- uint64: the vetted (managerAddress, factoryEpoch) pair
  deriving (Eq, Show)

-- | Encode an 'NttGovernanceAction'. The inverse of 'parseNttGovernance'.
-- @AcceptAdminToGovernance@/@RotateToCanonicalFactory@ are 75 bytes
-- (module(32) ‖ action(1) ‖ chain(2) ‖ managerAddress(32) ‖ factoryEpoch(8));
-- @RegisterBurnMintManager@ is 68 (module(32) ‖ action(1) ‖ chain(2) ‖
-- registrationBinding(32) ‖ tokenDecimals(1)).
encodeNttGovernance : NttGovernanceAction -> Bytes
encodeNttGovernance = \case
  AcceptAdminToGovernance chain managerAddress factoryEpoch ->
    nttGovernanceModule
      <> intToHexByte nttGovernanceAcceptAdminAction
      <> intToBytesN chain 2
      <> leftPadTo 32 managerAddress
      <> intToBytesN factoryEpoch 8
  RegisterBurnMintManager chain registrationBinding tokenDecimals ->
    nttGovernanceModule
      <> intToHexByte nttGovernanceRegisterBurnMintManagerAction
      <> intToBytesN chain 2
      <> leftPadTo 32 registrationBinding
      <> intToHexByte tokenDecimals
  RotateToCanonicalFactory chain managerAddress factoryEpoch ->
    nttGovernanceModule
      <> intToHexByte nttGovernanceRotateToCanonicalFactoryAction
      <> intToBytesN chain 2
      <> leftPadTo 32 managerAddress
      <> intToBytesN factoryEpoch 8

-- | Parse an NTT governance packet. Verifies the module is "Ntt" and dispatches
-- on the action id. Aborts (via 'error', matching 'Wormhole.Core.Governance.parseGovernance')
-- on the wrong module, an unknown action, or malformed input — every caller
-- runs this only after VAA signature verification, so a parse failure here
-- means a genuinely guardian-signed VAA for the wrong purpose, not a forgery.
parseNttGovernance : Bytes -> NttGovernanceAction
parseNttGovernance payload =
  let
    moduleId = normalizeHex (sliceBytes 0 32 payload)
    action = bytesToInt (sliceBytes 32 1 payload)
    chain = bytesToInt (sliceBytes 33 2 payload)
  in
    if moduleId /= nttGovernanceModule
      then error "ntt governance: not the Ntt module"
      else case action of
        1 -> AcceptAdminToGovernance
               chain
               (normalizeHex (sliceBytes 35 32 payload))
               (bytesToInt (sliceBytes 67 8 payload))
        2 -> RegisterBurnMintManager
               chain
               (normalizeHex (sliceBytes 35 32 payload))
               (bytesToInt (sliceBytes 67 1 payload))
        3 -> RotateToCanonicalFactory
               chain
               (normalizeHex (sliceBytes 35 32 payload))
               (bytesToInt (sliceBytes 67 8 payload))
        _ -> error ("ntt governance: unsupported action " <> show action)
