-- | The genesis 'NttCoinFactory' (a 'BurnMintFactory' plus, for
-- CIP-0056/CIP-0112 compliance, 'TransferFactory'/'AllocationFactory' v1+v2
-- and 'AV2.SettlementFactory'), and the templates those factories produce.
-- 'NttCoinFactory' is @signatory guardianGovernance@ alone, created once at
-- genesis, never replaced, and generic over its @instrumentId@, whose
-- @admin@ must always be @guardianGovernance@. See 'Wormhole.Ntt.Coin',
-- 'Wormhole.Ntt.CoinTransfer', 'Wormhole.Ntt.CoinAllocation', and
-- 'Wormhole.Ntt.CoinAllocationV2' for the sibling modules whose templates
-- this factory produces.
module Wormhole.Ntt.CoinFactory where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.AllocationInstructionV2 qualified as AIV2
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.AllocationV2 qualified as AV2
import Splice.Api.Token.BurnMintV1
  ( BurnMintFactory, BurnMintFactoryView (..)
  , BurnMintFactory_BurnMintResult (..)
  )
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId (..))
import Splice.Api.Token.HoldingV2 qualified as HoldingV2
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Splice.Api.Token.TransferInstructionV2 qualified as TIV2
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinAllocation
import Wormhole.Ntt.CoinAllocationV2
import Wormhole.Ntt.CoinTransfer

template NttCoinFactory
  with
    guardianGovernance : Party
  where
    signatory guardianGovernance

    interface instance BurnMintFactory for NttCoinFactory where
      view = BurnMintFactoryView with admin = guardianGovernance, meta = emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        assertMsg "ntt: NttCoinFactory only serves instruments administered by guardianGovernance"
          (arg.instrumentId.admin == guardianGovernance)
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        forA_ arg.inputHoldingCids \cid -> do
          hv <- view <$> fetch cid
          assertMsg "ntt: burn input's instrument does not match the requested instrumentId"
            (hv.instrumentId == arg.instrumentId)
          archive cid
        -- BurnMintFactory is party-based, not account-based -- mint/burn stays
        -- basic-account-only by construction.
        outputCids <- forA arg.outputs \o ->
          toInterfaceContractId @Holding <$> createCoinIn arg.instrumentId (basicAccountV2 o.owner) o.amount
        pure BurnMintFactory_BurnMintResult with outputCids

      burnMintFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure BurnMintFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance TIV1.TransferFactory for NttCoinFactory where
      view = TIV1.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

      transferFactory_transferImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        let t = arg.transfer
        assertTransferWindow t.requestedAt t.executeBefore
        -- v1 is inherently basic (a bare party, no account model) -- lift
        -- the sender/receiver parties into basic accounts for the shared,
        -- account-based core (Phase 2).
        let senderAccount = basicAccountV2 t.sender
            receiverAccount = basicAccountV2 t.receiver
        outcome <- nttTransferCore guardianGovernance (t.sender == t.receiver)
          senderAccount receiverAccount t.amount t.instrumentId t.inputHoldingCids arg.extraArgs
        case outcome of
          CoreCompleted{receiverCid, senderChangeCids} ->
            pure TIV1.TransferInstructionResult with
              output = TIV1.TransferInstructionResult_Completed with receiverHoldingCids = [receiverCid]
              senderChangeCids
              meta = emptyMetadata
          CorePendingNeeded{senderChangeCids} -> do
            instructionCid <- create NttTransferInstruction with
              instrumentId = t.instrumentId, senderAccount, receiverAccount, amount = t.amount
              requestedAt = t.requestedAt, executeBefore = t.executeBefore
            pure TIV1.TransferInstructionResult with
              output = TIV1.TransferInstructionResult_Pending with
                transferInstructionCid = toInterfaceContractId instructionCid
              senderChangeCids
              meta = emptyMetadata

      transferFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure TIV1.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance TIV2.TransferFactory for NttCoinFactory where
      view = TIV2.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

      transferFactory_transferExtraObservers _ = []

      transferFactory_transferImpl _self arg = do
        let t = arg.transfer
        assertTransferWindow t.requestedAt t.executeBefore
        -- Only the null-owner account is rejected -- sub-accounts and
        -- provider-delegated accounts are genuine, composable accounts on
        -- both sides.
        _ <- requireAccountOwner t.sender
        _ <- requireAccountOwner t.receiver
        assertMsg "ntt: TransferFactory_Transfer requires the sender account's owner and provider authority"
          (all (`elem` arg.actors) (accountControlParties t.sender))
        let instrumentId = InstrumentId with admin = t.instrumentId.admin, id = t.instrumentId.id
            inputHoldingCids = map coerceContractId t.inputHoldingCids
            receiverAuthorityPresent = all (`elem` arg.actors) (accountControlParties t.receiver)
        outcome <- nttTransferCore guardianGovernance receiverAuthorityPresent
          t.sender t.receiver t.amount instrumentId inputHoldingCids arg.extraArgs
        case outcome of
          CoreCompleted{receiverCid, senderChangeCids} ->
            pure TIV2.TransferInstructionResult with
              output = TIV2.TransferInstructionResult_Completed with
                receiverHoldingCids = [coerceContractId receiverCid]
              senderChangeCids = map coerceContractId senderChangeCids
              meta = emptyMetadata
          CorePendingNeeded{senderChangeCids} -> do
            instructionCid <- create NttTransferInstruction with
              instrumentId, senderAccount = t.sender, receiverAccount = t.receiver, amount = t.amount
              requestedAt = t.requestedAt, executeBefore = t.executeBefore
            pure TIV2.TransferInstructionResult with
              output = TIV2.TransferInstructionResult_Pending with
                transferInstructionCid = toInterfaceContractId instructionCid
              senderChangeCids = map coerceContractId senderChangeCids
              meta = emptyMetadata

      transferFactory_publicFetchImpl _self _arg =
        pure TIV2.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance AllocationFactory for NttCoinFactory where
      view = AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata

      allocationFactory_allocateImpl _self arg = do
        let spec = arg.allocation
            leg = spec.transferLeg
        assertMsg "ntt: NttCoinFactory only serves instruments administered by guardianGovernance"
          (leg.instrumentId.admin == guardianGovernance)
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        assertMsg "ntt: allocation amount must be positive" (leg.amount > 0.0)
        now <- getTime
        assertMsg "ntt: allocation window (allocateBefore) has passed" (now < spec.settlement.allocateBefore)
        -- v1 allocations are party-based, not account-based -- basic by
        -- construction.
        senderChangeCids <-
          debitInputs "allocation" leg.instrumentId (basicAccountV2 leg.sender) leg.amount arg.inputHoldingCids
        allocationCid <- toInterfaceContractId @Allocation <$> create NttCoinAllocation with
          instrumentId = leg.instrumentId, allocation = spec
        pure AllocationInstructionResult with
          output = AllocationInstructionResult_Completed with allocationCid
          senderChangeCids
          meta = emptyMetadata

      allocationFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance AIV2.AllocationFactory for NttCoinFactory where
      view = AIV2.AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata

      allocationFactory_allocateExtraObservers _ = []

      allocationFactory_allocateImpl _self arg = do
        let spec = arg.allocation
        assertMsg "ntt: allocation's admin does not match this factory's admin"
          (spec.admin == guardianGovernance)
        -- Only the null-owner account is rejected -- a provider-delegated or
        -- sub-account authorizer is genuine and composable (Phase 2, module
        -- header); its owner AND provider must both authorize the allocate.
        _ <- requireAccountOwner spec.authorizer
        assertMsg "ntt: AllocationFactory_Allocate requires the authorizer account's owner and provider authority"
          (all (`elem` arg.actors) (accountControlParties spec.authorizer))
        assertMsg "ntt: transferLegSides amounts must be positive"
          (all (> 0.0) (map (.amount) spec.transferLegSides))
        assertMsg "ntt: nextIterationFunding amounts must be positive"
          (all ((> 0.0) . snd) (TextMap.toList (fromOptional TextMap.empty spec.nextIterationFunding)))

        now <- getTime
        let round1Totals = sumSide AV2.SenderSide spec.transferLegSides
            reserveTotals = fromOptional TextMap.empty spec.nextIterationFunding
            requiredTotals = textMapUnionWith (+) round1Totals reserveTotals

        inputViews <- forA arg.inputHoldingCids \cid -> do
          hv <- view <$> fetch cid
          assertMsg "ntt: allocation input not owned by the authorizer" (hv.account == spec.authorizer)
          assertMsg "ntt: allocation input's instrument admin does not match this factory's admin"
            (hv.instrumentId.admin == guardianGovernance)
          pure hv
        forA_ arg.inputHoldingCids archive
        let inputsByInstrument = TextMap.fromListWithR (+) [(hv.instrumentId.id, hv.amount) | hv <- inputViews]
            instruments = dedup (map fst (TextMap.toList requiredTotals) ++ map fst (TextMap.toList inputsByInstrument))

        results <- forA instruments \instr -> do
          let have = fromOptional 0.0 (TextMap.lookup instr inputsByInstrument)
              need = fromOptional 0.0 (TextMap.lookup instr requiredTotals)
          assertMsg ("ntt: input holdings for " <> instr <> " do not cover the allocation's required funding")
            (have >= need)
          let change = have - need
          changeCids <-
            if change > 0.0
              then do
                cid <- toInterfaceContractId @HoldingV2.Holding <$>
                  createCoinIn (InstrumentId with admin = guardianGovernance, id = instr) spec.authorizer change
                pure [cid]
              else pure []
          pure (instr, need, changeCids)

        allocationCid <- toInterfaceContractId @AV2.Allocation <$> create NttCoinAllocationV2 with
          authorizerAccount = spec.authorizer
          settlement = arg.settlement
          allocation = spec
          lockedAmounts = TextMap.filter (> 0.0) (TextMap.fromList [(i, n) | (i, n, _) <- results])
          originalAllocationCid = None
          createdAt = now
          numIterations = 0

        pure AIV2.AllocationInstructionResult with
          output = AIV2.AllocationInstructionResult_Completed with allocationCid
          authorizerChangeCids = TextMap.fromList [(i, cs) | (i, _, cs) <- results, not (null cs)]
          meta = emptyMetadata

      allocationFactory_publicFetchImpl _self _arg =
        pure AIV2.AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance AV2.SettlementFactory for NttCoinFactory where
      view = AV2.SettlementFactoryView with admin = guardianGovernance, meta = emptyMetadata

      settlementFactory_settleBatchExtraObservers _ = []

      settlementFactory_settleBatchImpl _self arg = do
        assertMsg "ntt: SettlementFactory_SettleBatch requires at least one transfer leg"
          (not (null arg.transferLegs))
        assertMsg "ntt: SettlementFactory_SettleBatch requires actors to be exactly settlement.executors"
          (sameGroup arg.actors arg.settlement.executors)
        assertMsg "ntt: duplicate transferLegId in transferLegs"
          (length (dedup (map (.transferLegId) arg.transferLegs)) == length arg.transferLegs)

        allocViews <- forA arg.allocations \fa -> do
          av <- view <$> fetch fa.allocationCid
          assertMsg "ntt: allocation's admin does not match this factory's admin"
            (av.allocation.admin == guardianGovernance)
          assertMsg "ntt: allocation was not created for this settlement" (av.settlement == arg.settlement)
          pure (fa, av)

        let entries =
              [ (s.transferLegId, s.side, av.allocation.authorizer, s.otherside, s.amount, s.instrumentId)
              | (fa, av) <- allocViews, s <- av.allocation.transferLegSides ++ fa.extraTransferLegSides
              ]

        forA_ arg.transferLegs \leg -> do
          let senders = [e | e@(tlid, AV2.SenderSide, _, _, _, _) <- entries, tlid == leg.transferLegId]
              receivers = [e | e@(tlid, AV2.ReceiverSide, _, _, _, _) <- entries, tlid == leg.transferLegId]
          assertMsg ("ntt: transferLeg " <> leg.transferLegId <> " has no matching SenderSide allocation")
            (length senders == 1)
          assertMsg ("ntt: transferLeg " <> leg.transferLegId <> " has no matching ReceiverSide allocation")
            (length receivers == 1)
          let [(_, _, sAuth, sOther, sAmt, sInstr)] = senders
              [(_, _, rAuth, rOther, rAmt, rInstr)] = receivers
          assertMsg ("ntt: transferLeg " <> leg.transferLegId <> " SenderSide authorization mismatch")
            (sAuth == leg.sender && sOther == leg.receiver && sAmt == leg.amount && sInstr == leg.instrumentId)
          assertMsg ("ntt: transferLeg " <> leg.transferLegId <> " ReceiverSide authorization mismatch")
            (rAuth == leg.receiver && rOther == leg.sender && rAmt == leg.amount && rInstr == leg.instrumentId)

        assertMsg "ntt: allocations authorize transfer leg sides not covered by the given transferLegs"
          (length entries == 2 * length arg.transferLegs)

        allocationSettleResults <- forA allocViews \(fa, _) ->
          exercise fa.allocationCid AV2.Allocation_Settle with
            actors = guardianGovernance :: arg.settlement.executors
            extraTransferLegSides = fa.extraTransferLegSides
            nextIterationFunding = fa.nextIterationFunding
            extraArgs = withSettleBatchContext arg.extraArgs

        pure AV2.SettlementFactory_SettleBatchResult with allocationSettleResults, meta = emptyMetadata

      settlementFactory_publicFetchImpl _self _arg =
        pure AV2.SettlementFactoryView with admin = guardianGovernance, meta = emptyMetadata
