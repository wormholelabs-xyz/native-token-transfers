-- | The genesis 'NttCoinFactory': a 'BurnMintFactory' plus
-- 'TransferFactory'/'AllocationFactory' v1.
-- Signatory guardianGovernance alone, created once and never replaced;
-- instrumentId.admin must always equal guardianGovernance.
module Wormhole.Ntt.CoinFactory where

import DA.Foldable (forA_)
import DA.List (dedup)
import DA.Optional (fromOptional)
import DA.TextMap qualified as TextMap

import Splice.Api.Token.AllocationInstructionV1
import Splice.Api.Token.AllocationV1
import Splice.Api.Token.BurnMintV1
  ( BurnMintFactory, BurnMintFactoryView (..)
  , BurnMintFactory_BurnMintResult (..)
  )
import Splice.Api.Token.HoldingV1 (Holding, InstrumentId (..))
import Splice.Api.Token.MetadataV1 (emptyMetadata)
import Splice.Api.Token.TransferInstructionV1 qualified as TIV1
import Wormhole.Ntt.Coin
import Wormhole.Ntt.CoinAllocation
import Wormhole.Ntt.CoinTransfer

template NttCoinFactory
  with
    guardianGovernance : Party
  where
    signatory guardianGovernance

    interface instance BurnMintFactory for NttCoinFactory where
      view = BurnMintFactoryView with admin = guardianGovernance, meta = emptyMetadata

      burnMintFactory_burnMintImpl _self arg = do
        assertMsg "ntt: NttCoinFactory only serves instruments administered by guardianGovernance"
          (arg.instrumentId.admin == guardianGovernance)
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        forA_ arg.inputHoldingCids \cid -> do
          r <- fetchFromInterface @NttCoin cid
          case r of
            None -> abort "ntt: burn input is not an NttCoin issued by this registry"
            Some (_, coin) ->
              assertMsg "ntt: burn input's instrument does not match the requested instrumentId"
                (coin.instrumentId == arg.instrumentId)
          archive cid
        outputCids <- forA arg.outputs \o ->
          toInterfaceContractId @Holding <$> createCoin arg.instrumentId o.owner o.amount
        pure BurnMintFactory_BurnMintResult with outputCids

      burnMintFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure BurnMintFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance TIV1.TransferFactory for NttCoinFactory where
      view = TIV1.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

      transferFactory_transferImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        let t = arg.transfer
        assertTransferWindow t.requestedAt t.executeBefore
        outcome <- nttTransferCore guardianGovernance (t.sender == t.receiver)
          t.sender t.receiver t.amount t.instrumentId t.inputHoldingCids arg.extraArgs
        case outcome of
          CoreCompleted{receiverCid, senderChangeCids} ->
            pure TIV1.TransferInstructionResult with
              output = TIV1.TransferInstructionResult_Completed with receiverHoldingCids = [receiverCid]
              senderChangeCids
              meta = emptyMetadata
          CorePendingNeeded{senderChangeCids} -> do
            instructionCid <- create NttTransferInstruction with
              instrumentId = t.instrumentId, sender = t.sender, receiver = t.receiver, amount = t.amount
              requestedAt = t.requestedAt, executeBefore = t.executeBefore
            pure TIV1.TransferInstructionResult with
              output = TIV1.TransferInstructionResult_Pending with
                transferInstructionCid = toInterfaceContractId instructionCid
              senderChangeCids
              meta = emptyMetadata

      transferFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure TIV1.TransferFactoryView with admin = guardianGovernance, meta = emptyMetadata

    interface instance AllocationFactory for NttCoinFactory where
      view = AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata

      allocationFactory_allocateImpl _self arg = do
        let spec = arg.allocation
            leg = spec.transferLeg
        assertMsg "ntt: NttCoinFactory only serves instruments administered by guardianGovernance"
          (leg.instrumentId.admin == guardianGovernance)
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        assertMsg "ntt: allocation amount must be positive" (leg.amount > 0.0)
        now <- getTime
        assertMsg "ntt: allocation window (allocateBefore) has passed" (now < spec.settlement.allocateBefore)
        senderChangeCids <-
          debitInputs "allocation" leg.instrumentId leg.sender leg.amount arg.inputHoldingCids
        allocationCid <- toInterfaceContractId @Allocation <$> create NttCoinAllocation with
          instrumentId = leg.instrumentId, allocation = spec
        pure AllocationInstructionResult with
          output = AllocationInstructionResult_Completed with allocationCid
          senderChangeCids
          meta = emptyMetadata

      allocationFactory_publicFetchImpl _self arg = do
        assertMsg "ntt: expectedAdmin does not match this factory's admin"
          (arg.expectedAdmin == guardianGovernance)
        pure AllocationFactoryView with admin = guardianGovernance, meta = emptyMetadata
