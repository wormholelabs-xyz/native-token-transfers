-- | The guardian-governance-owned token registry: the 'NttCoin' holding, a
-- CIP-0056 token-standard asset. See 'Wormhole.Ntt.CoinTransfer',
-- 'Wormhole.Ntt.CoinAllocation', and 'Wormhole.Ntt.CoinFactory' for the
-- genesis factory and the templates it produces.
module Wormhole.Ntt.Coin where

import Splice.Api.Token.HoldingV1 (Holding, HoldingView (..), InstrumentId)
import Splice.Api.Token.MetadataV1 (emptyMetadata)

-- A token holding, named per Amulet's holding convention.
template NttCoin
  with
    instrumentId : InstrumentId
    owner        : Party
    amount       : Decimal
  where
    signatory instrumentId.admin, owner
    ensure amount > 0.0

    interface instance Holding for NttCoin where
      view = HoldingView with
        owner
        instrumentId
        amount
        lock = None
        meta = emptyMetadata

-- | Create a coin owned by the given party.
createCoin : InstrumentId -> Party -> Decimal -> Update (ContractId NttCoin)
createCoin instrumentId owner amount = create NttCoin with instrumentId, owner, amount
