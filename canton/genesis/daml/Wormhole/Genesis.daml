-- | Genesis of one Wormhole deployment on Canton. The operator offers every
-- genesis parameter in a 'WormholeGenesisOffer'. guardianGovernance (gg) and
-- the two custody parties accept it once with 'AcceptGenesis'. That one
-- transaction creates the 'CoreState', the 'EmitterRegistry', the
-- 'ReplayRootRegistry' and the 'NttGovernance' root. A first genesis also
-- creates the gg 'CoinFactory'.
--
-- SECURITY: 'AcceptGenesis' is the only code that runs with gg authority
-- outside a VAA path. It creates only the roots, and it checks each one
-- against the agreed parameters.
--
-- A re-genesis ('ReGenesisReplacing') names the earlier 'CoreState',
-- 'EmitterRegistry', 'ReplayRootRegistry' and 'NttGovernance'. 'AcceptGenesis'
-- checks that the parameters equal what the earlier roots imply: the
-- governance replay records, the guardian sets and the next ids. It archives
-- the earlier roots and creates the new roots in the same transaction. Thus
-- one gg has one set of active roots, each earlier governance VAA stays
-- consumed or below the eviction floor, the guardian set index stays, and
-- each new emitter and manager id is above the earlier ones. The new
-- 'NttGovernance' keeps the earlier root identity. The earlier 'CoinFactory'
-- stays active and is the 'CoinFactory' of the new roots: burn/mint managers
-- hold its cid, and one gg has one canonical factory.
module Wormhole.Genesis where

import DA.List (dedup, sort)
import DA.Map qualified as Map
import DA.Optional (isNone)
import Splice.Api.Token.HoldingV1 (InstrumentId)
import Token.CIP0056.CoinFactory (CoinFactory (..))
import Wormhole.Core.Bytes (EmitterAddress, checkHexValueIsWellFormed)
import Wormhole.Core.GuardianSet
  ( attachedPublicKeyCount, checkGuardianSetMembersAreWellFormed, numGuardians )
import Wormhole.Core.Setup
  ( GenesisGuardianSet (..), RegistryParties (..), cantonChainId, guardianSetMemberOfGenesisGuardian
  , mkInitialCoreState, mkInitialEmitterRegistry, mkInitialReplayRootRegistry )
import Wormhole.Core.State
  ( CoreState (..), EmitterRegistry (..), GovernanceReplayRecord (..), RegenesisGuardianSets (..)
  , ReplayRootRegistry (..), checkConsumedGovernanceIsBounded, maxEmitterId
  , tryGovernanceReplayRecordForRegenesis, tryGovernanceReplayRecordForRegenesisFromRecords, tryGuardianSetsForRegenesis )
import Wormhole.Ntt.Bytes (NttGovernanceRootIdentity)
import Wormhole.Ntt.Governance (NttGovernance (..), nttGovernanceReplayRecordOf)
import Wormhole.Ntt.Manager (nttGovernanceRootIdentityFor)

-- | 2^53 - 1, as core 'maxEmitterId': manager ids stay exact in JSON doubles.
maxNttManagerId : Int
maxNttManagerId = 9007199254740991

-- | The roots that a re-genesis archives, and the 'CoinFactory' that it keeps.
data EarlierGenesisRoots = EarlierGenesisRoots with
    coreStateCid          : ContractId CoreState
    emitterRegistryCid    : ContractId EmitterRegistry
    replayRootRegistryCid : ContractId ReplayRootRegistry
    nttGovernanceCid      : ContractId NttGovernance
    coinFactoryCid        : ContractId CoinFactory
  deriving (Eq, Show)

data GenesisKind
  = FirstGenesis
  | ReGenesisReplacing EarlierGenesisRoots
  deriving (Eq, Show)

-- | Every genesis parameter. Each gg owner compares it with its agreed copy.
data GenesisParameters = GenesisParameters with
    guardianGovernance         : Party
    feeCustody                 : Party                   -- CoreState feeRecipient
    nttCustody                 : Party
    onboardingFeeAdmin         : Party                   -- controller of SetRegistrationFee and SetClaimFee
    genesisGuardianSet         : GenesisGuardianSet      -- the current set: global index, each address and public key
    governanceChainId          : Int
    governanceContract         : EmitterAddress
    initialMessageFee          : Int                     -- 10^-10 feeInstrument units
    feeInstrument              : InstrumentId
    registrationFee            : Int                     -- 10^-10 feeInstrument units
    replayRootClaimFee         : Int                     -- 10^-10 feeInstrument units
    firstEmitterId             : Int                     -- EmitterRegistry nextId; the earlier registry's nextId on a re-genesis
    firstNttManagerId          : Int                     -- NttGovernance nextId; the earlier root's nextId on a re-genesis
    coreGovernanceReplayRecord : GovernanceReplayRecord  -- empty at a first genesis; tryGovernanceReplayRecordForRegenesis of the earlier CoreState
    nttGovernanceReplayRecord  : GovernanceReplayRecord  -- empty at a first genesis; tryGovernanceReplayRecordForRegenesisFromRecords of the earlier NttGovernance
    genesisKind                : GenesisKind
  deriving (Eq, Show)

-- | The contracts that 'AcceptGenesis' creates.
data GenesisRoots = GenesisRoots with
    coreStateCid          : ContractId CoreState
    emitterRegistryCid    : ContractId EmitterRegistry
    replayRootRegistryCid : ContractId ReplayRootRegistry
    nttGovernanceCid      : ContractId NttGovernance
    coinFactoryCid        : ContractId CoinFactory
  deriving (Eq, Show)

-- | The guardian set state and the root identity of the new roots: from the
-- parameters at a first genesis, from the earlier roots on a re-genesis.
data GenesisLineage = GenesisLineage with
    guardianSets : RegenesisGuardianSets
    rootIdentity : NttGovernanceRootIdentity
  deriving (Eq, Show)

checkGovernanceReplayRecordIsWellFormed : Text -> GovernanceReplayRecord -> Either Text ()
checkGovernanceReplayRecordIsWellFormed recordName replayRecord = do
  assertMsg ("genesis: a consumed " <> recordName <> " governance digest is not a well-formed VaaDigest")
    (all checkHexValueIsWellFormed (Map.keys replayRecord.consumedGovernance))
  assertMsg ("genesis: the " <> recordName <> " governance replay record is not bounded")
    (checkConsumedGovernanceIsBounded replayRecord.evictedGovernanceMaxTimestampSeconds replayRecord.consumedGovernance)

checkGenesisReplayRecordsAreWellFormed : GenesisParameters -> Bool
checkGenesisReplayRecordsAreWellFormed parameters =
  checkGovernanceReplayRecordIsWellFormed "core" parameters.coreGovernanceReplayRecord == Right ()
    && checkGovernanceReplayRecordIsWellFormed "NTT" parameters.nttGovernanceReplayRecord == Right ()

template WormholeGenesisOffer
  with
    operator   : Party
    parameters : GenesisParameters
  where
    signatory operator
    observer parameters.guardianGovernance, parameters.feeCustody, parameters.nttCustody
    ensure checkGenesisReplayRecordsAreWellFormed parameters

    -- | Creates the roots. Authority: the actors gg, feeCustody and
    -- nttCustody sign each root and each earlier root that a re-genesis
    -- archives; the operator signs only this offer, which the choice archives.
    choice AcceptGenesis : GenesisRoots
      with
        agreedParameters : GenesisParameters
      controller parameters.guardianGovernance, parameters.feeCustody, parameters.nttCustody
      do
        assertMsg "genesis: agreed parameters differ from the offer" (agreedParameters == parameters)
        either assertFail pure (checkGenesisParametersAreWellFormed parameters)
        (lineage, coinFactoryCid) <- case parameters.genesisKind of
          FirstGenesis -> do
            either assertFail pure (checkFirstGenesisStartsEmpty parameters)
            genesisTime <- getTime
            coinFactoryCid <- create CoinFactory with admin = parameters.guardianGovernance
            pure (firstGenesisLineageOf parameters genesisTime, coinFactoryCid)
          ReGenesisReplacing earlierRoots -> do
            lineage <- archiveEarlierRootsMatchingParameters parameters earlierRoots
            coinFactoryCid <- requireEarlierCoinFactoryOf parameters.guardianGovernance earlierRoots.coinFactoryCid
            pure (lineage, coinFactoryCid)
        roots <- createGenesisRoots parameters lineage coinFactoryCid
        checkGenesisRootsMatchParameters parameters lineage roots
        pure roots

    choice WithdrawGenesisOffer : ()
      controller operator
      do pure ()

-- | Parameter checks that run before the creates, for both genesis kinds. The
-- 'CoreState', registry and 'NttGovernance' preconditions run on each create.
-- The core key precondition binds only without governance history, so the
-- guardian keys are checked here for a re-genesis too.
checkGenesisParametersAreWellFormed : GenesisParameters -> Either Text ()
checkGenesisParametersAreWellFormed parameters = do
  checkGuardianSetMembersAreWellFormed
    (map guardianSetMemberOfGenesisGuardian parameters.genesisGuardianSet.guardians)
  -- sdk/vaa ChainID is a uint16, and 0 is ChainIDUnset.
  assertMsg "genesis: governance chain is 0 (unset)" (parameters.governanceChainId >= 1)
  assertMsg "genesis: governance chain exceeds uint16" (parameters.governanceChainId <= 65535)
  assertMsg "genesis: governance chain is the Canton chain" (parameters.governanceChainId /= cantonChainId)
  assertMsg "genesis: governance contract is not a well-formed EmitterAddress"
    (checkHexValueIsWellFormed parameters.governanceContract)
  assertMsg "genesis: fee custody party is guardianGovernance" (parameters.feeCustody /= parameters.guardianGovernance)
  assertMsg "genesis: NTT custody party is guardianGovernance" (parameters.nttCustody /= parameters.guardianGovernance)
  assertMsg "genesis: fee custody party is the NTT custody party" (parameters.feeCustody /= parameters.nttCustody)
  assertMsg "genesis: first emitter id is negative" (parameters.firstEmitterId >= 0)
  assertMsg "genesis: first emitter id exceeds the bound" (parameters.firstEmitterId <= maxEmitterId + 1)
  assertMsg "genesis: first NTT manager id is negative" (parameters.firstNttManagerId >= 0)
  assertMsg "genesis: first NTT manager id exceeds the bound" (parameters.firstNttManagerId <= maxNttManagerId)
  checkGovernanceReplayRecordIsWellFormed "core" parameters.coreGovernanceReplayRecord
  checkGovernanceReplayRecordIsWellFormed "NTT" parameters.nttGovernanceReplayRecord

-- | A first genesis has no governance history, so the core key precondition
-- requires each guardian public key.
checkFirstGenesisStartsEmpty : GenesisParameters -> Either Text ()
checkFirstGenesisStartsEmpty parameters = do
  assertMsg "genesis: a first genesis starts at emitter id 0" (parameters.firstEmitterId == 0)
  assertMsg "genesis: a first genesis starts at NTT manager id 0" (parameters.firstNttManagerId == 0)
  assertMsg "genesis: a first genesis has no consumed core governance digest"
    (Map.null parameters.coreGovernanceReplayRecord.consumedGovernance)
  assertMsg "genesis: a first genesis has no evicted core governance timestamp floor"
    (isNone parameters.coreGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds)
  assertMsg "genesis: a first genesis has no consumed NTT governance digest"
    (Map.null parameters.nttGovernanceReplayRecord.consumedGovernance)
  assertMsg "genesis: a first genesis has no evicted NTT governance timestamp floor"
    (isNone parameters.nttGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds)

firstGenesisLineageOf : GenesisParameters -> Time -> GenesisLineage
firstGenesisLineageOf parameters genesisTime = GenesisLineage with
  guardianSets = RegenesisGuardianSets with
    guardianSetIndex = parameters.genesisGuardianSet.guardianSetIndex
    guardianSets = (expectedFirstCoreStateOf parameters).guardianSets
  rootIdentity = nttGovernanceRootIdentityFor parameters.guardianGovernance genesisTime

-- | The guardian set state that a re-genesis carries. The parameters name the
-- current set of the earlier root, and each of its guardians has a key.
checkGenesisGuardianSetMatchesEarlierRoots : GenesisParameters -> RegenesisGuardianSets -> Either Text ()
checkGenesisGuardianSetMatchesEarlierRoots parameters regenesisSets = do
  assertMsg "genesis: guardian set index differs from the earlier CoreState"
    (parameters.genesisGuardianSet.guardianSetIndex == regenesisSets.guardianSetIndex)
  currentSet <- case Map.lookup regenesisSets.guardianSetIndex regenesisSets.guardianSets of
    Some currentSet -> Right currentSet
    None -> Left "genesis: the earlier CoreState has no current guardian set"
  assertMsg "genesis: a guardian of the earlier current set has no public key; attach it to the earlier CoreState first"
    (attachedPublicKeyCount currentSet == numGuardians currentSet)
  assertMsg "genesis: genesis guardians differ from the earlier current guardian set"
    (map guardianSetMemberOfGenesisGuardian parameters.genesisGuardianSet.guardians == currentSet.members)

-- | Fetches the earlier roots, checks that the parameters equal what they
-- imply, then archives them. Returns the lineage of the new roots.
archiveEarlierRootsMatchingParameters : GenesisParameters -> EarlierGenesisRoots -> Update GenesisLineage
archiveEarlierRootsMatchingParameters parameters earlierRoots = do
  let gg = parameters.guardianGovernance
  earlierCoreState <- fetch earlierRoots.coreStateCid
  earlierEmitterRegistry <- fetch earlierRoots.emitterRegistryCid
  earlierReplayRootRegistry <- fetch earlierRoots.replayRootRegistryCid
  earlierNttGovernance <- fetch earlierRoots.nttGovernanceCid
  assertMsg "genesis: earlier CoreState has another guardianGovernance" (earlierCoreState.guardianGovernance == gg)
  assertMsg "genesis: earlier CoreState has another fee custody party" (earlierCoreState.feeRecipient == parameters.feeCustody)
  assertMsg "genesis: earlier EmitterRegistry has another guardianGovernance" (earlierEmitterRegistry.guardianGovernance == gg)
  assertMsg "genesis: earlier ReplayRootRegistry has another guardianGovernance" (earlierReplayRootRegistry.guardianGovernance == gg)
  assertMsg "genesis: earlier NttGovernance has another guardianGovernance" (earlierNttGovernance.guardianGovernance == gg)
  assertMsg "genesis: earlier NttGovernance has another NTT custody party" (earlierNttGovernance.nttCustody == parameters.nttCustody)
  assertMsg "genesis: first emitter id differs from the earlier EmitterRegistry nextId"
    (parameters.firstEmitterId == earlierEmitterRegistry.nextId)
  assertMsg "genesis: first NTT manager id differs from the earlier NttGovernance nextId"
    (parameters.firstNttManagerId == earlierNttGovernance.nextId)
  earlierCoreReplayRecord <- either assertFail pure (tryGovernanceReplayRecordForRegenesis [earlierCoreState])
  assertMsg "genesis: core governance replay record differs from the earlier CoreState"
    (parameters.coreGovernanceReplayRecord == earlierCoreReplayRecord)
  earlierNttReplayRecord <- either assertFail pure (tryGovernanceReplayRecordForRegenesisFromRecords [nttGovernanceReplayRecordOf earlierNttGovernance])
  assertMsg "genesis: NTT governance replay record differs from the earlier NttGovernance"
    (parameters.nttGovernanceReplayRecord == earlierNttReplayRecord)
  regenesisSets <- either assertFail pure (tryGuardianSetsForRegenesis [earlierCoreState])
  either assertFail pure (checkGenesisGuardianSetMatchesEarlierRoots parameters regenesisSets)
  archive earlierRoots.coreStateCid
  archive earlierRoots.emitterRegistryCid
  archive earlierRoots.replayRootRegistryCid
  archive earlierRoots.nttGovernanceCid
  pure GenesisLineage with
    guardianSets = regenesisSets
    rootIdentity = earlierNttGovernance.rootIdentity

registryPartiesOf : GenesisParameters -> RegistryParties
registryPartiesOf parameters = RegistryParties with
  guardianGovernance = parameters.guardianGovernance
  onboardingFeeAdmin = parameters.onboardingFeeAdmin

expectedFirstCoreStateOf : GenesisParameters -> CoreState
expectedFirstCoreStateOf parameters =
  mkInitialCoreState parameters.guardianGovernance parameters.governanceChainId parameters.governanceContract
    parameters.genesisGuardianSet parameters.feeInstrument parameters.feeCustody

expectedCoreStateOf : GenesisParameters -> GenesisLineage -> CoreState
expectedCoreStateOf parameters lineage = (expectedFirstCoreStateOf parameters) with
  guardianSetIndex = lineage.guardianSets.guardianSetIndex
  guardianSets = lineage.guardianSets.guardianSets
  messageFee = parameters.initialMessageFee
  consumedGovernance = parameters.coreGovernanceReplayRecord.consumedGovernance
  evictedGovernanceMaxTimestampSeconds = parameters.coreGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds

expectedNttGovernanceOf : GenesisParameters -> GenesisLineage -> NttGovernance
expectedNttGovernanceOf parameters lineage = NttGovernance with
  guardianGovernance = parameters.guardianGovernance
  nttCustody = parameters.nttCustody
  nextId = parameters.firstNttManagerId
  rootIdentity = lineage.rootIdentity
  consumedGovernance = parameters.nttGovernanceReplayRecord.consumedGovernance
  evictedGovernanceMaxTimestampSeconds = parameters.nttGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds

-- | The earlier 'CoinFactory', checked to be administered by gg.
requireEarlierCoinFactoryOf : Party -> ContractId CoinFactory -> Update (ContractId CoinFactory)
requireEarlierCoinFactoryOf guardianGovernance earlierCoinFactoryCid = do
  earlierCoinFactory <- fetch earlierCoinFactoryCid
  assertMsg "genesis: earlier CoinFactory has another admin" (earlierCoinFactory.admin == guardianGovernance)
  pure earlierCoinFactoryCid

-- | Creates the core and NTT roots; @coinFactoryCid@ is the gg factory of the roots.
createGenesisRoots : GenesisParameters -> GenesisLineage -> ContractId CoinFactory -> Update GenesisRoots
createGenesisRoots parameters lineage coinFactoryCid = do
  coreStateCid <- create (expectedCoreStateOf parameters lineage)
  emitterRegistryCid <- create (mkInitialEmitterRegistry (registryPartiesOf parameters) parameters.registrationFee) with
    nextId = parameters.firstEmitterId
  replayRootRegistryCid <- create (mkInitialReplayRootRegistry (registryPartiesOf parameters) parameters.replayRootClaimFee)
  nttGovernanceCid <- create (expectedNttGovernanceOf parameters lineage)
  pure GenesisRoots with ..

checkSignatoriesAre : Text -> [Party] -> [Party] -> Update ()
checkSignatoriesAre templateName expectedSignatories actualSignatories =
  assertMsg ("genesis: " <> templateName <> " signatories differ from the parameters")
    (sort (dedup actualSignatories) == sort expectedSignatories)

-- | Fetches each created root and checks each field and each signatory list.
checkGenesisRootsMatchParameters : GenesisParameters -> GenesisLineage -> GenesisRoots -> Update ()
checkGenesisRootsMatchParameters parameters lineage roots = do
  let gg = parameters.guardianGovernance
      expectedCoreState = expectedCoreStateOf parameters lineage
      expectedNttGovernance = expectedNttGovernanceOf parameters lineage
  coreState <- fetch roots.coreStateCid
  checkSignatoriesAre "CoreState" [gg, parameters.feeCustody] (signatory coreState)
  assertMsg "genesis: CoreState has observers" (null (observer coreState))
  assertMsg "genesis: CoreState guardianGovernance" (coreState.guardianGovernance == gg)
  assertMsg "genesis: CoreState chainId" (coreState.chainId == cantonChainId)
  assertMsg "genesis: CoreState governanceChainId" (coreState.governanceChainId == parameters.governanceChainId)
  assertMsg "genesis: CoreState governanceContract" (coreState.governanceContract == parameters.governanceContract)
  assertMsg "genesis: CoreState guardianSetIndex" (coreState.guardianSetIndex == expectedCoreState.guardianSetIndex)
  assertMsg "genesis: CoreState guardianSets" (coreState.guardianSets == expectedCoreState.guardianSets)
  assertMsg "genesis: CoreState messageFee" (coreState.messageFee == parameters.initialMessageFee)
  assertMsg "genesis: CoreState feeInstrument" (coreState.feeInstrument == parameters.feeInstrument)
  assertMsg "genesis: CoreState feeRecipient" (coreState.feeRecipient == parameters.feeCustody)
  assertMsg "genesis: CoreState consumedGovernance"
    (coreState.consumedGovernance == parameters.coreGovernanceReplayRecord.consumedGovernance)
  assertMsg "genesis: CoreState evictedGovernanceMaxTimestampSeconds"
    (coreState.evictedGovernanceMaxTimestampSeconds == parameters.coreGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds)
  assertMsg "genesis: CoreState differs from the expected root" (coreState == expectedCoreState)

  emitterRegistry <- fetch roots.emitterRegistryCid
  checkSignatoriesAre "EmitterRegistry" [gg] (signatory emitterRegistry)
  assertMsg "genesis: EmitterRegistry has observers" (null (observer emitterRegistry))
  assertMsg "genesis: EmitterRegistry guardianGovernance" (emitterRegistry.guardianGovernance == gg)
  assertMsg "genesis: EmitterRegistry onboardingFeeAdmin" (emitterRegistry.onboardingFeeAdmin == parameters.onboardingFeeAdmin)
  assertMsg "genesis: EmitterRegistry registrationFee" (emitterRegistry.registrationFee == parameters.registrationFee)
  assertMsg "genesis: EmitterRegistry nextId" (emitterRegistry.nextId == parameters.firstEmitterId)

  replayRootRegistry <- fetch roots.replayRootRegistryCid
  checkSignatoriesAre "ReplayRootRegistry" [gg] (signatory replayRootRegistry)
  assertMsg "genesis: ReplayRootRegistry has observers" (null (observer replayRootRegistry))
  assertMsg "genesis: ReplayRootRegistry guardianGovernance" (replayRootRegistry.guardianGovernance == gg)
  assertMsg "genesis: ReplayRootRegistry onboardingFeeAdmin" (replayRootRegistry.onboardingFeeAdmin == parameters.onboardingFeeAdmin)
  assertMsg "genesis: ReplayRootRegistry claimFee" (replayRootRegistry.claimFee == parameters.replayRootClaimFee)

  nttGovernance <- fetch roots.nttGovernanceCid
  checkSignatoriesAre "NttGovernance" [gg, parameters.nttCustody] (signatory nttGovernance)
  assertMsg "genesis: NttGovernance has observers" (null (observer nttGovernance))
  assertMsg "genesis: NttGovernance guardianGovernance" (nttGovernance.guardianGovernance == gg)
  assertMsg "genesis: NttGovernance nttCustody" (nttGovernance.nttCustody == parameters.nttCustody)
  assertMsg "genesis: NttGovernance nextId" (nttGovernance.nextId == parameters.firstNttManagerId)
  assertMsg "genesis: NttGovernance rootIdentity" (nttGovernance.rootIdentity == lineage.rootIdentity)
  assertMsg "genesis: NttGovernance consumedGovernance"
    (nttGovernance.consumedGovernance == parameters.nttGovernanceReplayRecord.consumedGovernance)
  assertMsg "genesis: NttGovernance evictedGovernanceMaxTimestampSeconds"
    (nttGovernance.evictedGovernanceMaxTimestampSeconds == parameters.nttGovernanceReplayRecord.evictedGovernanceMaxTimestampSeconds)
  assertMsg "genesis: NttGovernance differs from the expected root" (nttGovernance == expectedNttGovernance)

  coinFactory <- fetch roots.coinFactoryCid
  checkSignatoriesAre "CoinFactory" [gg] (signatory coinFactory)
  assertMsg "genesis: CoinFactory has observers" (null (observer coinFactory))
  assertMsg "genesis: CoinFactory admin" (coinFactory.admin == gg)
